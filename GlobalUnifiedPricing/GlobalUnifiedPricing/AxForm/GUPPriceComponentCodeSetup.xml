				<Fields>
					<Field>
						<DataField>CalculationSequence</DataField>
						<Methods>
							<Method>
								<Name>modified</Name>
								<Source><![CDATA[
            public void modified()
            {
                super();

                RetailPricingPriorityTable  retailPricingPriorityTable;
                RetailPricingPriorityNumber priorityNumber = GUPPriceComponentCodeSetup.CalculationSequence > 0 ? CalculationSequenceBasis - GUPPriceComponentCodeSetup.CalculationSequence : 0;

                select firstonly retailPricingPriorityTable where retailPricingPriorityTable.PriorityNumber == priorityNumber;
                if (!retailPricingPriorityTable)
                {
                    retailPricingPriorityTable.PriorityNumber = priorityNumber;
                    retailPricingPriorityTable.insert();
                }

                RetailPeriodicDiscount retailPeriodicDiscount;

                while select forupdate PricingPriorityNumber from retailPeriodicDiscount
                    where retailPeriodicDiscount.PriceComponentCodeName == GUPPriceComponentCodeSetup.PriceComponentCodeName
                {
                    if (retailPeriodicDiscount.PricingPriorityNumber != priorityNumber)
                    {
                        retailPeriodicDiscount.PricingPriorityNumber = priorityNumber;
                        retailPeriodicDiscount.doUpdate();
                    }
                }
            }

]]></Source>
