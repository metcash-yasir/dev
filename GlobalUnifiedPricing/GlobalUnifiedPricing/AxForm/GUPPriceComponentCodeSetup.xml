public class GUPPriceComponentCodeSetup extends FormRun
{
    protected const RetailPricingPriorityNumber CalculationSequenceBasis = 1000;


}
]]></Source>
			</Method>
			<Method>
				<Name>changeLayoutByPriceComponentCode</Name>
				<Source><![CDATA[
    private void changeLayoutByPriceComponentCode()
    {
        GUPPriceComponentCodeSetup.PriceComponent = GUPPriceComponentCodeSetup.PriComponent();
        if (GUPPriceComponentCodeSetup.PriceComponent != GUPPriceComponent::PriceMarginComponentAdjustment)
        {
            GUPPriceComponentCodeSetup.CompoundcalculationBasis = false;
        }

        MarginComponentSetup_CompoundcalculationBasis.allowEdit(GUPPriceComponentCodeSetup.PriceComponent == GUPPriceComponent::PriceMarginComponentAdjustment);

        if (GUPPriceComponentCodeSetup.PriceComponent == GUPPriceComponent::PriceMarginComponentAdjustment)
        {
            GUPPriceComponentCodeSetup.ConcurrencyModeAcrossPriority = GUPDiscountConcurrencyModeAcrossPriority::Compound;
        }

        GUPPriceComponentCodeSetup_ConcurrencyModeAcrossPriority.allowEdit(GUPPriceComponentCodeSetup.PriceComponent == GUPPriceComponent::RetailDiscounts);

        MarginComponentSetup_PostInLedger.allowEdit(
            GUPPriceComponentCodeSetup.PriceComponent != GUPPriceComponent::RebateManagement && 
            GUPPriceComponentCodeSetup.PriceComponent != GUPPriceComponent::AutoCharges);
    }

]]></Source>
			</Method>
			<Method>
				<Name>refresh</Name>
				<Source><![CDATA[
    private void refresh()
    {
        if (PriceComponentCodeSetup != null)
        {
            var groupings = ColumnGroupingContexts::construct();
            groupings.addGrouping(ColumnGroupingContext::construct(formControlStr(GUPPriceComponentCodeSetup, GUPPriceComponentCodeSetup_PriceComponent)));
            PriceComponentCodeSetup.columnGrouping(groupings.serialize());
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        super();

        this.refresh();
    }

]]></Source>
			</Method>
			<Method>
				<Name>initSortOrder</Name>
				<Source><![CDATA[
    private void initSortOrder()
    {
        Query query = GUPPriceComponentCodeSetup_ds.query();

        query.dataSourceTable(tableNum(GUPPriceComponentCodeSetup)).addOrderByField(fieldNum(GUPPriceComponentCodeSetup, PriceComponent));
        query.dataSourceTable(tableNum(GUPPriceComponentCodeSetup)).addOrderByField(fieldNum(GUPPriceComponentCodeSetup, CalculationSequence));
    }

]]></Source>
