    {
        str ret = SysComputedColumn::if(SysComputedColumn::equalExpression(GUPItemBasePriceCurrentActive::getToDate(), SysComputedColumn::returnLiteral(DateTimeUtil::minValue())),
            SysComputedColumn::returnLiteral(NoYes::Yes),                    
                SysComputedColumn::if(SysComputedColumn::compareExpressions(GUPItemBasePriceCurrentActive::getToDate(), '>=', sysComputedColumn::GetCurrentDate()),
                    SysComputedColumn::returnLiteral(NoYes::Yes),
                    SysComputedColumn::returnLiteral(NoYes::No)));

        return ret;
    }

