		<Methods>
			<Method>
				<Name>mapEntityToDataSource</Name>
				<Source><![CDATA[
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        InventDim inventdim;
        InventDim inventdimBuffer;

        switch (_dataSourceCtx.name())
        {
            case dataEntityDataSourceStr(GUPFreeItemLineEntity, InventDim):  
                inventdim.InventSiteId = this.InventSiteId;
                inventdim.inventLocationid = this.InventLocationId;
                inventdimBuffer = InventDim::findOrCreate(inventdim);
                _dataSourceCtx.setbuffer(inventdimBuffer);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::Update);
                break;

            case dataEntityDataSourceStr(GUPFreeItemLineEntity, GUPFreeItemLine):
                if (!this.VariantDisplayProductNumber && _dataSourceCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Insert)
                {
                    //The data entity query does not recognise an existing record is about to be updated. 
                    //It still tries to insert, so the code is needed to re-setbuffer and do an update instead. 

                    GUPFreeItemLine gupFreeItemLine;
                    EcoResProduct   product;
                    UnitOfMeasure   unitOfMeasure;

                    select firstonly gupFreeItemLine
                        join product
                            where product.RecId == gupFreeItemLine.Product
                        join inventDim
                            where inventDim.inventDimId == gupFreeItemLine.InventDimId
                        join unitOfMeasure
                            where unitOfMeasure.RecId == gupFreeItemLine.UnitOfMeasure
                                && gupFreeItemLine.Variant == 0
                                && gupFreeItemLine.FreeItemGroup == this.FreeItemGroup
                                && gupFreeItemLine.FreeItemId == this.FreeItemId
                                && product.DisplayProductNumber == this.ProductDisplayProductNumber
                                && unitOfMeasure.Symbol == this.UnitOfMeasure_Symbol
                                && inventDim.InventSiteId == this.InventSiteId
                                && inventdim.InventLocationId == this.InventLocationId;
                                        
                    if (gupFreeItemLine)
                    {
                        _dataSourceCtx.setBuffer(gupFreeItemLine);
                        _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::Update);                       
                    }
                }
        }
        super(_entityCtx, _dataSourceCtx);
    }

]]></Source>
			</Method>
		</Methods>
