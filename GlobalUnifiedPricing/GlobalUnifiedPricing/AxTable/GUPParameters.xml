			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (this.EnablePriceTree)
        {
            ret = ret && this.validateSalesOrderAttributeGroup();
        }
        else
        {
            ret = ret && this.validateIfPricingTreeExists();
        }
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>shouldSkipValidation</Name>
				<Source><![CDATA[
    public boolean shouldSkipValidation()
    {
        return false;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateSalesOrderAttributeGroup</Name>
				<Source><![CDATA[
    protected boolean validateSalesOrderAttributeGroup()
    {
        EcoResAttributeGroupAttribute ecoResAttributeGroupAttribute;

        select count(RecId) from ecoResAttributeGroupAttribute
            where ecoResAttributeGroupAttribute.AttributeGroup == this.SalesOrderAttributeGroup;

        if (!this.shouldSkipValidation() && ecoResAttributeGroupAttribute.RecId != 1)
        {
            checkFailed("@GlobalUnifiedPricing:GUPParameters_SalesOrderAttributeGroup_validate");
            return false;
        }

        return true;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateIfPricingTreeExists</Name>
				<Source><![CDATA[
    private boolean validateIfPricingTreeExists()
    {
        GUPPricingTree gupPricingTree;

        select firstonly RecId from gupPricingTree;
        if (gupPricingTree.RecId)
        {
            checkFailed("@GlobalUnifiedPricing:GUPPriceTree_disablePriceTree");
            return false;
        }

        return true;
    }

]]></Source>
			</Method>
			<Method>
				<Name>isLegacySCMSalesOrder</Name>
				<Source><![CDATA[
    public static boolean isLegacySCMSalesOrder(SalesTable _salesTable)
    {
        RetailSalesTable retailSalesTable;

        select retailSalesTable where retailSalesTable.salesTable == _salesTable.RecId;

        return (!retailSalesTable.RecId || !retailSalesTable.RetailChannel) && !retailSalesTable.ShouldUseUnifiedPricingEngineOnSalesOrder;
    }

]]></Source>
			</Method>
