			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static GUPParameters find(boolean _forupdate = false)
    {
        GUPParameters parameter = null;

        parameter.selectForUpdate(_forupdate);

        select firstonly parameter 
            index Key 
            where parameter.Key == 0;

        if (! parameter && !parameter.isTmp())
        {
            Company::createParameter(parameter);
        }

        return parameter;
    }

]]></Source>
