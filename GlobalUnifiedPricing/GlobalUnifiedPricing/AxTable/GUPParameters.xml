			<Method>
				<Name>attributeGroupUsedForPriceTree</Name>
				<Source><![CDATA[
    public static boolean attributeGroupUsedForPriceTree(EcoResAttributeGroup _ecoResAttributeGroup)
    {
        return GUPParameters::find().EnablePriceTree && _ecoResAttributeGroup.RecId == GUPParameters::find().SalesOrderAttributeGroup;
    }

]]></Source>
