		<Methods>
			<Method>
				<Name>findOrCreate</Name>
				<Source><![CDATA[
    public static GUPPriceTreeInstanceValue findOrCreate(GUPPriceTreeName _name, DataAreaId _priceTreeDataAreaId)
    {
        GUPPriceTreeInstanceValue gupPriceTreeInstanceValue;

        if (_name && _priceTreeDataAreaId)
        {
            gupPriceTreeInstanceValue = GUPPriceTreeInstanceValue::findByPriceTree(_name, _priceTreeDataAreaId, false);

            // Insert new value if no record identifier found.
            if (!gupPriceTreeInstanceValue.RecId)
            {
                ttsbegin;
                gupPriceTreeInstanceValue.initValue();
                gupPriceTreeInstanceValue.PriceTreeName = _name;
                gupPriceTreeInstanceValue.PriceTreeDataAreaId = _priceTreeDataAreaId;
                gupPriceTreeInstanceValue.insert();
                ttscommit;
            }
        }

        return gupPriceTreeInstanceValue;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByPriceTree</Name>
				<Source><![CDATA[
    public static GUPPriceTreeInstanceValue findByPriceTree(GUPPriceTreeName _name, DataAreaId _priceTreeDataAreaId, boolean _forupdate = false)
    {
        GUPPriceTreeInstanceValue gupPriceTreeInstanceValue;

        if (_name && _priceTreeDataAreaId)
        {
            gupPriceTreeInstanceValue.selectForUpdate(_forupdate);
            select firstonly gupPriceTreeInstanceValue
                where gupPriceTreeInstanceValue.PriceTreeName == _name
                && gupPriceTreeInstanceValue.PriceTreeDataAreaId == _priceTreeDataAreaId;
        }

        return gupPriceTreeInstanceValue;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    internal static GUPPriceTreeInstanceValue find(RefRecId _recId, boolean _forupdate = false)
    {
        GUPPriceTreeInstanceValue record;

        if (_recId)
        {
            record.selectForUpdate(_forupdate);

            select firstonly record
                where record.RecId == _recId;
        }

        return record;
    }

]]></Source>
			</Method>
