		<Methods>
			<Method>
				<Name>pricingAttribute</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets the related pricing attribute.
    /// </summary>
    /// <returns>The pricing attribute.</returns>
    public GUPIPricingAttribute pricingAttribute()
    {
        GUPPricingAttributeLink link = this.priceAttributeLink();

        return GUPPricingAttributeRepository::priceAttribute(
            link.PriceAttributeClassId,
            link.AttributeProviderClassId,
            link.AttributeName,
            link.TypeName);
    }

]]></Source>
			</Method>
			<Method>
				<Name>priceAttributeLink</Name>
				<Source><![CDATA[
    public GUPPricingAttributeLink priceAttributeLink()
    {
        GUPPricingAttributeLink link;

        select firstonly link where link.RecId == this.ConditionAttribute;

        return link;
    }

]]></Source>
			</Method>
			<Method>
				<Name>editConditionValue</Name>
				<Source><![CDATA[
    /// <summary>
    /// Modifies condition value
    /// </summary>
    /// <param name = "_name">New value</param>
    /// <param name = "_appendValueOnLookup">Append/override value</param>
    public void editConditionValue(Name _name, NoYes _appendValueOnLookup = NoYes::No)
    {
        if (_appendValueOnLookup
                    && strLen(this.ConditionValue) > 0)
        {
            boolean categoryAlreadyAdded = false;
            ListEnumerator existingCategoriesListEnumerator = strSplit(this.ConditionValue, ',').getEnumerator();
            while (existingCategoriesListEnumerator.moveNext())
            {
                if (existingCategoriesListEnumerator.current() == _name)
                {
                    categoryAlreadyAdded = true;
                    break;
                }
            }
            if (!categoryAlreadyAdded)
            {
                this.ConditionValue +=  ',' + _name;
            }
        }
        else
        {
            this.ConditionValue = _name;
        }
    }

]]></Source>
			</Method>
