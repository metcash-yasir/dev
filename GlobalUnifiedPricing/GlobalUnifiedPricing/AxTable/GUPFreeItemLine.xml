		<Methods>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    public static boolean exists(
        RetailOfferId _offerId,
        GUPFreeItemGroupId _freeItemGroup)
    {
        return GUPFreeItemLine::findByFreeItemGroup(_offerId, _freeItemGroup).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static GUPFreeItemLine find(
        RecId _recId,
        boolean _selectForUpdate = false)
    {
        GUPFreeItemLine freeItemLine;
        freeItemLine.selectForUpdate(_selectForUpdate);

        select firstOnly freeItemLine
            where freeItemLine.RecId == _recId;

        return freeItemLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByFreeItemGroup</Name>
				<Source><![CDATA[
    public static GUPFreeItemLine findByFreeItemGroup(
        RetailOfferId _offerId,
        GUPFreeItemGroupId _freeItemGroup,
        boolean _selectForUpdate = false)
    {
        GUPFreeItemLine freeItemLine;
        freeItemLine.selectForUpdate(_selectForUpdate);

        select firstOnly freeItemLine
            where freeItemLine.FreeItemId == _offerId
               && freeItemLine.FreeItemGroup == _freeItemGroup;

        return freeItemLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByFreeItemLine</Name>
				<Source><![CDATA[
    public static GUPFreeItemLine findByFreeItemLine(
        GUPFreeItemLine _freeItemLine,
        boolean _selectForUpdate = false)
    {
        GUPFreeItemLine freeItemLine;
        freeItemLine.selectForUpdate(_selectForUpdate);

        select firstOnly freeItemLine
            where freeItemLine.FreeItemId == _freeItemLine.FreeItemId
               && freeItemLine.FreeItemGroup == _freeItemLine.FreeItemGroup
               && freeItemLine.Product == _freeItemLine.Product
               && freeItemLine.Variant == _freeItemLine.Variant
               && freeItemLine.UnitOfMeasure == _freeItemLine.UnitOfMeasure
              && freeItemLine.InventDimId == _freeItemLine.InventDimId;

        return freeItemLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (!this.UnitOfMeasure)
        {
            return checkFailed(strFmt("@MCR38340", fieldstr(GUPFreeItemLine, UnitOfMeasure)));
        }

        if (!this.Product)
        {
            return checkFailed(strFmt("@MCR38340", fieldstr(GUPFreeItemLine, product)));
        }

        return ret;
    }

]]></Source>
