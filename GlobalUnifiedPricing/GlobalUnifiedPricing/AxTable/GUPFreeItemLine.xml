			<Method>
				<Name>findByCRTFreeItemLine</Name>
				<Source><![CDATA[
    public static GUPFreeItemLine findByCRTFreeItemLine(Microsoft.Dynamics.Commerce.Runtime.DataModel.AttributeBasedPricing.FreeItemLine _crtFreeItemLine)
    {
        GUPFreeItemLine gupFreeItemLine;

        select firstonly gupFreeItemLine
            where gupFreeItemLine.RecId == str2Int64(_crtFreeItemLine.RecordId);

        return gupFreeItemLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedFieldValue</Name>
				<Source><![CDATA[
    public void modifiedFieldValue(FieldName _fieldName, int _arrayIndex = 1)
    {
        super(_fieldName, _arrayIndex);

        if (_fieldName == fieldStr(GUPFreeItemLine, Product))
        {
            this.Variant = 0;
        }
    }

]]></Source>
