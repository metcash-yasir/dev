			<Control>
				<Name>PrintDestination</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void clicked()
        {
            super();
            if (!destinationSettings)
            {
                destinationSettings = new SRSPrintDestinationSettings();
            }
            // Updating destination availability from report setup
            LACArgs args = LACArgs::construct();
            args.parmReportName(ssrsReportStr(SalesConfirm, Report));
            destinationSettings.lacDestinationSettings().allowForcedReRun(LACReport::find(Args.parmReportName()).ArchiveAllowForcedRerun != LACAllowForcedRerun::None);
            LACReportNameFinder::updateDestinationSettings(destinationSettings, args);
            // Show dialog
            SrsReportRunUtil::showSettingsDialog(destinationSettings);
            destinationTypeCtrl.update();
            destinationNameCtrl.update();
        }

]]></Source>
					</Method>
