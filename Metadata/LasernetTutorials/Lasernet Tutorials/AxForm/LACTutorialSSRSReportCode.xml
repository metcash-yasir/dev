			<Control>
				<Name>PostProformaGetPDF</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        ///  This code demonstrates how to get Lasernet generated report file (PDF) from the Posting process - Sales Invoice Proforma
        /// </summary>
        public void clicked()
        {
            SalesId         salesId;
            boolean         fileGenerated;

            super();

            Common          salesTable;
            Common          salesLine;

            // Checing LAC report for SalesInvoice.Report
            if (!LACReport::find('SalesInvoice.Report').Active)
            {
                throw Error("No active Lasernet report found for 'SalesInvoice.Report'.");
            }

            salesTable = DictTable::createRecord('SalesTable');
            salesLine = DictTable::createRecord('SalesLine');
            

        
            // Selecting last Sales order that can generate Invoice proforma
            // Using Common to avoid reference to non related modules
            select firstonly salesTable
            order by CreatedDateTime desc
            where salesTable.(fieldNum(SalesTable, SalesStatus)) != SalesStatus::Invoiced &&
                 salesTable.(fieldNum(SalesTable, SalesStatus)) != SalesStatus::Canceled
            exists join salesLine
                where salesLine.(fieldNum(SalesLine, SalesId)) == salesTable.(fieldNum(SalesTable, SalesId));
            if (!salesTable)
            {
                throw Error("No Sales order was found for the invoice proforma.");
            }
            salesId = salesTable.(fieldNum(SalesTable, SalesId));

            // Posting Sales Invoice Proforma
            SalesFormLetter salesFormLetter = SalesFormLetter::construct(DocumentStatus::Invoice);
            SRSPrintDestinationSettings pds = LACReportRunResult_DispContext::getSRSPrintDestinationSettings();
            salesFormLetter.updatePrinterSettingsFormLetter(pds.pack());
            // Using Disposable context object that is wrapping actual Posting process, that has Report print inside
            // This conext object can be accessed from the inner process and used to put required information. In this case Result of PDF file
            using (LACReportRunResult_DispContext reportRunResultContext = new LACReportRunResult_DispContext())
            {
                salesFormLetter.update(SalesTable::find(salesId), salesFormLetter.transDate(), SalesUpdate::All, AccountOrder::None, NoYes::Yes, NoYes::Yes, NoYes::No);
            
                // result to be filled in with all infomration (PDF binaries) in deeper process
                while (reportRunResultContext.moveNextLACResult())
                {
                    if (reportRunResultContext.currentLACResult().dataPDF())
                    {
                        str                     reportName = reportRunResultContext.currentLACResult().parmReportName();
                        Filename                fileName = reportName + '_' + reportRunResultContext.currentLACResult().firstDestination().outputFile(LACFileType::PDF).fileNameOnly();

                        System.IO.MemoryStream  fileData = Binary::constructFromContainer(reportRunResultContext.currentLACResult().dataPDF()).getMemoryStream();
                        File::SendFileToUser(fileData, fileName);
                        fileGenerated = true;
                    }
                }
            }
            if (!fileGenerated)
            {
                warning('No files were generated or retrieved.');
            }
        }

]]></Source>
					</Method>
