				<Name>validateProfileId</Name>
				<Source><![CDATA[
    public boolean validateProfileId()
    {
        boolean ret = true;

        if (element.design().controlName(formControlStr(UPSPriceMarginComponentCopyProfile, ProfileId)).valueStr() == "")
        {
            ret = checkFailed("@UnifiedPricingService:UPSPostProfileCheck");
        }

        return ret;
    }

]]></Source>
