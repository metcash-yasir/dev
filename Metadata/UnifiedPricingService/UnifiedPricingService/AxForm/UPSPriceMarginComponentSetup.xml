						<Source><![CDATA[
        public int active()
        {
            int ret;
        
            ret = super();

            if (UPSPriceMarginComponentSetup.PostInLedger == NoYes::Yes)
            {
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, PostingProfile)).mandatory(true);
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, PostingProfile)).allowEdit(true);
            }
            else
            {
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, PostingProfile)).mandatory(false);
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, PostingProfile)).allowEdit(false);
            }


            if (UPSPriceMarginComponentSetup.Flexible == NoYes::Yes)
            {
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, CalculationSequence)).mandatory(false);
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, CalculationSequence)).allowEdit(false);

                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, CompoundcalculationBasis)).allowEdit(false);
            }
            else
            {
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, CalculationSequence)).mandatory(true);
                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, CalculationSequence)).allowEdit(true);

                UPSPriceMarginComponentSetup.dataSource().object(fieldNum(UPSPriceMarginComponentSetup, CompoundcalculationBasis)).allowEdit(true);
            }
        
            return ret;
        }

]]></Source>
