					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            xMenuFunction menuFunction = this.menufunction();

            xArgs args = new Args(element);
            args.parmEnumType(enumNum(UPSPricingAttributeSourceLevel));
            args.parmEnum(enum2int(UPSPricingAttributeSourceLevel::Line));

            if (!upsPriceTermJournalTrans.PricingRule)
            {
                ttsbegin;

                UPSPricingRule rule;
                rule.insert();

                upsPriceTermJournalTrans.PricingRule = rule.RecId;
                upsPriceTermJournalTrans.update();

                ttscommit;
            }

            args.record(upsPriceTermJournalTrans.upsPricingRule());

            menuFunction.run(args);
        }

]]></Source>
