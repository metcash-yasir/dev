				<Source><![CDATA[
    public void init()
    {
        super();

        UPSPriceTermJournalTable journalTable = element.callerTable();
        if (journalTable.RecId)
        {
            if (journalTable.Posted)
            {
                UPSPriceTermJournalTrans_ds.allowEdit(false);

                PostButton.enabled(false);
                ValidateButton.enabled(false);

                UPSAddPriceAttributeGroup.enabled(false);
                UPSPriceTermJournalTransCopy.enabled(false);
            }
        }

        journalFormTrans = new JournalFormTrans(element);
        journalFormTrans.parmCtrlCheckJournal(ValidateButton);
        journalFormTrans.parmCtrlPostJournal(PostButton);

        journalFormTrans.formInitPost();
    }

]]></Source>
