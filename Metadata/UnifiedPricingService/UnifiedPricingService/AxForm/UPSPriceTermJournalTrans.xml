			<Method>
				<Name>selectPriceAttributeGroup</Name>
				<Source><![CDATA[
    private UPSPricingRule selectPriceAttributeGroup(UPSPricingRule _pricingRule)
    {
        Args args = new Args(formStr(UPSAddPriceAttributeGroup));
        args.parmEnumType(enumNum(UPSPricingAttributeSourceLevel));
        args.parmEnum(enum2int(_pricingRule.getSourceLevel()));
        args.record(_pricingRule);

        FormRun selectAttributeGrpForm = classFactory.formRunClass(args);
        selectAttributeGrpForm.init();
        selectAttributeGrpForm.run();
        selectAttributeGrpForm.wait();

        UPSPricingRule ret;

        if (formHasMethod(selectAttributeGrpForm, identifierStr(masterRecord)))
        {
            ret = selectAttributeGrpForm.masterRecord();
        }

        return ret;
    }

]]></Source>
