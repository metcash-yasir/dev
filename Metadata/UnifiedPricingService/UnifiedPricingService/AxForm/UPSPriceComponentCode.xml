				<Source><![CDATA[
    private void lookupAttributeGroup(FormControl _control, UPSPricingAttributeSourceLevel _level)
    {
        SysTableLookup sysTableLookup = SysTableLookup::newParameters(tableNum(UPSPricingAttributeGroup), _control);
        Query query = new Query();
        QueryBuildDataSource qbdsGroup = query.addDataSource(tableNum(UPSPricingAttributeGroup));
        qbdsGroup.addRange(fieldNum(UPSPricingAttributeGroup, SourceLevel))
                 .value(any2Str(_level));
        qbdsGroup.addRange(fieldNum(UPSPricingAttributeGroup, IsValid))
                 .value(any2Str(NoYes::Yes));

        sysTableLookup.addLookupfield(fieldNum(UPSPricingAttributeGroup, Name));
        sysTableLookup.addLookupfield(fieldNum(UPSPricingAttributeGroup, FriendlyName));

        sysTableLookup.parmQuery(query);
        sysTableLookup.performFormLookup();
    }

]]></Source>
