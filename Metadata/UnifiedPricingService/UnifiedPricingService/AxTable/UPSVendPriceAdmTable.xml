    public static UPSVendPriceAdmTable find(UPSVendPriceJournalNum _journalNum, boolean _forupdate = false)
    {
        UPSVendPriceAdmTable UPSVendPriceAdmTable;

        if (_journalNum)
        {
            UPSVendPriceAdmTable.selectForUpdate(_forupdate);

            select firstonly UPSVendPriceAdmTable
                index hint JournalNumIdx
                where UPSVendPriceAdmTable.JournalNum == _journalNum;
        }

        return UPSVendPriceAdmTable;
    }

