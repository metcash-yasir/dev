		<Methods>
			<Method>
				<Name>checkSourceLevel</Name>
				<Source><![CDATA[
    internal boolean checkSourceLevel()
    {
        boolean ret = true;

        UPSPricingAttributeGroup selectionGroup = UPSPricingAttributeGroup::find(this.PriceAttributeGroup);
        
        if (selectionGroup.SourceLevel != this.SourceLevel)
        {
            ret = checkFailed("@UnifiedPricingService:SourceLevelNotMatchedError");
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>checkPriority</Name>
				<Source><![CDATA[
    internal boolean checkPriority()
    {
        boolean ret = true;

        UPSPricingAttributeGroup selectionGroup = UPSPricingAttributeGroup::find(this.PriceAttributeGroup);
        
        if (selectionGroup && this.Priority < 0)
        {
            ret = checkFailed("@UnifiedPricingService:SelectionPriorityNegativeError");
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();
    
        ret = ret && this.checkSourceLevel();
        ret = ret && this.checkPriority();

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>editPriceAttributeGroupSelection</Name>
				<Source><![CDATA[
    public edit Name editPriceAttributeGroupSelection(boolean _set, UPSPriceComponentCodePriceAttributeGroupSelection _attributeGroupSelection, Name _name)
    {
        Name result = UPSPricingAttributeGroup::find(_attributeGroupSelection.PriceAttributeGroup).Name;

        if (_set)
        {
            UPSPricingAttributeGroup attributeGroup = UPSPricingAttributeGroup::findByName(_name);
            if (attributeGroup.RecId)
            {
                _attributeGroupSelection.PriceAttributeGroup = attributeGroup.RecId;
            }
            else
            {
                checkFailed("@UnifiedPricingService:PriceAttributeGroupNameNotExistError");
            }
        }

        return result;
    }

]]></Source>
			</Method>
