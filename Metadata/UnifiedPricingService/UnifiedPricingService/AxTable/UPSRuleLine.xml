	<SourceCode>
		<Declaration><![CDATA[
public class UPSRuleLine extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>linePricingRule</Name>
				<Source><![CDATA[
    public UPSPricingRule linePricingRule(boolean _selectForUpdate = false)
    {
        UPSPricingRule lineRule;
        lineRule.selectForUpdate(_selectForUpdate);
        select firstonly lineRule where lineRule.RecId == this.linePricingRule;
        return lineRule;
    }

]]></Source>
			</Method>
			<Method>
				<Name>delete</Name>
				<Source><![CDATA[
    public void delete()
    {
        this.linePricingRule(true).delete();

        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>lastLineNum</Name>
				<Source><![CDATA[
    static TradeLineNumber lastLineNum(UPSRuleId _ruleId)
    {
        return (select maxof(LineNum) from UPSRuleLine
            index hint TransIdx
            where UPSRuleLine.RuleId == _ruleId).LineNum;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        this.ProductCodeType = UPSGroupAll::All;
        this.LineNum = UPSRuleLine::lastLineNum(this.RuleId) + 1;

        super();
    }

]]></Source>
			</Method>
		</Methods>
