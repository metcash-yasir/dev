		<Methods>
			<Method>
				<Name>findByLineNum</Name>
				<Source><![CDATA[
    public static UPSItemBasePriceCalcTransDetail findByLineNum(
        UPSBasePriceType            _priceType,
        UPSVendPriceAccountCode     _accountCode,
        UPSVendPriceRelation        _accountRelation,
        LineNum                     _lineNum,
        UPSBasePriceCalcPriceCalcId _priceCalcId,
        boolean                     _forUpdate = false)
    {
        UPSItemBasePriceCalcTransDetail basePriceCalcTransDetail;

        basePriceCalcTransDetail.selectForUpdate(_forUpdate);

        select firstonly basePriceCalcTransDetail
            where basePriceCalcTransDetail.PriceType        == _priceType &&
                  basePriceCalcTransDetail.AccountCode      == _accountCode &&
                  basePriceCalcTransDetail.AccountRelation  == _accountRelation &&
                  basePriceCalcTransDetail.LineNum          == _lineNum &&
                  basePriceCalcTransDetail.PriceCalcId      == _priceCalcId;

        return basePriceCalcTransDetail;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByFinalPrice</Name>
				<Source><![CDATA[
    public static UPSItemBasePriceCalcTransDetail findByFinalPrice(
        UPSBasePriceType            _priceType,
        UPSBaseAmountNonMonetary    _calculatedPrice,
        UPSBasePriceCalcPriceCalcId _priceCalcId,
        boolean                     _forUpdate = false)
    {
        UPSItemBasePriceCalcTransDetail basePriceCalcTransDetail;

        basePriceCalcTransDetail.selectForUpdate(_forUpdate);

        select firstonly basePriceCalcTransDetail
            where basePriceCalcTransDetail.PriceType        == _priceType &&
                  basePriceCalcTransDetail.CalculatedPrice  == _calculatedPrice &&
                  basePriceCalcTransDetail.PriceCalcId      == _priceCalcId &&
                  basePriceCalcTransDetail.FinalPrice       == NoYes::Yes;

        return basePriceCalcTransDetail;
    }

]]></Source>
			</Method>
		</Methods>
