		<Methods>
			<Method>
				<Name>excludeLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// Exclude selected line from pricing query
    /// </summary>
    /// <param name = "_groupRecId">Reference Id of related group</param>
    /// <param name = "_refTableId">Reference table Id of selected line</param>
    /// <param name = "_refRecId">Reference record Id of selected line</param>
    static public void excludeLine(UPSPricingAttributeGroupRecId _groupRecId, RefTableId _refTableId, RefRecId _refRecId )
    {
        UPSPricingAttributeLineState pricingAttributeLineState;

        ttsbegin;

        if (_groupRecId && _refTableId && _refRecId)
        {
            pricingAttributeLineState = UPSPricingAttributeLineState::find(_groupRecId, _refTableId, _refRecId, true);

            pricingAttributeLineState.PricingAttributeGroup = _groupRecId;
            pricingAttributeLineState.LineTableId           = _refTableId;
            pricingAttributeLineState.LineRecId             = _refRecId;
            pricingAttributeLineState.LineType              = UPSPricingAttributeLineType::Exclude;

            pricingAttributeLineState.write();
        }

        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find <c>UPSPricingAttributeLineState</c> record
    /// </summary>
    /// <param name = "_groupRecId">Reference Id of related group</param>
    /// <param name = "_refTableId">Reference table ID</param>
    /// <param name = "_refRecId">Reference record Id</param>
    /// <param name = "_forUpdate">For update parameter</param>
    /// <returns><c>UPSPricingAttributeLineState</c> record</returns>
    static public UPSPricingAttributeLineState find(UPSPricingAttributeGroupRecId _groupRecId, RefTableId _refTableId, RefRecId _refRecId, boolean _forUpdate = false)
    {
        UPSPricingAttributeLineState pricingAttributeLineState;

        if (_groupRecId && _refTableId && _refRecId)
        {
            pricingAttributeLineState.selectForUpdate(_forUpdate);

            select firstonly pricingAttributeLineState
                where pricingAttributeLineState.PricingAttributeGroup   == _groupRecId
                    && pricingAttributeLineState.LineTableId            == _refTableId
                    && pricingAttributeLineState.LineRecId              == _refRecId;
        }

        return pricingAttributeLineState;
    }

]]></Source>
			</Method>
