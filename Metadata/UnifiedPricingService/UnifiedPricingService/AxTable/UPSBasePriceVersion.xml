		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static UPSBasePriceVersion find(UPSBasePriceVersionId _versionId, boolean _forUpdate = false)
    {
        UPSBasePriceVersion     version;

        if (_forUpdate)
        {
            version.selectForUpdate(true);
        }

        select firstonly version where version.VersionId == _versionId;

        return version;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    public static boolean exist(UPSBasePriceVersionId _versionId)
    {
        return _versionId && (select firstonly UPSBasePriceVersion where UPSBasePriceVersion.VersionId == _versionId).RecId;
    }

]]></Source>
			</Method>
