			<Method>
				<Name>checkEnableOnlyParameters</Name>
				<Source><![CDATA[
    private boolean checkEnableOnlyParameters()
    {
        boolean ret = true;
        UPSParameters originalParameters = this.orig();

        if (originalParameters.EnablePriceAttributePriority && !this.EnablePriceAttributePriority)
        {
            ret = checkFailed("@UnifiedPricingService:UPSPriceAttributePriorityCannotBeDisabledError");
        }

        if (originalParameters.EnablePriceComponentCode && !this.EnablePriceComponentCode)
        {
            ret = checkFailed("@UnifiedPricingService:UPSPriceComponentCodeCannotBeDisabledError");
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();
    
        ret = ret && this.checkEnableOnlyParameters();

        return ret;
    }

]]></Source>
