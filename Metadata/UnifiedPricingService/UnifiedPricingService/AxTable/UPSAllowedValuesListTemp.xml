				<Source><![CDATA[
    /// <summary>
    /// Method is used to populate <c>UPSAllowedValuesListTemp</c> temporary tables with values from Set parameter
    /// </summary>
    /// <param name = "_valuesSet">The value set to display.</param>
    /// <returns>Temp table placeholder.</returns>
    public static UPSAllowedValuesListTemp populate(Set _valuesSet)
    {
        UPSAllowedValuesListTemp table;
        SetEnumerator            se;

        se = _valuesSet.getEnumerator();

        while (se.MoveNext())
        {
            table.clear();
            table.initValue();
            table.Value = se.current();
            table.insert();
        }

        return table;
    }

]]></Source>
