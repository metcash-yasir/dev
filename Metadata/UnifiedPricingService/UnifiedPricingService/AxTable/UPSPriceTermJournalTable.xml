		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static UPSPriceTermJournalTable find(UPSAgreementId     _agreementId,
                                         boolean            _update = false)
    {
        UPSPriceTermJournalTable upsPriceTermJournalTable;

        if (_agreementId)
        {
            if (_update)
            {
                upsPriceTermJournalTable.selectForUpdate(_update);
            }
            
            select firstonly upsPriceTermJournalTable
                index hint JournalId
                where upsPriceTermJournalTable.AgreementId == _agreementId;
            
        }

        return upsPriceTermJournalTable;
    }

]]></Source>
			</Method>
		</Methods>
