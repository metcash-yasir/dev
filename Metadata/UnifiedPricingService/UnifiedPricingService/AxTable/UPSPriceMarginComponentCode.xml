				<Name>find</Name>
				<Source><![CDATA[
    public static UPSPriceMarginComponentCode find(UPSPostingId _postingId, boolean _update = false)
    {
        UPSPriceMarginComponentCode     priceMarginComp;

        if (_update)
        {
            priceMarginComp.selectForUpdate(_update);
        }

        select firstonly priceMarginComp
            where priceMarginComp.PostingId == _postingId;

        return priceMarginComp;
    }

]]></Source>
