    private void foreignKeyPropagation_DS1(DataEntityRuntimeContext _entityCtx, LedgerJournalTrans _ledgerJournalTrans)
    {
        LedgerVoucherType_CN ledgerVoucherType_CN_ = _entityCtx.getRuntimeContextByName('LedgerVoucherType_CN').getBuffer();
        // FK propagation of references to an optional read-only PK data source will be done if
        //   1. conflict detection has been invoked against the PK data source, or
        //   2. the PK data source buffer is not null.
        if(_entityCtx.getRuntimeContextByName('LedgerVoucherType_CN').conflictDetectionInvoked() || ledgerVoucherType_CN_)
        {
            // do not set foreign key values if they are same to make sure validation is not fired unless value changed
            if(_ledgerJournalTrans.LedgerVoucherType_CN != ledgerVoucherType_CN_.RecId)
            {
                _ledgerJournalTrans.LedgerVoucherType_CN = ledgerVoucherType_CN_.RecId;
            }
        }
        
        // foreign key value validation
        boolean validationFailed = false;
        DataEntityDatabaseOperation dataSourceDBOperation = _entityCtx.getRuntimeContextByName('LedgerJournalTrans').getDatabaseOperation();
        BankJournalLineEntity dataEntityRecord = _entityCtx.getEntityRecord();
        
        if(!dataEntityRecord.skipDataSourceValidateField(fieldnum(BankJournalLineEntity, ChineseVoucherTypeRecId)))
        {
            if(!this.validateDataSourceField(dataSourceDBOperation, 'LedgerJournalTrans.LedgerVoucherType_CN', _ledgerJournalTrans, fieldnum(LedgerJournalTrans, LedgerVoucherType_CN), false/*disallowEditOnCreate*/, false/*disallowEdit*/, false/*callValidateField*/, 1))
            {
                validationFailed = true;
            }
        }
        
        if(validationFailed)
        {
