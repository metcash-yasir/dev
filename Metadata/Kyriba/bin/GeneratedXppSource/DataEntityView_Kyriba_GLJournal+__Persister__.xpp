    private LedgerJournalTrans LookForUniqueKeyMatch_DS1(Kyriba_GLJournal _kyriba_GLJournal, LedgerJournalTrans _ledgerJournalTrans)
    {
        LedgerJournalTrans ledgerJournalTrans_ = null;
        
        select
            forUpdate
            firstOnly
                ledgerJournalTrans_
        where
            ledgerJournalTrans_.JournalNum == _ledgerJournalTrans.JournalNum && ledgerJournalTrans_.DataAreaId == _ledgerJournalTrans.DataAreaId && ledgerJournalTrans_.LineNum == _ledgerJournalTrans.LineNum && ledgerJournalTrans_.Partition == _ledgerJournalTrans.Partition
