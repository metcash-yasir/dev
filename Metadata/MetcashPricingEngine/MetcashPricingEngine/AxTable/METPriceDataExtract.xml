		<Methods>
			<Method>
				<Name>initFromTmpPriceList</Name>
				<Source><![CDATA[
    /// <summary>
    /// initialise the record
    /// </summary>
    /// <param name = "_tmpPriceList">Temporary table with values as calcued by report price framework</param>
    public void initFromTmpPriceList(GUPTmpPriceReportValues _tmpPriceList)
    {
        this.CustAccount        = _tmpPriceList.AccountNum;
        this.ItemId             = _tmpPriceList.ItemId;
        this.StartDate          = _tmpPriceList.FromDate;
        this.UnitOfMeasure      = _tmpPriceList.SalesUnit;
        this.Qty                = _tmpPriceList.Quantity;
        this.Quantity           = this.numToString(_tmpPriceList.Quantity);
        this.NetAmount          = this.numToString(_tmpPriceList.LineAmount);
        this.LineAmount         = _tmpPriceList.LineAmount;
        this.BaseInventoryAmount = this.numToString(_tmpPriceList.BasePrice);
        this.MarginComponent    = _tmpPriceList.MarginOffers;
        this.MarginComponentAmount = _tmpPriceList.MarginAmountList;
        this.WholesaleAmount    = this.numToString(_tmpPriceList.UnitPrice);
        this.DiscCode           = _tmpPriceList.DiscountOffers;
        this.DiscAmount         = _tmpPriceList.DiscountAmountList;
        this.CurrencyCode       = _tmpPriceList.CurrencyCode;
    }

]]></Source>
			</Method>
			<Method>
				<Name>enhanceFromPriceDataFeed</Name>
				<Source><![CDATA[
    /// <summary>
    /// Enhance the METPriceDataExtract records with additional values not created by pricing report framework
    /// </summary>
    /// <param name = "_priceDataFeed">Price data feed record</param>
    public void enhanceFromPriceDataFeed(METPriceDataFeed _priceDataFeed)
    {
        METPriceDataFeed        priceDataFeed = _priceDataFeed;
        CustTable               custTable = custTable::find(priceDataFeed.CustAccount);

        //update customer Invent Site
        this.InventSiteId   = priceDataFeed.InventSiteId;
   
        //update currency
        this.CurrencyCode = this.CurrencyCode ? this.CurrencyCode : custTable.Currency;

        //update customer Tax group
        this.TaxGroup = custTable.TaxGroup;

        //update Item Tax group
        this.TaxItemGroup = InventTableModule::find(priceDataFeed.ItemId, ModuleInventPurchSales::Sales).taxItemGroupId;

        //event id
        this.EventId = priceDataFeed.EventId;

        this.DateOfChange = priceDataFeed.DateOfChange;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateTax</Name>
				<Source><![CDATA[
    /// <summary>
    /// Calculate and populate the Tax value and populate string Tax Group field
    /// </summary>
    public void updateTax()
    {
        boolean taxSeparator;

        if(this.TaxGroup && this.TaxItemGroup && this.StartDate && this.CurrencyCode && this.LineAmount)
        {
            this.ItemTaxAmount = this.numToString(Tax::calcTaxAmount(this.TaxGroup,
                                                                    this.TaxItemGroup, 
                                                                    this.StartDate, 
                                                                    this.CurrencyCode, 
                                                                    this.LineAmount, 
                                                                    TaxModuleType::Sales));
        }

        if(this.TaxGroup)
        {
            this.ItemTaxCode = this.TaxGroup;
            taxSeparator = true;
        }

        if(this.TaxItemGroup)
        {
            this.ItemTaxCode += taxSeparator ? strFmt("@MET:Concatenate", "@MET:Pipe", this.TaxItemGroup) : this.TaxItemGroup;
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>numToString</Name>
				<Source><![CDATA[
    /// <summary>
    /// Convert Real to String
    /// </summary>
    /// <param name = "_number">Real</param>
    /// <returns>Real as a String</returns>
    public str  numToString(real _number)
    {
        return num2Str(_number, 4, 2, DecimalSeparator::Dot, ThousandSeparator::Comma);
    }

]]></Source>
			</Method>
			<Method>
				<Name>existForCustItem</Name>
				<Source><![CDATA[
    /// <summary>
    /// does thes record exist
    /// </summary>
    /// <param name = "_custAccount">Customer account</param>
    /// <param name = "_itemId">Item</param>
    /// <param name = "_inventSiteId">Inventory site</param>
    /// <param name = "_unitOfMeasure">Unit of measure</param>
    /// <param name = "_startDate">Date from</param>
    /// <param name = "_qty">Quantity</param>
    /// <param name = "_eventId">Event id</param>
    /// <returns>the result</returns>
    static boolean existForCustItem(MetCustAccount  _custAccount,
                                    ItemId          _itemId,
                                    METInventSiteId _inventSiteId,
                                    METUnitOfMeasure _unitOfMeasure,
                                    StartDate       _startDate,
                                    UnitQty         _qty,
                                    METEventId      _eventId) //can be blank
    {
        return _custAccount && _itemId && _inventSiteId && _unitOfMeasure && _startDate && _qty
        && (select firstOnly RecId
            from METPriceDataExtract
            where METPriceDataExtract.CustAccount   == _custAccount
            &&    METPriceDataExtract.ItemId        == _itemId
            &&    METPriceDataExtract.InventSiteId  == _inventSiteId
            &&    METPriceDataExtract.UnitOfMeasure == _unitOfMeasure
            &&    METPriceDataExtract.StartDate     == _startDate
            &&    METPriceDataExtract.Qty           == _qty
            &&    METPriceDataExtract.EventId       == _eventId
            ).RecId != 0;
    }

]]></Source>
			</Method>
