]]></Declaration>
		<Methods>
			<Method>
				<Name>initFromTmpPriceList</Name>
				<Source><![CDATA[
    /// <summary>
    /// initialise the record
    /// </summary>
    /// <param name = "_tmpPriceList">Temporary table with values as calcued by report price framework</param>
    public void initFromTmpPriceList(GUPTmpPriceReportValues _tmpPriceList)
    {
        this.CustAccount        = _tmpPriceList.AccountNum;
        this.ItemId             = _tmpPriceList.ItemId;
        this.StartDate          = _tmpPriceList.FromDate;
        this.UnitOfMeasure      = _tmpPriceList.SalesUnit;
        this.Qty                = _tmpPriceList.Quantity;
        this.Quantity           = this.numToString(_tmpPriceList.Quantity);
        this.NetAmount          = this.numToString(_tmpPriceList.LineAmount);
        this.LineAmount         = _tmpPriceList.LineAmount;
        this.BaseInventoryAmount = this.numToString(_tmpPriceList.BasePrice);
        this.MarginComponent    = _tmpPriceList.MarginOffers;
        this.MarginComponentAmount = _tmpPriceList.MarginAmountList;
        this.WholesaleAmount    = this.numToString(_tmpPriceList.UnitPrice);
        this.DiscCode           = _tmpPriceList.DiscountOffers;
        this.DiscAmount         = _tmpPriceList.DiscountAmountList;
        this.CurrencyCode       = _tmpPriceList.CurrencyCode;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateTax</Name>
				<Source><![CDATA[
    /// <summary>
    /// Calculate and populate the Tax value and populate string Tax Group field
    /// </summary>
    public void updateTax()
    {
        boolean taxSeparator;

        if(this.TaxGroup && this.TaxItemGroup && this.StartDate && this.CurrencyCode && this.LineAmount)
        {
            this.ItemTaxAmount = this.numToString(Tax::calcTaxAmount(this.TaxGroup,
                                                                    this.TaxItemGroup, 
                                                                    this.StartDate, 
                                                                    this.CurrencyCode, 
                                                                    this.LineAmount, 
                                                                    TaxModuleType::Sales));
        }

        if(this.TaxGroup)
        {
            this.ItemTaxCode = this.TaxGroup;
            taxSeparator = true;
        }

        if(this.TaxItemGroup)
        {
            this.ItemTaxCode += taxSeparator ? strFmt("@MET:Concatenate", "@MET:Pipe", this.TaxItemGroup) : this.TaxItemGroup;
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>getLastEntryNumber</Name>
				<Source><![CDATA[
    /// <summary>
    /// get last Entry number
    /// </summary>
    /// <returns>Last entry number</returns>
    public static METEntryNumber getLastEntryNumber()
    {
        return (select firstonly entryNumber from METPriceDataExtract order by entryNumber desc).EntryNumber;
    }

]]></Source>
			</Method>
			<Method>
				<Name>numToString</Name>
				<Source><![CDATA[
    /// <summary>
    /// Convert Real to String
    /// </summary>
    /// <param name = "_number">Real</param>
    /// <returns>Real as a String</returns>
    public str  numToString(real _number)
    {
        return num2Str(_number, 4, 2, DecimalSeparator::Dot, ThousandSeparator::Comma);
    }

]]></Source>
			</Method>
		</Methods>
