		<Methods>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// does thes record exist
    /// </summary>
    /// <param name = "_refRecId">Reference rec id</param>
    /// <param name = "_refTableId">Reference table id</param>
    /// <returns>the result</returns>
    static boolean exist(RefRecId _refRecId, RefTableId _refTableId)
    {
        return _refRecId && _refTableId
        && (select firstOnly RecId
            from METPriceDataFeed
            where METPriceDataFeed.RefRecId     == _refRecId
            &&    METPriceDataFeed.RefTableId   == _refTableId).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>existForCustItem</Name>
				<Source><![CDATA[
    /// <summary>
    /// does thes record exist
    /// </summary>
    /// <param name = "_custAccount">Customer account</param>
    /// <param name = "_itemId">Item</param>
    /// <param name = "_inventSiteId">Inventory site</param>
    /// <param name = "_unitOfMeasure">Unit of measure</param>
    /// <param name = "_startDate">Date from</param>
    /// <param name = "_quantity">Quantity</param>
    /// <returns>the result</returns>
    static boolean existForCustItem(MetCustAccount _custAccount, ItemId _itemId, METInventSiteId _inventSiteId, METUnitOfMeasure _unitOfMeasure, StartDate _startDate, UnitQty _quantity)
    {
        return _custAccount && _itemId && _inventSiteId && _unitOfMeasure && _startDate && _quantity
        && (select firstOnly RecId
            from METPriceDataFeed
            where METPriceDataFeed.CustAccount  == _custAccount
            &&    METPriceDataFeed.ItemId       == _itemId
            &&    METPriceDataFeed.InventSiteId == _inventSiteId
            &&    METPriceDataFeed.UnitOfMeasure == _unitOfMeasure
            &&    METPriceDataFeed.StartDate    == _startDate
            &&    METPriceDataFeed.Quantity     == _quantity
            ).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
