		<Methods>
			<Method>
				<Name>existForType</Name>
				<Source><![CDATA[
    /// <summary>
    /// does the record exist for a Type
    /// </summary>
    /// <param name = "_discCode">Discount code</param>
    /// <param name = "_fromDate">from date</param>
    /// <param name = "_quantityAmountFrom">qty from</param>
    /// <param name = "_priceChangeType">price change type</param>
    /// <returns>Result</returns>
    public static boolean existForType(METRetailOfferIdDisc _discCode, FromDate _fromDate, METQuantityAmountFrom _quantityAmountFrom, METPriceChangeType _priceChangeType)
    {
        return _discCode && _fromDate && _QuantityAmountFrom
        && (select firstOnly RecId
            from METPriceChangeTracking
            where METPriceChangeTracking.DiscountCode       == _discCode
            &&    METPriceChangeTracking.FromDate           == _fromDate
            &&    METPriceChangeTracking.QuantityAmountFrom == _QuantityAmountFrom
            &&    METPriceChangeTracking.ChangeType         == _priceChangeType).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>deleteChangeTrack</Name>
				<Source><![CDATA[
    /// <summary>
    /// delete records 
    /// </summary>
    /// <param name = "_discountCode">Discount code</param>
    /// <param name = "_fromDate">from date</param>
    /// <param name = "_fromQty">qty from</param>
    /// <param name = "_priceChangeType">price change type</param>
    /// <param name = "_activation">Activation</param>
    public static void deleteChangeTrack(RetailOfferIdEx3 _discountCode, FromDate _fromDate, RetailQtyLowest _fromQty, METPriceChangeType _priceChangeType, METActivation _activation)
    {
        METPriceChangeTracking      priceChangeTracking;
        
        //delete any prior records that still exist
        delete_from priceChangeTracking
            where   priceChangeTracking.DiscountCode    == _discountCode
            &&      priceChangeTracking.FromDate        == _fromDate
            &&      priceChangeTracking.QuantityAmountFrom  == _fromQty
            &&      priceChangeTracking.ChangeType      == _priceChangeType
            &&      priceChangeTracking.Activation      == _activation;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
