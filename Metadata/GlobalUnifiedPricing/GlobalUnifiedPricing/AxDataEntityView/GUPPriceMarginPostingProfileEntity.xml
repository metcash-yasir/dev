				<Source><![CDATA[
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch (_dataSourceCtx.name())
        {
            case dataentitydatasourcestr(GUPPriceMarginPostingProfileEntity, GUPPriceMarginLedger):
                if (_entityCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
                {
                    GUPPriceMarginLedger priceMarginLedger;

                    select firstonly priceMarginLedger where priceMarginLedger.PostingProfile == this.PostingProfile;
                    if (priceMarginLedger.RecId)
                    {
                        ttsbegin;
                        priceMarginLedger.selectForUpdate(true);
                        priceMarginLedger.Description = this.Description;
                        priceMarginLedger.update();
                        ttscommit;

                        _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                    }
                }
                break;
            case dataentitydatasourcestr(GUPPriceMarginPostingProfileEntity, GUPPriceMarginLedgerAccounts):
                if (this.AccountCode == TableGroupAll::All)
                {
                    this.AccountRelation = '';
                }
                if (this.ItemCode == TableGroupAll::All)
                {
                    this.ItemRelation ='';
                }

                // if component account or offset account is not set, UPSPriceMarginLedgerAccounts will be skipped.
                if ( this.ComponentAccountDisplayValue == '' || this.OffsetAccountDisplayValue == '')
                {
                    _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                }
                break;
        }
        

        super(_entityCtx, _dataSourceCtx);
    }

]]></Source>
