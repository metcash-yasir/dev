				<Name>mapEntityToDataSource</Name>
				<Source><![CDATA[
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        if (_entityCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Insert || _entityCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
        {
            switch (_dataSourceCtx.name())
            {
                case dataEntityDataSourceStr(GUPPricingAttributeGroupEntity, GUPPricingAttributeGroup) :
                    if (this.attributeGroupCanBeUpdated())
                    {
                        this.skipDataSourceValidateField(fieldNum(GUPPricingAttributeGroupEntity, SourceLevel), true);
                    }
                    else
                    {
                        throw error("@SYS93289");
                    }
                    break;
                case dataEntityDataSourceStr(GUPPricingAttributeGroupEntity, GUPPricingAttributeLink) :
                    GUPPricingAttributeLink link = _dataSourceCtx.getBuffer();
                    this.setPricingAttributeLink(this.AttributeName, link);
                    break;
            }
        }

        super(_entityCtx, _dataSourceCtx);
    }

]]></Source>
			</Method>
			<Method>
				<Name>setPricingAttributeLink</Name>
				<Source><![CDATA[
    private void setPricingAttributeLink(Name _attributeName, GUPPricingAttributeLink _link)
    {
        List                    attributes = GUPPricingAttributeRepository::getAllPricingAttributes();
        Enumerator              enum       = attributes.getEnumerator();
        GUPIPricingAttribute    pricingAttr;
        GUPPricingAttributeLink linkLocal;
        DictClass               dc;

        while (enum.moveNext())
        {
            GUPPricingAttributeSourceLevel  sourceLevel;
            str                             fieldName;
            str                             tableName;

            pricingAttr = enum.current();
            linkLocal   = GUPPricingAttributeRepository::toPriceAttributeLink(pricingAttr);
            tableName   = pricingAttr.getQueryBuilderDatasourceIdentifier();

            if (this.AttributeName == linkLocal.AttributeName && this.SourceName == tableName)
            {
                sourceLevel = GUPPricingAttributeRepository::getPricingAttributeAttributeAsObject(
                    pricingAttr,
                    attributeStr(GUPPricingAttributeSourceDiscoveryAttribute)).parmSource();

                if (sourceLevel != this.SourceLevel)
                {
                    throw error(strFmt("@GlobalUnifiedPricing:GUPPricingAttributeGroupEntityCheckSourceLevel", this.SourceLevel));
                }
                else if (this.FieldName == fieldName)
                {
                    _link.AttributeName            = linkLocal.AttributeName;
                    _link.PriceAttributeClassId    = linkLocal.PriceAttributeClassId ;
                    _link.AttributeProviderClassId = linkLocal.AttributeProviderClassId;
                    _link.TypeName                 = linkLocal.TypeName;

                    _link.initFromPricingAttribute(pricingAttr);
                    _link.AttributeSourceType      = GUPPricingAttributeSourceType::Table;

                    break;
                }
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>attributeGroupCanBeUpdated</Name>
				<Source><![CDATA[
    private boolean attributeGroupCanBeUpdated()
    {
        GUPPricingAttributeGroup attrGroup = GUPPricingAttributeGroup::findByName(this.Name);
        boolean                  ret       = true;

        if (attrGroup && attrGroup.SourceLevel != this.SourceLevel)
        {
            ret = checkFailed(strFmt("@ApplicationFoundation:DataEntitiesNoAllowEdit", fieldPName(GUPPricingAttributeGroup, SourceLevel)));
        }

        return ret;
    }

]]></Source>
			</Method>
