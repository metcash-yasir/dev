    public boolean validateWrite()
    {
        boolean ret = super();

        ret = ret && this.InventInventoryDimensionEntityFieldsMapping::validateInactiveDimensionsAreNotSpecified(this.ItemNum);

        if (ret && this.PriceVendorGroupCode && this.VendorAccountNumber)
