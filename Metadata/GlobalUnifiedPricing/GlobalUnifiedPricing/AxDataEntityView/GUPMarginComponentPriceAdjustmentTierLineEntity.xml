		<Methods>
			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
    
        ret = super(_fieldIdToCheck);
        switch (_fieldIdToCheck)
        {
            case (fieldNum(GUPMarginComponentPriceAdjustmentTierLineEntity, OfferId)) :
                ret = ret && this.checkRetailDiscountOfferRelation();
                ret = ret && this.checkTierConfigurationStatus();
                ret = ret && this.checkHeaderStatus();
                break;
        }
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>checkRetailDiscountOfferRelation</Name>
				<Source><![CDATA[
    protected boolean checkRetailDiscountOfferRelation()
    {
        boolean ret = true;
        RetailPeriodicDiscount retailDiscount = RetailPeriodicDiscount::findByOfferId(this.OfferId);
        if (!retailDiscount || !(retailDiscount is RetailDiscountOffer))
        {
            ret = checkFailed(strfmt("@GlobalUnifiedPricing:GUPDataEntityInvalidRelationError", tablePName(RetailPeriodicDiscount), this.OfferId));
        }
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>checkTierConfigurationStatus</Name>
				<Source><![CDATA[
    private boolean checkTierConfigurationStatus()
    {
        boolean ret = true;
        RetailPeriodicDiscount discount = RetailPeriodicDiscount::findByOfferId(this.OfferId);
        RetailDiscountOffer offer = discount as RetailDiscountOffer;
        if (offer.IsTierConfigurationEnabled == NoYes::No)
        {
            ret = checkFailed(strfmt("@GlobalUnifiedPricing:GUPMarginComponentPriceAdjustmentTierLineNotEnabledError", offer.OfferId));
        }
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>checkHeaderStatus</Name>
				<Source><![CDATA[
    private boolean checkHeaderStatus()
    {
        boolean ret = true;
        RetailPeriodicDiscount discount = RetailPeriodicDiscount::findByOfferId(this.OfferId);
        if (discount.Status == RetailDisabledEnabled::Enabled)
        {
            ret = checkFailed(strFmt("@RetailDiscount:NotAllowEditEnabledDiscount"));
        }
        return ret;
    }

]]></Source>
			</Method>
		</Methods>
