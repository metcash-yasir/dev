			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        super();
        Common record = element.args().record();
        if (record is GUPPriceTermJournalTrans)
        {
            GUPPriceTermJournalTrans trans = record as GUPPriceTermJournalTrans;
            element.populateData(trans.PricingRule);
        }
        else if (record is GUPPricingRule)
        {
            element.populateData(record.RecId);
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>populateData</Name>
				<Source><![CDATA[
    private void populateData(RecId _recId)
    {
        GUPPricingAttributeValue pricingAttributeValue;        
  
        GUPPricingRuleCondition ruleCond;
        GUPPricingAttributeLink link;
        delete_from pricingAttributeValue;
        while select ruleCond
            where ruleCond.RuleId == _recId
            join Priority from link
            order by Priority desc
            where ruleCond.ConditionAttribute == link.RecId
        {
            pricingAttributeValue.AttributeName = ruleCond.pricingAttribute().getName();
            pricingAttributeValue.AttributeValue = ruleCond.ConditionValue;
            pricingAttributeValue.Priority = link.Priority;
            pricingAttributeValue.insert();
        }
    }

]]></Source>
