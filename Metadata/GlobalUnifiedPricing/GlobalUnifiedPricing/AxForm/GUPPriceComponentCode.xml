    private Common lookupAttributeGroup(FormControl _control, GUPPricingAttributeSourceLevel _level)
    {
        Query query = new Query();
        QueryBuildDataSource qbdsGroup = query.addDataSource(tableNum(GUPPricingAttributeGroup));
        qbdsGroup.addRange(fieldNum(GUPPricingAttributeGroup, SourceLevel))
                 .value(any2Str(_level));
        qbdsGroup.addRange(fieldNum(GUPPricingAttributeGroup, IsValid))
                 .value(any2Str(NoYes::Yes));
        qbdsGroup.addRange(fieldNum(GUPPricingAttributeGroup, GroupType))
                 .value(enum2Symbol(enumNum(GUPPricingAttributeGroupType), GUPPricingAttributeGroupType::General));

        SysReferenceTableLookup referenceLookup = SysReferenceTableLookup::newParameters(tableNum(GUPPricingAttributeGroup), _control, true);

        referenceLookup.addLookupfield(fieldNum(GUPPricingAttributeGroup, Name));
        referenceLookup.addLookupfield(fieldNum(GUPPricingAttributeGroup, Description));

        referenceLookup.parmQuery(query);
        return referenceLookup.performFormLookup();
    }

]]></Source>
