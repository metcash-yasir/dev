    GUPInventDimCtrl_Frm_BasePriceCalc inventDimFormSetup;

}
]]></Source>
			</Method>
			<Method>
				<Name>basePriceCalcWhereUsedUpdate</Name>
				<Source><![CDATA[
    edit GUPBasePriceCalcWhereUsedUpdate basePriceCalcWhereUsedUpdate(
        boolean                 _set,
        GUPBasePriceCalcWhereUsedUpdate  _basePriceCalcWhereUsedUpdate)
    {
        calcJobObsVar.observe();

        if (_set)
        {
            calcJob.parmBasePriceCalcWhereUsedUpdate(_basePriceCalcWhereUsedUpdate);
        }

        return calcJob.parmBasePriceCalcWhereUsedUpdate();

    }

]]></Source>
			</Method>
			<Method>
				<Name>calcDate</Name>
				<Source><![CDATA[
    edit TransDate calcDate(
        boolean      set,
        TransDate    _calcDate
        )
    {
        calcJobObsVar.observe();

        if (set)
        {
            return calcJob.parmCalcDate(_calcDate);
        }

        return calcJob.parmCalcDate();
    }

]]></Source>
			</Method>
			<Method>
				<Name>versionId</Name>
				<Source><![CDATA[
    edit GUPBasePriceVersionId versionId(
