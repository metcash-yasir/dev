        return calcJob.parmItemId();
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        if (!element.args().caller() || !element.args().caller().runbase())
        {
            throw error("@SYS22996");
        }

        calcJob = element.args().caller().runbase();
        calcJobObsVar = new FormObservableLink();

        super();

        itemMode = calcJob.showItem();
        if (!itemMode)
        {
            Debug::assert(classIdGet(calcJob) == classNum(GUPItemBasePriceCalcJob_All));
            calcJobAll = calcJob as GUPItemBasePriceCalcJob_All;
        }

        switch (classIdGet(calcJob))
        {
            case classNum(GUPItemBasePriceCalcJob_All) :
                this.design().caption("@SYS126880");
                break;
            default :
                this.design().caption("@SYS5681");
        }

        transferToItem.visible(true);
        ItemIdShow.visible(itemMode);
        itemIdGrp.visible(true);    // To get rid of BP check

        if (itemIdShow.visible())
        {
            inventorydimensionsShow.visible(false);
        }
        else
        {
            itemIdGrp.visible(false);
        }

        if (calcJob.parmBasePriceVersionId())
        {
            versionId.enabled(false);
        }

        this.initTransferControls();

        this.updateDesign(InventDimFormDesignUpdate::Init);

        inventDim_ds.executeQuery();
    }

]]></Source>
			</Method>
			<Method>
				<Name>initTransferControls</Name>
				<Source><![CDATA[
    void initTransferControls()
    {
        purchasePriceTransfer.optionValue(calcJob.parmPurchPriceTransfer());

        salesPriceTransfer.optionValue(calcJob.parmSalesPriceTransfer());

        inventCostPriceTransfer.optionValue(calcJob.parmCostPriceTransfer());
    }

]]></Source>
			</Method>
			<Method>
				<Name>inventDimSetupObject</Name>
				<Source><![CDATA[
    Object inventDimSetupObject()
    {
        return inventDimFormSetup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateDesign</Name>
				<Source><![CDATA[
    void updateDesign(InventDimFormDesignUpdate mode)
    {
        InventDimParm   inventDimParm;

        switch (mode)
        {
            case InventDimFormDesignUpdate::Init:
                if (! inventDimFormSetup)
                {
                    inventDimFormSetup  = GUPInventDimCtrl_Frm_BasePriceCalc::newFromForm(element);
                }
                inventDimFormSetup.parmSkipOnHandLookUp(true);


                inventDimParm.initSiteDimAllGrp();

                inventDimFormSetup.parmDimParmVisible(inventDimParm);
                inventDimFormSetup.parmDimParmEnabled(inventDimParm);
                inventDimFormSetup.formSetControls(true);
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    void run()
    {
        super();

        if (calcJob.parmBasePriceVersionId())
        {
            element.modifiedVersionId();
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedVersionId</Name>
				<Source><![CDATA[
    boolean modifiedVersionId()
    {
        GUPBasePriceVersion    basePriceVersion = GUPBasePriceVersion::find(calcJob.parmBasePriceVersionId());

        if (basePriceVersion)
        {
            calcJob.parmCalcDate(basePriceVersion.DefaultDate ? basePriceVersion.DefaultDate : DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone()));
            if (basePriceVersion.InventSiteId)
            {
                calcJob.parmSiteId(basePriceVersion.InventSiteId);
                inventDim.InventSiteId = basePriceVersion.InventSiteId;
            }

            calcJob.parmPurchPriceTransfer(basePriceVersion.AllowPurch);
            calcJob.parmSalesPriceTransfer(basePriceVersion.AllowSales);
            calcJob.parmCostPriceTransfer(basePriceVersion.AllowInventoryCost);

            element.initTransferControls();

            element.enablePriceVersionRecordingFields(basePriceVersion);
        }

        return basePriceVersion ? true : false;
    }

]]></Source>
			</Method>
			<Method>
				<Name>enablePriceVersionRecordingFields</Name>
				<Source><![CDATA[
    void enablePriceVersionRecordingFields(GUPBasePriceVersion _basePriceVersion)
    {
        calcDate.enabled(_basePriceVersion.DefaultDate ? false : true);
        inventDim_ds.object(fieldnum(InventDim, InventSiteId)).allowEdit(_basePriceVersion.InventSiteId ? false : true);

        purchasePriceTransfer.enabled(false);
        salesPriceTransfer.enabled(false);
        inventCostPriceTransfer.enabled(false);
    }

]]></Source>
			</Method>
			<Method>
				<Name>runBase</Name>
				<Source><![CDATA[
    RunBase runBase()
    {
        return calcJob;
    }

]]></Source>
