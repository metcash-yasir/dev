			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
[Form]
public class GUPBasePriceCalcResult
{
    private QueryBuildRange             priceCalcIdRange;
    private QueryBuildRange             versionIdRange;
    private QueryBuildRange             itemIdRange;
    private QueryBuildRange             priceTypeRange;
    private QueryBuildRange             fromDateRange;
    private QueryBuildRange             toDateRange;

    private GUPItemBasePriceMap         itemBasePriceMap;

    private InventDimCtrl_Frm           inventDimFormSetup;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        if (!element.args() ||
            (element.args().dataset() != tableNum(GUPItemBasePrice) &&
             element.args().dataset() != tableNum(GUPItemBasePriceSim)))
        {
            throw error(Error::missingFormActiveBuffer(element.name()));
        }

        super();

        switch (element.args().dataset())
        {
            case tableNum(GUPItemBasePriceSim),
                tableNum(GUPItemBasePrice):
                itemBasePriceMap = element.args().record();

                itemIdRange.value(itemBasePriceMap.ItemId ? itemBasePriceMap.ItemId : SysQuery::valueEmptyString());
                versionIdRange.value(itemBasePriceMap.VersionId ? itemBasePriceMap.VersionId : SysQuery::valueEmptyString());
                priceCalcIdRange.value(itemBasePriceMap.PriceCalcId ? itemBasePriceMap.PriceCalcId : SysQuery::valueEmptyString());
                priceTypeRange.value(strFmt('(PriceType == %1)', any2int(itemBasePriceMap.PriceType)));
                fromDateRange.value(itemBasePriceMap.ToDate ? SysQuery::range(itemBasePriceMap.FromDate, itemBasePriceMap.ToDate) 
                    : SysQuery::value(itemBasePriceMap.FromDate));
                toDateRange.value(itemBasePriceMap.ToDate ? SysQuery::range(itemBasePriceMap.FromDate, itemBasePriceMap.ToDate) 
                    : SysQuery::valueEmptyString());
                
                break;

            default:
                throw error(Error::wrongUseOfFunction(funcName()));
        }

        element.updateDesign(InventDimFormDesignUpdate::Init);
    }

]]></Source>
			</Method>
			<Method>
				<Name>inventDimSetupObject</Name>
				<Source><![CDATA[
    public Object inventDimSetupObject()
    {
        return inventDimFormSetup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateDesign</Name>
				<Source><![CDATA[
    public void updateDesign(InventDimFormDesignUpdate _mode)
    {
        InventDimParm   inventDimParmShow;
        InventDimParm   inventDimParmEnabled;

        switch (_mode)
        {
            case InventDimFormDesignUpdate::Init:
                if (!inventDimFormSetup)
                {
                    inventDimFormSetup = InventDimCtrl::newFromForm(element);
                }

                inventDimFormSetup.parmSkipOnHandLookUp(true);
                inventDimParmShow                       = inventDimFormSetup.parmDimParmVisibleGrid();
                inventDimParmShow.ConfigIdFlag          = true;
                inventDimParmShow.InventLocationIdFlag  = true;
            //fallthrough
            case InventDimFormDesignUpdate::Active,
                InventDimFormDesignUpdate::FieldChange :
                InventDimGroupSetup::newInventTable(GUPItemBasePriceCalcTable.inventTable()).inventDimParmActive(inventDimParmEnabled);
                inventDimFormSetup.parmDimParmEnabled(inventDimParmEnabled);
                inventDimFormSetup.formSetControls(true);
                break;

            default :
                throw error(strFmt("@SYS54195",funcName()));
        }
    }

]]></Source>
			</Method>
