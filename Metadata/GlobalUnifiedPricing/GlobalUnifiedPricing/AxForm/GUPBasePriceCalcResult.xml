						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            itemIdRange     = SysQuery::findOrCreateRange(this.query().dataSourceTable(tableNum(GUPItemBasePriceCalcTable)), fieldNum(GUPItemBasePriceCalcTable, ItemId));
            versionIdRange  = SysQuery::findOrCreateRange(this.query().dataSourceTable(tableNum(GUPItemBasePriceCalcTable)), fieldNum(GUPItemBasePriceCalcTable, VersionId));
            priceCalcIdRange =SysQuery::findOrCreateRange(this.query().dataSourceTable(tableNum(GUPItemBasePriceCalcTable)), fieldNum(GUPItemBasePriceCalcTable, PriceCalcId));
        }

]]></Source>
					</Method>
					<Method>
						<Name>calculatedBasePrice</Name>
						<Source><![CDATA[
        display GUPVendPriceAmount calculatedBasePrice()
        {
            GUPItemBasePriceCalcTrans itemBaseFianlPrice;

            select firstonly BasePrice from itemBaseFianlPrice
                where itemBaseFianlPrice.PriceCalcId == GUPItemBasePriceCalcTable.PriceCalcId &&
                      itemBaseFianlPrice.PriceType   == itemBasePriceMap.PriceType &&
                      itemBaseFianlPrice.FromDate    >= itemBasePriceMap.FromDate &&
                      itemBaseFianlPrice.ToDate      <= itemBasePriceMap.ToDate;

            return itemBaseFianlPrice.BasePrice;

        }

]]></Source>
					</Method>
					<Method>
						<Name>calculatedFinalPrice</Name>
						<Source><![CDATA[
        display GUPVendPriceAmount calculatedFinalPrice()
        {
            GUPItemBasePriceCalcTrans itemBaseFianlPrice;

            select firstonly CalculatedPrice from itemBaseFianlPrice
                where itemBaseFianlPrice.PriceCalcId == GUPItemBasePriceCalcTable.PriceCalcId &&
                      itemBaseFianlPrice.PriceType   == itemBasePriceMap.PriceType &&
                      itemBaseFianlPrice.FinalPrice  == NoYes::Yes &&
                      itemBaseFianlPrice.FromDate    >= itemBasePriceMap.FromDate &&
                      itemBaseFianlPrice.ToDate      <= itemBasePriceMap.ToDate;

            return itemBaseFianlPrice.CalculatedPrice;

        }

]]></Source>
