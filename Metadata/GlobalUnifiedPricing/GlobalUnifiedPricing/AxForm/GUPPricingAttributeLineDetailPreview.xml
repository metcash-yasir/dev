public class GUPPricingAttributeLineDetailPreview extends FormRun
{
    private GUPPricingRule pricingRule;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        RecId pricingRuleRecId;

        super();
        Common record = element.args().record();
        if (record is GUPPriceTermJournalTrans)
        {
            GUPPriceTermJournalTrans trans = record as GUPPriceTermJournalTrans;
            pricingRuleRecId = trans.PricingRule;
        }
        else if (record is PriceDiscAdmTrans)
        {
            PriceDiscAdmTrans trans = record as PriceDiscAdmTrans;
            pricingRuleRecId = trans.PricingRuleLine;
        }
        else if (record is GUPPricingRule)
        {
            pricingRuleRecId = record.RecId;
        }

        pricingRule = GUPPricingRule::find(pricingRuleRecId);

        if (pricingRule.RecId)
        {
            GUPPricingAttributeValueTmp.setTmpData(GUPPricingAttributeValueTmp::buildPricingAttributeValueTmp(pricingRule.RecId));
        }
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>GUPPricingAttributeGroup</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            if (pricingRule.RecId)
            {
                this.query().dataSourceTable(tableNum(GUPPricingAttributeGroup)).addRange(
                    fieldNum(GUPPricingAttributeGroup, Name)).value(SysQuery::value(pricingRule.PriceAttributeGroupName));
            }

            super();
        }

]]></Source>
