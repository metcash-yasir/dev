					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        /// A discount record within PriceComponentGroup A cannot exclude A (itself).
        /// </summary>
        /// <returns>As super method.</returns>
        public int active()
        {
            int ret;
        
            ret = super();
                
            boolean allowEdit = GUPDiscountPriceComponentGroupExclusionList.PriceComponentCodeGroup != priceComponentCode.PriceComponentCodeGroup;
            GUPDiscountPriceComponentGroupExclusionList_ds.object(fieldNum(GUPDiscountPriceComponentGroupExclusionList, IsExcluded)).allowEdit(allowEdit);

            return ret;
        }

]]></Source>
