public class GUPDiscountPriceComponentGroupExclusionList extends FormRun
{
    RetailPeriodicDiscount retailPeriodicDiscount;
    GUPPriceComponentCode priceComponentCode;


}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        xArgs args = element.args();
        if (!args.caller() || !args.dataset() || !(args.record() is RetailPeriodicDiscount))
        {
            throw error(strFmt("@SYS22678",element.name()));
        }

        retailPeriodicDiscount = element.args().record() as RetailPeriodicDiscount;

        select priceComponentCode where priceComponentCode.Name == retailPeriodicDiscount.PriceComponentCodeName;

        this.initializeExclusionRecords();
        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>initializeExclusionRecords</Name>
				<Source><![CDATA[
    /// <summary>
    /// Create and insert all PriceComponentGroups, for current discount record.
    /// </summary>
    private void initializeExclusionRecords()
    {
        GUPDiscountPriceComponentGroupExclusionList exclusionList;
        GUPPriceComponentCodeGroup priceComponentCodeGroup;

        // Find all current existing items.
        Set existingExclusionItemSet = new Set(Types::String);
        while select exclusionList
            where exclusionList.OfferId == retailPeriodicDiscount.OfferId
        {
            existingExclusionItemSet.add(exclusionList.PriceComponentCodeGroup);
        }

        // Insert missing items, and default to 'not excluded'. Do not show group of the current discount.
            while select priceComponentCodeGroup
            where priceComponentCodeGroup.PriceComponent == GUPPriceComponent::RetailDiscounts 
                && priceComponentCodeGroup.PriceComponentCodeGroup != priceComponentCode.PriceComponentCodeGroup
        {
            if (!existingExclusionItemSet.in(priceComponentCodeGroup.PriceComponentCodeGroup))
            {
                exclusionList.PriceComponentCodeGroup = priceComponentCodeGroup.PriceComponentCodeGroup;
                exclusionList.OfferId = retailPeriodicDiscount.OfferId;
                exclusionList.IsExcluded = NoYes::No;
                exclusionList.insert();
            }
        }

    }

]]></Source>
			</Method>
