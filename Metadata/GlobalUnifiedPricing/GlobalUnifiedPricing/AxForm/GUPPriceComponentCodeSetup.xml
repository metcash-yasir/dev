		<DataSources xmlns="">
			<DataSource>
				<Name>GUPPriceComponentCodeSetup</Name>
				<Methods>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret;
        
            ret = super();

            if (GUPPriceComponentCodeSetup.PostInLedger == NoYes::Yes)
            {
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, LedgerDimension)).mandatory(true);
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, LedgerDimension)).allowEdit(true);
            }
            else
            {
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, LedgerDimension)).mandatory(false);
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, LedgerDimension)).allowEdit(false);
            }


            if (GUPPriceComponentCodeSetup.Flexible == NoYes::Yes)
            {
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, CalculationSequence)).mandatory(false);
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, CalculationSequence)).allowEdit(false);

                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, CompoundcalculationBasis)).allowEdit(false);
            }
            else
            {
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, CalculationSequence)).mandatory(true);
                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, CalculationSequence)).allowEdit(true);

                GUPPriceComponentCodeSetup.dataSource().object(fieldNum(GUPPriceComponentCodeSetup, CompoundcalculationBasis)).allowEdit(true);
            }
        
            return ret;
        }

]]></Source>
					</Method>
				</Methods>
				<Fields>
					<Field>
						<DataField>CalculationSequence</DataField>
						<Methods>
							<Method>
								<Name>modified</Name>
								<Source><![CDATA[
            public void modified()
            {
                super();

                RetailPeriodicDiscount retailPeriodicDiscount;

                while select forupdate PricingPriorityNumber from retailPeriodicDiscount
                    where retailPeriodicDiscount.PriceComponentCodeName == GUPPriceComponentCodeSetup.PriceComponentCodeName
                {
                    RetailPricingPriorityNumber priorityNumber;
                    RetailPricingPriorityTable  retailPricingPriorityTable;

                    priorityNumber = GUPPriceComponentCodeSetup.CalculationSequence > 0 ? CalculationSequenceBasis - GUPPriceComponentCodeSetup.CalculationSequence : 0;

                    select firstonly retailPricingPriorityTable where retailPricingPriorityTable.PriorityNumber == priorityNumber;
                    if (!retailPricingPriorityTable)
                    {
                        retailPricingPriorityTable.PriorityNumber = priorityNumber;
                        retailPricingPriorityTable.insert();
                    }

                    if (retailPeriodicDiscount.PricingPriorityNumber != priorityNumber)
                    {
                        retailPeriodicDiscount.PricingPriorityNumber = priorityNumber;
                        retailPeriodicDiscount.doUpdate();
                    }
                }
            }

]]></Source>
							</Method>
						</Methods>
					</Field>
				</Fields>
