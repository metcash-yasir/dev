			<Method>
				<Name>findByNameAndCode</Name>
				<Source><![CDATA[
    public static GUPRebateAgreementTypePricingComponent findByNameAndCode(GUPRebateAgreementTypeName _typeName, GUPPriceComponentCodeName _codeName, boolean _selectForUpdate = false)
    {
        GUPRebateAgreementTypePricingComponent rebateAgreementTypeCode;

        select firstonly rebateAgreementTypeCode 
            where rebateAgreementTypeCode.TypeName == _typeName
               && rebateAgreementTypeCode.ComponentCodeName == _codeName;
        rebateAgreementTypeCode.selectForUpdate(_selectForUpdate);

        return rebateAgreementTypeCode;
    }

]]></Source>
