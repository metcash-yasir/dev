		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        if (FeatureStateProvider::isFeatureEnabled(GUPGlobalEnableFeature::instance()))
        {
            if (this.IsEnabledAsPricingAttribute == NoYes::No && this.orig().IsEnabledAsPricingAttribute == NoYes::Yes)
            {
                EcoResAttribute ecoResAttribute = EcoResAttribute::find(this.Attribute);

                GUPPricingAttributeLink  pricingAttributeLink;
                select firstonly RecId from pricingAttributeLink
                    where pricingAttributeLink.AttributeName == ecoResAttribute.Name;

                if (pricingAttributeLink.RecId)
                {
                    ret = checkFailed("@GlobalUnifiedPricing:GUPErrorDeleteAttrValueOnPricingGroup");
                }
            }
        }

        return ret;
    }

]]></Source>
