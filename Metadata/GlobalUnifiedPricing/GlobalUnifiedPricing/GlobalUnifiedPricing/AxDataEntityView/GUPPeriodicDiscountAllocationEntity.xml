		<Methods>
			<Method>
				<Name>insertEntityDataSource</Name>
				<Source><![CDATA[
    public boolean insertEntityDataSource(DataEntityRuntimeContext entityCtx, DataEntityDataSourceRuntimeContext dataSourceCtx)
    {
        boolean ret = true;
        if (dataSourceCtx.name() == tablestr(GUPPeriodicDiscountAllocation))
        {
            GUPPeriodicDiscountAllocation allocation = dataSourceCtx.getBuffer();
            RetailPeriodicDiscount discount = RetailPeriodicDiscount::findByOfferId(allocation.OfferId);
            if (!discount)
            {
                throw error(strfmt("@GlobalUnifiedPricing:GUPDataEntityInvalidRelationError", tablePName(RetailPeriodicDiscount), allocation.OfferId));
            }
            if (discount.Status == RetailDisabledEnabled::Enabled)
            {
                throw error(strFmt("@RetailDiscount:NotAllowEditEnabledDiscount"));
            }
            allocation.PostingSetupLevel = GUPDiscountPostingSetupLevel::Line;
        }

        ret = ret && super(entityCtx, dataSourceCtx);

        return ret;
    }

]]></Source>
