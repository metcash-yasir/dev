						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            boolean isEnabled = (GUPPricingTree.Status == GUPDisabledEnabled::Enabled);

            if (!isEnabled && !GUPPricingTree.validatePriceTree())
            {
                return;
            }

            str labelValue = isEnabled ? "@GlobalUnifiedPricing:GUPPriceTree_infolog_disable" : "@GlobalUnifiedPricing:GUPPriceTree_infolog_enable";

            ttsbegin;
            GUPPricingTree.Status = isEnabled ? GUPDisabledEnabled::Disabled : GUPDisabledEnabled::Enabled;
            GUPPricingTree.update();
            ttscommit;

            GUPPricingTree_ds.reread();
            element.doActiveButtons();

            info(strFmt(labelValue, GUPPricingTree.Name));
        }

]]></Source>
