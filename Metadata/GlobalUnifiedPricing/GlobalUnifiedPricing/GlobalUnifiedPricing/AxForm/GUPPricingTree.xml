			<Method>
				<Name>initSortOrder</Name>
				<Source><![CDATA[
    private void initSortOrder()
    {
        Query query = GUPPriceComponentCodeSetup_ds.query();

        query.dataSourceTable(tableNum(GUPPriceComponentCodeSetup)).addOrderByField(fieldNum(GUPPriceComponentCodeSetup, PriceComponent));
        query.dataSourceTable(tableNum(GUPPriceComponentCodeSetup)).addOrderByField(fieldNum(GUPPriceComponentCodeSetup, CalculationSequence));
    }

]]></Source>
