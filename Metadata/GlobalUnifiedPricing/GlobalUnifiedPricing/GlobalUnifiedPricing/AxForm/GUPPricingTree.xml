							<Method>
								<Name>lookup</Name>
								<Source><![CDATA[
            public void lookup(FormControl _formControl, str _filterStr)
            {
                Query                   query = new Query();
                QueryBuildDataSource    qbds = query.addDataSource(tableNum(GUPPriceComponentCode));

                SysTableLookup SysTableLookup = SysTableLookup::newParameters(tableNum(GUPPriceComponentCode), _formControl);
                SysTableLookup.addLookupfield(fieldNum(GUPPriceComponentCode, Name));
                SysTableLookup.addLookupfield(fieldNum(GUPPriceComponentCode, Description));

                qbds.addRange(fieldNum(GUPPriceComponentCode, PriceComponent)).value(SysQuery::valueNot(GUPPriceComponent::AutoCharges));

                SysTableLookup.parmQuery(query);
                SysTableLookup.performFormLookup();
            }

]]></Source>
