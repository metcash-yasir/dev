			<Method>
				<Name>changeLayoutByPriceComponentCode</Name>
				<Source><![CDATA[
    private void changeLayoutByPriceComponentCode()
    {
        GUPPriceComponentCodeSetup.PriceComponent = GUPPriceComponentCodeSetup.PriComponent();
        GUPPriceComponentCodeSetup_CompoundcalculationBasis.allowEdit(GUPPriceComponentCodeSetup.PriceComponent == GUPPriceComponent::PriceMarginComponentAdjustment);

        if (GUPPriceComponentCodeSetup.PriceComponent == GUPPriceComponent::PriceMarginComponentAdjustment)
        {
            GUPPriceComponentCodeSetup.ConcurrencyModeAcrossPriority = GUPDiscountConcurrencyModeAcrossPriority::Compound;
        }

        GUPPriceComponentCodeSetup_ConcurrencyModeAcrossPriority.allowEdit(GUPPriceComponentCodeSetup.PriceComponent == GUPPriceComponent::RetailDiscounts);

        GUPPriceComponentCodeSetup_PostInLedger.allowEdit(
            GUPPriceComponentCodeSetup.PriceComponent != GUPPriceComponent::RebateManagement &&
            GUPPriceComponentCodeSetup.PriceComponent != GUPPriceComponent::AutoCharges);
    }

]]></Source>
			</Method>
			<Method>
				<Name>refresh</Name>
				<Source><![CDATA[
    private void refresh()
    {
        if (PriceComponentCodeSetup != null)
        {
            var groupings = ColumnGroupingContexts::construct();
            groupings.addGrouping(ColumnGroupingContext::construct(formControlStr(GUPPriceComponentCodeSetup, GUPPriceComponentCodeSetup_PriceComponent)));
            PriceComponentCodeSetup.columnGrouping(groupings.serialize());
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>doActiveButtons</Name>
				<Source><![CDATA[
    private void doActiveButtons()
    {
        boolean enabled = (GUPPricingTree.Status == GUPDisabledEnabled::Disabled);
        str textValue = enabled ? "@SYS70338" : "@SYS70337";

        GUPPricingTree_ds.allowEdit(enabled);
        GUPPricingTree_ds.allowDelete(enabled);

        GUPPriceComponentCodeSetup_ds.allowEdit(enabled);
        GUPPriceComponentCodeSetup_ds.allowCreate(enabled);
        GUPPriceComponentCodeSetup_ds.allowDelete(enabled);

        EnableDisable.text(textValue);
    }

]]></Source>
			</Method>
			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    public void run()
    {
        super();

        this.refresh();
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        if (!GUPParameters::find().EnablePriceTree)
        {
            error("@GlobalUnifiedPricing:GUPPriceTree_ToggleIsNotEnabled");
            return;
        }

        super();
    }

]]></Source>
