			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
[Form]
public class GUPPriceDetailPreview extends FormRun
{
    MCRPriceHistoryForm     mcrPriceHistoryForm;
    AmountCur               totalPriceAdjustmentAmount;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        super();

        if (element.args()
            && element.args().dataset() == tableNum(SalesLine))
        {
            this.setControls(element.args().record());
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>setControls</Name>
				<Source><![CDATA[
    protected void setControls(Common _common)
    {
        mcrPriceHistoryForm = MCRPriceHistoryForm::construct(_common);

        this.calculateTotalAdjustmentAmount();

        //base price
        this.setBasePriceControls();

        //price adjustment
        this.setPriceAdjustmentControls();
              
        //discount
        this.setDiscountControls();

        //total
        this.setSubtotalControls();
    }

]]></Source>
			</Method>
			<Method>
				<Name>calculateTotalAdjustmentAmount</Name>
				<Source><![CDATA[
    private void calculateTotalAdjustmentAmount()
    {
        GUPMarginComponentAdjustmentHistory adjustmentHistory;
        select sum(Amount) from adjustmentHistory
            where adjustmentHistory.InventTransId == mcrPriceHistoryForm.getInventTransId();

        totalPriceAdjustmentAmount =  adjustmentHistory.Amount * mcrPriceHistoryForm.getQty();
    }

]]></Source>
			</Method>
			<Method>
				<Name>setBasePriceControls</Name>
				<Source><![CDATA[
    protected void setBasePriceControls()
    {
        BasePrice.realValue(mcrPriceHistoryForm.getUnitPriceExtendedAmount() - totalPriceAdjustmentAmount);
    }

]]></Source>
			</Method>
			<Method>
				<Name>setPriceAdjustmentControls</Name>
				<Source><![CDATA[
    protected void setPriceAdjustmentControls()
    {
        RetailSalesPriceAdjustmentLineView priceAdjustmentView;
        select count(RecId) from priceAdjustmentView
            where priceAdjustmentView.InventTransId == mcrPriceHistoryForm.getInventTransId();

        PriceAdjustmentLabel.text(strFmt('@GlobalUnifiedPricing:GUPPriceDetailPreviewLabelFormat', '@RET3844', int2Str(priceAdjustmentView.RecId)));
        PriceAdjustment.realValue(totalPriceAdjustmentAmount);
    }

]]></Source>
			</Method>
			<Method>
				<Name>setDiscountControls</Name>
				<Source><![CDATA[
    protected void setDiscountControls()
    {
        RetailSalesQuotationDiscountLineView discountLineView;
        select count(RecId) from discountLineView
            where discountLineView.InventTransId == mcrPriceHistoryForm.getInventTransId();

        //Add count of manual discounts
        discountLineView.RecId += mcrPriceHistoryForm.getMultilineDiscAmount()? 1:0;

        DiscAmountLabel.text(strFmt('@GlobalUnifiedPricing:GUPPriceDetailPreviewLabelFormat', '@SYS11829', int2Str(discountLineView.RecId)));
        DiscAmount.realValue((mcrPriceHistoryForm.getUnitPriceExtendedAmount() - mcrPriceHistoryForm.getDiscAmountExtendedAmount()) * -1);
    }

]]></Source>
			</Method>
			<Method>
				<Name>setSubtotalControls</Name>
				<Source><![CDATA[
    protected void setSubtotalControls()
    {
        SubTotalLabel.text(strFmt('@GlobalUnifiedPricing:GUPPriceDetailPreviewLabelFormat', '@SYS4004209', mcrPriceHistoryForm.getCurrencyCode()));
        SubTotal.realValue(mcrPriceHistoryForm.getMarkupExtendedAmount());
    }

]]></Source>
			</Method>
