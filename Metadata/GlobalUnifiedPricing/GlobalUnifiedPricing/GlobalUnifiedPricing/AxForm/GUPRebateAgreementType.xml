						<Name>lookup</Name>
						<Source><![CDATA[
        public void lookup()
        {
            SysTableLookup sysTableLookup = SysTableLookup::newParameters(tablenum(GUPPriceComponentCode), this);

            Query query = new Query();
            QueryBuildRange queryBuildRange;
            QueryBuildDataSource qbds = query.addDataSource(tablenum(GUPPriceComponentCode));
            sysTableLookup.addLookupfield(fieldNum(GUPPriceComponentCode, Name), true);
            sysTableLookup.addLookupfield(fieldNum(GUPPriceComponentCode, Description));
            queryBuildRange = qbds.addRange(fieldNum(GUPPriceComponentCode, PriceComponent));
            queryBuildRange.value(queryValue(GUPPriceComponent::RebateManagement));
            sysTableLookup.parmQuery(query);
            sysTableLookup.performFormLookup();
        }

]]></Source>
