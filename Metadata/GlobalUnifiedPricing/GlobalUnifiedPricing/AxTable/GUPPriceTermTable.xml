		<Methods>
			<Method>
				<Name>findPriceTermCode</Name>
				<Source><![CDATA[
    public static GUPPriceTermTable findPriceTermCode(GUPPriceTermCode _code, boolean _selectForUpdate = false)
    {
        GUPPriceTermTable priceTerm;

        select firstonly priceTerm where priceTerm.Code == _code;
        priceTerm.selectForUpdate(_selectForUpdate);

        return priceTerm;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(GUPPriceTermTable, AccountCode):
                this.AccountRelation = '';
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        GUPPriceTermTable otherCode;
        select firstonly otherCode index hint CalculationSequenceIdx
            where otherCode.CalculationBasis == this.CalculationBasis
                && otherCode.CalculationSequence == this.CalculationSequence
                && otherCode.Code != this.Code;

        if (otherCode.RecId)
        {
            ret = ret && checkFailed(
                strFmt("@GlobalUnifiedPricing:GUPPriceTermTable_Check_DuplicateCalculationSeq",
                this.Code,
                otherCode.Code));
        }
    
        return ret;
    }

]]></Source>
			</Method>
