		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static GUPFreeItemDiscount find(GUPFreeItemDiscountId _offerId, boolean _forUpdate = false)
    {
        GUPFreeItemDiscount discountFreeItem;

        if (_offerId)
        {
            discountFreeItem.selectForUpdate(_forUpdate);

            select firstonly discountFreeItem where discountFreeItem.OfferId == _offerId;
        }

        return discountFreeItem;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        if (_fieldId == fieldNum(GUPFreeItemDiscount, FreeItemCriteriaType))
        {
            RetailPeriodicDiscountLine discountLine;
            if (this.FreeItemCriteriaType == GUPFreeItemCriteriaType::Quantity)
            {
                update_recordset discountLine
                    Setting LeastAmount = 0
                    where discountLine.OfferId == this.OfferId;
            }
            else if (this.FreeItemCriteriaType == GUPFreeItemCriteriaType::Amount)
            {
                update_recordset discountLine
                    Setting IsMandatory = NoYes::No
                    where discountLine.OfferId == this.OfferId;
            }
        }
    }

]]></Source>
			</Method>
