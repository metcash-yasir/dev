		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();
        ret = ret & this.checkPricingTree();
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>checkPricingTree</Name>
				<Source><![CDATA[
    private boolean checkPricingTree()
    {
        GUPPricingTree pricingTree;
        boolean ret = true;
        select firstonly RecId from pricingTree
            where pricingTree.RecId != this.RecId;

        if (pricingTree)
        {
            ret = checkFailed("@GlobalUnifiedPricing:GUPPricingTreeExists");
        }

        return ret;
    }

]]></Source>
