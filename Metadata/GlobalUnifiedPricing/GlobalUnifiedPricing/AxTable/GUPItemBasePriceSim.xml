			<Method>
				<Name>checkNoActivePrice</Name>
				<Source><![CDATA[
    public boolean checkNoActivePrice(boolean _showErrorMessage)
    {
        TransDate       currentActivationDate;
        boolean         ret                     = true;

        currentActivationDate = GUPItemBasePrice::findCurrent(
                                    this.ItemId,
                                    this.PriceType,
                                    this.InventDimId).ActivationDate;

        if (this.FromDate < currentActivationDate && currentActivationDate)
        {
            if (_showErrorMessage)
            {
                checkFailed(strFmt("@SYS106970", this.ItemId, date2StrUsr( this.FromDate, DateFlags::FormatAll), date2StrUsr(currentActivationDate, DateFlags::FormatAll)));
            }
            ret = false;
        }
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>moveSimulatedToCurrent</Name>
				<Source><![CDATA[
    public void moveSimulatedToCurrent()
    {
        ttsbegin;

        GUPItemBasePrice baseItemPrice;
        baseItemPrice.initFromGUPItemBasePriceSim(this);
                
        baseItemPrice.ActivationDate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
        baseItemPrice.insert();

        this.delete();

        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static GUPItemBasePriceSim find(
        ItemId                  _itemId,
        GUPBasePriceVersionId   _versionId,
        FromDate                _fromDate,
        GUPBasePriceType        _priceType,
        UnitOfMeasureSymbol     _unitId,
        InventDimId             _inventDimId,
        InventSiteId            _newSiteId          = '',
        boolean                 _forUpdate          = false)
    {
        GUPItemBasePriceSim  itemBasePriceSim;

        if (_itemId
            && _versionId
            && InventDim::find(_inventDimId).isOwnerCurrentLegalEntity())
        {
            itemBasePriceSim.selectForUpdate(_forUpdate);

            InventTable inventTable         = InventTable::find(_itemId);
            InventDim inventDimCriteria     = GUPItemBasePrice::initializeInventDimCriteria(inventTable, _inventDimId);
            inventDimCriteria.InventSiteId  = GUPItemBasePrice::changeSiteId(inventDimCriteria.InventSiteId, _newSiteId);

            InventDim inventDim = InventDim::findDim(inventDimCriteria);

            select firstonly itemBasePriceSim
            where itemBasePriceSim.ItemId        == _itemId
               && itemBasePriceSim.VersionId     == _versionId
               && itemBasePriceSim.FromDate      == _fromDate
               && itemBasePriceSim.PriceType     == _priceType
               && itemBasePriceSim.UnitId        == _unitId
               && itemBasePriceSim.InventDimId    == inventDim.inventDimId;
        }

        return itemBasePriceSim;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByVersionId</Name>
				<Source><![CDATA[
    public static GUPItemBasePriceSim findByVersionId(
        GUPBasePriceVersionId   _versionId,
        boolean                 _forUpdate = false)
    {
        GUPItemBasePriceSim  itemBasePriceSim;
        
        itemBasePriceSim.selectForUpdate(_forUpdate);

        select firstonly itemBasePriceSim
            where itemBasePriceSim.VersionId == _versionId;          

        return itemBasePriceSim;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromCalcTable</Name>
				<Source><![CDATA[
    public void initFromCalcTable(GUPItemBasePriceCalcTable _basePriceCalcTable)
    {
        if (!this.RecId)
        {
            this.ItemId         = _basePriceCalcTable.ItemId;
            this.UnitId         = _basePriceCalcTable.UnitId;
            this.InventDimId    = _basePriceCalcTable.InventDimId;
        }
        this.VersionId          = _basePriceCalcTable.VersionId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromBasePriceVersionTable</Name>
				<Source><![CDATA[
    public void initFromBasePriceVersionTable(
        GUPBasePriceVersion             _basePriceVersion,
        InventSiteId                    _siteId             = '',
        GUPBasePriceVersionId           _basePriceVersionId = _basePriceVersion.VersionId,
        GUPBasePriceVersionDefaultDate  _fromDate           = _basePriceVersion.DefaultDate
        )
    {
        InventDim               inventDim;

        this.VersionId = _basePriceVersionId;

        if (_fromDate)
        {
            this.FromDate = _fromDate;
        }

        if (_siteId || _basePriceVersion.InventSiteId)
        {
            inventDim               = InventDim::find(this.InventDimId);
            inventDim.InventSiteId  = _basePriceVersion.InventSiteId ? _basePriceVersion.InventSiteId : _siteId;
            this.InventDimId        = InventDim::findOrCreate(inventDim).InventDimId;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>delete</Name>
				<Source><![CDATA[
    public void delete()
    {
        GUPItemBasePriceSim oldItemBasePriceSim ;

        ttsbegin;

        if (this.PriceCalcId)
        {
            oldItemBasePriceSim.data(this);
        }

        super();

        GUPBasePriceVersion::updateLastUpdated(this.VersionId);

        if (oldItemBasePriceSim.PriceCalcId)
        {
            this.deleteItemBasePriceCalcTable(oldItemBasePriceSim);
        }

        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>deleteItemBasePriceCalcTable</Name>
				<Source><![CDATA[
    private void deleteItemBasePriceCalcTable(GUPItemBasePriceSim _oldItemBasePriceSim)
    {
        GUPItemBasePrice            itemBasePrice;
        GUPItemBasePriceSim         itemBasePriceSim;
        GUPItemBasePriceCalcTable   itemBasePriceCalcTable;

        select count(RecId) from itemBasePrice
            where itemBasePrice.ItemId            == _oldItemBasePriceSim.ItemId
               && itemBasePrice.PriceCalcId       == _oldItemBasePriceSim.PriceCalcId;

        select count(RecId) from itemBasePriceSim
            where itemBasePriceSim.ItemId         == _oldItemBasePriceSim.ItemId
               && itemBasePriceSim.PriceCalcId    == _oldItemBasePriceSim.PriceCalcId;

        if ((! itemBasePrice.RecId) && (! itemBasePriceSim.RecId))
        {
            itemBasePriceCalcTable = GUPItemBasePriceCalcTable::find(_oldItemBasePriceSim.PriceCalcId, true);
            itemBasePriceCalcTable.delete();
        }
    }

]]></Source>
			</Method>
