				<Source><![CDATA[
    public UPSPricingRule headerPricingRule(boolean _selectForUpdate = false)
    {
        UPSPricingRule headerRule;
        headerRule.selectForUpdate(_selectForUpdate);
        select firstonly headerRule where headerRule.RecId == this.HeaderPricingRule;
        return headerRule;
    }

]]></Source>
