				<Source><![CDATA[
    /// <summary>
    /// Get the related pricing attribute.
    /// </summary>
    /// <returns>The pricing attribute.</returns>
    public UPSIPricingAttribute pricingAttribute()
    {
        return UPSPricingAttributeRepository::priceAttribute(
            this.ClassId,
            this.AttributeProviderClassId,
            this.AttributeName);
    }

