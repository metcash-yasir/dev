			<Method>
				<Name>lookupAllowedValues</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void lookupAllowedValues(FormStringControl _control)
    {
        SysTableLookup    lookup;
        QueryBuildDataSource qbds;
        Query q = new Query();
        qbds = q.addDataSource(tableNum(UPSAllowedValuesListTemp));
        qbds.addSortField(fieldNum(UPSAllowedValuesListTemp, Value), SortOrder::Ascending);

        lookup = SysTableLookup::newParameters(tableNum(UPSAllowedValuesListTemp),
                                               _control,
                                               true);

        lookup.addLookupField(fieldnum(UPSAllowedValuesListTemp, Value), true);
        lookup.parmQuery(q);
        lookup.parmTmpBuffer(UPSAllowedValuesListTemp::populate(this.pricingAttribute().getAllowedValues()));

        lookup.performFormLookup();
    }

]]></Source>
