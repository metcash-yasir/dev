		<Methods>
			<Method>
				<Name>displayItemName</Name>
				<Source><![CDATA[
    display InventItemPriceName displayItemName()
    {
        return this.ItemId ? InventTable::find(this.ItemId).defaultProductName() : '';
    }

]]></Source>
			</Method>
			<Method>
				<Name>inventTable</Name>
				<Source><![CDATA[
    public InventTable inventTable(boolean _forUpdate = false)
    {
        InventTable inventTable;

        inventTable = InventTable::find(this.ItemId,_forUpdate);

        return inventTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static GUPItemBasePriceCalcTable find(GUPBasePriceCalcPriceCalcId _priceCalcId, boolean _forUpdate = false)
    {
        GUPItemBasePriceCalcTable  itemBasePriceCalcTable;

        if (_priceCalcId)
        {
            itemBasePriceCalcTable.selectForUpdate(_forUpdate);

            select firstonly itemBasePriceCalcTable
                index hint NumIdx
                where itemBasePriceCalcTable.PriceCalcId == _priceCalcId;
        }
        return itemBasePriceCalcTable;
    }

]]></Source>
			</Method>
		</Methods>
