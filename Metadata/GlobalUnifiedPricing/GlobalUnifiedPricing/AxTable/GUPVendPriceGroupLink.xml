}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    [Hookable(false)]
    public static GUPVendPriceGroupLink find(
        GUPVendPriceGroupId _vendPriceGroupId, 
        RefRecId _vendRecId,
        boolean _forUpdate = false)
    {
        GUPVendPriceGroupLink vendPriceGroupLink;
        
        vendPriceGroupLink.selectForUpdate(_forUpdate);

        if (_vendPriceGroupId)
        {
            select firstOnly vendPriceGroupLink
                where vendPriceGroupLink.VendPriceGroupId == _vendPriceGroupId
                   && vendPriceGroupLink.VendRecId == _vendRecId;
        }
    
        return vendPriceGroupLink;
    }

]]></Source>
			</Method>
			<Method>
				<Name>vendTable</Name>
				<Source><![CDATA[
    internal VendTable vendTable(boolean _forupdate = false)
    {
        return VendTable::findRecId(this.VendRecId, _forupdate);
    }

]]></Source>
			</Method>
			<Method>
				<Name>rebateDescription</Name>
				<Source><![CDATA[
    internal display Description rebateDescription()
    {
        return GUPVendPriceGroup::find(this.VendPriceGroupId).Description;
    }

]]></Source>
			</Method>
			<Method>
				<Name>vendAccount</Name>
				<Source><![CDATA[
    internal edit VendAccount vendAccount(boolean _set, VendAccount _vendAccount)
    {
        if (_set)
        {
            VendTable vendTable = VendTable::find(_vendAccount);
            if (vendTable)
            {
                this.VendRecId = vendTable.RecId;
            }
        }
    
        if (!this.VendRecId)
        {
            return '';
        }
    
        return this.vendTable().AccountNum;
    }

]]></Source>
			</Method>
			<Method>
				<Name>vendName</Name>
				<Source><![CDATA[
    internal display VendName vendName()
    {
        VendTable vendTable = this.vendTable();
    
        if (!vendTable)
        {
            return '';
        }
    
        return vendTable.name();
    }

]]></Source>
			</Method>
		</Methods>
