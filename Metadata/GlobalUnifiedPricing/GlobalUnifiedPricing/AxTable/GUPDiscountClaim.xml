		<Methods>
			<Method>
				<Name>displayTotalClaimAmount</Name>
				<Source><![CDATA[
    display int displayTotalClaimAmount()
    {
        GUPDiscountClaimTransaction discountClaimTransaction;
        select sum(ClaimAmount) from discountClaimTransaction
            where discountClaimTransaction.DiscountClaimId == this.DiscountClaimId;
        return discountClaimTransaction.ClaimAmount;
    }

]]></Source>
			</Method>
