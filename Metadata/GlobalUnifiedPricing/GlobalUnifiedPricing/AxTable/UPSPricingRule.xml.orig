			<Method>
				<Name>displayPricingAttributeDetails</Name>
				<Source><![CDATA[
    public display UPSPricingAttributeDetails displayPricingAttributeDetails()
    {
        UPSPricingAttributeDetails displayDetails = '';
        str attributeDetail;
        UPSPricingRuleCondition ruleCond;
        while select ruleCond where ruleCond.RuleId == this.RecId
        {
            attributeDetail = strFmt(
                '%1: %2\n',
                ruleCond.pricingAttribute().getName(),
                ruleCond.ConditionValue);
            displayDetails += attributeDetail;
        }

        return displayDetails;
    }

]]></Source>
			</Method>
			<Method>
				<Name>pricingAttributeGroup</Name>
				<Source><![CDATA[
    internal UPSPricingAttributeGroup pricingAttributeGroup(boolean _selectForUpdate = false)
    {
        UPSPricingAttributeGroup pricingAttributeGroup;

        select firstonly pricingAttributeGroup where pricingAttributeGroup.RecId == this.PriceAttributeGroup;

        pricingAttributeGroup.selectForUpdate(_selectForUpdate);
        return pricingAttributeGroup;
    }

]]></Source>
