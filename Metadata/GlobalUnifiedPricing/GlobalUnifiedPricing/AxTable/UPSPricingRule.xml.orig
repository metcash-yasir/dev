			<Method>
				<Name>match</Name>
				<Source><![CDATA[
    /// <summary>
    /// Determine if pricing object matches current pricing rule.
    /// </summary>
    /// <param name = "_pricingObject">The pricing object.</param>
    /// <returns>True if pricing object matches current pricing rule.</returns>
    public boolean match(Common _pricingObject)
    {
        UPSPricingRuleCondition ruleCondition;

        while select ruleCondition
            where ruleCondition.RuleId == this.RecId
        {
            if (!ruleCondition.match(_pricingObject))
            {
                return false;
            }
        }

        return true;
    }

]]></Source>
			</Method>
			<Method>
				<Name>clearRuleConditions</Name>
				<Source><![CDATA[
    /// <summary>
    /// Clear all child rule conditions.
    /// </summary>
    public void clearRuleConditions()
    {
        if (this.RecId)
        {
            UPSPricingRuleCondition ruleCondition;
            UPSPricingRuleExclusion ruleExclusion;

            delete_from ruleCondition where ruleCondition.RuleId == this.RecId;
            delete_from ruleExclusion where ruleExclusion.RuleId == this.RecId;
        }
    }

]]></Source>
