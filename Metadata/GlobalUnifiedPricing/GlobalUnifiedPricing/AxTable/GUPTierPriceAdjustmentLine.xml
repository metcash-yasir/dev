		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the specified record in <c>GUPTierPriceAdjustmentLine</c> table.
    /// </summary>
    /// <param name="_offerId">
    /// Value of the offer id.
    /// </param>
    /// <param name="_qtyLowest">
    /// Value of the minimum quantity.
    /// </param>
    /// <param name="_forUpdate">
    /// A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    /// A record in the <c>GUPTierPriceAdjustmentLine</c> table; otherwise, an empty record.
    /// </returns>
    public static GUPTierPriceAdjustmentLine find(RetailOfferIdEx3 _offerId, RetailQtyLowest _qtyLowest, boolean _forUpdate = false)
    {
        GUPTierPriceAdjustmentLine tierLine;

        if (_offerId && _qtyLowest)
        {
            tierLine.selectForUpdate(_forUpdate);

            select firstonly tierLine
                index hint QtyLowest
                where tierLine.OfferId == _offerId
                   && tierLine.QtyLowest == _qtyLowest;
        }

        return tierLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>deleteByOfferId</Name>
				<Source><![CDATA[
    public static void deleteByOfferId(RetailOfferIdEx3 _offerId)
    {
        GUPTierPriceAdjustmentLine tierLine;

        delete_from tierLine
            where tierLine.OfferId == _offerId;
    }

]]></Source>
			</Method>
