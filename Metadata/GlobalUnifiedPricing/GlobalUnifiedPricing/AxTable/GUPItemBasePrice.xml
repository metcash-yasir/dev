			<Method>
				<Name>getCacheKey</Name>
				<Source><![CDATA[
    protected static str getCacheKey(
            ItemId                  _itemId,
            GUPBasePriceType        _priceType,
            InventDimId             _inventDimId,
            TransDate               _activationDate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone()),
            InventSiteId            _newSiteId      = '')
    {
        str key = _itemId + '#'
                + int2str(enum2int(_priceType)) + '#'
                + _inventDimId + '#'
                + date2StrXpp(_activationDate) + '#'
                + _newSiteId + '#'
                + curext();

        return key;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findCurrent</Name>
				<Source><![CDATA[
    public static GUPItemBasePrice findCurrent(
        ItemId                  _itemId,
        GUPBasePriceType        _priceType,
        InventDimId             _inventDimId,
        TransDate               _activationDate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone()),
        InventSiteId            _newSiteId      = '',
        boolean                 _forUpdate      = false
        )
    {
        GUPItemBasePrice     itemBasePrice;

        if (_itemId
            && InventDim::find(_inventDimId).isOwnerCurrentLegalEntity())
        {
            str cacheKey = GUPItemBasePrice::getCacheKey(_itemId, _priceType, _inventDimId, _activationDate, _newSiteId);
            itemBasePrice = SysTransactionScopeCache::get(tableStr(InventItemPrice), cacheKey, itemBasePrice);

            if (!itemBasePrice || itemBasePrice.selectForUpdate() != _forUpdate)
            {
                InventTable inventTable         = InventTable::find(_itemId);
                InventDim inventDimCriteria     = InventItemPrice::initializeInventDimCriteria(inventTable, _inventDimId);
                inventDimCriteria.InventSiteId  = InventItemPrice::changeSiteId(inventDimCriteria.InventSiteId, _newSiteId);
                itemBasePrice.selectForUpdate(_forUpdate);

                InventDim inventDim = InventDim::findDim(inventDimCriteria);

                select firstonly itemBasePrice
                order by ActivationDate desc, CreatedDateTime desc
                where itemBasePrice.ItemId         == _itemId
                   && itemBasePrice.PriceType      == _priceType
                   && itemBasePrice.ActivationDate <= _activationDate
                && itemBasePrice.InventDimId    == inventDim.inventDimId;

                SysTransactionScopeCache::set(tableStr(GUPItemBasePrice), cacheKey, itemBasePrice);
            }
        }

        return itemBasePrice;
    }

]]></Source>
			</Method>
