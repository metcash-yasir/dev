			<Method>
				<Name>initFromPriceConvert</Name>
				<Source><![CDATA[
    public void initFromPriceConvert(PriceConvert _priceConvert)
    {
        this.Price       = _priceConvert.parmPrice();
        this.Markup      = _priceConvert.parmMarkup();
        this.PriceQty    = _priceConvert.parmPriceQty();
        this.UnitID      = _priceConvert.parmUnitId();
    }

]]></Source>
			</Method>
			<Method>
				<Name>changeSiteId</Name>
				<Source><![CDATA[
    public static InventSiteId changeSiteId(
        InventSiteId    _oldSiteId,
        InventSiteId    _newSiteId
        )
    {
        return _newSiteId ? _newSiteId : _oldSiteId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initializeInventDimCriteria</Name>
				<Source><![CDATA[
    public static InventDim initializeInventDimCriteria(
        InventTable _inventTable,
        InventDimId _inventDimId,
        InventDim   _inventDim = null)
    {
        InventDim       inventDimCriteria;

        if (_inventDim || _inventDimId)
        {
            inventDimCriteria = _inventDim ? _inventDim.data() : InventDim::find(_inventDimId);
        }
        else
        {
            inventDimCriteria = InventDim::findDim(_inventDim);
        }

        inventDimCriteria.clearNotSiteAndProductDim(InventDimGroupSetup::newInventTable(_inventTable));

        return inventDimCriteria;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getItemBasePrice</Name>
				<Source><![CDATA[
    public static real getItemBasePrice(GUPItemBasePriceParameter _parameter)
    {
        GUPItemBasePrice itemBasePrice;
        real ret;
        select firstonly Price, PriceQty, UnitId, Markup from itemBasePrice
            order by RecId desc
            where itemBasePrice.PriceType == _parameter.parmPriceType() &&
                itemBasePrice.InventDimId == _parameter.parmInventDimId() &&
                itemBasePrice.ItemId == _parameter.parmItemId() &&
                itemBasePrice.FromDate <= _parameter.parmTransDate() &&
                (itemBasePrice.ToDate == dateNull() || itemBasePrice.ToDate >= _parameter.parmTransDate());

        if (itemBasePrice)
        {
            ret = itemBasePrice.convertUnitCurrency(_parameter);
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>convertUnitCurrency</Name>
				<Source><![CDATA[
    private real convertUnitCurrency(GUPItemBasePriceParameter _parameter)
    {
        PriceConvertFactory priceConvertFactory = PriceConvertFactory::newItemPrice(
            _parameter.parmItemid(),
            this.Unitid,
            this.Price,
            1,
            this.Markup,
            this.PriceQty,
            Ledger::accountingCurrency());

        priceConvertFactory.parmNewCurrencyCode(_parameter.parmCurrency());
        priceConvertFactory.parmNewUnitId(_parameter.parmUnitId());
        PriceConvert priceConvert = priceConvertFactory.priceConvert();

        return priceConvert.parmPrice() / priceConvert.parmPriceQty();
    }

]]></Source>
			</Method>
