		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static GUPBasePriceVersion find(GUPBasePriceVersionId _versionId, boolean _forUpdate = false)
    {
        GUPBasePriceVersion     version;

        if (_forUpdate)
        {
            version.selectForUpdate(true);
        }

        select firstonly version where version.VersionId == _versionId;

        return version;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    public static boolean exist(GUPBasePriceVersionId _versionId)
    {
        return _versionId && (select firstonly GUPBasePriceVersion where GUPBasePriceVersion.VersionId == _versionId).RecId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateActivationDate</Name>
				<Source><![CDATA[
    public static void updateActivationDate(GUPBasePriceVersionId _versionId)
    {
        GUPBasePriceVersion version;

        ttsbegin;

        version = GUPBasePriceVersion::find(_versionId, true);
        
        if (version)
        {            
            version.LastActivation = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
            version.LastUpdate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
            version.update();
        }

        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromGUPBasePriceVersion</Name>
				<Source><![CDATA[
    public void initFromGUPBasePriceVersion(GUPBasePriceVersion _basePriceVersion)
    {
        this.Name               = _basePriceVersion.Name;
        this.BlockActivation    = _basePriceVersion.BlockActivation;
        this.BlockChange        = _basePriceVersion.BlockChange;
        this.DefaultDate        = _basePriceVersion.DefaultDate;
        this.InventSiteId       = _basePriceVersion.InventSiteId;
        this.AllowInventoryCost = _basePriceVersion.AllowInventoryCost;
        this.AllowPurch         = _basePriceVersion.AllowPurch;
        this.AllowSales         = _basePriceVersion.AllowSales;
        this.PriceBasis         = _basePriceVersion.PriceBasis;
        this.PriceRule          = _basePriceVersion.PriceRule;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateLastUpdated</Name>
				<Source><![CDATA[
    public static void updateLastUpdated(GUPBasePriceVersionId  _versionId)
    {
        #OCCRetryCount

        GUPBasePriceVersion basePriceVersion;

        basePriceVersion = GUPBasePriceVersion::find(_versionId);

        if (basePriceVersion.LastUpdate == DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone()) || basePriceVersion.RecId == 0)
        {
            return;
        }

        try
        {
            ttsbegin;

            basePriceVersion = GUPBasePriceVersion::find(_versionId, true);
            basePriceVersion.LastUpdate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
            basePriceVersion.update();

            ttscommit;
        }
        catch (Exception::Deadlock)
        {
            retry;
        }
        catch (Exception::UpdateConflict)
        {
            if (appl.ttsLevel() == 0)
            {
                if (xSession::currentRetryCount() >= #RetryNum)
                {
                    throw Exception::UpdateConflictNotRecovered;
                }
                else
                {
                    retry;
                }
            }
            else
            {
                throw Exception::UpdateConflict;
            }
        }
        catch (Exception::Error)
        {
            ttsabort;
            exceptionTextFallThrough();
        }
    }

]]></Source>
