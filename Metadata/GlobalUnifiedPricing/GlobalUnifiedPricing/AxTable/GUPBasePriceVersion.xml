				<Source><![CDATA[
    private void setCheckedForAllowPriceTypes()
    {        
        this.AllowPurch = NoYes::Yes;
        this.AllowSales = NoYes::Yes;
        this.AllowInventoryCost = NoYes::Yes;
    }

]]></Source>
