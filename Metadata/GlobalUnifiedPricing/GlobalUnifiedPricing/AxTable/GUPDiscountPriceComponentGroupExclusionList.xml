				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();
    
        RetailDiscountOfferTypeBase offerType = RetailPeriodicDiscount::findByOfferId(this.OfferId).PeriodicDiscountType;

        if (offerType != RetailDiscountOfferTypeBase::Multibuy
            && offerType != RetailDiscountOfferTypeBase::MixAndMatch
            && offerType != RetailDiscountOfferTypeBase::DiscountOffer
            && offerType != RetailDiscountOfferTypeBase::Threshold)
        {
            ret = checkFailed("@GlobalUnifiedPricing:GUPDiscountPriceComponentGroupExclusionListNotSupport");
        }
    
        return ret;
    }

]]></Source>
