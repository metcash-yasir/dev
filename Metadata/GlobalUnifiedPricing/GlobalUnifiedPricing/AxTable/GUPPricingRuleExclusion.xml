		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static GUPPricingRuleExclusion find(RefRecId        _ruleId,
                                               GUPExclusion    _exclusion,
                                               boolean         _update = false)
    {
        GUPPricingRuleExclusion gupPricingRuleExclusion;

        if (_ruleId && _exclusion)
        {
            if (_update)
            {
                gupPricingRuleExclusion.selectForUpdate(_update);
            }
            
            select firstonly gupPricingRuleExclusion
                index hint ExclusionIdx
                    where gupPricingRuleExclusion.RuleId == _ruleId
                    &&    gupPricingRuleExclusion.Exclusion == _exclusion;
            
        }

        return gupPricingRuleExclusion;
    }

]]></Source>
