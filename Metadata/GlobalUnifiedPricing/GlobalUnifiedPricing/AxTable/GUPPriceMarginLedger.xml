				<Source><![CDATA[
    public static GUPPriceMarginLedger find(GUPPostingProfile _postingProfileId, boolean _update = false)
    {
        GUPPriceMarginLedger     priceMarginLedger;

        if (_update)
        {
            priceMarginLedger.selectForUpdate(_update);
        }

        select firstonly priceMarginLedger
            where priceMarginLedger.PostingProfile == _postingProfileId;

        return priceMarginLedger;
    }

]]></Source>
