			<Method>
				<Name>getAllowedValues</Name>
				<Source><![CDATA[
    public Set getAllowedValues()
    {
        SysDictEnum sysDictEnum = new SysDictEnum(enumNum(EcoResProductType));
        
        var ret = new Set(Types::String);
        EcoResProductType enum;
        for (int i = 0; i < sysDictEnum.values(); ++i)
        {
            enum = sysDictEnum.index2Value(i);
            ret.add(enum2Str(enum) );
        }
        return ret;
    }

]]></Source>
