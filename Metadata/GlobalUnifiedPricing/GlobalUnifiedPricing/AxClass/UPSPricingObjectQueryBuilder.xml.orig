				<Name>findFirstDsForTable</Name>
				<Source><![CDATA[
    public static QueryBuildDataSource findFirstDsForTable(Query _q, TableId _tableId)
    {
        QueryBuildDataSource ds;
        int i;

        for (i = 1; i <= _q.dataSourceCount(); i++)
        {
            ds = _q.dataSourceNo(i);
            if (ds.table() == _tableId)
            {
                return ds;
            }
        }

        return null;
    }

]]></Source>
