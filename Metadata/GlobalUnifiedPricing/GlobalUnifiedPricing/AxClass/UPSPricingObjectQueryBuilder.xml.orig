				<Name>custTableQuery</Name>
				<Source><![CDATA[
    public static Query custTableQuery(UPSRuleTable _ruleTable)
    {
        Query query;

        if (_ruleTable && _ruleTable.headerPricingRule() && _ruleTable.headerPricingRule().PriceAttributeGroup)
        {
            UPSPricingObjectQueryBuilder queryBuilder = new UPSPricingObjectQueryBuilder(UPSPricingAttributeSource::Customer);
            query = queryBuilder
                .addPricingRuleFilter(_ruleTable.headerPricingRule())
                .build();
        }
        else
        {
            query = new Query();
            query.addDataSource(tableNum(CustTable))
                .addRange(fieldNum(CustTable, RecId))
                .value(any2Str(-1));
        }

        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>inventTableQuery</Name>
				<Source><![CDATA[
    public static Query inventTableQuery(UPSRuleTable _ruleTable)
    {
        Query query;

        if (_ruleTable)
        {
            UPSPricingObjectQueryBuilder queryBuilder = new UPSPricingObjectQueryBuilder(UPSPricingAttributeSource::Product);
            UPSRuleLine ruleLine;
            UPSPricingRule rule;
            while select ruleLine where ruleLine.RuleId == _ruleTable.RuleId
            {
                rule = ruleLine.linePricingRule();
                if (rule && rule.PriceAttributeGroup)
                {
                    queryBuilder.addPricingRuleFilter(rule);
                }
            }
            query = queryBuilder.build();
        }
        else
        {
            query = new Query();
            query.addDataSource(tableNum(InventTable))
                .addRange(fieldNum(InventTable, RecId))
                .value(any2Str(-1));
        }

        return query;
    }

]]></Source>
			</Method>
			<Method>
>>>>>>> e221facb848 (UPSRuleTable UI and UPSAddPriceAttributeGroup UI)
				<Name>new</Name>
				<Source><![CDATA[
    public void new(UPSPricingAttributeSource _source)
    {
        QueryBuildDataSource rootDS;

        this.querySourceType = _source;
        this.query = new Query();
        this.queryBuildDatasourceMap = new Map(Types::String, Types::Class);

        switch (_source)
        {
            case UPSPricingAttributeSource::Customer:
                rootDS = query.addDataSource(tableNum(CustTable));
                queryBuildDatasourceMap.insert(tableStr(CustTable), rootDS);
                break;
            case UPSPricingAttributeSource::Product:
                rootDS = query.addDataSource(tableNum(InventTable));
                queryBuildDatasourceMap.insert(tableStr(InventTable), rootDS);
                break;
            case UPSPricingAttributeSource::SalesTable:
                rootDS = query.addDataSource(tableNum(SalesTable));
                queryBuildDatasourceMap.insert(tableStr(SalesTable), rootDS);
                break;
            case UPSPricingAttributeSource::SalesLine:
                rootDS = query.addDataSource(tableNum(SalesLine));
                queryBuildDatasourceMap.insert(tableStr(SalesLine), rootDS);
                break;
            default:
                throw error("@UnifiedPricingService:UPSErrorForUnsupportedPricingAttributeSourceType");
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>build</Name>
				<Source><![CDATA[
    public Query build()
    {
        return this.query;
    }

]]></Source>
