			<Method>
				<Name>clearCache</Name>
				<Source><![CDATA[
    internal static void clearCache()
    {
        SysExtensionCache::clearAllScopes();
        classFactory.globalCache().clear(SysExtAppClassReflectionData::CacheOwner);
    }

