			</Method>
			<Method>
				<Name>getAllPricingAttributes</Name>
				<Source><![CDATA[
    /// <summary>
    /// Get cached pricing attr map.
    /// </summary>
    /// <returns>The map.</returns>
    public static List getAllPricingAttributes()
    {
        List pricingAttrs = new List(Types::Class);

        MapEnumerator attrEnum = cachedPricingAttrs.getEnumerator();
        while (attrEnum.moveNext())
        {
            pricingAttrs.addEnd(attrEnum.currentValue());
        }

        MapEnumerator providerEnum = cachedPricingAttrProviders.getEnumerator();
        UPSIPricingAttributeProvider provider;
        SetEnumerator providerAttrEnum;
        while (providerEnum.moveNext())
        {
            provider = providerEnum.currentValue();
            providerAttrEnum = provider.getPricingAttributes().getEnumerator();

            while (providerAttrEnum.moveNext())
            {
                pricingAttrs.addEnd(providerAttrEnum.current());
            }
        }

        return pricingAttrs;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getPriceAttributeTmp</Name>
				<Source><![CDATA[
    /// <summary>
    /// Get temporay price attribute records; these records are to be consumed as form control lookup datasource.
    /// </summary>
    /// <param name = "_sourceLevel">The source level of price attribute.</param>
    /// <returns>Price attribute records.</returns>
    public static UPSPricingAttributeTmp getPriceAttributeTmp(UPSPricingAttributeSourceLevel _sourceLevel)
    {
        // TODO: retrieve source level matched price attribute instances only.
        UPSPricingAttributeTmp priceAttrTmp;
        priceAttrTmp.clear();

        UPSPricingAttributeRepository::getPricingAttributes();

        List attributes = UPSPricingAttributeRepository::getAllPricingAttributes();
        Enumerator enum = attributes.getEnumerator();

        UPSIPricingAttribute pricingAttr;
        UPSPricingAttributeLink link;
        while (enum.moveNext())
        {
            pricingAttr = enum.current();
            link = UPSPricingAttributeRepository::toPriceAttributeLink(pricingAttr);
            priceAttrTmp.Name = link.AttributeName;
            priceAttrTmp.ClassId = link.ClassId;
            priceAttrTmp.Type = 'abc';  // TODO
            priceAttrTmp.ProviderClassId = link.AttributeProviderClassId;
            priceAttrTmp.insert();
        }

        return priceAttrTmp;
    }

]]></Source>
			</Method>
