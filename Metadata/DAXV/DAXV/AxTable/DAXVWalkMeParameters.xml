			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static DAXVWalkMeParameters find(boolean _forupdate = false)
    {
        DAXVWalkMeParameters parameter;

        if (_forupdate)
        {
            parameter.selectForUpdate(_forupdate);
        }

        select firstonly parameter
            index Key
            where parameter.Key == 0;

        if (!parameter && !parameter.isTmp())
        {
            Company::createParameter(parameter);
        }

        return parameter;
    }

]]></Source>
