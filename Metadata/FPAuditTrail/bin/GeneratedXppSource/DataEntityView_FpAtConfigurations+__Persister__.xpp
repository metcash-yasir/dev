Private class __Persister__
extends SysDataEntityPersister
{
    // Data source ID macros
    #define.FpAtConfiguration_ID(1)
    
    // Data source buffers
    FpAtConfiguration m_FpAtConfiguration;
    
    protected void mapEntityToDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.validateFieldFailed = false;
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('FpAtConfiguration'));
        this.mapEntityToDataSourcesExtensions(_entityCtx);
        if(this.validateFieldFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    protected boolean saveDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // save data sources in topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [FpAtConfiguration]
            if(!this.preSaveDataSource(_entityCtx, 'FpAtConfiguration'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('FpAtConfiguration');
            // propagates foreign key values from referenced data sources which are part of extensions.
            this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
            // inserts/updates data source [FpAtConfiguration].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [FpAtConfiguration]
            if(!this.preSaveDataSource(_entityCtx, 'FpAtConfiguration'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('FpAtConfiguration');
            // deletes data source [FpAtConfiguration].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    private void mapToDataSource_DS1(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx, FpAtConfiguration _fpAtConfiguration, FpAtConfigurations _fpAtConfigurations)
    {
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtConfigurations, fieldnum(FpAtConfigurations, Name), _fpAtConfiguration, fieldnum(FpAtConfiguration, Name), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtConfigurations, fieldnum(FpAtConfigurations, Value), _fpAtConfiguration, fieldnum(FpAtConfiguration, Value), 1);
        
        this.mapToDataSourceExtensions(_dataSourceCtx, _fpAtConfiguration, _fpAtConfigurations);
        _fpAtConfiguration.trackFieldExternallySet(false);
    }
    protected void doMapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #FpAtConfiguration_ID:
                this.mapToDataSource_DS1(_entityCtx, _dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapEntityToDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    private void mapFromDataSource_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, FpAtConfiguration _fpAtConfiguration, FpAtConfigurations _fpAtConfigurations)
    {
        this.mapDataSourceFieldToEntityField(_fpAtConfiguration, fieldnum(FpAtConfiguration, Name), _fpAtConfigurations, fieldnum(FpAtConfigurations, Name), false);
        this.mapDataSourceFieldToEntityField(_fpAtConfiguration, fieldnum(FpAtConfiguration, Value), _fpAtConfigurations, fieldnum(FpAtConfigurations, Value), false);
        this.mapFromDataSourceExtensions(_dataSourceCtx, _fpAtConfiguration, _fpAtConfigurations);
        // map system fields (e.g. recid and recversion) from data source buffer to view record.
        _fpAtConfigurations.fromViewDataSource(_dataSourceCtx.id(), _fpAtConfiguration);
    }
    protected void doMapDataSourceToEntity(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #FpAtConfiguration_ID:
                this.mapFromDataSource_DS1(_dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapDataSourceToEntityExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    protected Common doFindDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        Common rtrn = null;
        switch(_dataSourceCtx.id())
        {
            case #FpAtConfiguration_ID:
                rtrn = this.LookForUniqueKeyMatch_DS1(_entityCtx.getEntityRecord(), _dataSourceCtx.getBuffer());
                break;
            default :
                rtrn = this.doFindDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    protected boolean isAnyMappedDataSourceFieldSet_DS1(FpAtConfigurations _fpAtConfigurations, str disabledConfigKey = null)
    {
        boolean rtrn = false;
        if(_fpAtConfigurations.isFieldSet(fieldnum(FpAtConfigurations, Name)))
        {
            return true;
        }
        if(_fpAtConfigurations.isFieldSet(fieldnum(FpAtConfigurations, Value)))
        {
            return true;
        }
        rtrn = this.isAnyMappedDataSourceFieldSetExtensions(_fpAtConfigurations, disabledConfigKey);
        return rtrn;
    }
    protected boolean isAnyMappedDataSourceFieldSet(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        boolean rtrn = false;
        switch(_dataSourceCtx.id())
        {
            case #FpAtConfiguration_ID:
                rtrn = this.isAnyMappedDataSourceFieldSet_DS1(_entityCtx.getEntityRecord());
                break;
            default :
                rtrn = this.isAnyMappedDataSourceFieldSet_DSExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    private boolean validateDataSource_DS1(DataEntityRuntimeContext _entityCtx, FpAtConfigurations _fpAtConfigurations, DataEntityDataSourceRuntimeContext _dataSourceCtx, FpAtConfiguration _fpAtConfiguration)
    {
        boolean rtrn = true;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, _dataSourceCtx.getCompany(), '', conNull(), _fpAtConfigurations, fieldnum(FpAtConfigurations, Name), 'FpAtConfigurations.Name', _fpAtConfiguration, fieldnum(FpAtConfiguration, Name), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, _dataSourceCtx.getCompany(), '', conNull(), _fpAtConfigurations, fieldnum(FpAtConfigurations, Value), 'FpAtConfigurations.Value', _fpAtConfiguration, fieldnum(FpAtConfiguration, Value), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateDataSourceExtensions(_entityCtx, _fpAtConfigurations, _dataSourceCtx, _fpAtConfiguration) ? rtrn : false;
        return rtrn;
    }
    protected boolean validateDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        boolean rtrn = true;
        switch(_dataSourceCtx.id())
        {
            case #FpAtConfiguration_ID:
                rtrn = this.validateDataSource_DS1(_entityCtx,_entityCtx.getEntityRecord(),_dataSourceCtx,_dataSourceCtx.getBuffer());
                break;
            default :
                rtrn = this.validateDataSourceExtensions_DSExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    private void mapToMatchingRecord_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, FpAtConfiguration _fpAtConfiguration, FpAtConfiguration _matchingRecord)
    {
        // map data changes in bound fields.
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtConfiguration, fieldnum(FpAtConfiguration, Name), _matchingRecord, fieldnum(FpAtConfiguration, Name), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtConfiguration, fieldnum(FpAtConfiguration, Value), _matchingRecord, fieldnum(FpAtConfiguration, Value), 1);
        this.mapToMatchingRecordExtensions(_dataSourceCtx, tablestr(FpAtConfigurations), _fpAtConfiguration, _matchingRecord);
    }
    protected void mapDataSourceToMatchingRecord(DataEntityDataSourceRuntimeContext _dataSourceCtx, Common _matchingRecord)
    {
        switch(_dataSourceCtx.id())
        {
            case #FpAtConfiguration_ID:
                this.mapToMatchingRecord_DS1(_dataSourceCtx, _dataSourceCtx.getBuffer(), _matchingRecord);
                break;
            default :
                this.mapDataSourceToMatchingRecordExtensions(_dataSourceCtx, _matchingRecord);
                break;
        }
    }
    protected void validateConfigurationKeys(DataEntityRuntimeContext _entityCtx)
    {
    }
    protected void initializeDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.initializeDataSource(_entityCtx, 'FpAtConfiguration', m_FpAtConfiguration, this.getDataSourceId('FpAtConfiguration'), this.getDataSourceRuntimeId('FpAtConfiguration'), false/* optional */, false/* readonly */, false/* oneToMany */, false/* dateEffective */, false/* applyDateFilter */);
        this.initializeDataSourcesExtensions(_entityCtx);
    }
    private FpAtConfiguration LookForUniqueKeyMatch_DS1(FpAtConfigurations _fpAtConfigurations, FpAtConfiguration _fpAtConfiguration)
    {
        FpAtConfiguration fpAtConfiguration_ = null;
        
        select
            forUpdate
            firstOnly
                fpAtConfiguration_
        where
            fpAtConfiguration_.Name == _fpAtConfiguration.Name
        ;
        
        if (fpAtConfiguration_)
        {
            return fpAtConfiguration_;
        }
        
        return fpAtConfiguration_;
    }

}

