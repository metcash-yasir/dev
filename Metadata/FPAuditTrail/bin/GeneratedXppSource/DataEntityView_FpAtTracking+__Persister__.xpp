Private class __Persister__
extends SysDataEntityPersister
{
    // Data source ID macros
    #define.FPTracking_ID(1)
    
    // Data source buffers
    FPTracking m_FPTracking;
    
    protected void mapEntityToDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.validateFieldFailed = false;
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('FPTracking'));
        this.mapEntityToDataSourcesExtensions(_entityCtx);
        if(this.validateFieldFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    protected boolean saveDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // save data sources in topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [FPTracking]
            if(!this.preSaveDataSource(_entityCtx, 'FPTracking'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('FPTracking');
            // propagates foreign key values from referenced data sources which are part of extensions.
            this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
            // inserts/updates data source [FPTracking].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [FPTracking]
            if(!this.preSaveDataSource(_entityCtx, 'FPTracking'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('FPTracking');
            // deletes data source [FPTracking].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    private void mapToDataSource_DS1(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx, FPTracking _fPTracking, FpAtTracking _fpAtTracking)
    {
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtTracking, fieldnum(FpAtTracking, AxTableId), _fPTracking, fieldnum(FPTracking, AxTableId), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtTracking, fieldnum(FpAtTracking, AxFieldId), _fPTracking, fieldnum(FPTracking, AxFieldId), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtTracking, fieldnum(FpAtTracking, TrackInsert), _fPTracking, fieldnum(FPTracking, TrackInsert), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtTracking, fieldnum(FpAtTracking, TrackUpdate), _fPTracking, fieldnum(FPTracking, TrackUpdate), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fpAtTracking, fieldnum(FpAtTracking, TrackDelete), _fPTracking, fieldnum(FPTracking, TrackDelete), 1);
        
        this.mapToDataSourceExtensions(_dataSourceCtx, _fPTracking, _fpAtTracking);
        _fPTracking.trackFieldExternallySet(false);
    }
    protected void doMapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #FPTracking_ID:
                this.mapToDataSource_DS1(_entityCtx, _dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapEntityToDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    private void mapFromDataSource_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, FPTracking _fPTracking, FpAtTracking _fpAtTracking)
    {
        this.mapDataSourceFieldToEntityField(_fPTracking, fieldnum(FPTracking, AxTableId), _fpAtTracking, fieldnum(FpAtTracking, AxTableId), false);
        this.mapDataSourceFieldToEntityField(_fPTracking, fieldnum(FPTracking, AxFieldId), _fpAtTracking, fieldnum(FpAtTracking, AxFieldId), false);
        this.mapDataSourceFieldToEntityField(_fPTracking, fieldnum(FPTracking, TrackInsert), _fpAtTracking, fieldnum(FpAtTracking, TrackInsert), false);
        this.mapDataSourceFieldToEntityField(_fPTracking, fieldnum(FPTracking, TrackUpdate), _fpAtTracking, fieldnum(FpAtTracking, TrackUpdate), false);
        this.mapDataSourceFieldToEntityField(_fPTracking, fieldnum(FPTracking, TrackDelete), _fpAtTracking, fieldnum(FpAtTracking, TrackDelete), false);
        this.mapFromDataSourceExtensions(_dataSourceCtx, _fPTracking, _fpAtTracking);
        // map system fields (e.g. recid and recversion) from data source buffer to view record.
        _fpAtTracking.fromViewDataSource(_dataSourceCtx.id(), _fPTracking);
    }
    protected void doMapDataSourceToEntity(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #FPTracking_ID:
                this.mapFromDataSource_DS1(_dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapDataSourceToEntityExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    protected Common doFindDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        Common rtrn = null;
        switch(_dataSourceCtx.id())
        {
            case #FPTracking_ID:
                rtrn = this.LookForUniqueKeyMatch_DS1(_entityCtx.getEntityRecord(), _dataSourceCtx.getBuffer());
                break;
            default :
                rtrn = this.doFindDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    protected boolean isAnyMappedDataSourceFieldSet_DS1(FpAtTracking _fpAtTracking, str disabledConfigKey = null)
    {
        boolean rtrn = false;
        if(_fpAtTracking.isFieldSet(fieldnum(FpAtTracking, AxTableId)))
        {
            return true;
        }
        if(_fpAtTracking.isFieldSet(fieldnum(FpAtTracking, AxFieldId)))
        {
            return true;
        }
        if(_fpAtTracking.isFieldSet(fieldnum(FpAtTracking, TrackInsert)))
        {
            return true;
        }
        if(_fpAtTracking.isFieldSet(fieldnum(FpAtTracking, TrackUpdate)))
        {
            return true;
        }
        if(_fpAtTracking.isFieldSet(fieldnum(FpAtTracking, TrackDelete)))
        {
            return true;
        }
        rtrn = this.isAnyMappedDataSourceFieldSetExtensions(_fpAtTracking, disabledConfigKey);
        return rtrn;
    }
    protected boolean isAnyMappedDataSourceFieldSet(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        boolean rtrn = false;
        switch(_dataSourceCtx.id())
        {
            case #FPTracking_ID:
                rtrn = this.isAnyMappedDataSourceFieldSet_DS1(_entityCtx.getEntityRecord());
                break;
            default :
                rtrn = this.isAnyMappedDataSourceFieldSet_DSExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    private boolean validateDataSource_DS1(DataEntityRuntimeContext _entityCtx, FpAtTracking _fpAtTracking, DataEntityDataSourceRuntimeContext _dataSourceCtx, FPTracking _fPTracking)
    {
        boolean rtrn = true;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, _dataSourceCtx.getCompany(), '', conNull(), _fpAtTracking, fieldnum(FpAtTracking, AxTableId), 'FpAtTracking.AxTableId', _fPTracking, fieldnum(FPTracking, AxTableId), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, _dataSourceCtx.getCompany(), '', conNull(), _fpAtTracking, fieldnum(FpAtTracking, AxFieldId), 'FpAtTracking.AxFieldId', _fPTracking, fieldnum(FPTracking, AxFieldId), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, _dataSourceCtx.getCompany(), '', conNull(), _fpAtTracking, fieldnum(FpAtTracking, TrackInsert), 'FpAtTracking.TrackInsert', _fPTracking, fieldnum(FPTracking, TrackInsert), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, _dataSourceCtx.getCompany(), '', conNull(), _fpAtTracking, fieldnum(FpAtTracking, TrackUpdate), 'FpAtTracking.TrackUpdate', _fPTracking, fieldnum(FPTracking, TrackUpdate), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, _dataSourceCtx.getCompany(), '', conNull(), _fpAtTracking, fieldnum(FpAtTracking, TrackDelete), 'FpAtTracking.TrackDelete', _fPTracking, fieldnum(FPTracking, TrackDelete), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateDataSourceExtensions(_entityCtx, _fpAtTracking, _dataSourceCtx, _fPTracking) ? rtrn : false;
        return rtrn;
    }
    protected boolean validateDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        boolean rtrn = true;
        switch(_dataSourceCtx.id())
        {
            case #FPTracking_ID:
                rtrn = this.validateDataSource_DS1(_entityCtx,_entityCtx.getEntityRecord(),_dataSourceCtx,_dataSourceCtx.getBuffer());
                break;
            default :
                rtrn = this.validateDataSourceExtensions_DSExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
    private void mapToMatchingRecord_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, FPTracking _fPTracking, FPTracking _matchingRecord)
    {
        // map data changes in bound fields.
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fPTracking, fieldnum(FPTracking, AxTableId), _matchingRecord, fieldnum(FPTracking, AxTableId), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fPTracking, fieldnum(FPTracking, AxFieldId), _matchingRecord, fieldnum(FPTracking, AxFieldId), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fPTracking, fieldnum(FPTracking, TrackInsert), _matchingRecord, fieldnum(FPTracking, TrackInsert), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fPTracking, fieldnum(FPTracking, TrackUpdate), _matchingRecord, fieldnum(FPTracking, TrackUpdate), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _fPTracking, fieldnum(FPTracking, TrackDelete), _matchingRecord, fieldnum(FPTracking, TrackDelete), 1);
        this.mapToMatchingRecordExtensions(_dataSourceCtx, tablestr(FpAtTracking), _fPTracking, _matchingRecord);
    }
    protected void mapDataSourceToMatchingRecord(DataEntityDataSourceRuntimeContext _dataSourceCtx, Common _matchingRecord)
    {
        switch(_dataSourceCtx.id())
        {
            case #FPTracking_ID:
                this.mapToMatchingRecord_DS1(_dataSourceCtx, _dataSourceCtx.getBuffer(), _matchingRecord);
                break;
            default :
                this.mapDataSourceToMatchingRecordExtensions(_dataSourceCtx, _matchingRecord);
                break;
        }
    }
    protected void validateConfigurationKeys(DataEntityRuntimeContext _entityCtx)
    {
    }
    protected void initializeDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.initializeDataSource(_entityCtx, 'FPTracking', m_FPTracking, this.getDataSourceId('FPTracking'), this.getDataSourceRuntimeId('FPTracking'), false/* optional */, false/* readonly */, false/* oneToMany */, false/* dateEffective */, false/* applyDateFilter */);
        this.initializeDataSourcesExtensions(_entityCtx);
    }
    private FPTracking LookForUniqueKeyMatch_DS1(FpAtTracking _fpAtTracking, FPTracking _fPTracking)
    {
        FPTracking fPTracking_ = null;
        
        select
            forUpdate
            firstOnly
                fPTracking_
        where
            fPTracking_.AxTableId == _fPTracking.AxTableId && fPTracking_.AxFieldId == _fPTracking.AxFieldId
        ;
        
        if (fPTracking_)
        {
            return fPTracking_;
        }
        
        return fPTracking_;
    }

}

