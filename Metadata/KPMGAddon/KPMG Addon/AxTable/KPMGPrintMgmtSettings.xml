				<Name>displayPrintMgmtReportFormatName</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    display PrintMgmtReportFormatName displayPrintMgmtReportFormatName()
    {
        PrintMgmtReportFormat   printMgmtReportFormat = PrintMgmtReportFormat::find(this.ReportFormat);

        return printMgmtReportFormat.Name;
    }

]]></Source>
