			<Method>
				<Name>findByReportFormatId</Name>
				<Source><![CDATA[
    /// <summary>
    ///    Finds a record in the <c>METPrintMgmtSettings</c> table.
    /// </summary>
    /// <param name="_reportFormat">
    ///    RecId of PrintMgmtReportFormat
    /// </param>
    /// <param name="_forUpdate">
    ///    A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    A record in the <c>METPrintMgmtSettings</c> table.
    /// </returns>
    public client server static KPMGPrintMgmtSettings findByReportFormatId(PrintMgmtReportFormatId   _reportFormat, boolean _forUpdate = false)
    {
        KPMGPrintMgmtSettings    kpmgPrintMgmtSettings;
        
        kpmgPrintMgmtSettings.selectForUpdate(_forUpdate);

        select firstonly kpmgPrintMgmtSettings
            where kpmgPrintMgmtSettings.ReportFormat == _reportFormat;

        return kpmgPrintMgmtSettings;
    }

]]></Source>
			</Method>
