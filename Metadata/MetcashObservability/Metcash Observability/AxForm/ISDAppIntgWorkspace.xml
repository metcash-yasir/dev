			<Method>
				<Name>getUTCdatetimeRangeValue</Name>
				<Source><![CDATA[
    /// <summary>
    /// Get utcdatetime based on date filter selection
    /// </summary>
    /// <param name = "_selection"></param>
    /// <returns> Returns a <c>utcdatetime</c> object</returns>
    private utcdatetime getUTCdatetimeRangeValue(DMFExecutionHistoryDateFilterOptions _selection)
    {
        utcdatetime filterDateTime;
        
        if(_selection == DMFExecutionHistoryDateFilterOptions::All)
        {
            filterDateTime = DateTimeUtil::minValue();
        }
        else
        {
            switch(_selection)
            {
                case DMFExecutionHistoryDateFilterOptions::PastDay:
                    filterDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -1);
                    break;

                case DMFExecutionHistoryDateFilterOptions::Past3Days:
                    filterDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -3);
                    break;

                case DMFExecutionHistoryDateFilterOptions::PastWeek:
                    filterDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -7);
                    break;

                case DMFExecutionHistoryDateFilterOptions::PastMonth:
                    filterDateTime = DateTimeUtil::addMonths(DateTimeUtil::utcNow(), -1);
                    break;

                case DMFExecutionHistoryDateFilterOptions::Past3Months:
                    filterDateTime = DateTimeUtil::addMonths(DateTimeUtil::utcNow(), -3);
                    break;

                case DMFExecutionHistoryDateFilterOptions::Past6Months:
                    filterDateTime = DateTimeUtil::addMonths(DateTimeUtil::utcNow(), -6);
                    break;

                default:
                    // Default: Last week to match selection on the standard view of workspace
                    filterDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -7);
                    break;
            }
        }

        return filterDateTime;
    }

]]></Source>
