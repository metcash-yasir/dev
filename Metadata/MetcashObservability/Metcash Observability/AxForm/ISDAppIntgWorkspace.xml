        [Hookable(false)]
        public void lookup()
        {
            SysTableLookup lookup = SysTableLookup::newParameters(tableNum(DMFDefinitionGroup), this, true);

            lookup.addLookupfield(fieldNum(DMFDefinitionGroup, DefinitionGroupName), true);
            lookup.addLookupfield(fieldNum(DMFDefinitionGroup,OperationType), false);
            lookup.addLookupfield(fieldNum(DMFDefinitionGroup, Description), false);
            
            Query q = new Query();
            q.addDataSource(tableNum(DMFDefinitionGroup));
            q.dataSourceNo(1).addRange(fieldNum(DMFDefinitionGroup,ProjectCategory)).value(queryValue(DMFProjectCategory::Integration));
            lookup.parmQuery(q);
            lookup.performFormLookup();
        }

]]></Source>
