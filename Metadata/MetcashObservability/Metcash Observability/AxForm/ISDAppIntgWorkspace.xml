			<Method>
				<Name>parmFilter</Name>
				<Source><![CDATA[
    /// <summary>
    /// Prepare filter
    /// </summary>
    /// <returns>Returns a <c>SysIFilter</c> object</returns>
    [Hookable(false)]
    public SysIFilter parmFilter()
    {
        SysIFilter                      filter = SysFilterFactory::createEmptyFilter();
        SysIFilterValue                 filterValue;
        SysFilterValueResolutionMethod  filterValueResolutionMethod = SysFilterValueResolutionMethod::All;
        str                             selectedDefGroupName = DefGroupNameFilter.valueStr();
        DMFDefinitionGroup              dmfDefinitionGroup = DMFDefinitionGroup::find(selectedDefGroupName);
        utcdatetime                     utcDateTimeFilter;
        SysIFilterValue                 filterCreatedDateTime;

        
        if (dmfDefinitionGroup)
        {
            filterValueResolutionMethod = SysFilterValueResolutionMethod::None;

            filterValue = SysFilterValueFactory::createFilterValueForBuffer(dmfDefinitionGroup);
            filter.addItem(filterValue, SysFilterOperator::Equal, filterValueResolutionMethod);
        }
            
        utcDateTimeFilter = this.getUTCdatetimeRangeValue(DefGroupDateFilter.selection());
        filterCreatedDateTime = SysFilterValueFactory::createFilterValueForDateTime(utcDateTimeFilter, extendedTypeNum(CreatedDateTime));
        filter.addItem(filterCreatedDateTime, SysFilterOperator::GreaterThan, SysFilterValueResolutionMethod::None);

        return filter;
    }

]]></Source>
