            firstOnly
                ledger_
        where
            ledger_.Name == _ledger.Name
        ;
        
        if (ledger_)
        {
            return ledger_;
        }
        
        select
            forUpdate
            firstOnly
                ledger_
        where
            ledger_.PrimaryForLegalEntity == _ledger.PrimaryForLegalEntity
        ;
        
        if (ledger_)
        {
            return ledger_;
        }
        
        return ledger_;
    }

}

