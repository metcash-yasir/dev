				<Name>processConsolidationPosting</Name>
				<Source><![CDATA[
    void processConsolidationPosting(METCustomerMDFConsolidationTable _consolidationPosting)
    {
        ttsbegin;

        Common common = this.createPosting(_consolidationPosting);

        if(this.autoPost())
        {
            this.post(common);
        }

        ttscommit;
    }

]]></Source>
