				<Source><![CDATA[
    void process()
    {
        Query query = this.getQuery();

        QueryRun queryRun = new QueryRun(query);

        while(queryRun.next())
        {
            METCustomerMDFConsolidationTable consolidationPosting = queryRun.get(tableNum(METCustomerMDFConsolidationTable));

            this.processConsolidationPosting(consolidationPosting);
        }
    }

]]></Source>
