				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validates the record being written.
    /// </summary>
    /// <returns>Returns true or false.</returns>
    public boolean validateWrite()
    {
        boolean ret;
        InventTable inventTable;

        ret = super();

        if (ret)
        {
            select RecId from inventTable
                where inventTable.ItemId == this.ItemId;

            if (!inventTable.RecId)
            {
                ret = checkFailed(strFmt('@MET:METInvalidItemId', this.ItemId));
            }
        }
    
        return ret;
    }

]]></Source>
			</Method>
