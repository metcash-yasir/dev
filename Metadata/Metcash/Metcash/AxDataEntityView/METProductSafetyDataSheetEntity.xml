    /// <param name = "_entityCtx">The entity run time context.</param>
    public void persistEntity(DataEntityRuntimeContext _entityCtx)
    {
        // Skip the validation for Item Id field as it non editable on table level and we are validating it in Validate Write method above.
        this.skipDataSourceValidateField(fieldNum(METProductSafetyDataSheetEntity, ItemId), true);
        super(_entityCtx);
    }

]]></Source>
