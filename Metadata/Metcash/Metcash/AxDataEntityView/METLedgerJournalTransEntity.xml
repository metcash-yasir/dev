				<Name>populatePartyFields</Name>
				<Source><![CDATA[
    /// MPJ - 28908 Removing postLoad() method to ensure Skip Staging is enabled for the MET Ledger Journal Transactions entity
    /// <summary>
    /// MPJ-25581 Ledger journal trans entity DCP 02/06/2022
    /// Method is triggered during the BYOD GL 15 export operation but should be commented out if we need to leverage Skip Staging - 29/09/2022
    /// </summary>
    //public void postLoad()
    //{
