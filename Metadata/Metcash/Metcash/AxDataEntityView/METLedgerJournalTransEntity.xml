    //    //MPJ - 28908 Stop populating Party Fields

    //    this.populatePartyFields();

    //}
    /// MPJ - 28908 Removing postLoad() method to ensure Skip Staging is enabled for the MET Ledger Journal Transactions entity - 29/09/2022

    /// <summary>
    /// MPJ-25581 Ledger journal trans entity DCP 02/06/2022
    /// </summary>
    public void populatePartyFields()
    {
        ModuleCustVend  module;
        DirPartyTable   party;
        boolean         doParty = false;
        
        try
        {
            switch (this.AccountType)
            {
                case LedgerJournalACType::Cust:
                    module = ModuleCustVend::Cust;
                    doParty = true;
                    break;

                case LedgerJournalACType::Vend:
                    module = ModuleCustVend::Vend;
                    doParty = true;
                    break;
            }

            if(doParty && this.LedgerDimensionDisplayValue)
            {
                party = DirPartyTable::findRec(CustVendTable::findModule(module, this.LedgerDimensionDisplayValue).Party);

                if(party)
                {
                    this.PartyId        = party.recid;
                    this.PartyNumber    = substr(this.LedgerDimensionDisplayValue,1,40);  //truncate value to 40 chars
                    this.partyName      = party.Name;
                }
            }
        }
        catch
        {
            this.PartyId        = 0;
            this.PartyNumber    = null;
            this.partyName      = null;
        }
    }

]]></Source>
			</Method>
		</Methods>
