		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// update METTariffItemCodeBase reference
    /// </summary>
    /// <returns>true if valid</returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        if(ret)
        {
            METStatCode statCode;
            METNAT3040  nat3040;
            if(this.CustomsExcise == METCustomExcise::C)
            {
                nat3040  = METNAT3040::NAT30;
                statCode = this.StatCode;
            }
            else
            {
                nat3040   = METNAT3040::NAT40;
                statCode  = "@MET:DefaultStatCodeText";
            }

            METTariffItemCodeBase METTariffItemCodeBase = METTariffItemCodeBase::findbyTariffStatCode(this.TariffItem, statCode);

            if(!METTariffItemCodeBase)
            {
                METTariffItemCodeBase.TariffItem    = this.TariffItem;
                METTariffItemCodeBase.StatCode      = statCode;
                METTariffItemCodeBase.NAT3040       = nat3040;
                METTariffItemCodeBase.Description   = this.Description;
                METTariffItemCodeBase.CustomsExcise = this.CustomsExcise;

                ttsbegin;
                METTariffItemCodeBase.insert();
                ttscommit;
            }

            this.METTariffItemCodeBaseRecId = METTariffItemCodeBase.RecId;
            this.StatCode = statCode;

            if(!this.ValidTo)
            {
                this.ValidTo = dateMax();
            }
        }
    
        return ret;
    }

]]></Source>
			</Method>
		</Methods>
