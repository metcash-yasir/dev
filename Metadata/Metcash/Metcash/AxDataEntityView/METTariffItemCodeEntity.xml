    /// </summary>
    public static void postTargetProcess(DMFDefinitionGroupExecution _dmfDefinitionGroupExecution)
    {
        METInventTable  metInvenTable;
        if (_dmfDefinitionGroupExecution.StagingStatus == DMFBatchJobStatus::Finished)
        {
            METTariffItemCodeDataStaging    metTariffItemCodeDataStaging;
            delete_from metInvenTable;
            ttsbegin;
            while select metTariffItemCodeDataStaging
            where metTariffItemCodeDataStaging.DefinitionGroup == _dmfDefinitionGroupExecution.DefinitionGroup
               && metTariffItemCodeDataStaging.ExecutionId     == _dmfDefinitionGroupExecution.ExecutionId
               && metTariffItemCodeDataStaging.TransferStatus  == DMFTransferStatus::Completed
            {
                metInvenTable.TariffItem       = metTariffItemCodeDataStaging.TariffItem;
                metInvenTable.CustomsExcise    = metTariffItemCodeDataStaging.CustomsExcise;
                metInvenTable.StatCode         = metTariffItemCodeDataStaging.StatCode;
                metInvenTable.DutyPerLiterAlcohol = metTariffItemCodeDataStaging.DutyLAL;
                metInvenTable.insert();
            }
            ttscommit;
        }
    }

]]></Source>
