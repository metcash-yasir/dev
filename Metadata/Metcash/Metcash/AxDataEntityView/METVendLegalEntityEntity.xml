    public static void postGetStagingData(DMFDefinitionGroupExecution _dmfDefinitionGroupExecution)
    {
        METVendLegalEntityStaging    metVendLegalEntityStaging;
        ttsbegin;
            
        while select forupdate metVendLegalEntityStaging
            where metVendLegalEntityStaging .DefinitionGroup     == _dmfDefinitionGroupExecution.DefinitionGroup &&
                  metVendLegalEntityStaging .ExecutionId         == _dmfDefinitionGroupExecution.ExecutionId  &&
                  metVendLegalEntityStaging .TransferStatus      == DMFTransferStatus::NotStarted             &&
                  !metVendLegalEntityStaging.VendLegalEntityID


        {
           
            metVendLegalEntityStaging.VendLegalEntityID = NumberSeq::newGetNum(NumberSequenceReference::findByDatatypeAndScope(typeId2ExtendedTypeId(typeName2Type(extendedTypeStr(METVendLegalEntityID))))).num();
            metVendLegalEntityStaging.doUpdate();    
                       
        }
        ttscommit;
    }

]]></Source>
