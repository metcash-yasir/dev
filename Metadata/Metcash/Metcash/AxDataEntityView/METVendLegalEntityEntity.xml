				<Source><![CDATA[
    /// <summary>
    /// MPJ_21178_VendorGlobal by chaminda on 09 Mar 2022
    /// </summary>
    /// <returns></returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        if(ret)
        {
            METVendParentCompany    metVendParentCompany = METVendParentCompany::find(this.VendParentCompanyID);
            if(metVendParentCompany)
            {
                this.VendParentCompany = metVendParentCompany.RecId;                
            }
            else
            {
                ret=checkFailed("No parent company record found");
            }
        }
    
        return ret;
    }

]]></Source>
