		<Methods>
			<Method>
				<Name>initializeEntityDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializing the origin type for met excise register entry when there is blank.
    /// </summary>
    /// <param name = "_entityCtx">_entityCtx</param>
    /// <param name = "_dataSourceCtx">_dataSourceCtx</param>
    public void initializeEntityDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        super(_entityCtx, _dataSourceCtx);
    
        if (!this.OriginType)
        {
            this.OriginType = InventTransType::Blank;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>persistEntity</Name>
				<Source><![CDATA[
    /// <summary>
    /// Persist entity.
    /// </summary>
    /// <param name = "_entityCtx">EntityCtx</param>
    public void persistEntity(DataEntityRuntimeContext _entityCtx)
    {
        this.skipDataSourceValidateField(fieldNum(METExciseRegisterEntryEntity, ReferenceId), true);
        this.skipDataSourceValidateField(fieldNum(METExciseRegisterEntryEntity, ValidFrom), true);
        this.skipDataSourceValidateField(fieldNum(METExciseRegisterEntryEntity, ValidTo), true);
    
        super(_entityCtx);
    }

]]></Source>
			</Method>
			<Method>
				<Name>mapEntityToDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// Mapping entity to data source.
    /// </summary>
    /// <param name = "_entityCtx">entityCtx</param>
    /// <param name = "_dataSourceCtx">DXCtx</param>
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        if (!this.ReferenceId)
        {
            this.ReferenceId = guid2Str(newGuid());
            this.VersionNumber = 1;
        }
        else
        {
            METExciseRegisterEntry existingRecord;
            utcdatetime currentDateTime = DateTimeUtil::utcNow();
    
            select firstOnly forupdate validtimestate(currentDateTime) RecId, VersionNumberRegister from existingRecord
                where existingRecord.ReferenceId == this.ReferenceId;
    
            if (existingRecord.RecId)
            {
                this.VersionNumber = existingRecord.VersionNumberRegister + 1;
            }
            else
            {
                this.VersionNumber = 1;
            }
        }
    
        if (!this.ValidFrom)
        {
            this.ValidFrom = DateTimeUtil::utcNow();
        }
    
        if (!this.ValidTo)
        {
            this.ValidTo = DateTimeUtil::maxValue();
        }
    
        super(_entityCtx, _dataSourceCtx);
    }

]]></Source>
			</Method>
		</Methods>
