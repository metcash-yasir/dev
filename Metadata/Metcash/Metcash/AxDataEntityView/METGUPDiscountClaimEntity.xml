		<Methods>
			<Method>
				<Name>getGSTAmount</Name>
				<Source><![CDATA[
    private static server str getGSTAmount()
    {
        SysDictTable claimTransaction = new SysDictTable(tableNum(GUPDiscountClaimTransaction));
        return METGUPDiscountClaimEntity::getSumFromTable(fieldNum(GUPDiscountClaimTransaction, METGSTAmount), claimTransaction.name(), claimTransaction.fieldName(fieldNum(GUPDiscountClaimTransaction, DiscountClaimId)));
    }

]]></Source>
			</Method>
			<Method>
				<Name>getTotalClaimAmount</Name>
				<Source><![CDATA[
    private static server str getTotalClaimAmount()
    {
        SysDictTable claimTransaction = new SysDictTable(tableNum(GUPDiscountClaimTransaction));
        return METGUPDiscountClaimEntity::getSumFromTable(fieldNum(GUPDiscountClaimTransaction, Amount), claimTransaction.name(), claimTransaction.fieldName(fieldNum(GUPDiscountClaimTransaction, DiscountClaimId)));
    }

]]></Source>
			</Method>
			<Method>
				<Name>getAdminFeeAmount</Name>
				<Source><![CDATA[
    private static server str getAdminFeeAmount()
    {
        SysDictTable claimFeeCalculation = new SysDictTable(tableNum(GUPDiscountVendorClaimFeeCalculation));
        return METGUPDiscountClaimEntity::getSumFromTable(fieldNum(GUPDiscountVendorClaimFeeCalculation, Amount), claimFeeCalculation.name(), claimFeeCalculation.fieldName(fieldNum(GUPDiscountVendorClaimFeeCalculation, DiscountClaimId)));
    }

]]></Source>
			</Method>
			<Method>
				<Name>getTotalClaimAmountWithFeeAndGST</Name>
				<Source><![CDATA[
    private static server str getTotalClaimAmountWithFeeAndGST()
    {
        return SysComputedColumn::add(
                    METGUPDiscountClaimEntity::getTotalClaimAmount(),
                    SysComputedColumn::add(
                        METGUPDiscountClaimEntity::getAdminFeeAmount(),
                        METGUPDiscountClaimEntity::getGSTAmount()));
    }

]]></Source>
			</Method>
			<Method>
				<Name>getSumFromTable</Name>
				<Source><![CDATA[
    private static server str getSumFromTable(FieldId _sumField, str _sumTable, str _whereField)
    {
        SysDictTable claimTransaction = new SysDictTable(tableNum(GUPDiscountClaimTransaction));

        str DiscountClaimIdValue = SysComputedColumn::returnField(tablestr(METGUPDiscountClaimEntity), dataEntityDataSourceStr(METGUPDiscountClaimEntity, GUPDiscountClaim), fieldStr(GUPDiscountClaim, DiscountClaimId));

        str sumFieldSQL = strFmt("SELECT COALESCE(SUM(%1), 0) FROM %2 WHERE %2.%3 = %4",
            claimTransaction.fieldName(_sumField),
            _sumTable,
            _whereField,
            DiscountClaimIdValue);

        return sumFieldSQL;
    }

]]></Source>
			</Method>
		</Methods>
