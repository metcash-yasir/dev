				<Source><![CDATA[
    /// <summary>
    /// MPJ_22881_ExciseRegisterItemDutyCardDataEntity
    /// </summary>
    /// <returns></returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        METTariffItemCodeBase metTariffItemCodeBase = METTariffItemCodeBase::findbyTariffStatCode(this.TariffItem, this.StatCode);
        if(metTariffItemCodeBase)
        {
            this.METTariffItemCodeBaseRecid = metTariffItemCodeBase.RecId;
        }
        else
        {
            error("@MET:InvalidTariffItemAndStatcodeCombination");
            ret=false;
        }
    
        return ret;
    }

]]></Source>
