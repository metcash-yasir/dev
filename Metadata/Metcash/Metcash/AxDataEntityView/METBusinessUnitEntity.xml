		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validations
    /// </summary>
    /// <returns>boolean value</returns>
    public boolean validateWrite()
    {
        boolean             ret = true;
        METBusinessUnit     metBusinessUnit = METBusinessUnit::find(this.BusinessName, this.StatePrefix);

        if (metBusinessUnit.BusinessName == this.BusinessName && metBusinessUnit.StatePrefix == this.StatePrefix)
        {
            ret = checkFailed(strFmt("@MET:METBusinessNameStatePrefixValidation", this.BusinessName, this.StatePrefix));
        }

        if (this.EnableStatePrefix == NoYes::No && this.StatePrefix)
        {
            ret = checkFailed(strFmt("@MET:METEnableStatePrefixEntityValidation", this.StatePrefix));
        }
        
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findEntityDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find entity data source
    /// </summary>
    /// <param name = "_entityCtx">The context of the entity.</param>
    /// <param name = "_dataSourceCtx">The context of the datasource being mapped.</param>
    /// <returns>data source</returns>
    public Common findEntityDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        Common ret;
        NumberSequenceTable numberSequenceTable;

        if (_dataSourceCtx.name() == dataEntityDataSourceStr(METBusinessUnitEntity, NumberSequenceTable))
        {
            select firstonly NumberSequence from numberSequenceTable
                where numberSequenceTable.NumberSequence == this.NumberSequence;

            ret = numberSequenceTable;
        }
        else
        {
            ret = super(_entityCtx, _dataSourceCtx);
        }

        return ret;
    }

]]></Source>
			</Method>
		</Methods>
