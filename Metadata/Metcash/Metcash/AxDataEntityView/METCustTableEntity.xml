    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        // If the IndustryKey field is set and we're processing the METIndustryKeyTable data source,
        // retrieve the corresponding industry key record and set it as the buffer for this data source
        if (this.isFieldSet(fieldNum(METCustTableEntity, IndustryKey)) && _dataSourceCtx.name() == dataEntityDataSourceStr(METCustTableEntity, METIndustryKeyTable))
