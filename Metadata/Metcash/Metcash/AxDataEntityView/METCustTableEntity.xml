				<Source><![CDATA[
    /// <summary>
    /// Validates the entity before writing to the database.
    /// </summary>
    /// <returns>true if validation passed; otherwise false</returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        // Verify that the specified IndustryKey exists in the METIndustryKeyTable
        if (this.IndustryKey && !METIndustryKeyTable::find(this.IndustryKey))
        {
            ret = checkFailed(strFmt("@SCM:TableFieldValidation",
                    this.IndustryKey,
                    fieldId2PName(tableNum(METCustTableEntity), fieldNum(METCustTableEntity, IndustryKey)),
                    tableId2PName(tableNum(METIndustryKeyTable))));
        }
    
        return ret;
    }

]]></Source>
