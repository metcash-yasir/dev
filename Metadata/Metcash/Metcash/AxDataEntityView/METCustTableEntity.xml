		<Methods>
			<Method>
				<Name>computedIndustryChannel</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the IndustryChannel value from METIndustryKeyTable based on the IndustryKey.
    /// The value is exposed as a computed column for display/export purposes only.
    /// </summary>
    /// <returns>
    /// The IndustryChannel value associated with the customer IndustryKey.
    /// </returns>
    public static server str computedIndustryChannel()
    {
        str industryKeyExpr;
        str industryChannel;

        SysDictTable industryKeyTable = new SysDictTable(tableNum(METIndustryKeyTable));

        industryKeyExpr = SysComputedColumn::returnField(
        dataentityviewstr(METCustTableEntity),
        dataEntityDataSourceStr(METCustTableEntity, METCustTable),
        fieldStr(METCustTable, IndustryKey));

        industryChannel = strFmt(
        @"SELECT TOP 1 %1 FROM %2 WHERE %2.%3 = %4",
        industryKeyTable.fieldName(fieldNum(METIndustryKeyTable, IndustryChannel), DbBackend::Sql),
        industryKeyTable.name(DbBackend::Sql),
        industryKeyTable.fieldName(fieldNum(METIndustryKeyTable, IndustryKey), DbBackend::Sql),
        industryKeyExpr);

        return industryChannel;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
