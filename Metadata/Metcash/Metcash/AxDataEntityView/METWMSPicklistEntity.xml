		<Methods>
			<Method>
				<Name>getUnitShipCaseQty</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns a computed column expression for the <c>UnitShipCaseQty</c> field.
    /// The expression determines the unit ship case quantity based on the item's sales, purchase, or inventory unit,
    /// returning the appropriate conversion factor or 1 if the unit is 'Each' or the inventory unit.
    /// </summary>
    /// <returns>
    /// A string containing the computed column expression for the unit ship case quantity.
    /// </returns>
    public static str getUnitShipCaseQty()
    {
        #define.ToUnitWarehouse('EA')

        str  query;
 
        // Determine the "from unit" symbol for the conversion based on ExternalWMSUnit
        str fromUnitSymbol = SysComputedColumn::if(
            SysComputedColumn::equalExpression(
                SysComputedColumn::comparisonField(
                    identifierStr(METWMSPicklistEntity),
                    dataEntityDataSourceStr(METWMSPicklistEntity, METInventLocation),
                    fieldStr(METInventLocation, ExternalWMSUnit)),
                SysComputedColumn::comparisonLiteral(METExtWMSUnit::DefaultSellUnit)),
            SysComputedColumn::returnField(
                tableStr(METWMSPicklistEntity),
                dataEntityDataSourceStr(METWMSPicklistEntity, InventItemSalesSetup),
                fieldStr(InventItemSalesSetup, METSalesUnit)),
            SysComputedColumn::if(
                SysComputedColumn::equalExpression(
                    SysComputedColumn::comparisonField(
                        identifierStr(METWMSPicklistEntity),
                        dataEntityDataSourceStr(METWMSPicklistEntity, METInventLocation),
                        fieldStr(METInventLocation, ExternalWMSUnit)),
                    SysComputedColumn::comparisonLiteral(METExtWMSUnit::DefaultPurchaseUnit)),
                SysComputedColumn::returnField(
                    tableStr(METWMSPicklistEntity),
                    dataEntityDataSourceStr(METWMSPicklistEntity, InventItemPurchSetup),
                    fieldStr(InventItemPurchSetup, METPurchUnit)),
                SysComputedColumn::returnLiteral(#ToUnitWarehouse)));

        // Build the conversion factor query
        query = strFmt(
            @"(select Top 1 UOMConv.Factor from UnitOfMeasureConversion UOMConv
                join UnitOfMeasure UOM1
                    on UOM1.RecId = UOMConv.ToUnitOfMeasure
                    and UOM1.Symbol = '%1'
                join UnitOfMeasure UOM2
                    on UOM2.RecId = UOMConv.FromUnitOfMeasure
                    and UOM2.Symbol = %2)",
                    #ToUnitWarehouse,
                    fromUnitSymbol);

        // Returns 1 if the warehouse unit is the default inventory unit or if the unit is 'Each'.
        // Otherwise, it returns the conversion factor between units from the UnitOfMeasureConversion table.
        return SysComputedColumn::if(
                    SysComputedColumn::equalExpression(
                    SysComputedColumn::comparisonField(
                        identifierStr(METWMSPicklistEntity),
                        dataEntityDataSourceStr(METWMSPicklistEntity, METInventLocation),
                        fieldStr(METInventLocation, ExternalWMSUnit)),
                    SysComputedColumn::comparisonLiteral(METExtWMSUnit::DefaultInventoryUnit)),
                    SysComputedColumn::returnLiteral(1),
                SysComputedColumn::if(
                    SysComputedColumn::equalExpression(
                        fromUnitSymbol,
                        SysComputedColumn::comparisonLiteral(#ToUnitWarehouse)),
                    SysComputedColumn::returnLiteral(1),
                    query));
    }

]]></Source>
			</Method>
			<Method>
				<Name>getPickEaches</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns pick eaches field query.
    /// </summary>
    /// <returns>Query for pick eaches field.</returns>
    public static str getPickEaches()
    {
        str  query;
        List pickEachesCondition;

        pickEachesCondition = new List(Types::String);

        pickEachesCondition.addEnd(SysComputedColumn::equalExpression(
                                        SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity), 
                                                                           dataEntityDataSourceStr(METWMSPicklistEntity, METCustTable), 
                                                                           fieldStr(METCustTable, PickEaches)),
                                        SysComputedColumn::comparisonLiteral(NoYes::Yes)));  

        pickEachesCondition.addEnd(SysComputedColumn::equalExpression(
                                        SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity),
                                                                           dataEntityDataSourceStr(METWMSPicklistEntity, METInventLocation),
                                                                           fieldStr(METInventLocation, PickEaches)),
                                        SysComputedColumn::comparisonLiteral(NoYes::Yes)));


        query = SysComputedColumn::if(
                    SysComputedColumn::and(pickEachesCondition), 
                    SysComputedColumn::returnLiteral(NoYes::Yes),
                    SysComputedColumn::returnLiteral(NoYes::No));  
 
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getBondedWarehouse</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns bonded warehouse field query.
    /// </summary>
    /// <returns>Query for bonded warehouse field.</returns>
    public static str getBondedWarehouse()
    {
        #define.LegalEntity('2000')

        str  query;
        List bondedWarehouseCondition;

        bondedWarehouseCondition = new List(Types::String);

        bondedWarehouseCondition.addEnd(SysComputedColumn::equalExpression(
                                            SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity),
                                                                               dataEntityDataSourceStr(METWMSPicklistEntity, METWMSPicklistView),
                                                                               fieldStr(METWMSPicklistView, DataAreaId)),
                                            SysComputedColumn::comparisonLiteral(#LegalEntity)));

        bondedWarehouseCondition.addEnd(SysComputedColumn::isNotNullExpression(
                                            SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity),
                                                                               dataEntityDataSourceStr(METWMSPicklistEntity, METTariffItemCodeBase),
                                                                               fieldStr(METTariffItemCodeBase, RecId))));

        query = SysComputedColumn::if(
                    SysComputedColumn::and(bondedWarehouseCondition),
                    SysComputedColumn::returnLiteral(NoYes::Yes),
                    SysComputedColumn::returnLiteral(NoYes::No));

           
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// To map the reserved qty value based in the catch weight value
    /// </summary>
    public void postLoad()
    {
        super();
        WMSOrderTrans  wmsOrderTrans;
        Qty picklistQty;

        select firstonly Qty, PdsCWQty from  wmsOrderTrans
                where wmsOrderTrans.RecId == this.WMSOrderTransRecId;

        if (!ecoResProduct::findByProductNumber(wmsOrderTrans.itemId).PdsCWProduct)
        {
            picklistQty = wmsOrderTrans.qty;
        }
        else
        {
            picklistQty = wmsOrderTrans.PdsCWQty;
        }

        // BUG 279857 - Calculate the reserved quantity based on the unit ship case quantity
        // Reserved Qty = Picklist Qty/Unit Ship Case Qty
        this.ReservedQty = this.UnitShipCaseQty ? (picklistQty / this.UnitShipCaseQty) : picklistQty;

    }

]]></Source>
			</Method>
