		<Methods>
			<Method>
				<Name>getUnitShipCaseQty</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns query for field <c>UnitShipCaseQty</c>.
    /// </summary>
    public static str getUnitShipCaseQty()
    {
        #define.ToUnitWarehouse('EA')

        str  query;

        query = strFmt(@"select Top 1 UOMConv.Factor from UnitOfMeasureConversion UOMConv
                            join UnitOfMeasure UOM1
                                on UOM1.RecId = UOMConv.ToUnitOfMeasure
                                and UOM1.Symbol = '%1'
                            join UnitOfMeasure UOM2
                                on UOM2.RecId = UOMConv.FromUnitOfMeasure
                            join InventItemSalesSetup InventSales
                                on InventSales.METSalesUnit = UOM2.Symbol
                                and InventSales.ItemId = %2
                            join InventDim dim
                                on dim.InventDimId = InventSales.InventDimId
                                and dim.InventSiteId = %3",
                            #ToUnitWarehouse,
                            SysComputedColumn::returnField(tableStr(METWMSPicklistEntity), 
                                                          dataEntityDataSourceStr(METWMSPicklistEntity, METWMSPicklistView),
                                                          fieldStr(METWMSPicklistView, ItemId)),
                            SysComputedColumn::returnField(tableStr(METWMSPicklistEntity),
                                                          dataEntityDataSourceStr(METWMSPicklistEntity, METWMSPicklistView),
                                                          fieldStr(METWMSPicklistView, ShippingSite)));
        
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getPickEaches</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns pick eaches field query.
    /// </summary>
    /// <returns>Query for pick eaches field.</returns>
    public static str getPickEaches()
    {
        str  query;
        List pickEachesCondition;

        pickEachesCondition = new List(Types::String);

        pickEachesCondition.addEnd(SysComputedColumn::equalExpression(
                                        SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity), 
                                                                           dataEntityDataSourceStr(METWMSPicklistEntity, METCustTable), 
                                                                           fieldStr(METCustTable, PickEaches)),
                                        SysComputedColumn::comparisonLiteral(NoYes::Yes)));  

        pickEachesCondition.addEnd(SysComputedColumn::equalExpression(
                                        SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity),
                                                                           dataEntityDataSourceStr(METWMSPicklistEntity, METInventLocation),
                                                                           fieldStr(METInventLocation, PickEaches)),
                                        SysComputedColumn::comparisonLiteral(NoYes::Yes)));


        query = SysComputedColumn::if(
                    SysComputedColumn::and(pickEachesCondition), 
                    SysComputedColumn::returnLiteral(NoYes::Yes),
                    SysComputedColumn::returnLiteral(NoYes::No));  
 
        return query;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getBondedWarehouse</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns bonded warehouse field query.
    /// </summary>
    /// <returns>Query for bonded warehouse field.</returns>
    public static str getBondedWarehouse()
    {
        #define.LegalEntity('2000')

        str  query;
        List bondedWarehouseCondition;

        bondedWarehouseCondition = new List(Types::String);

        bondedWarehouseCondition.addEnd(SysComputedColumn::equalExpression(
                                            SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity),
                                                                               dataEntityDataSourceStr(METWMSPicklistEntity, METWMSPicklistView),
                                                                               fieldStr(METWMSPicklistView, DataAreaId)),
                                            SysComputedColumn::comparisonLiteral(#LegalEntity)));

        bondedWarehouseCondition.addEnd(SysComputedColumn::isNotNullExpression(
                                            SysComputedColumn::comparisonField(tableStr(METWMSPicklistEntity),
                                                                               dataEntityDataSourceStr(METWMSPicklistEntity, METTariffItemCodeBase),
                                                                               fieldStr(METTariffItemCodeBase, RecId))));

        query = SysComputedColumn::if(
                    SysComputedColumn::and(bondedWarehouseCondition),
                    SysComputedColumn::returnLiteral(NoYes::Yes),
                    SysComputedColumn::returnLiteral(NoYes::No));

           
        return query;
    }

]]></Source>
			</Method>
