			<Method>
				<Name>mapEntityToDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// Maps the data entity to the data source.
    /// </summary>
    /// <param name = "_entityCtx">DataEntityRuntimeContext</param>
    /// <param name = "_dataSourceCtx">DataEntityDataSourceRuntimeContext</param>
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        super(_entityCtx, _dataSourceCtx);

        if (_dataSourceCtx.name() == dataEntityDataSourceStr(METCustomerMDFSetupDataEntity, METCustomerMDFItemTableUnionView))
        {
            METCustomerMDFItemTableUnionView customerMDFItemTableUnionView = _dataSourceCtx.getBuffer();
            MetCustomerMdfTable customerMdfTable = MetCustomerMdfTable::find(this.CustAccount, this.InventSiteId, this.InventLocationId);
            MetCustomerMdfSetupTable customerMdfSetupTable = MetCustomerMdfSetupTable::find(customerMdfTable.RecId, this.DeliveryChargeType, this.ItemScope);
            EcoResCategory customerMdfCategory = EcoResCategory::findCategoryByNameAndHierarchy(this.CategoryName, this.CategoryHierarchyName);

            if(customerMdfSetupTable.RecId && customerMdfCategory.RecId)
            {
                switch (customerMdfSetupTable.ItemScope)
                {
                    case METItemScope::ExplicitItemInclusion:
                        METCustomerMDFItemInclusionTable customerMDFItemInclusionTable = METCustomerMDFItemInclusionTable::find(customerMdfSetupTable.RecId, this.METItemTypes, customerMdfCategory.RecId);
                        if(customerMDFItemInclusionTable.RecId)
                        {
                            customerMDFItemInclusionTable.selectForUpdate(true);
                            customerMDFItemInclusionTable.Description = this.ItemDescription;
                            customerMDFItemInclusionTable.update();
                        }
                        else
                        {
                            customerMDFItemInclusionTable.clear();
                            customerMDFItemInclusionTable.RefRecId = customerMdfSetupTable.RecId;
                            customerMDFItemInclusionTable.METItemTypes = this.METItemTypes;
                            customerMDFItemInclusionTable.Category = customerMdfCategory.RecId;
                            customerMDFItemInclusionTable.Description = this.ItemDescription;
                            customerMDFItemInclusionTable.insert();
                        }
                        break;
                    case METItemScope::ItemsWithExclusions:
                        METCustomerMDFItemExclusionTable customerMDFItemExclusionTable = METCustomerMDFItemExclusionTable::find(customerMdfSetupTable.RecId, this.METItemTypes, customerMdfCategory.RecId);
                        if(customerMDFItemExclusionTable.RecId)
                        {
                            customerMDFItemExclusionTable.selectForUpdate(true);
                            customerMDFItemExclusionTable.Description = this.ItemDescription;
                            customerMDFItemExclusionTable.update();
                        }
                        else
                        {
                            customerMDFItemExclusionTable.clear();
                            customerMDFItemExclusionTable.RefRecId = customerMdfSetupTable.RecId;
                            customerMDFItemExclusionTable.METItemTypes = this.METItemTypes;
                            customerMDFItemExclusionTable.Category = customerMdfCategory.RecId;
                            customerMDFItemExclusionTable.Description = this.ItemDescription;
                            customerMDFItemExclusionTable.insert();
                        }
                        break;
                }
            }
        }
    }

]]></Source>
			</Method>
