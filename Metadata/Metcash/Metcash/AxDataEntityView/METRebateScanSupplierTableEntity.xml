				<Source><![CDATA[
    /// <summary>
    /// Method to skip records having validation errors
    /// </summary>
    /// <returns>True, if there are validation errors, else False</returns>
    public boolean validateWrite()
    {
        boolean ret = true;
            
        if (!this.ItemGroupId)
        {
            ret = checkFailed("Item Id does not belong to any Rebate item group. Import failed");
        }

        ret = ret && super();
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>defaultRow</Name>
				<Source><![CDATA[
    /// <summary>
    /// Method to assign field values based on other dependent fields
    /// </summary>
    public void defaultRow()
    {
        TAMRebateGroupLink  rebateGroupLink;
        InventTable         inventTable;
        super();
                select firstonly RebateGroupId from rebateGroupLink
                    join inventTable where rebateGroupLink.RefRecId == inventTable.RecId
                                        && rebateGroupLink.RefTableId == inventTable.TableId
                                        && rebateGroupLink.ModuleInventCustVend == ModuleInventCustVend::Invent
                                        && inventTable.ItemId == this.ItemId;
                this.ItemGroupId = rebateGroupLink.RebateGroupId;
    }

]]></Source>
