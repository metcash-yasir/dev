				<Name>postGetStagingData</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates the staging table after insert.
    /// </summary>
    /// <param name = "_dmfDefinitionGroupExecution">A data management framework definition group being executed.</param>
    /// <remarks>This method is called automatically by the data management framework.</remarks>
    public static void postGetStagingData(DMFDefinitionGroupExecution _dmfDefinitionGroupExecution)
    {
        METTAMRebateDealEntityTmp rebateDealEntityMap;
        METTAMRebateTableEntityTmp rebateTableEntityMap;
        METTAMRebateDealStaging staging;

        NumberSequenceReference sequenceReference = TAMRebateParameters::numRefRebateDealId();
        NumberSequenceTable numberSequence = sequenceReference.numberSequenceTable();

        if (numberSequence && !numberSequence.Blocked && !numberSequence.Manual)
        {
            rebateDealEntityMap = METTAMRebateDealEntity::generateDealIds(_dmfDefinitionGroupExecution, staging);

            update_recordset staging
                setting DealId = rebateDealEntityMap.DealId
                where staging.DefinitionGroup == _dmfDefinitionGroupExecution.DefinitionGroup
                    && staging.ExecutionId == _dmfDefinitionGroupExecution.ExecutionId
                    && staging.TransferStatus == DMFTransferStatus::NotStarted
                join DealId from rebateDealEntityMap
                    where staging.RebateCompanyId == rebateDealEntityMap.RebateCompanyId
                    &&    staging.METVendAccount == rebateDealEntityMap.METVendAccount
                    &&    staging.DealCurrencyCode == rebateDealEntityMap.DealCurrencyCode;
        }

        sequenceReference = TAMRebateParameters::numRefRebateId();
        numberSequence = sequenceReference.numberSequenceTable();

        if (numberSequence && !numberSequence.Blocked && !numberSequence.Manual)
        {
            rebateTableEntityMap = METTAMRebateDealEntity::generateRebateIds(_dmfDefinitionGroupExecution, staging);

            update_recordset staging
                setting RebateId = rebateTableEntityMap.RebateId
                where staging.DefinitionGroup == _dmfDefinitionGroupExecution.DefinitionGroup
                    && staging.ExecutionId == _dmfDefinitionGroupExecution.ExecutionId
                    && staging.TransferStatus == DMFTransferStatus::NotStarted
                join RebateId from rebateTableEntityMap
                    where staging.DealId == rebateTableEntityMap.DealId
                    &&    staging.Line8 == rebateTableEntityMap.ItemId
                    &&    staging.StateId == rebateTableEntityMap.StateId;
        }

    }

]]></Source>
