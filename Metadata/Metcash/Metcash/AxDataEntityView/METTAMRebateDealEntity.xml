			<Method>
				<Name>generateRebateIds</Name>
				<Source><![CDATA[
    /// <summary>
    /// Generate rebate Ids.
    /// </summary>
    /// <param name = "_dmfDefinitionGroupExecution">>A data management framework definition group being executed.</param>
    /// <param name = "_staging">The staging table for the rebate management deal.</param>
    /// <returns>Temporary table.</returns>
    public static METTAMRebateTableEntityTmp generateRebateIds(DMFDefinitionGroupExecution _dmfDefinitionGroupExecution, METTAMRebateDealStaging _staging)
    {
        ttsbegin;
        
        METTAMRebateTableEntityTmp rebateTableEntityMap;
        RecordInsertList rebateTableEntityMapList = new RecordInsertList(tableNum(METTAMRebateTableEntityTmp), true, true, true, false, false, rebateTableEntityMap);
    
        while select DealId, StateId, Line8 from _staging
                group by DealId, StateId, Line8
            where _staging.DefinitionGroup == _dmfDefinitionGroupExecution.DefinitionGroup
                && _staging.ExecutionId == _dmfDefinitionGroupExecution.ExecutionId
                && _staging.TransferStatus == DMFTransferStatus::NotStarted
        {
            rebateTableEntityMap.clear();
    
            rebateTableEntityMap.DealId = _staging.DealId;
            rebateTableEntityMap.StateId = _staging.StateId;
            rebateTableEntityMap.ItemId = _staging.Line8;
            rebateTableEntityMap.RebateId =  NumberSeq::newGetNum(TAMRebateParameters::numRefRebateId(), false).num();
    
            rebateTableEntityMapList.add(rebateTableEntityMap);
        }
    
        rebateTableEntityMapList.insertDatabase();
    
        ttscommit;

        return rebateTableEntityMap;
    }

]]></Source>
