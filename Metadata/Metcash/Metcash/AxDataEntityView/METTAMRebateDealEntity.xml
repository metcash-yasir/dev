			<Method>
				<Name>initQuery</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialises query.
    /// </summary>
    /// <param name = "_rebateTable">
    /// <c>TAMRebateTable</c>.
    /// </param>
    public void initQuery(TAMRebateTable _rebateTable)
    {
        QueryBuildDataSource qbds;
        Query query;
        
        _rebateTable.PackedQuery = TAMRebateTable::initialQuery(_rebateTable);
        query = new Query(_rebateTable.PackedQuery);

        qbds = query.dataSourceTable(tableNum(VendPackingSlipTrans));

        if (qbds && this.StateId)
        {
            SysQuery::findOrCreateRange(qbds, fieldNum(VendPackingSlipTrans, DestState)).value(queryvalue(this.StateId));
        }

        _rebateTable.PackedQuery = query.pack();
    }

]]></Source>
