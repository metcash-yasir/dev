			<Method>
				<Name>generateDealIds</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates the deal Ids.
    /// </summary>
    /// <param name = "_dmfDefinitionGroupExecution">A data management framework definition group being executed.</param>
    /// <param name = "_staging">The staging table for the rebate management deal.</param>
    /// <returns>Temporary table.</returns>
    public static METTAMRebateDealEntityTmp generateDealIds(DMFDefinitionGroupExecution _dmfDefinitionGroupExecution, METTAMRebateDealStaging _staging)
    {
        ttsbegin;
    
        METTAMRebateDealEntityTmp rebateDealEntityMap;
        RecordInsertList rebateDealEntityMapList = new RecordInsertList(tableNum(METTAMRebateDealEntityTmp), true, true, true, false, false, rebateDealEntityMap);
    
        while select RebateCompanyId, DealCurrencyCode, METVendAccount from _staging
                group by RebateCompanyId, DealCurrencyCode, METVendAccount
            where _staging.DefinitionGroup == _dmfDefinitionGroupExecution.DefinitionGroup
                && _staging.ExecutionId == _dmfDefinitionGroupExecution.ExecutionId
                && _staging.TransferStatus == DMFTransferStatus::NotStarted
        {
            rebateDealEntityMap.clear();
    
            rebateDealEntityMap.RebateCompanyId = _staging.RebateCompanyId;
            rebateDealEntityMap.DealCurrencyCode = _staging.DealCurrencyCode;
            rebateDealEntityMap.METVendAccount = _staging.METVendAccount;
            rebateDealEntityMap.DealId = NumberSeq::newGetNum(TAMRebateParameters::numRefRebateDealId(), false).num();
    
            rebateDealEntityMapList.add(rebateDealEntityMap);
        }
    
        rebateDealEntityMapList.insertDatabase();
    
        ttscommit;
    
        return rebateDealEntityMap;
    }

]]></Source>
