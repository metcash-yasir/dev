			<Method>
				<Name>getMaxRebateLineNum</Name>
				<Source><![CDATA[
    /// <summary>
    /// Gets max rebate line Num
    /// </summary>
    /// <param name = "_rebateId">Rebate Id.</param>
    /// <returns>Line number.</returns>
    public static LineNum getMaxRebateLineNum(TAMRebateId _rebateId)
    {
        return (select maxOf(LineNum) from TAMRebateDate
                where TAMRebateDate.RebateId == _rebateId).LineNum;
    }

]]></Source>
