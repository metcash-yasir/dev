			<Method>
				<Name>mapEntityToDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// Maps entity to data source.
    /// </summary>
    /// <param name = "_entityCtx">Entity runtime contect.</param>
    /// <param name = "_dataSourceCtx">Datasource run time context.</param>
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        TAMRebateDeal  rebateDeal;
        TAMRebateTable rebateTable;
        TAMRebateDate  rebateDate;
        TAMRebateLine  rebateLine;
        InventDim      inventDim;
        Common         record;

        super(_entityCtx, _dataSourceCtx);

        record = _dataSourceCtx.getBuffer();

        switch (record.TableId)
        {
            case rebateDeal.TableId:
                rebateDeal = TAMRebateDeal::findByName(this.DealId);

                if (!rebateDeal)
                {
                    buf2Buf(record, rebateDeal);

                    if (this.DealId)
                    {
                        rebateDeal.Deal = this.DealId;
                    }

                    rebateDeal.insert();
                    _dataSourceCtx.setDataSaved(true);
                }

                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::Update);
                _dataSourceCtx.setBuffer(rebateDeal);
                break;

            case rebateTable.TableId:
                rebateDeal = TAMRebateDeal::findByName(this.DealId);
                rebateTable = TAMRebateTable::find(this.RebateId);

                if (!rebateTable)
                {
                    buf2Buf(record, rebateTable);

                    if (this.RebateId)
                    {
                        rebateTable.RebateId = this.RebateId;
                    }

                    rebateTable.ModuleInventCustVend = rebateDeal.ModuleInventCustVend;
                    rebateTable.StatusId = rebateDeal.StatusId;
                    rebateTable.RebateType = rebateDeal.RebateType;
                    rebateTable.RebateCompanyId = rebateDeal.RebateCompanyId;
                    rebateTable.RebateDeal = rebateDeal.RecId;
                    rebateTable.METVendAccount = rebateDeal.METVendAccount;

                    changecompany (rebateTable.RebateCompanyId)
                    {
                        rebateTable.InventDimId = this.InventInventoryDimensionEntityFieldsMapping::resolveInventDimId();
                    }

                    if (this.PriceComponentCombinationName)
                    {
                        changecompany (rebateTable.RebateCompanyId)
                        {
                            var combination = GUPPriceComponentCodePriceAttributeGroupCombination::findByNameAndComponentTypeAndCodeName(this.PriceComponentCombinationName, GUPPriceComponent::RebateManagement, this.PriceComponentCodeName);
                            rebateTable.PriceComponentCombination = combination.RecId;
                            rebateTable.PricingRuleLine = GUPPricingRule::findOrCreatePricingRuleFromEntity(this, GUPPricingAttributeSourceLevel::Line, this.LineExclusionType, combination.LinePriceAttributeGroupName, this.LineExclusion);
                        }
                    }
                    else
                    {
                        rebateTable.PricingRuleHeader = 0;
                        rebateTable.PricingRuleLine = 0;
                    }
                    
                    this.initQuery(rebateTable);

                    rebateTable.insert();
                    _dataSourceCtx.setDataSaved(true);
                }
                
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::Update);
                _dataSourceCtx.setBuffer(rebateTable);
                break;
            
            case rebateDate.TableId:
                rebateTable = TAMRebateTable::find(this.RebateId);
 
                if (rebateTable)
                {
                    buf2Buf(record, rebateDate);

                    rebateDate.RebateId = rebateTable.RebateId;
                    rebateDate.LineNum = METTAMRebateDealEntity::getMaxRebateLineNum(this.RebateId) + 1;
                    
                    rebateDate.insert();
                    _dataSourceCtx.setDataSaved(true);
                }

                _dataSourceCtx.setBuffer(rebateDate);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::Update);
                break;

            case rebateLine.TableId:
                rebateTable = TAMRebateTable::find(this.RebateId);
                
                if (rebateTable)
                {
                    buf2Buf(record, rebateLine);

                    rebateLine.RefLineNum = METTAMRebateDealEntity::getMaxRebateLineNum(this.RebateId);
                    rebateLine.RebateId = rebateTable.RebateId;

                    rebateLine.insert();
                    _dataSourceCtx.setDataSaved(true);
                }
                
                _dataSourceCtx.setBuffer(rebateLine);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::Update);
                break;

            case inventDim.TableId:
                changecompany (this.RebateCompanyId)
                {
                    inventDim = this.InventInventoryDimensionEntityFieldsMapping::resolveInventDim();
                }

                _dataSourceCtx.setBuffer(inventDim);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::Update);
                break;
        }

    }

]]></Source>
