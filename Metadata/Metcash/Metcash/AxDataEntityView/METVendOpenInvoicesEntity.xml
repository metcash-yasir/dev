]]></Declaration>
		<Methods>
			<Method>
				<Name>balanceInTransactionCur</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_6845_VendorOpenInvoices - KScerri - 18/05/2021
    /// Calculates balanceInTransaction field.
    /// </summary>
    /// <returns>balanceInTransaction</returns>
    public AmountCur balanceInTransactionCur()
    {
        Amountcur balanceInTransactionCur;

        balanceInTransactionCur = this.AmountCur - this.settleAmountCur;

        return balanceInTransactionCur;
    }

]]></Source>
			</Method>
			<Method>
				<Name>balanceInReportingCur</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_6845_VendorOpenInvoices - KScerri - 18/05/2021
    /// Calculates balanceInTransaction field.
    /// </summary>
    /// <returns>balanceInTransaction</returns>
    public AmountMSTSecondary balanceInReportingCur()
    {
        AmountMSTSecondary balanceInReportingCur;

        if (this.TransType == LedgerTransType::ExchAdjustment)
        {
            balanceInReportingCur = this.ReportingCurrencyAmount - this.SettleAmountReporting;
        }
        else
        {
            balanceInReportingCur = this.ReportingCurrencyAmount + this.ExchAdjustmentReporting - this.SettleAmountReporting;
        }

        return balanceInReportingCur;
    }

]]></Source>
			</Method>
			<Method>
				<Name>RemittanceAddress</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_6845_VendorOpenInvoices - KScerri - 24/05/2021
    /// Populate remittance address field
    /// </summary>
    public  RemittanceAddressing RemittanceAddress()
    {
        if (this.InternalClosed > DateTimeUtil::date(DateTimeUtil::minValue()))
        {
            return LogisticsPostalAddress::addressFromRecId(this.InternalRemittanceAddress);
        }

        return LogisticsLocationEntity::location2PostalAddress(this.RemittanceLocation).Address;
    }

]]></Source>
			</Method>
			<Method>
				<Name>RemittanceLocationDescription</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_6845_VendorOpenInvoices - KScerri - 24/05/2021
    /// Populate remittance description field
    /// </summary>
    public  Description RemittanceLocationDescription()
    {
        return LogisticsLocation::find(this.RemittanceLocation).Description;
    }

]]></Source>
			</Method>
			<Method>
				<Name>possibleCashDisc</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_6845_VendorOpenInvoices - KScerri - 24/05/2021
    /// populate discount granted
    /// </summary>
    public VendCashDiscAmount possibleCashDisc(VendTrans _vendTrans)
    {
        CustVendTransDetails custVendTransDetails;

        if (_vendTrans.TransDate)
            custVendTransDetails = new CustVendTransDetails(_vendTrans, _vendTrans.TransDate);

        return custVendTransDetails.possibleCashDisc();
    }

]]></Source>
			</Method>
			<Method>
				<Name>utilizedCashDisc</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_6845_VendorOpenInvoices - KScerri - 24/05/2021
    /// populate discount granted
    /// </summary>
    public DiscAmount utilizedCashDisc(VendTrans _vendTrans)
    {
        CustVendTransDetails custVendTransDetails;

        custVendTransDetails = new CustVendTransDetails(_vendTrans);

        if (_vendTrans)
        {
            custVendTransDetails.setCustVendTrans(_vendTrans);
        }

        return custVendTransDetails.utilizedCashDisc();
    }

]]></Source>
			</Method>
			<Method>
				<Name>accountingExchangeRate</Name>
				<Source><![CDATA[
    public ExchRate accountingExchangeRate()
    {
        ExchangeRateHelper exchangeRateHelper = ExchangeRateHelper::newCurrency(Ledger::primaryLedger(CompanyInfo::findDataArea(curext()).RecId), this.CurrencyCode);
        return exchangeRateHelper.displayStoredExchangeRate(this.ExchRate);
    }

]]></Source>
			</Method>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_6845_VendorOpenInvoices - KScerri - 18/05/2021
    /// To populate virtual fields.
    /// </summary>
    public void postLoad()
    {
        VendTrans vendTrans = VendTrans::find(this.VendTransRef);

        super();

        this.BalanceInTransctionCur = this.balanceInTransactionCur();
        this.BalanceInReportingCur  = this.balanceInReportingCur();
        this.RemittanceDescription  = this.RemittanceLocationDescription();
        this.RemittanceAddress      = this.RemittanceAddress();
        this.DiscountGranted        = this.possibleCashDisc(vendTrans);
        this.DiscountUsed           = this.utilizedCashDisc(vendTrans);
        this.ExchangeRate           = this.accountingExchangeRate();
    }

]]></Source>
			</Method>
		</Methods>
