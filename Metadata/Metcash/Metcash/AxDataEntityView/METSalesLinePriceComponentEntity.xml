		<Methods>
			<Method>
				<Name>priceComponent</Name>
				<Source><![CDATA[
    /// <summary>
    /// Generates SQL to retrieve the price component name based on the component code.
    /// </summary>
    /// <returns>Price component value</returns>
    public static server str priceComponent()
    {
        str componentField;
        str priceComponentSql;
        str enumName = enumStr(METPriceComponent);

        componentField = SysComputedColumn::returnField(
            viewStr(METSalesLinePriceComponentEntity),
            identifierStr(METSalesLinePriceComponent),
            fieldStr(METSalesLinePriceComponent, Component)
        );

        priceComponentSql = strFmt(
            "(select top 1 evt.NAME " +
                "from %1 mc " +
                "join ENUMVALUETABLE evt on evt.ENUMVALUE = mc.PriceComponent " +
                "join ENUMIDTABLE eit on eit.ID = evt.ENUMID and eit.NAME = '%2' " +
                "where mc.Component = %3)",
            tableStr(METComponentCode),
            enumName,
            componentField
        );

        return priceComponentSql;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
