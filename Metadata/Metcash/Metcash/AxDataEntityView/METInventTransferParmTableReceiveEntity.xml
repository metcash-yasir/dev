		<Methods>
			<Method>
				<Name>mapEntityToDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// Maps data source cursor.
    /// </summary>
    /// <param name = "_entityCtx">Data entity runtime context</param>
    /// <param name = "_dataSourceCtx">Data entity data source runtime context</param>
    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        this.skipDataSourceValidateField(fieldNum(METInventTransferParmTableReceiveEntity, ParmId), true);

        super(_entityCtx, _dataSourceCtx);

        switch (_entityCtx.getDatabaseOperation())
        {
            case DataEntityDatabaseOperation::Insert:
                switch (_dataSourceCtx.name())
                {
                    case dataEntityDataSourceStr(METInventTransferParmTableReceiveEntity, InventTransferParmTable):
                        this.mapInventTransferParmTable(_dataSourceCtx);
                        break;
                }
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>mapInventTransferParmTable</Name>
				<Source><![CDATA[
    /// <summary>
    /// Maps the data source cursor.
    /// </summary>
    /// <param name = "_dataSourceCtx">Data entity data source runtime context</param>
    protected void mapInventTransferParmTable(DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        InventTransferParmTable parmTable = _dataSourceCtx.getBuffer();
        
        if (!parmTable.ParmId)
        {
            parmTable.ParmId = RunBaseMultiParm::getSysParmId();
        }

        parmTable.UpdateType       = InventTransferUpdateType::Receive;
        parmTable.JobStatus        = ParmJobStatus::Waiting;
        parmTable.ShipUpdateQty    = InventTransferShipUpdateQty::ShipNow;
        // for partial shipping, InventTransferReceiveUpdateQty::Shipping will bring 1 line in InventTransferParmLine per sihpment causing the receipt to fail
        // use all instead, then update qty and delete lines that were not part of the line contract
        parmTable.ReceiveUpdateQty = InventTransferReceiveUpdateQty::All;
        parmTable.EditLines        = NoYes::Yes;
        parmTable.ExplodeLines     = NoYes::Yes;
        parmTable.METIsIntegration = NoYes::Yes;

        _dataSourceCtx.setBuffer(parmTable);
    }

]]></Source>
			</Method>
		</Methods>
