			<Method>
				<Name>createLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// Populates <c>METALMSupplierVolumetricRebateLine</c> table
    /// </summary>
    /// <param name = "_line"><c>METALMSupplierVolumetricRebateLine</c></param>
    /// <param name = "_entityCtx">The context of the entity.</param>
    /// <returns></returns>
    public METALMSupplierVolumetricRebateLine createLine(METALMSupplierVolumetricRebateLine _line,
                                                        DataEntityRuntimeContext            _entityCtx)
    {
        DataEntityDataSourceRuntimeContext headerContext =
                    _entityCtx.getRuntimeContextByName(dataEntityDataSourceStr(METALMSupplierVolumetricRebateEntity, METALMSupplierVolumetricRebateHeader));
        METALMSupplierVolumetricRebateHeader    header  = headerContext.getBuffer();
        _line.initFromALMSupplierVolumetricRebateHeader(header);
        _line.setDimensions();

        return _line;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findOrCreateHeader</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds or creates a <c>METALMSupplierVolumetricRebateHeader</c> record.
    /// </summary>
    /// <param name = "_journalEntityBase">The journal entity.</param>
    /// <returns>The <c>LedgerJournalTable</c> record.</returns>
    public static METALMSupplierVolumetricRebateHeader findOrCreateHeader(METALMSupplierVolumetricRebateStaging _staging)
    {
        METALMSupplierVolumetricRebateHeader    header = METALMSupplierVolumetricRebateHeader::find(_staging.Number);

        if (!header)
        {
            header.Number = NumberSeq::newGetNum(VendParameters::METnumRefALMSupplierVolumetricRebateNumber()).num();
            header.initValue();
            header.VendorAccount        = _staging.VendorAccount;
            header.CustomerAccount      = _staging.CustomerAccount;
            header.Reference            = _staging.Reference;
            header.InvoiceId            = _staging.InvoiceId;

            header.DocumentDate         = _staging.DocumentDate;
            header.setDimensions();
            header.insert();
        }
        return header;
    }

]]></Source>
