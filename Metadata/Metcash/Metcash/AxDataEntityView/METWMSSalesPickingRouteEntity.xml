		<Methods>
			<Method>
				<Name>confirmationDocumentReference</Name>
				<Source><![CDATA[
    /// <summary>
    /// get lastest sales confirmation number as reference
    /// </summary>
    /// <returns>sales confirmation number</returns>
    private static str confirmationDocumentReference()
    {
        SysDictTable custConfirmJourTable = new SysDictTable(tableNum(CustConfirmJour));

        str custConfirmJour = custConfirmJourTable.name(DbBackend::Sql);
        str confirmDate = custConfirmJourTable.fieldName(fieldNum(CustConfirmJour, ConfirmDate), DbBackend::Sql);
        str confirmDocNum = custConfirmJourTable.fieldName(fieldNum(CustConfirmJour, ConfirmDocNum), DbBackend::Sql);
        str salesId = custConfirmJourTable.fieldName(fieldNum(CustConfirmJour, SalesId), DbBackend::Sql);

        str salesIdValue = SysComputedColumn::returnField(tablestr(METWMSSalesPickingRouteEntity), dataEntityDataSourceStr(METWMSSalesPickingRouteEntity, SalesTable), fieldStr(SalesTable, SalesId));

        /*********************************************
        The following is an example of what the query string will look like
        SELECT TOP 1 CCJ.CONFIRMDOCNUM FROM CUSTCONFIRMJOUR CCJ
        WHERE CCJ.SALESID = SalesId 
        ORDER BY CCJ.CONFIRMDATE DESC
        *********************************************/

        return 'SELECT TOP 1 CCJ.' + confirmDocNum + ' FROM ' + custConfirmJour + ' CCJ' +
                ' WHERE CCJ.' + salesId + ' = ' + salesIdValue + 
                ' ORDER BY CCJ.' + confirmDate + ' DESC';
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
