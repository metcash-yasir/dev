		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// Populate values into Virtual fields on export
    /// </summary>
    public void postLoad()
    {
        CurrencyExchangeHelper currencyExchangeHelper;
        
        super();

        currencyExchangeHelper = CurrencyExchangeHelper::newExchangeDate(Ledger::primaryLedger(CompanyInfo::findDataArea(this.ProjPostedTransDataAreaId).RecId), this.ProjTransDate);

        this.TotalCostAmountMST = currencyExchangeHelper.calculateTransactionToAccounting(this.CurrencyIdCost, this.TotalCostAmountCur, true);
        this.TotalSalesAmountMST = currencyExchangeHelper.calculateTransactionToAccounting(this.CurrencyId, this.TotalSalesAmountCur, true);
    }

]]></Source>
			</Method>
		</Methods>
