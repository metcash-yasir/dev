		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// Populate virtual export fields in the wave company.
    /// Resolve source context in one query while retaining missing-record validation.
    /// </summary>
    public void postLoad()
    {
        super();
        this.SequenceNumber = 0;
        this.ToteType = '';
        this.METItemType = '';
        this.METSlotLoc1Area = '';
        this.METPickedQuantity = 0;
        if (!this.LegalEntityId || !this.WaveLineRecordId)
        {
            throw error("Missing legal entity or wave-line record ID.");
        }
        changecompany(this.LegalEntityId)
        {
            METWaveLine waveLine;
            SalesLine salesLine;
            SalesTable salesTable;
            container sequenceResult;
            select firstonly RecId, Type from waveLine
                where waveLine.RecId == this.WaveLineRecordId
                outer join RecId, SalesId, ItemId, InventDimId, InventTransId, SalesUnit from salesLine
                    where salesLine.RecId == waveLine.DocNumRefRecId
                outer join RecId, CustAccount, InventLocationId from salesTable
                    where salesTable.SalesId == salesLine.SalesId;
            if (!waveLine.RecId || waveLine.Type != METType::SalesOrder)
            {
                throw error("The source sales-order wave line no longer exists.");
            }
            if (!salesLine.RecId)
            {
                throw error("The source sales line no longer exists.");
            }
            if (!salesTable.RecId || !salesTable.CustAccount || !salesTable.InventLocationId)
            {
                throw error("Missing sales header, ordering customer, or shipping warehouse.");
            }
            sequenceResult = METWaveDetailLookup::sequenceNumber(
                salesTable.InventLocationId, salesTable.CustAccount);
            // Preserve existing behavior: missing sequence is represented as zero.
            this.SequenceNumber = conPeek(sequenceResult, 2);
            this.ToteType = METWaveDetailLookup::toteType(this.LegalEntityId, salesTable.CustAccount);
            this.METItemType = METWaveDetailLookup::itemType(
                salesLine.ItemId,
                InventDim::find(salesLine.InventDimId).InventSiteId);
            this.METSlotLoc1Area = METWaveDetailLookup::slotLocationArea(
                salesLine.ItemId, salesTable.InventLocationId);
            this.METPickedQuantity = METWaveDetailLookup::pickedQuantity(salesLine);
        }
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
