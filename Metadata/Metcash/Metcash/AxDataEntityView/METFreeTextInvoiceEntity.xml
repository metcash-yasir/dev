			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_24809 Returns Claims
    /// </summary>
    public void postLoad()
    {
        super();
        changecompany(this.DataAreaId)
        {
            ReturnReasonCode    metReturnReasonCodeStd = ReturnReasonCode::find(this.ClaimReason);
                
            CustFreeInvoiceCalcTotals metCustFreeInvoiceCalcTotalsStd = new CustFreeInvoiceCalcTotals(CustInvoiceTable::findRecId(this.RecId));
            metCustFreeInvoiceCalcTotalsStd.calc();

            this.MainAccountDisplayValue = metReturnReasonCodeStd.METMainAccountNum;
            this.InvoiceAmount           = metCustFreeInvoiceCalcTotalsStd.custFreeInvoiceBalance();
            this.SumTax                  = metCustFreeInvoiceCalcTotalsStd.custFreeInvoiceTaxTotal();

        }
        
    }

]]></Source>
