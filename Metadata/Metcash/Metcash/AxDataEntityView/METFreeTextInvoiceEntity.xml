			<Method>
				<Name>setDefaultValues</Name>
				<Source><![CDATA[
    private void setDefaultValues()
    {
        CustTable custTable;
        DirPartyTable party;
        ReturnReasonCode returnReason = ReturnReasonCode::find(this.ClaimReason);

        select firstonly CustGroup from custTable
            join LanguageId from party 
            where party.RecId == custTable.Party
            && custTable.AccountNum == this.CustomerAccount;

        this.LanguageId = party.LanguageId;
        this.CustGroup = custTable.CustGroup;
        this.MainAccountDisplayValue = returnReason.METMainAccountNum;

    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    /// Overridding insert method to set default values
    /// </summary>
    public void insert()
    {
        this.setDefaultValues();

        super();
    }

]]></Source>
