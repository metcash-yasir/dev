		<Methods>
			<Method>
				<Name>createFreeTextInvoice</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_24809 Returns Claims
    /// Service method to get free text invoice header created
    /// </summary>
    /// <param name="dataAreaId"> Get company id</param>
    /// <param name="customerAccountNumber"> Get customer account number</param>
    /// <param name="metClaimOriginalInvoice"> Get claim original invoice</param>
    /// <param name="metClaimReasonCode"> Get claim reason code"</param>
    /// <param name="metParentClaimId"> Get parent claim Id"</param>
    [
        SysODataActionAttribute('CreateFreeTextInvoice',false),
        SysODataCollectionAttribute("dataAreaId", Types::String),
        SysODataCollectionAttribute("customerAccountNumber", Types::String),
        SysODataCollectionAttribute("metClaimOriginalInvoice", Types::String),
        SysODataCollectionAttribute("metClaimReasonCode", Types::String),
        SysODataCollectionAttribute("metParentClaimId ", Types::String),
        SysODataCollectionAttribute("return", Types::Record, 'METFreeTextInvoiceEntity')
        
    ]
    public static List createFreeTextInvoice (DataAreaId dataAreaId,
                                              CustAccount customerAccountNumber,
                                              METClaimOriginalInvoice metClaimOriginalInvoice,
                                              METClaimReason metClaimReasonCode,
                                              METParentClaimId metParentClaimId
                                            )
    {
        CustInvoiceTable            metcustInvoiceTableStd;
        METFreeTextInvoiceEntity    metFreeTextInvoiceEntity;
        List                        metFreeTextInvoiceEntityList = new List(Types::Record);
        changecompany(dataAreaId)
        {
            ReturnReasonCode    metReturnReasonCodeStd = ReturnReasonCode::find(metClaimReasonCode);
            CustTable           metCustTableStd        = CustTable::find(customerAccountNumber);
            if(!metCustTableStd)
            {
                throw error('@MET:InvalidCustomer');
            }
            if(!metReturnReasonCodeStd)
            {                
                throw error('@MET:InvalidReasonCode');
            }  
            NumberSequenceReference metnumberSequenceReferenceStd = NumberSeqReference::findReference(extendedTypeNum(METClaimId));

            ttsBegin;             
            metcustInvoiceTableStd.initFromCustTable(metCustTableStd);
            metcustInvoiceTableStd.METClaimOriginalInvoice  = metClaimOriginalInvoice;
            metcustInvoiceTableStd.METClaimReason           = metClaimReasonCode;
            metcustInvoiceTableStd.METParentClaimId         = metParentClaimId; 
            metcustInvoiceTableStd.METClaimId               = NumberSeq::newGetNum(metnumberSequenceReferenceStd).num();
            metcustInvoiceTableStd.insert();           
            ttsCommit;          
          
            select firstonly metFreeTextInvoiceEntity
                where metFreeTextInvoiceEntity.ClaimId         == metcustInvoiceTableStd.METClaimId;      
            metFreeTextInvoiceEntity.MainAccountDisplayValue = metReturnReasonCodeStd.METMainAccountNum;
            metFreeTextInvoiceEntityList.addEnd(metFreeTextInvoiceEntity);
        }
        return metFreeTextInvoiceEntityList;
    }

]]></Source>
			</Method>
			<Method>
				<Name>generateFreeTextInvoiceNumber</Name>
				<Source><![CDATA[
    /// <summary>
    /// Generates Free text number which is unique for all invoices being exported or imported in scope of each Partition and DataAreaId.
    /// </summary>
    /// <returns>
    /// If export of posted invoices is done then it returns just the invoice number itself.
    /// Otherwise sets it to be "Not posted 1", "Not posted 2" and etc.
    /// </returns>
    public static str generateFreeTextInvoiceNumber()
    {
        str sql = 'IIF(';
    
        sql += SysComputedColumn::returnField(tablestr(FreeTextInvoiceEntity), dataEntityDataSourceStr(FreeTextInvoiceEntity, CustInvoiceTable), fieldstr(FreeTextInvoiceEntity, InvoiceId));
    
        sql += '=\'\',';
        sql += 'CONCAT(\'';
        sql += "@SYS11670";
        sql += ' \',CONVERT(nvarchar(10), DENSE_RANK() OVER (PARTITION BY ';
        sql += SysComputedColumn::returnField(tablestr(FreeTextInvoiceEntity), dataEntityDataSourceStr(FreeTextInvoiceEntity, CustInvoiceTable), fieldstr(FreeTextInvoiceEntity, Partition));
        sql += ',';
        sql += SysComputedColumn::returnField(tablestr(FreeTextInvoiceEntity), dataEntityDataSourceStr(FreeTextInvoiceEntity, CustInvoiceTable), fieldstr(FreeTextInvoiceEntity, DataAreaId));
        sql += ',';
        sql += SysComputedColumn::returnField(tablestr(FreeTextInvoiceEntity), dataEntityDataSourceStr(FreeTextInvoiceEntity, CustInvoiceTable), fieldstr(FreeTextInvoiceEntity, InvoiceId));
        sql += ' ORDER BY ';
        sql += SysComputedColumn::returnField(tablestr(FreeTextInvoiceEntity), dataEntityDataSourceStr(FreeTextInvoiceEntity, CustInvoiceTable), fieldstr(FreeTextInvoiceEntity, RecId));
        sql += '),1)),';
        sql += SysComputedColumn::returnField(tablestr(FreeTextInvoiceEntity), dataEntityDataSourceStr(FreeTextInvoiceEntity, CustInvoiceTable), fieldstr(FreeTextInvoiceEntity, InvoiceId));
        sql += ')';
    
        return sql;
    }

]]></Source>
