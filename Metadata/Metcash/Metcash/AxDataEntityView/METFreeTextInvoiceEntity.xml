			<Method>
				<Name>findOrCreateInvoice</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find a free text invoice based on parent claim id, if not found then create a new one
    /// </summary>
    /// <param name = "_parentClaimId">Parent claim Id</param>
    /// <param name = "_customerAccountNumber">Customer account number to be used to create invoice header</param>
    /// <param name = "_metClaimOriginalInvoice">MET Claim original invoice number set by Sorted</param>
    /// <param name = "_metClaimReason">MET Claim reason code used to find the main account that is used in the invoice line</param>
    /// <param name = "_metReturnStatus">Return status of the invoice set by Sorted</param>
    /// <returns>Record buffer <t>CustInvoiceTable</t></returns>
    public static CustInvoiceTable findOrCreateInvoice(
        METParentClaimId _parentClaimId, 
        CustAccount _customerAccountNumber, 
        METClaimOriginalInvoice _metClaimOriginalInvoice, 
        METClaimReason _metClaimReason,
        str _metReturnStatus)
    {
        CustInvoiceTable metcustInvoiceTableStd;

        select firstonly metcustInvoiceTableStd
            where metcustInvoiceTableStd.MetParentClaimId == _parentClaimId;

        if(!metcustInvoiceTableStd)
        {
            METReturnStatus metReturnStatusEDT;
            NumberSequenceReference metnumberSequenceReferenceStd = NumberSeqReference::findReference(extendedTypeNum(METClaimId));
            CustTable metCustTableStd = CustTable::find(_customerAccountNumber);

            metcustInvoiceTableStd.clear();
            metcustInvoiceTableStd.initFromCustTable(metCustTableStd);

            metcustInvoiceTableStd.METClaimOriginalInvoice  = _metClaimOriginalInvoice;
            metcustInvoiceTableStd.METClaimReason           = _metClaimReason;
            metcustInvoiceTableStd.METParentClaimId         = _parentClaimId;
            metcustInvoiceTableStd.METClaimId               = NumberSeq::newGetNum(metnumberSequenceReferenceStd).num();
            metcustInvoiceTableStd.METReturnStatus          = str2Enum(metReturnStatusEDT, _metReturnStatus);
            metcustInvoiceTableStd.InvoiceDate = today();
            metcustInvoiceTableStd.CurrencyCode = METConstants::currencyCodeAUD;
            metcustInvoiceTableStd.insert();
        }

        return metcustInvoiceTableStd;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createFreeTextInvoice</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_24809 Returns Claims
    /// Service method to get free text invoice header created
    /// </summary>
    /// <param name="dataAreaId"> Get company id</param>
    /// <param name="customerAccountNumber"> Get customer account number</param>
    /// <param name="metClaimOriginalInvoice"> Get claim original invoice</param>
    /// <param name="metClaimReasonCode"> Get claim reason code"</param>
    /// <param name="metParentClaimId"> Get parent claim Id"</param>
    /// <parm name="quantity">Invoice line quantity</parm>
    /// <parm name="unitPrice">Invoice line unit price</parm>
    /// <parm name="amountCur">Invoice line amount used if the quantity and unit price is not set</parm>
    /// <parm name="lineNum">Invoice line number that is used to identify a specific line</parm>
    /// <param name="metReturnStatus"> Get return status"</param>
    [
        SysODataActionAttribute('CreateFreeTextInvoice',false),
        SysODataCollectionAttribute("dataAreaId", Types::String),
        SysODataCollectionAttribute("customerAccountNumber", Types::String),
        SysODataCollectionAttribute("metClaimOriginalInvoice", Types::String),
        SysODataCollectionAttribute("metClaimReasonCode", Types::String),
        SysODataCollectionAttribute("metParentClaimId ", Types::String),
        SysODataCollectionAttribute("Quantity", Types::Real),
        SysODataCollectionAttribute("UnitPrice", Types::Real),
        SysODataCollectionAttribute("AmountCur", Types::Real),
        SysODataCollectionAttribute("LineNum", Types::Real),
        SysODataCollectionAttribute("MetReturnStatus", Types::String),
        SysODataCollectionAttribute("return", Types::Record, 'METFreeTextInvoiceEntity')

    ]
    public static List createFreeTextInvoice (DataAreaId dataAreaId,
                                              CustAccount customerAccountNumber,
                                              METClaimOriginalInvoice metClaimOriginalInvoice,
                                              METClaimReason metClaimReasonCode,
                                              METParentClaimId metParentClaimId,
                                              Qty quantity,
                                              UnitPrice unitPrice,
                                              AmountCur amountCur,
                                              LineNum lineNum,
                                              string20 metReturnStatus)
    {
        
        CustInvoiceTable metcustInvoiceTableStd;
        CustInvoiceLine metCustInvoiceLineStd;

        METFreeTextInvoiceEntity    metFreeTextInvoiceEntity;
        ReturnReasonCode metReturnReasonCodeStd;

        changecompany(dataAreaId)
        {
            metReturnReasonCodeStd = ReturnReasonCode::find(metClaimReasonCode);
            CustTable metCustTableStd = CustTable::find(customerAccountNumber);
            
            if(!metCustTableStd)
            {
                throw error('@MET:InvalidCustomer');
            }

            if(!metReturnReasonCodeStd)
            {
                throw error('@MET:InvalidReasonCode');
            }
            else
            {
                if(metReturnReasonCodeStd.METMainAccountNum == '')
                {
                    throw error(strFmt("@MET:FTIMainAccountNotAttachedToReasonCode", metClaimReasonCode));
                }
            }
            ttsBegin;
            metcustInvoiceTableStd = METFreeTextInvoiceEntity::findOrCreateInvoice(metParentClaimId, customerAccountNumber, metClaimOriginalInvoice, metClaimReasonCode, metReturnStatus);
            
            if(metcustInvoiceTableStd)
            {
                CustInvoiceLine invLineCheck;

                select firstonly RecId 
                    from invLineCheck
                    where invLineCheck.ParentRecId == metcustInvoiceTableStd.RecId
                    && invLineCheck.LineNum == lineNum;

                if(invLineCheck.RecId == 0)
                {
                    metCustInvoiceLineStd.clear();
                    metCustInvoiceLineStd.initFromCustInvoiceTable(metcustInvoiceTableStd);
                    metCustInvoiceLineStd.ParentRecId = metcustInvoiceTableStd.RecId;
                    metCustInvoiceLineStd.LineNum = lineNum;

                    if(amountCur)
                    {
                        metCustInvoiceLineStd.AmountCur = amountCur;
                    }
                    else
                    {
                        metCustInvoiceLineStd.Quantity = quantity;
                        metCustInvoiceLineStd.UnitPrice = unitPrice;
                        metCustInvoiceLineStd.calcLineAmount();
                    }
                    metCustInvoiceLineStd.LedgerDimension = LedgerDefaultAccountHelper::getDefaultAccountFromMainAccountId(metReturnReasonCodeStd.METMainAccountNum);

                    metCustInvoiceLineStd.insert();
                }
            }

            ttsCommit;
        }

        return METFreeTextInvoiceEntity::getReturnList(metParentClaimId);
    }

]]></Source>
			</Method>
			<Method>
				<Name>getReturnList</Name>
				<Source><![CDATA[
    public static List getReturnList(METParentClaimId _parentClaimId)
    {
        METFreeTextInvoiceEntity freeTextInvoice;
        List metFreeTextInvoiceEntityList = new List(Types::Record);
        
        while select freeTextInvoice
            where freeTextInvoice.ParentClaimId == _parentClaimId
        {
            metFreeTextInvoiceEntityList.addEnd(freeTextInvoice);
        }

        return metFreeTextInvoiceEntityList;
    }

]]></Source>
