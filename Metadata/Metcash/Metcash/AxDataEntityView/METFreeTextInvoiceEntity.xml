			<Method>
				<Name>updateFTIReturnReasonCodeReturnStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_24809 Returns Claims
    /// Service method to get reason code and return status updated
    /// </summary>
    /// <param name="dataAreaId"> Get company id</param>
    /// <param name="metClaimId"> Get claim id</param>
    /// <param name="metReturnReasonCode"> Get return reason code</param>
    /// <param name="metReturnStatus"> Get return status"</param>
    
    [
        SysODataActionAttribute('UpdateFTIReturnReasonCodeReturnStatus',false),
        SysODataCollectionAttribute("dataAreaId", Types::String),
        SysODataCollectionAttribute("metClaimId", Types::String),
        SysODataCollectionAttribute("metReturnReasonCode", Types::String),
        SysODataCollectionAttribute("metReturnStatus", Types::String)
        
    ]
    public static void updateFTIReturnReasonCodeReturnStatus (DataAreaId dataAreaId,
                                              METClaimId metClaimId,
                                              METReturnReasonCode metReturnReasonCode,
                                              string20 metReturnStatus
                                            )
    {
        
        changecompany(dataAreaId)
        {       
            
            CustInvoiceTable    metcustInvoiceTableStd = CustInvoiceTable::findMETClaimId(metClaimId);
            METReturnStatus     metReturnStatusEDT;
            if(metcustInvoiceTableStd)
            {               
                ttsBegin;
                metcustInvoiceTableStd.selectForUpdate(true);
                metcustInvoiceTableStd.METReturnReasonCode  = metReturnReasonCode;
                metcustInvoiceTableStd.METReturnStatus      = str2Enum(metReturnStatusEDT, metReturnStatus);
                metcustInvoiceTableStd.update();
                
                ttsCommit;
            }            
        }        
    }

]]></Source>
