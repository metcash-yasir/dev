    public void postLoad()
    {
        super();
        ReturnReasonCode    metReturnReasonCodeStd = ReturnReasonCode::find(this.ClaimReason);
        this.MainAccountDisplayValue = metReturnReasonCodeStd.METMainAccountNum;
    }

]]></Source>
