		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// Map data fields to virtual fields
    /// </summary>
    public void postLoad()
    {
        changecompany(this.DataAreaId)
        {
            TaxTable taxTable;
            TaxOnItem taxOnItem;
            TaxItemGroupHeading taxItemGroupHeading;

            select firstonly TaxCode from taxTable
                where taxTable.TaxCode == METConstants::taxGroupGST
                join taxOnItem
                    where taxOnItem.TaxCode == taxTable.TaxCode
                exists join taxItemGroupHeading
                    where taxItemGroupHeading.TaxItemGroup == taxOnItem.TaxItemGroup
                    && taxItemGroupHeading.TaxItemGroup == this.SalesTaxItemGroupCode;
            
            if (taxTable.TaxCode)
            {
                this.TaxRate = TaxData::percent(taxTable.TaxCode, this.AccountingDate, 0);
            }
        }
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
