}
]]></Declaration>
		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializing the values into the data entity for the export purpose
    /// </summary>
    public void postLoad()
    {
        super();

        // Loading the data entity with the values from the company of the record
        changecompany(this.DataAreaId)
        {
            #Define.SalesUnitEA('EA')
            #Define.SalesUnitKG('KG')
            #Define.SalesUnitCS('CS')

            EcoResProductTranslation ecoResProductTranslation;
            InventTable inventTable;
            EcoResProduct ecoresProduct;
        
            select firstonly Name from ecoResProductTranslation
            join PdsCWProduct from ecoresProduct
            where ecoResProductTranslation.Product == ecoresProduct.RecId
            exists join inventTable
            where inventTable.Product == ecoresProduct.RecId
            && inventTable.ItemId == this.ItemId;

            this.ProductName = ecoResProductTranslation.Name;

            this.IsCatchWeightProduct = ecoresProduct.PdsCWProduct;

            this.Price = decRound(this.Price, 2);

            UnitOfMeasureConversion unitOfMeasureConversion = UnitOfMeasureConversion::findByConversion(
                            UnitOfMeasure::findBySymbol(#SalesUnitEA).RecId,
                            UnitOfMeasure::findBySymbol(#SalesUnitKG).RecId,
                            EcoResProduct::findByProductNumber(this.ItemId).RecId);

            this.Factor = decRound((unitOfMeasureConversion.Factor ? unitOfMeasureConversion.Factor : 0.00), 2);

            METExciseSiteDutySetup siteDutySetup;
            InventLocation inventLocation = InventLocation::find(this.InventLocationId);

            select firstonly ExcisePerCase from siteDutySetup
            where siteDutySetup.SiteId == inventLocation.InventSiteId
            && siteDutySetup.ItemId == this.ItemId;

            this.ExcisePerCase = decRound(siteDutySetup.ExcisePerCase, 2);

            InventItemSalesSetup inventItemSalesSetup;
            InventDim inventDim;

            select firstonly METSalesUnit, METAltSalesUnit from inventItemSalesSetup
            where inventItemSalesSetup.ItemId == this.ItemId
            exists join inventDim
            where inventItemSalesSetup.InventDimIdDefault == inventDim.inventDimId
            && inventDim.InventLocationId == this.InventLocationId;

            unitOfMeasureConversion = UnitOfMeasureConversion::findByConversion(
                            UnitOfMeasure::findBySymbol(inventItemSalesSetup.METSalesUnit).RecId,
                            UnitOfMeasure::findBySymbol(#SalesUnitEA).RecId,
                            EcoResProduct::findByProductNumber(this.ItemId).RecId);

            if (this.IsCatchWeightProduct)
            {
                this.AltSalesUnit = #SalesUnitKG;
            }
            else
            {
                if (inventItemSalesSetup.METAltSalesUnit)
                {
                    this.AltSalesUnit = #SalesUnitEA;
                }
                else
                {
                    this.AltSalesUnit = #SalesUnitCS;
                }
            }

            if (inventItemSalesSetup.METSalesUnit == #SalesUnitEA)
            {
                this.CaseQty = 1;
            }
            else
            {
                this.CaseQty = decRound(unitOfMeasureConversion.Factor, 2);
            }
        }
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
