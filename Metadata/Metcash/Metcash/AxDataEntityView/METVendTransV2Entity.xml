		<Methods>
			<Method>
				<Name>dueInvoiceDt</Name>
				<Source><![CDATA[
    public date dueInvoiceDt(Voucher voucher,DataAreaId dataAreaId,VendTransRefRecId vendTransId)
    {
        DueDate             dueDt;
        LedgerJournalTrans  ledgerJournalTrans;
        
        select Voucher,Due from ledgerJournalTrans
            where ledgerJournalTrans.Voucher == voucher
            && ledgerJournalTrans.VendTransId == vendTransId
            && ledgerJournalTrans.DataAreaId == dataAreaId;

        dueDt = ledgerJournalTrans.Due;

        return dueDt;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getDueDt</Name>
				<Source><![CDATA[
    public static str getDueDt()
    {
        DataEntityName dataEntityName = tableStr(METVendTransV2Entity);
        str sqlQry = strFmt(@"select Due FROM LedgerJournalTrans 
                             where Voucher = %1 
                             AND VendTransId = %2
                             AND DATAAREAID = %3"
                        ,
             SysComputedColumn::returnField(dataEntityName,identifierstr(VendTrans),fieldStr(VendTrans,Voucher)),
             SysComputedColumn::returnField(dataEntityName,identifierstr(VendTrans),fieldStr(VendTrans,RecId)),
             SysComputedColumn::returnField(dataEntityName,identifierstr(VendTrans),fieldStr(VendTrans,DataAreaId))
            );

        return sqlQry;
    }

]]></Source>
			</Method>
		</Methods>
