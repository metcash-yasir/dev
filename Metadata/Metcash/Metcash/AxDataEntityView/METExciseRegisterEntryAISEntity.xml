    public void mapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        super(_entityCtx, _dataSourceCtx);

        if (_dataSourceCtx.name() == dataEntityDataSourceStr(METExciseRegisterEntryAISEntity, METExciseRegisterEntryAIS))
        {
            METExciseRegisterEntryAIS exciseRegisterEntryAIs = _dataSourceCtx.getBuffer();
            PurchTable purchTable = PurchTable::find(exciseRegisterEntryAIs.OrderNumber);
            InventTransferTable inventTransferTable;

            if (purchTable)
            {
                exciseRegisterEntryAIs.OriginType = InventTransType::Purch;
            }
            else
            {
                inventTransferTable = InventTransferTable::find(exciseRegisterEntryAIs.OrderNumber);

                if (inventTransferTable)
                {
                    exciseRegisterEntryAIs.OriginType = InventTransType::TransferOrderReceive;
                }
            }
        }
    }

]]></Source>
