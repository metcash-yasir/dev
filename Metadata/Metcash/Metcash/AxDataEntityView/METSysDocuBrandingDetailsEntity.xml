			<Method>
				<Name>setLogisticsLocationRecId</Name>
				<Source><![CDATA[
    private void setLogisticsLocationRecId(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        if(_dataSourceCtx.name() == dataEntityDataSourceStr(METSysDocuBrandingDetailsEntity, SysDocuBrandDetails))
        {
            LogisticsLocationRecId locationRecId = LogisticsPostalAddressBaseEntity::saveAddress(_entityCtx,
                dataEntityDataSourceStr(METSysDocuBrandingDetailsEntity,LogisticsPostalAddressBaseEntity));

            SysDocuBrandDetails docuBrandDetails    = _dataSourceCtx.getBuffer();

            docuBrandDetails.LogisticsLocationRecId = locationRecId;
        }
        else
        {
            this.doNotUpdateDataSource(_entityCtx, dataEntityDataSourceStr(METSysDocuBrandingDetailsEntity, LogisticsPostalAddressBaseEntity));
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>doNotUpdateDataSource</Name>
				<Source><![CDATA[
    private void doNotUpdateDataSource(DataEntityRuntimeContext _entityCtx, str _addressDataSourceName)
    {
        DataEntityDataSourceRuntimeContext addressDataSourceContext = _entityCtx.getRuntimeContextByName(_addressDataSourceName);
        addressDataSourceContext.setDataSaved(true);
        addressDataSourceContext.setDatabaseOperation(DataEntityDatabaseOperation::None);

    }

]]></Source>
			</Method>
