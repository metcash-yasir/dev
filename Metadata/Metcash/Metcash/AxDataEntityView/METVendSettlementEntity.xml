		<Methods>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void postLoad()
    {
        LedgerJournalTrans  ledgerJournalTrans;  
        LedgerJournalTable  ledgerJournalTable;
 
        super();

        
        this.VendorOrganizationName = VendTable::find(this.OffsetAccountNum).name();

        select DocumentNum, JournalNum, PaymentNotes, AmountCurCredit, AmountCurDebit from ledgerJournalTrans
            where ledgerJournalTrans.VendTransId == this.OffsetRecId
            && ledgerJournalTrans.Company == this.OffsetCompany
        join JournalName 
            from ledgerJournalTable 
            where LedgerJournalTable.JournalNum == ledgerJournalTrans.JournalNum;

        this.RelatedDocument            = ledgerJournalTrans.DocumentNum;
        this.RelatedPaymentNotes        = ledgerJournalTrans.PaymentNotes;
        this.RelatedJournalName         = ledgerJournalTable.JournalName;
        this.RelatedJournalBatchNumber  = ledgerJournalTrans.JournalNum;
        this.RelatedJournalLineAmount   = ledgerJournalTrans.amount();
        if(this.TransactionType == LedgerTransType::Vend)
        {
            this.RelatedJournalLineAmount   = this.RelatedJournalLineAmount * -1;
        }

    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
