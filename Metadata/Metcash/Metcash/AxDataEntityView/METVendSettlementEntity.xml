				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void postLoad()
    {
        LedgerJournalTrans  journalTrans;  
 
        super();
        this.InvoiceAmountMST = -this.InvoiceAmountMST;
        this.VendorOrganizationName = VendTable::find(this.OffsetAccountNum).name();

        select DocumentNum, PaymentNotes from journalTrans
            where journalTrans.VendTransId == this.OffsetRecId
            && journalTrans.Company == this.OffsetCompany;

        this.Document = journalTrans.DocumentNum;
        this.PaymentNotes = journalTrans.PaymentNotes;

    }

]]></Source>
