		<Methods>
			<Method>
				<Name>initializeAttribueDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialize attribue data source
    /// </summary>
    /// <param name = "_entityCtx"> record of entity</param>
    /// <param name = "_dataSourceCtx"> datasource instance </param>
    public static void initializeAttribueDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        METAttributeIdentifiersEntity attributeIdentifiersEntity = _entityCtx.getEntityRecord();

        EcoResAttribute attribute;
        EcoResAttributeType attributeType;
        /*
         This logic retrieves the first available record from the EcoresAttribute table.
         Since the table does not have a unique index other than the surrogate key,
         this approach is required to support insert logic in the data entity.
         It is assumed that duplicate attribute names will not be maintained in this table for Attribute identifiers.
        */
        select firstonly forupdate attribute where attribute.Name == attributeIdentifiersEntity.AttributeName
            join attributeType
                where attributeType.RecId == attribute.AttributeType
                   && attributeType.Name == attributeIdentifiersEntity.AttributeTypeName;

        if (attribute)
        {
            _dataSourceCtx.setBuffer(attribute);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>initializeEntityDataSource</Name>
				<Source><![CDATA[
    /// <summary>
    /// set datasource instance
    /// </summary>
    /// <param name = "_entityCtx"> record of entity</param>
    /// <param name = "_dataSourceCtx"> datasource instance </param>
    public void initializeEntityDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        super(_entityCtx, _dataSourceCtx);

        if (_dataSourceCtx.name() == dataEntityDataSourceStr(METAttributeIdentifiersEntity, EcoResAttribute))
        {
            // Takes care of maintaining the reference to existing parties if this record provides a party number.
            METAttributeIdentifiersEntity::initializeAttribueDataSource(_entityCtx, _dataSourceCtx);
        }
    }

]]></Source>
			</Method>
		</Methods>
