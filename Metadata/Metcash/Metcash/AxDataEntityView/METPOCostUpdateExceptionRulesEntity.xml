				<Source><![CDATA[
    /// <summary>
    /// The postLoad method of the entity
    /// </summary>
    public void postLoad()
    {
        EcoResCategory ecoResCategory;
        EcoResCategoryHierarchy ecoResCategoryHierarchy;

        super();

        ecoResCategory = EcoResCategory::find(this.Category);
        ecoResCategoryHierarchy = EcoResCategoryHierarchy::find(this.CategoryHierarchy);

        this.CategoryName = ecoResCategory.Name;
        this.CategoryHierarchyName = ecoResCategoryHierarchy.Name;
    }

]]></Source>
			</Method>
			<Method>
				<Name>defaultRow</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_12065_RestrictCostchangesOnPOs on 16 Feb 2022 by chaminda
    /// insert category and category Hierarchy records
    /// </summary>
    public void defaultRow()
    {
        super();
        EcoResCategoryHierarchy ecoResCategoryHierarchy             = EcoResCategoryHierarchy::findByName(this.CategoryHierarchyName);
        if(!ecoResCategoryHierarchy)
        {
            warning("@MET:NoCategoryHierachyFoundWithThisName");
        }
        
        EcoResCategory ecoResCategory = EcoResCategory::findByName(this.CategoryName,ecoResCategoryHierarchy.RecId);
        if(!ecoResCategory)
        {
            warning("@MET:NoCategoryFoundWithThisName");
        }
        
        this.Category          = ecoResCategory.RecId;
        this.CategoryHierarchy = ecoResCategoryHierarchy.RecId;
    }

]]></Source>
