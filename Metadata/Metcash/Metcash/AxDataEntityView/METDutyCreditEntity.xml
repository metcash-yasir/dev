		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validate
    /// </summary>
    /// <returns>ret</returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        if(this.TariffItem && this.StatCode)
        {
            METTariffItemCodeBase metTariffItemCodeBase = METTariffItemCodeBase::findbyTariffStatCode(this.TariffItem, this.StatCode);

            if (metTariffItemCodeBase)
            {
                this.TariffItemCodeBaseRecid = metTariffItemCodeBase.RecId;
            }
            else
            {
                error("@MET:InvalidTariffItemAndStatcodeCombination");
                ret=false;
            }
        }
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>postLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// fill statcode and tariffitem while exporting
    /// </summary>
    public void postLoad()
    {
        super();
        METTariffItemCodeBase metTariffItemCodeBase = METTariffItemCodeBase::findRecId(this.TariffItemCodeBaseRecid);
        if(metTariffItemCodeBase)
        {
            this.TariffItem = metTariffItemCodeBase.TariffItem;
            this.StatCode   = metTariffItemCodeBase.StatCode;
        }

    }

]]></Source>
			</Method>
		</Methods>
