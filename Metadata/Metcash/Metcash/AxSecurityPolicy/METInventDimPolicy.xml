			i:type="AxSecurityPolicyConstrainedExpression">
			<Constrained>Yes</Constrained>
			<Name>InventSite</Name>
			<ConstrainedTables>
				<AxSecurityPolicyConstrainedEntity xmlns=""
					i:type="AxSecurityPolicyConstrainedTable">
