<?xml version="1.0" encoding="utf-8"?>
<AxSecurityPolicy xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>METInventDimPolicy</Name>
	<ConstrainedTable>Yes</ConstrainedTable>
	<ContextString>METInventSitePolicyRole</ContextString>
	<ContextType>RoleProperty</ContextType>
	<HelpText>Inventory dimension security policy help</HelpText>
	<Label>MET Inventory dimension security policy</Label>
