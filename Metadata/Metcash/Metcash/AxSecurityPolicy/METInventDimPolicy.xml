				</AxSecurityPolicyConstrainedEntity>
			</ConstrainedTables>
			<Value>(InventSite.SiteId == InventDim.InventSiteId)</Value>
		</AxSecurityPolicyConstrainedEntity>
	</ConstrainedTables>
