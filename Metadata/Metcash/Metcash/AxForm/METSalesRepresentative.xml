								<Source><![CDATA[
            /// <summary>
            /// To Show the Business name from Business unit form
            /// </summary>
            /// <param name = "_formControl"></param>
            /// <param name = "_filterStr"></param>
            public void lookup(FormControl _formControl, str _filterStr)
            {
                Query                   query = new Query();
                QueryBuildDataSource     qbds;
                SysTableLookup           sysTableLookup;

                sysTableLookup = SysTableLookup::newParameters(tableNum(METBusinessUnit), _formControl);

                sysTableLookup.addLookupfield(fieldNum(METBusinessUnit, BusinessName));   // The value
                sysTableLookup.addLookupfield(fieldNum(METBusinessUnit, StatePrefixStr)); // The description

                qbds = query.addDataSource(tableNum(METBusinessUnit));
                
                sysTableLookup.parmQuery(query);
                sysTableLookup.performFormLookup();

            }

]]></Source>
