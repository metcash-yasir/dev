				<Source><![CDATA[
    /// <summary>
    /// Initialize the filter consumer form.
    /// </summary>
    void init()
    {
        formRun = element.args().caller() as FormRun;

        super();

        if (METApplyWarehouseRestrictionForISPUsers())
        {
            QueryBuildDataSource qbdsUserWarehouse;
            qbdsUserWarehouse = CustSalesOpenLines_ds.queryBuildDataSource().addDataSource(tableNum(METAllowedWarehousesForISPUsers));
            qbdsUserWarehouse.joinMode(JoinMode::ExistsJoin);
            qbdsUserWarehouse.addLink(fieldnum(InventDim, InventLocationId), fieldNum(METAllowedWarehousesForISPUsers, InventLocationID));
            qbdsUserWarehouse.addRange(fieldnum(METAllowedWarehousesForISPUsers, UserId)).value(curUserId());
            CustSalesOpenLines_ds.executeQuery();
        }
    }

]]></Source>
