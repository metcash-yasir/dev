					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void executeQuery()
        {
            ItemId                  itemId              = formRun.parmItemId();
            InventLocationId        inventLocationId    = formRun.parminventoryLocationId();
            QueryBuildDataSource    qbdsSalesOpenLines;

            if (formRun)
            {
                qbdsSalesOpenLines = this.queryBuildDataSource();
                
                qbdsSalesOpenLines.clearRanges();

                if (itemId)
                {
                    qbdsSalesOpenLines.addRange(fieldNum(METSalesOpenLinesView, ItemId)).value(itemId);
                    qbdsSalesOpenLines.addRange(fieldNum(METSalesOpenLinesView, ItemId)).status(RangeStatus::Locked);
                }
                if (inventLocationId)
                {
                    qbdsSalesOpenLines.addRange(fieldNum(METSalesOpenLinesView, InventLocationId)).value(inventLocationId);
                    qbdsSalesOpenLines.addRange(fieldNum(METSalesOpenLinesView, InventLocationId)).status(RangeStatus::Locked);
                }
            }

            super();
        }

]]></Source>
