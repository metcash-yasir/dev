        /// <summary>
        /// Lookup method
        /// </summary>
        public void lookup()
        {
            Query query;
            SysTableLookup sysTableLookup;
            super(); 
            
            sysTableLookup = SysTableLookup::newParameters(tableNum(EcoResAttributeType), this);
 
            sysTableLookup.addLookupfield(fieldNum(EcoResAttributeType, Name));
            sysTableLookup.addLookupfield(fieldNum(EcoResAttributeType, DataType));
 
            query = new Query();
 
            query.addDataSource(tableNum(EcoResAttributeType));
 
            sysTableLookup.parmQuery(query);
 
            sysTableLookup.performFormLookup();
        }

]]></Source>
