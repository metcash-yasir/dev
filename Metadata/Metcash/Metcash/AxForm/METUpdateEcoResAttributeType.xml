						<Source><![CDATA[
        /// <summary>
        /// Modified method
        /// </summary>
        /// <returns></returns>
        public boolean modified()
        {
            boolean ret;
        
            ret = super();

            EcoResAttributeType ecoResAttributeType;

            select DataType from ecoResAttributeType
                where ecoResAttributeType.Name == this.text();

            if (ecoResAttributeType.RecId)
            {
                ExistingDataType.selection(ecoResAttributeType.DataType);
            }
        
            return ret;
        }

