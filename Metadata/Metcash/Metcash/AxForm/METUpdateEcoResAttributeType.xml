				<Source><![CDATA[
    /// <summary>
    /// Close Ok method
    /// </summary>
    public void closeOk()
    {
        EcoResAttributeType ecoResAttributeType;
        ttsbegin;
        select forupdate ecoResAttributeType
            where ecoResAttributeType.Name == AttributeType.text();

        if (ecoResAttributeType)
        {
            ecoResAttributeType.DataType = NewDataType.selection();
            ecoResAttributeType.update();
            info(strFmt("@MET:AttributeTypeUpdated", ecoResAttributeType.Name, ecoResAttributeType.DataType));
        }
        ttscommit;
        super();
    }

]]></Source>
