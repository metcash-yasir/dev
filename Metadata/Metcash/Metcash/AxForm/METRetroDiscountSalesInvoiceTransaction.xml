			<Method>
				<Name>postClaim</Name>
				<Source><![CDATA[
    public void postClaim()
    {
        MultiSelectionHelper selectionHelper = MultiSelectionHelper::construct();

        METRetroDiscountFreeTextInvoicePost     freeTextInvoicePost;
        METRetroDiscountDiscountClaimPost       discountClaimPost;
        METRetroDiscountSalesInvoiceTransaction trans;
        
        Map freeTextInvoicePostMap = new Map(Types::Container, Types::Class);
        Map discountClaimMap = new Map(Types::Container, Types::Class);
        MapEnumerator   enumerator;
        container       key;
        boolean claimable = RetailPeriodicDiscount::findByOfferId(OfferId.valueStr()).Claimable;

        selectionHelper.parmDataSource(METRetroDiscountSalesInvoiceTransaction_ds);
        trans = selectionHelper.getFirst();

        while (trans)
        {
            if (!trans.Posted)
            {
                key = [trans.CustAccount, trans.InvoiceAccount, trans.ItemId];
                if (freeTextInvoicePostMap.exists(key))
                {
                    freeTextInvoicePost = freeTextInvoicePostMap.lookup(key);
                    freeTextInvoicePost.addTransToList(trans);
                }
                else
                {
                    freeTextInvoicePostMap.insert(key, new METRetroDiscountFreeTextInvoicePost(trans));
                }

                if (claimable)
                {
                    key = [trans.SalesId, trans.InvoiceId];
                    if (discountClaimMap.exists(key))
                    {
                        discountClaimPost = discountClaimMap.lookup(key);
                        discountClaimPost.addTransToList(trans);
                    }
                    else
                    {
                        discountClaimMap.insert(key, new METRetroDiscountDiscountClaimPost(trans));
                    }
                }
            }

            trans = selectionHelper.getNext();
        }

        ttsbegin;

        enumerator = new MapEnumerator(freeTextInvoicePostMap);
        while (enumerator.moveNext())
        {
            freeTextInvoicePost = enumerator.currentValue();
            freeTextInvoicePost.postFreeTextInovice();
        }

        if (claimable)
        {
            enumerator = new MapEnumerator(discountClaimMap);
            while (enumerator.moveNext())
            {
                discountClaimPost = enumerator.currentValue();
                discountClaimPost.postDiscountClaim();
            }
        }

        ttscommit;
    }

]]></Source>
