			<Method>
				<Name>updateDesign</Name>
				<Source><![CDATA[
    public void updateDesign(InventDimFormDesignUpdate mode)
    {
        switch (mode)
        {
            case InventDimFormDesignUpdate::Init:
                if (!inventDimFormSetup)
                {
                    inventDimFormSetup  = InventDimCtrl::newFromForm(this);
                }

                inventDimFormSetup.parmSkipOnHandLookUp(true);
                inventDimFormSetup.parmDimParmEnabled(InventDimParm::allInventDim());
                inventDimFormSetup.parmDimParmVisible(InventDimParm::siteAndWarehouse());

                inventDimFormSetup.formSetControls(true);

                break;
        }
    }

]]></Source>
