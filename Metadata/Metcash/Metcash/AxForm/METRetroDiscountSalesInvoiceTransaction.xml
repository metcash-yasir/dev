            sysTableLookup.addLookupfield(fieldNum(RetailPeriodicDiscount, PriceComponentCodeName));
            sysTableLookup.addLookupfield(fieldNum(RetailPeriodicDiscount, ValidFrom));
            sysTableLookup.addLookupfield(fieldNum(RetailPeriodicDiscount, ValidTo));
            sysTableLookup.parmQuery(query);

            sysTableLookup.performFormLookup();
        }

