				<Source><![CDATA[
    public void init()
    {
        super();

        Object o = element.args().parmObject();
        if (o && o is METRetroDiscountSalesInvoiceGenerate)
        {
            METRetroDiscountSalesInvoiceGenerate retroDiscountSalesInvoiceGenerate = o as METRetroDiscountSalesInvoiceGenerate;

            OfferId.text(retroDiscountSalesInvoiceGenerate.parmOfferId());
            offerIdFilter.value(SysQuery::value(retroDiscountSalesInvoiceGenerate.parmOfferId()));
            
            element.editAllOpenPosted(true, AllOpenPosted::Open);
        }

        element.updateDesign(InventDimFormDesignUpdate::Init);
    }

]]></Source>
			</Method>
			<Method>
				<Name>editAllOpenPosted</Name>
				<Source><![CDATA[
    public edit AllOpenPosted editAllOpenPosted(boolean _set, AllOpenPosted _value)
    {
        if (_set && allOpenPostedValue != _value)
        {
            allOpenPostedValue = _value;
            switch (allOpenPostedValue)
            {
                case AllOpenPosted::All:
                    postedCriteria.value(SysQuery::valueUnlimited());
                    break;

                case AllOpenPosted::Open:
                    postedCriteria.value(SysQuery::value(NoYes::No));
                    break;

                case AllOpenPosted::Posted:
                    postedCriteria.value(SysQuery::value(NoYes::Yes));
                    break;
            }

            METRetroDiscountSalesInvoiceTransaction_ds.executeQuery();
        }

        return allOpenPostedValue;
    }

]]></Source>
