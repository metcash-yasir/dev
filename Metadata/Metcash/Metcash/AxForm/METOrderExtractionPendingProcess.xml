			</Control>
			<Control>
				<Name>ProcessExtraction</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            METOrderExtractionPendingProcess pendingRecord = metOrderExtractionPendingProcess_ds.cursor();

            if (!pendingRecord.RecId)
            {
                return;
            }

            // Re-read to get latest RecVersion for the OCC claim check
            pendingRecord = METOrderExtractionPendingProcess::findByRecId(pendingRecord.RecId);

            if (pendingRecord.Status == METOrderExtractionPendingProcessStatus::Processing)
            {
                throw error("@MET:METSalesExtractionAlreadyInProcess");
                return;
            }

            METSalesOrderExtractionPendingProcess processor = METSalesOrderExtractionPendingProcess::construct();
            processor.processRecord(pendingRecord);

            metOrderExtractionPendingProcess_ds.reread();
            metOrderExtractionPendingProcess_ds.refresh();
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
