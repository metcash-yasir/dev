        public int active()
        {
            int ret;
        
            ret = super();

            METOrderExtractionPendingProcess pendingRecord = METOrderExtractionPendingProcess_ds.cursor();

            ProcessExtraction.visible(pendingRecord.Status == METOrderExtractionPendingProcessStatus::Failed);
        
            return ret;
        }

]]></Source>
