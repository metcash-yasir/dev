			<DataSource>
				<Name>METTariffItemCode</Name>
				<Methods>
					<Method>
						<Name>validateWrite</Name>
						<Source><![CDATA[
        /// <summary>
        /// assign Base table recId 
        /// </summary>
        /// <returns>true if valid</returns>
        public boolean validateWrite()
        {
            boolean ret;
            
            METTariffItemCode tariffItemCode = METTariffItemCode_ds.cursor();
            if(!tariffItemCode)
            {
                METTariffItemCodeBase tariffItemCodebase    = METTariffItemCodeBase_ds.cursor();

                if(!tariffItemCodebase && tariffItemCodebase.validateWrite())
                {
                    ttsbegin;
                    tariffItemCodebase.write();
                    ttscommit;
                }
                tariffItemCode.MetTariffItemCodeBase        = tariffItemCodebase.RecId;
            }
            
            ret = super();
        
            return ret;
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// reflects the Item Code Details according to Base table record
        /// </summary>
        public void executeQuery()
        {
            QueryBuildRange      metBaseRefRecIdRange;
            QueryBuildDataSource tariffItemCodeBase;

            tariffItemCodeBase = this.query().dataSourceTable(tableNum(METTariffItemCode));
            tariffItemCodeBase.clearDynalinks();

            metBaseRefRecIdRange = SysQuery::findOrCreateRange(
                this.query().dataSourceTable(tableNum(METTariffItemCode)),
                fieldNum(METTariffItemCode, METTariffItemCodeBase));

            metBaseRefRecIdRange.value(queryValue(METTariffItemCodeBase_ds.cursor().RecId));
            super();
        }

]]></Source>
					</Method>
