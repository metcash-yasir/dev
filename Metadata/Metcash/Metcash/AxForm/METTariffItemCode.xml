					<Method>
						<Name>create</Name>
						<Source><![CDATA[
        /// <summary>
        /// Creates record 
        /// </summary>
        /// <param name = "_append">Indicates whether append the data</param>
        public void create(boolean _append = false)
        {
            METItemTariffCreate itemTariffCreate = new METItemTariffCreate();

            if(itemTariffCreate.prompt())
            {
                itemTariffCreate.run();

                if(itemTariffCreate.parmTariffItemCodeBase().RecId)
                {
                    super(_append);

                    METTariffItemCodeBase.data(itemTariffCreate.parmTariffItemCodeBase());
                    METTariffItemCodeBase_ds.reread();
                    METTariffItemCodeBase_ds.refresh();
                }
            }
        }

]]></Source>
					</Method>
				</Methods>
