				<Type>ComboBox</Type>
				<Methods>
					<Method>
						<Name>modified</Name>
						<Source><![CDATA[
        /// <summary>
        /// Based on CustomExcise, initialise NAT3040, set AllowEdit property of StatCode
        /// </summary>
        /// <returns>true if successfull</returns>
        public boolean modified()
        {
            boolean ret;
        
            ret = super();

            if(METTariffItemCodeBase.CustomsExcise == METCustomExcise::C)
            {
                METTariffItemCodeBase.NAT3040   = METNAT3040::NAT30;
                METTariffItemCodeBase.StatCode  = '';
                METTariffItemCodeBase_ds.object(fieldNum(METTariffItemCodeBase, StatCode)).allowEdit(true);
            }
            else if(METTariffItemCodeBase.CustomsExcise == METCustomExcise::E)
            {
                METTariffItemCodeBase.NAT3040   = METNAT3040::NAT40;
                METTariffItemCodeBase.StatCode  = "@MET:DefaultStatCodeText";
                METTariffItemCodeBase_ds.object(fieldNum(METTariffItemCodeBase, StatCode)).allowEdit(false);
            }
            else
            {
                METTariffItemCodeBase_ds.object(fieldNum(METTariffItemCodeBase, StatCode)).allowEdit(true);
            }
        
            return ret;
        }

]]></Source>
					</Method>
