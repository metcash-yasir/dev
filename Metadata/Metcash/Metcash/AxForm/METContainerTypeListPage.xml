						<Source><![CDATA[
        /// <summary>
        /// Stop apply filters on the warehouse column on the grid.
        /// </summary>
        public void init()
        {
            super();
            
            if (element.args().callerName() == formStr(InventLocation)      ||
                element.args().callerName() == formStr(METSalesOrderFinalizationWorkbench))
            {
                element.design(1).caption("@MET:ContainerTypeByWarehouse");
                METContainerTypeTable_ds.object(fieldNum(METContainerTypeTable, InventLocationId)).allowAdd(false);
                METContainerTypeTable_ds.object(fieldNum(METContainerTypeTable, InventLocationId)).allowEdit(false);
                this.query().dataSourceTable(tableNum(METContainerTypeTable)).addRange(fieldNum(METContainerTypeTable, InventLocationId)).status(RangeStatus::Locked);
            }
            
            if (element.args().callerName() == formStr(METSalesOrderFinalizationWorkbench))
            {
                METSalesOrderShipmentLoadHeader         shipmentLoadHeader = element.args().record();

                this.query().dataSourceTable(tableNum(METContainerTypeTable)).addRange(fieldNum(METContainerTypeTable, InventLocationId)).value(queryValue(shipmentLoadHeader.Warehouse));
            }
        }

]]></Source>
