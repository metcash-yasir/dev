				<Source><![CDATA[
    public void init()
    {
        whsPhysDimUOMForm = new WHSPhysDimUOMForm();

        super();

        if (element.args().dataset() == tableNum(InventTable))
        {
            InventTable passedInventTable = element.args().record();
            InventTable_ds.query().dataSourceTable(tableNum(InventTable)).addRange(fieldNum(InventTable, ItemId)).value(passedInventTable.ItemId);

            if (WHSInventTable::find(passedInventTable.ItemId).uomSeqGroupId)
            {
                importUOMSeqGroup.enabled(true);
            }
        }
    }

]]></Source>
