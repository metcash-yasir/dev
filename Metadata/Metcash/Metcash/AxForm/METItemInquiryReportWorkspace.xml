<Form Name="METItemInquiryReportWorkspace" Type="Workspace">
  <GlobalFilters>
    <Filter Name="ItemId" DataType="String" Label="Item Id" />
    <Filter Name="WarehouseId" DataType="String" Label="Warehouse Id" />
  </GlobalFilters>
  <Tiles>
    <Tile Name="PurchaseOrderCountTile" Label="Purchase Orders (Last Month)" Form="PurchTableListPage">
      <Query>
        <Range Field="CreatedDateTime" Operator="GreaterThanOrEqual" Value="dateadd(month, -1, getdate())" />
      </Query>
      <DisplayMode>Count</DisplayMode>
    </Tile>
  </Tiles>
  <Lists>
    <List Name="ProductReceiptList" Label="Product Receipts" Form="VendPackingSlipJourListPage" />
  </Lists>
</Form>