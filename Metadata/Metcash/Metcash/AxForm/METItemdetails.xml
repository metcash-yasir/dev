		<DataSources xmlns="">
			<DataSource>
				<Name>ReqItemTable</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Executing query
        /// </summary>
        public void executeQuery()
        {
            ItemId                  itemIdFilter;
            QueryBuildDataSource    qbdsItemBarcode = this.queryBuildDataSource();
            QueryBuildDataSource    inventDimds = InventDim_ds.queryBuildDataSource();
            itemIdFilter            = formRun.parmItemId();

            qbdsItemBarcode.clearRanges();
            inventDimds.clearRanges();

            if (itemIdFilter)
            {
                qbdsItemBarcode.addRange(fieldNum(ReqItemTable, ItemId)).value(queryValue(itemIdFilter));
                qbdsItemBarcode.addRange(fieldNum(ReqItemTable, ItemId)).status(RangeStatus::Locked);
            }

            InventLocationId        inventLocationIdFilter;
            inventLocationIdFilter  = formRun.parminventoryLocationId();

            if (inventLocationIdFilter)
            {
                inventDimds.addRange(fieldNum(InventDim, InventLocationId)).value(queryValue(inventLocationIdFilter));
                inventDimds.addRange(fieldNum(InventDim, InventLocationId)).status(RangeStatus::Locked);
            }
            super();
        }

]]></Source>
					</Method>
				</Methods>
