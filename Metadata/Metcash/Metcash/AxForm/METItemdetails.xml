		<DataSources xmlns="">
			<DataSource>
				<Name>METItemDetailsView</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Execute the query with the applied filters.
        /// </summary>
        public void executeQuery()
        {
            ItemId                  itemIdFilter;
            QueryBuildDataSource    qbds;
            
            if (formRun)
            {
                qbds            = this.queryBuildDataSource();
                itemIdFilter    = formRun.parmItemId();

                if (itemIdFilter)
                {
                    this.query().dataSourceTable(tableNum(METItemDetailsView)).clearRanges();
                    qbds.addRange(fieldNum(METItemDetailsView, ItemId)).value(itemIdFilter);

                }
                else
                {
                    this.query().dataSourceTable(tableNum(METItemDetailsView)).clearRange(fieldNum(METItemDetailsView, ItemId));
                }
                qbds.addRange(fieldNum(METItemDetailsView, ItemId)).status(RangeStatus::Locked);

            }
            super();
        }

]]></Source>
					</Method>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Initialize the data source.
        /// </summary>
        public void init()
        {
            super();
            this.queryBuildDataSource().addSortField(fieldNum(METItemDetailsView, ItemId), SortOrder::Ascending);
        }

]]></Source>
					</Method>
