			<Method>
				<Name>onFilterChanged</Name>
				<Source><![CDATA[
    /// <summary>
    /// Event handler to react on a filter change.
    /// </summary>
    public void onFilterChanged()
    {
        ReqItemTable_ds.research();
        ReqItemTable_ds.executeQuery();

        InventDim_ds.research();
        InventDim_ds.executeQuery();
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialize the filter consumer form.
    /// </summary>
    public void init()
    {
        formRun = element.args().caller() as FormRun;

        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>registerDatasourceOnQueryingEvent</Name>
				<Source><![CDATA[
    /// <summary>
    /// Register the data source to which the filter should be applied.
    /// </summary>
    public void registerDatasourceOnQueryingEvent()
    {
        ReqItemTable_ds.OnQueryExecuting += eventhandler(this.parmFilterFormQueryEventHandler().applyFilter);
    }

]]></Source>
			</Method>
			<Method>
				<Name>parmItemIdFilter</Name>
				<Source><![CDATA[
    /// <summary>
    /// Parameter method to get the ItemId filter from the filter form.
    /// </summary>
    /// <returns>ItemId</returns>
    public ItemId parmItemIdFilter()
    {
        return SysFilterValueHelper::getFirstValueRecordFromFilterForType(this.parmSourceFilter(), SysFilterValueTypeEnum::String, extendedTypeNum(ItemId));
    
    }

]]></Source>
			</Method>
			<Method>
				<Name>parminventoryLocationIdFilter</Name>
				<Source><![CDATA[
    /// <summary>
    /// Parameter method to get the InventLocationId filter from the filter form.
    /// </summary>
