						<Source><![CDATA[
        /// <summary>
        /// updates the claim status to Rejected
        /// </summary>
        public void clicked()
        {
            super();
    
            if(METVendorClaimRegister.ClaimStatus == METVendorClaimStatus::Pending)
            {
                METVendorClaimRegister.updateClaimStatus(METVendorClaimStatus::Rejected);
                element.refreshDataSource();
            }
        }

]]></Source>
