				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// updates the claim status to Approved
        /// </summary>
        public void clicked()
        {
            super();
            if(METVendorClaimRegister.ClaimStatus == METVendorClaimStatus::Pending)
            {
                METVendorClaimRegister.updateClaimStatus(METVendorClaimStatus::Approved);
                element.refreshDataSource();
            }
        }

]]></Source>
