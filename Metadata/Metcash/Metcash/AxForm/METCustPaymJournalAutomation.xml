    /// element.closeOk
    /// </summary>
    public void closeOk()
    {       
        callerProcess.setJournalAutomationParams(METCustPaymJournalAutomationParamsTmp);                

        DialogRunbase dialog = element.args().caller();
        if(callerProcess.checkCloseDialog())
