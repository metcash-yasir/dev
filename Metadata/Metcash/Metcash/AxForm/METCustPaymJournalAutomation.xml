			<Method>
				<Name>promptPaymProposal</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_15465_DirectDebitAutomation
    /// Display payment proposal options.
    /// </summary>
    public void promptPaymProposal()
    {
        CustVendCreatePaymJournal_Cust paymProposal = CustVendCreatePaymJournal_Cust::construct();
        paymProposal.metParmFromAutomation(true);        

        if(conLen(callerProcess.parmPaymProposalParams()))
        {
            paymProposal.unpack(callerProcess.parmPaymProposalParams());
            paymProposal.metSetGetLastCalled(true);
        }

        if(paymProposal.prompt())
        {
            callerProcess.parmPaymProposalParams(paymProposal.pack());      
        }            
    }

]]></Source>
			</Method>
			<Method>
				<Name>promptGeneratePayment</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_15465_DirectDebitAutomation
    /// Show generate payments prompt
    /// </summary>
    public void promptGeneratePayment()
    {        
        CustVendSumForPaym sumForPaym = new CustSumForPaym();
        Args promptArgs = new Args();

        if(callerProcess.parmGeneratePaymentParams())
        {
            sumForPaym.unpack(callerProcess.parmGeneratePaymentParams());
        }
        else
        {
            sumForPaym.initParmDefault();
        }

        LedgerJournalTrans dummyJournalTrans;
        promptArgs.record(dummyJournalTrans);
        sumForPaym.parmArgs(promptArgs);
        sumForPaym.metParmFromAutomation(true);

        if(sumForPaym.prompt())
        {
            callerProcess.parmGeneratePaymentParams(sumForPaym.pack());            
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>promptFileFormat</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_15465_DirectDebitAutomation
    /// Show file format prompt
    /// </summary>
    public void promptFileFormat()
    {        
        if(!conLen(callerProcess.parmPaymProposalParams()))
            throw error("Payment proposal parameters have not been defined.");

        CustSumForPaym      custSumForPaym  = callerProcess.getCustSumForPaymFromPackedParams();
        CustVendOutPaym     paym            = CustVendOutPaym::construct(CustPaymModeTable::find(custSumForPaym.parmPaymMode()).ClassId);

        if(conLen(callerProcess.parmFileFormatParams()))
        {
            paym.unpack(callerProcess.parmFileFormatParams());
        }

        paym.parmPaymMode(custSumForPaym.parmPaymMode());
        paym.metParmFromAutomation(true);
        paym.parmLastValueDesignName('');
        paym.parmBankAccountID(custSumForPaym.parmBankAccountID());
        paym.parmFilename('-');

        if(paym.prompt())
        {
            callerProcess.parmFileFormatParams(paym.pack());            
        }
    }

]]></Source>
			</Method>
