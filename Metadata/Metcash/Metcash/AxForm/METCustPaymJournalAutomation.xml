        {
            throw error("Form must be called from %1", classId2Name(classNum(METCustPaymJournalAutomation)));
        }

        METCustPaymJournalAutomationParamsTmp_ds.create();
        METCustPaymJournalAutomationParamsTmp_ds.write();
    }

]]></Source>
