        metTransferOrderShipWorkbenchExtractFilter.parmToShipDate(toShipDate.dateValue());

        metTransferOrderShipWorkbenchExtractFilter.saveLastValue(formStr(MetTransferOrderShipWorkbench));

        if (element.args()
            &&  element.args().caller()
            &&  element.args().caller() is FormRun
            &&  formHasMethod(element.args().caller(), identifierStr(refresh)))
        {
            element.args().caller().refresh();
        }

        super();
    }

]]></Source>
