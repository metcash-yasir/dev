			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// If the form was called from the load list page and the hazardous additions feature enabled
    /// the data source is ranged by shipment for selected load.
    /// </summary>
    public void init()
    {
        super();

        if (element.args().caller()
           && element.args().caller().name() == formStr(METSalesOrderFinalizationWorkbench))
        {
            METSalesOrderShipmentLoadHeader   shipmentLoadHeader = element.args().record();

            METHMIMMultimodalDG_ds.query().dataSourceTable(tableNum(METHMIMMultimodalDG)).addRange(fieldNum(METHMIMMultimodalDG, ShipmentId)).value(shipmentLoadHeader.ShipmentId);
        }
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>METHMIMMultimodalDG</Name>
				<Methods>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        /// <summary>
        /// init value
        /// </summary>
        public void initValue()
        {
            super();

            if (METHMIMMultimodalDG.ShipmentId)
            {
                METHMIMMultimodalDG.modifiedField(fieldNum(METHMIMMultimodalDG, ShipmentId));
            }
        }

]]></Source>
					</Method>
				</Methods>
				<Fields>
					<Field>
						<DataField>DeliveryPostalAddress</DataField>
						<Methods>
							<Method>
								<Name>lookupReference</Name>
								<Source><![CDATA[
            public Common lookupReference(FormReferenceControl _formReferenceControl)
            {
                Common ret;
                CustTable custTable = CustTable::find(METHMIMMultimodalDG.CustAccount);

                ret = LogisticsLocationSelectionLookup::lookupAddressForm(_formReferenceControl, custTable,
                    [LogisticsLocationRoleType::Delivery],
                    false);
                return ret;
            }

]]></Source>
							</Method>
						</Methods>
					</Field>
					<Field>
						<DataField>ShippingPostalAddress</DataField>
						<Methods>
							<Method>
								<Name>lookupReference</Name>
								<Source><![CDATA[
            public Common lookupReference(FormReferenceControl _formReferenceControl)
            {
                Common ret;
                METSalesOrderShipmentLoadHeader   shipmentLoadHeader;

                select Warehouse from shipmentLoadHeader
                    where shipmentLoadHeader.ShipmentId == METHMIMMultimodalDG.ShipmentId;

                InventLocation      inventLocation = InventLocation::find(shipmentLoadHeader.Warehouse);

                ret = LogisticsLocationSelectionLookup::lookupAddressForm(_formReferenceControl,
                    inventLocation,
                    [LogisticsLocationRoleType::Delivery], false);

                return ret;
            }

]]></Source>
							</Method>
						</Methods>
