		<DataControls xmlns="">
			<Control>
				<Name>ReGenerate</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Handles the click event for the ReGenerate button.
        /// </summary>
        public void clicked()
        {
            METNature3040ReportController           controller = new METNature3040ReportController();
            METNature3040ReportContract             contract = new METNature3040ReportContract();
            contract.parmNat30Number(METNature3040ReportExecution.Nat3040ReportNumber);

            if (METNature3040ReportExecution.NAT3040 == METNAT3040::NAT30)
            {
                controller.parmReportName(ssrsReportStr(METNature3040Report, Nature30));
                contract.parmMETNat3040(METNAT3040::NAT30);
            }
            else if (METNature3040ReportExecution.NAT3040 == METNAT3040::NAT40)
            {
                controller.parmReportName(ssrsReportStr(METNature3040Report, Nature40));
                contract.parmMETNat3040(METNAT3040::NAT40);
            }

            controller.parmReportContract().parmRdpContract(contract);
            METNature3040ReportExecute::execute(controller);

            super();

            METNature3040ReportExecution_ds.refresh();
        }

]]></Source>
					</Method>
