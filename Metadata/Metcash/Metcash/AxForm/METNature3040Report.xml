			<Method>
				<Name>enableRegenerateControl</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates the design of the form based on whether the national report has been generated.
    /// </summary>
    private void enableRegenerateControl()
    {
        METNature3040ReportsTable       metNature3040ReportsTableLocal;
        select firstonly NationalReportGenerated from metNature3040ReportsTableLocal
            where metNature3040ReportsTableLocal.Nat3040ReportNumber == METNature3040ReportExecution.Nat3040ReportNumber;

        ReGenerate.enabled(!metNature3040ReportsTableLocal.NationalReportGenerated);
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializes the form and sets up the regenerate control.
    /// </summary>
    public void init()
    {
        super();
        this.enableRegenerateControl();
    }

]]></Source>
