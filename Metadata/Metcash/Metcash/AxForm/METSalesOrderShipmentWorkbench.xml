			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initilize METSalesOrderShipmentWorkbenchFilterParameters and parameters
    /// </summary>
    public void init()
    {
        const str emptyString = '';
        
        refresh = false;
        
        super();

        salesOrderShipmentWorkbenchFilterParameters = METSalesOrderShipmentWorkbenchFilterParameters::construct();

        // load previous values and reset everything except warehouse 
        salesOrderShipmentWorkbenchFilterParameters.loadLastValue(formStr(METSalesOrderShipmentWorkbenchParameters));
        salesOrderShipmentWorkbenchFilterParameters.parmShipDateFrom(dateNull());
        salesOrderShipmentWorkbenchFilterParameters.parmShipDateTo(dateNull());
        salesOrderShipmentWorkbenchFilterParameters.parmPrimaryRoute(emptyString);
        salesOrderShipmentWorkbenchFilterParameters.parmCustAccount(emptyString);
        salesOrderShipmentWorkbenchFilterParameters.saveLastValue(formStr(METSalesOrderShipmentWorkbenchParameters));
     
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>SalesTable</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Change the query based on the parameters
        /// </summary>
        public void executeQuery()
        {
            InventLocationId        inventLocationId;
            SalesShippingDate       shipDateFrom, shipDateTo;
            METRoute                primaryRoute;
            CustAccount             custAccount;
            QueryBuildDataSource    qbds, qbds2;

            salesOrderShipmentWorkbenchFilterParameters.loadLastValue(formStr(METSalesOrderShipmentWorkbenchParameters));

            inventLocationId = salesOrderShipmentWorkbenchFilterParameters.parmInventLocationId();
            shipDateFrom = salesOrderShipmentWorkbenchFilterParameters.parmShipDateFrom();
            shipDateTo = salesOrderShipmentWorkbenchFilterParameters.parmShipDateTo();
            primaryRoute = salesOrderShipmentWorkbenchFilterParameters.parmPrimaryRoute();
            custAccount = salesOrderShipmentWorkbenchFilterParameters.parmCustAccount();            

            qbds = this.query().dataSourceTable(tableNum(SalesTable));            
            qbds2 = this.query().dataSourceTable(tableNum(METSalesTable));
            qbds.clearRanges();

            if (refresh)
            {            
                // Add filters
                // for RDC filter by warehouse, order status 'Open order'
                // for NDC filter by secondary warehouse, order status 'Delivered'                
                if (inventLocationId)
                {
                    qbds.addRange(fieldNum(SalesTable, RecId)).value(strFmt('(((%1 == "%2") && (%3 == %4)) || ((%5.%6 == "%2") && (%3 == %7)))',
                                                                             fieldStr(SalesTable, InventLocationId),
                                                                             queryValue(inventLocationId),
                                                                             fieldStr(SalesTable, SalesStatus),
                                                                             any2Int(SalesStatus::Backorder),
                                                                             qbds2.name(),
                                                                             fieldStr(METSalesTable, SecondaryInventLocationId),
                                                                             any2Int(SalesStatus::Delivered)));
                }

                // Filter by confirmed ship date if populated, if not filter by requested ship date
                if (shipDateFrom && shipDateTo)
                {
                    qbds.addRange(fieldNum(SalesTable, DataAreaId)).value(strFmt('(((%1 >= %2) && (%1 <= %3)) || ((%1 == %4) && ((%5 >= %2) && (%5 <= %3))))',
                                                                              fieldStr(SalesTable, ShippingDateConfirmed),
                                                                                Date2StrXpp(shipDateFrom),
                                                                                Date2StrXpp(shipDateTo),
                                                                                Date2StrXpp(dateNull()),
                                                                              fieldStr(SalesTable, ShippingDateRequested)));
                }

                // Filter by primary route
                if (primaryRoute)
                {
                    qbds.addRange(fieldNum(SalesTable, METRoute)).value(SysQuery::value(primaryRoute));
                }
                

                // Filter by customer account
                if (custAccount)
                {
                    qbds.addRange(fieldNum(SalesTable, CustAccount)).value(SysQuery::value(custAccount));
                }

                // to include orders having extraction status "extracted/open"
                this.query().dataSourceTable(tableNum(SalesTable)).addRange(fieldNum(SalesTable,METOrderExtractStatus)).value(strFmt('%1 || %2',
                                any2Str(METOrderExtractStatus::Extracted),any2Str(METOrderExtractStatus::Open)));
            
                // Filter only SO with picking list completed/Activated
                this.query().dataSourceTable(tableNum(WMSPickingRoute)).addRange(fieldNum(WMSPickingRoute, expeditionStatus)).value(strFmt('%1 || %2',
                                                any2Str(WMSExpeditionStatus::Complete),any2Str(WMSExpeditionStatus::Activated)));
               
            }
            else
            {
                // When opening the form before selecting parameters, form must be empty
                qbds.addRange(fieldNum(SalesTable, RecId)).value(int642Str(0));
            }

            super();
        }

]]></Source>
