        /// <summary>
        /// Executes the query for future duty roll values lines, applying date effectiveness and valid time state filters.
        /// </summary>
        public void executeQuery()
        {
            str queryRangeStr = '';
            QueryBuildRange qbrValidFrom, qbrValidTo;

            qbrValidFrom = SysQuery::findOrCreateRange(this.query().dataSourceTable(tableNum(METDutyRollValuesLine)), fieldNum(METDutyRollValuesLine,ValidFrom));
            qbrValidTo   = SysQuery::findOrCreateRange(this.query().dataSourceTable(tableNum(METDutyRollValuesLine)), fieldNum(METDutyRollValuesLine,ValidTo));
            
            queryRangeStr = DateEffectivenessCheck::queryRange(false, false, true);
            METDutyRollValuesLineFuture_ds.query().validTimeStateDateTimeRange(DateTimeUtil::utcNow(), DateTimeUtil::maxValue());
            METDutyRollValuesLineFuture_ds.validTimeStateUpdate(ValidTimeStateUpdate::Correction);

            if (queryRangeStr)
            {
                qbrValidFrom.value(
                            strFmt(queryRangeStr,
                                METDutyRollValuesLineFuture_ds.name(),
                                fieldStr(METDutyRollValuesLine,ValidFrom),
                                fieldStr(METDutyRollValuesLine,ValidTo),
                                DateTimeUtil::toStr(DateTimeUtil::utcNow())));
            }

            super();
        }

]]></Source>
