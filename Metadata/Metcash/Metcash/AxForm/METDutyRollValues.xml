			<Method>
				<Name>filterWithParentSite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Method to fetch duty roll values lines based on the selected site in the parent form.
    /// </summary>
    /// <param name = "_formDataSource">Object of FormDataSource type</param>
    public void filterWithParentSite(FormDataSource _formDataSource)
    {
        METDutyRollValuesLineViewBySite parentRec = METDutyRollValuesLineViewBySite_ds.cursor();
        if (!parentRec)
        {
            return;
        }

        // Clear previous filters
        _formDataSource.queryBuildDataSource().clearRanges();

        // Filter by selected Site
        _formDataSource.queryBuildDataSource().addRange(fieldNum(METDutyRollValuesLine, Site)).value(queryValue(parentRec.Site));

        _formDataSource.executeQuery();
    }

]]></Source>
