						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Execute the query with the applied filters.
        /// </summary>
        public void executeQuery()
        {
            ItemId              itemId              = formRun.parmitemId();
            InventLocationId    inventLocationId    = formRun.parminventoryLocationId();

            if (formRun)
            {
                QueryBuildDataSource qbdsLoc = this.queryBuildDataSource();
                
                qbdsLoc.clearRanges();
                
                qbdsLoc.addRange(fieldNum(METItemPackDetailsView, ItemId)).value(itemId);
                qbdsLoc.addRange(fieldNum(METItemPackDetailsView, ItemId)).status(RangeStatus::Locked);
                
                if (inventLocationId)
                {                
                    qbdsLoc.addRange(fieldNum(METItemPackDetailsView, InventLocationId)).value(inventLocationId);
                }
                else
                {
                    qbdsLoc.clearRange(fieldNum(METItemPackDetailsView, InventLocationId));
                }
                qbdsLoc.addRange(fieldNum(METItemPackDetailsView, InventLocationId)).status(RangeStatus::Locked);
            }
            super();
        }

]]></Source>
