								<Source><![CDATA[
            /// <summary>
            /// MPJ-37288
            /// </summary>
            /// <param name = "_formReferenceControl"></param>
            /// <returns>ret</returns>
            public Common resolveReference(FormReferenceControl _formReferenceControl)
            {
                Common ret;
                EcoResCategoryHierarchyRole ecoResCategoryHierarchyRole;
                select firstonly ecoResCategoryHierarchyRole
                    where ecoResCategoryHierarchyRole.NamedCategoryHierarchyRole == EcoResCategoryNamedHierarchyRole::Retail;
                EcoResCategoryHierarchy     categoryHierarchy  = EcoResCategoryHierarchy::find(ecoResCategoryHierarchyRole.CategoryHierarchy);                
                
                ret = EcoResCategory::lookupCategoryHierarchy(_formReferenceControl,categoryHierarchy);
                
            
                return ret;
            }

]]></Source>
