				<Name>TestSetToComplete</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            METSalesOrderExtractionTable header;
            METSalesOrderExtractionTable headerToUpdate;

            header = METSalesOrderExtractionTable_ds.getFirst(true);
            while (header.RecId)
            {
                ttsbegin;

                headerToUpdate = METSalesOrderExtractionTable::find(header.ExtractionId, true);
                headerToUpdate.ExtractionStatus = METSalesOrderExtractionStatus::Completed;
                headerToUpdate.update();

                ttscommit;

                DEVIntegExportDocumentsLog::exportRecordList(DEVIntegExportRecordList::constructFromRecord(headerToUpdate, classStr(METSalesOrderExtractionExportIntegration)));

                header = METSalesOrderExtractionTable_ds.getNext();
            }

            METSalesOrderExtractionTable_ds.executeQuery();

            super();
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
			<Control>
				<Name>DEVIntegExportDocumentLog</Name>
				<Type>MenuFunctionButton</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            DEVIntegExportDocumentLog log = DEVIntegExportDocumentLog::findFromCommon(METSalesOrderExtractionTable, classStr(METSalesOrderExtractionExportIntegration));

            if (log)
            {
                METGlobal::runButtonWithRecord(this, log, element);
            }
            else
            {
                warning("No export document log found.");
            }
        }

]]></Source>
					</Method>
