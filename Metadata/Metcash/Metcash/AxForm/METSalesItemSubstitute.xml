            /// Lookup method for AccountRelation
            /// </summary>
            /// <param name = "_formControl">Form control</param>
            /// <param name = "_filterStr">Filter string</param>
            public void lookup(FormControl _formControl, str _filterStr)
            {
                // Call custom lookup for party code type Table so we can filter the customer lists using the Trading customer parameters
                if (METSalesItemSubstitute.AccountCode == METSalesItemSubstitutionAccountCodeType::Table)
                {
                    METSalesItemSubstitute::lookupCustomer(_formControl);
                }
                else
                {
                    super(_formControl, _filterStr);
                }
            }

