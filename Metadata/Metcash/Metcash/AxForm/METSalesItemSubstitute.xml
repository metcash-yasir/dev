					<Method>
						<Name>validateWrite</Name>
						<Source><![CDATA[
        public boolean validateWrite()
        {
            boolean ret;
        
            ret = super();
        
            if(ret)
            {
                // TODO prompt, date eff. change
                METSalesItemSubstitute  otherEntry;
                date                    d = today();    // **
                select firstonly validtimestate(d) otherEntry
                    where   otherEntry.AccountCode              == METSalesItemSubstitute.AccountCode
                    &&      otherEntry.AccountRelation          == METSalesItemSubstitute.AccountRelation
                    &&      otherEntry.InventSiteId             == METSalesItemSubstitute.InventSiteId
                    &&      otherEntry.ItemId                   == METSalesItemSubstitute.ItemId
                    &&      otherEntry.SubstitutionCode         == METSalesItemSubstitute.SubstitutionCode
                    &&      otherEntry.DateEffectivityCategory  == METSalesItemSubstitute.DateEffectivityCategory;
                if(otherEntry)
                {
                    if(Box::yesNo("An active substitution record exists for the selected item and substitution code. Expire the existing record and create a new record?", DialogButton::No) != DialogButton::Yes)
                    {
                        ret = false;
                    }
                }
            }

            return ret;
        }

]]></Source>
					</Method>
				</Methods>
