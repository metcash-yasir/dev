					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Datasource init method
        /// </summary>
        public void init()
        {
            super();

            if (element.args().dataset() == tableNum(SalesLine))
            {
                salesLine = element.args().record();                
            }            

            METSalesLinePriceComponentTmp.linkPhysicalTableInstance(METSalesPriceComponents::construct(salesLine.salesTable().SalesType).insertTmp(salesLine));

            METSalesLinePriceComponentTmp_ds.queryBuildDataSource().addSortField(fieldNum(METSalesLinePriceComponentTmp, LineNum));
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        /// Datasource active method
        /// </summary>
        /// <returns>Integer reference</returns>
        public int active()
        {
            int ret;
        
            ret = super();

            //Unable to link the tmp table with regular table hence filtering child table on active method

            METSalesLinePriceComponentDetail_ds.executeQuery();
        
            return ret;
        }

]]></Source>
					</Method>
				</Methods>
