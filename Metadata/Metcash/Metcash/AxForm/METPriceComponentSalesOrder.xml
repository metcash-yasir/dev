						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Datasource init method
        /// </summary>
        public void init()
        {
            super();

            if(salesType ==SalesType ::ReturnItem)
            {
                SysQuery::findOrCreateRange(METSalesLinePriceComponentDetail_ds.queryBuildDataSource(), fieldNum(METSalesLinePriceComponentDetail, InventTransId)).value(queryValue(METSalesPriceComponents::getInventTransID(salesLine)));
            }
            else
            {
                SysQuery::findOrCreateRange(METSalesLinePriceComponentDetail_ds.queryBuildDataSource(), fieldNum(METSalesLinePriceComponentDetail, InventTransId)).value(queryValue(salesLine.InventTransId));
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Datasource executequery method
        /// </summary>
        public void executeQuery()
        {
            METSalesLinePriceComponentDetail_ds.queryBuildDataSource().clearRange(fieldNum(METSalesLinePriceComponentDetail, Component));

            SysQuery::findOrCreateRange(METSalesLinePriceComponentDetail_ds.queryBuildDataSource(), fieldNum(METSalesLinePriceComponentDetail, Component)).value(queryValue(METSalesLinePriceComponentTmp.Component));
            SysQuery::findOrCreateRange(METSalesLinePriceComponentDetail_ds.queryBuildDataSource(), fieldNum(METSalesLinePriceComponentDetail, PriceCodeRef)).value(queryValue(METSalesLinePriceComponentTmp.PriceCodeRef));
            super();
        }

]]></Source>
