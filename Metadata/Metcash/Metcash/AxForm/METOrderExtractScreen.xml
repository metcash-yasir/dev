			<Method>
				<Name>totalPallets</Name>
				<Source><![CDATA[
    /// <summary>
    /// Calculates total pallets.
    /// </summary>
    /// <returns>pallets</returns>
    public display Integer totalPallets()
    {
        Integer     pallets; 
        if (WHSParameters::find().METPalletVolume > 0)
        {
            pallets =  any2Int((totalVolume/WHSParameters::find().METPalletVolume));
        }
        return pallets;
    }

]]></Source>
