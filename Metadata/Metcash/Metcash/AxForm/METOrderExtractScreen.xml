			<Method>
				<Name>extractOrders</Name>
				<Source><![CDATA[
    /// <summary>
    /// Populates the <c>METOrderExtractScreenTmp</c> table.
    /// </summary>
    public void extractOrders()
    {
        delete_from METOrderExtractScreenTmpDS;

        if (this.args().parmObject() == null)
        {
            metOrderExtractScreenParameters = METOrderExtractScreenParameters::construct();
        }
        else
        {
            metOrderExtractScreenParameters = this.args().parmObject() as METOrderExtractScreenParameters;
        }

        metOrderExtractScreenParameters.loadLastValue(formStr(METOrderExtractScreen));

        metOrderExtractScreenProcessor = METOrderExtractScreenProcessor::construct(METOrderExtractScreenTmpDS, metOrderExtractScreenParameters);

        totalVolume = metOrderExtractScreenProcessor.parmTotalVolume();

        SalesTable_ds.executeQuery();
    }

]]></Source>
			</Method>
