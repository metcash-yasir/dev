        /// <summary>
        /// initialize
        /// </summary>
        public void init()
        {
            super();

            date systemDate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());

            // Add and lock PurchId filter
            QueryBuildRange qbrPurchId = METPurchaseOrderAdjustmentView_ds.queryBuildDataSource().addRange(fieldNum(METPurchaseOrderAdjustmentView, PurchId));
            qbrPurchId.value( "0");
            qbrPurchId.status(RangeStatus::Locked); // 🔒 Lock the filter

            // Set default values for date controls (optional for UI input)
            Fromdatefilter.dateValue(systemDate - METConstants::oneDay);
            ToDateFilter.dateValue(systemDate);
        }

]]></Source>
