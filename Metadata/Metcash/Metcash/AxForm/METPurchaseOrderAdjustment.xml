			<Method>
				<Name>filterRecords</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void filterRecords()
    {
        if (element.validate())
        {
            FromDateTime fromDateTime = DateTimeUtil::newDateTime(Fromdatefilter.dateValue(), 0);
            ToDateTime toDateTime = DateTimeUtil::newDateTime(ToDateFilter.dateValue(), timeMax());
            InventLocationID inventLocationId = InventlocationIdFilter.valueStr();

            METPurchaseOrderAdjustmentView_ds.queryBuildDataSource().clearRanges();
            Query query = METPurchaseOrderAdjustmentView_ds.query();
            QueryBuildDataSource qbds = query.dataSourceTable(tableNum(METPurchaseOrderAdjustmentView));

            // 🔒 Lock Date range
            QueryBuildRange qbrDate = qbds.addRange(fieldNum(METPurchaseOrderAdjustmentView, CreatedDateTimePurchLine));
            qbrDate.value(SysQuery::range(fromDateTime, toDateTime));
            qbrDate.status(RangeStatus::Locked);

            // 🔒 Lock InventLocationId (if provided)
            if (inventLocationId)
            {
                QueryBuildRange qbrLoc = qbds.addRange(fieldNum(METPurchaseOrderAdjustmentView, InventLocationId));
                qbrLoc.value(queryValue(inventLocationId));
                qbrLoc.status(RangeStatus::Locked);
            }

            // 🔒 Lock IsValid = true
            QueryBuildRange qbrValid = qbds.addRange(fieldNum(METPurchaseOrderAdjustmentView, IsValid));
            qbrValid.value('1');
            qbrValid.status(RangeStatus::Locked);

            METPurchaseOrderAdjustmentView_ds.executeQuery();
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>validate</Name>
				<Source><![CDATA[
    public boolean validate()
    {
        #define.MinAllowedDaysBack(365)
        boolean ret = true;
        date today = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
        date minAllowedDate = today - #MinAllowedDaysBack;

        // Check if FromDateFilter is empty (mandatory check)
        if (!FromDateFilter.dateValue())
        {
            error("@MET:FromDateMandatory");
            ret = false;
        }
        // Check if From date is earlier than the minimum allowed date
        else if (FromDateFilter.dateValue() < minAllowedDate)
        {
            error(strFmt("@MET:FromDateEarlier", minAllowedDate));
            FromDateFilter.dateValue(minAllowedDate);
            ret = false;
        }

        // Check if ToDateFilter is empty (mandatory check)
        if (!ToDateFilter.dateValue())
        {
            error("@MET:ToDateMandatory");
            ret = false;
        }

        // Check if Warehouse is empty (mandatory check)
        if (!InventlocationIdFilter.valueStr() || !InventLocation::find(InventlocationIdFilter.valueStr()))
        {
            error("@MET:WarehouseMandatory");
            ret = false;
        }

        // Check if From date is greater than To date
        if (FromDateFilter.dateValue() && ToDateFilter.dateValue() &&
        FromDateFilter.dateValue() > ToDateFilter.dateValue())
        {
            error(strFmt("@MET:FromDateGreater",
                     FromDateFilter.dateValue(), ToDateFilter.dateValue()));
            ret = false;
        }

        return ret;
    }

]]></Source>
