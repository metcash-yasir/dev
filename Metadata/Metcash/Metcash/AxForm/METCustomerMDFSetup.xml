					<Field>
						<DataField>CustAccount</DataField>
						<Methods>
							<Method>
								<Name>modified</Name>
								<Source><![CDATA[
            /// <summary>
            /// TO fetch the site and warehouse from the customer master
            /// </summary>
            public void modified()
            {
                super();

                MetCustomerMdfTable mdfSetupTable = MetCustomerMdfTable_ds.cursor();

                if (mdfSetupTable.CustAccount)
                {
                    CustTable custTable;
                    InventLocation inventLocation;
                    select firstOnly custTable where custTable.AccountNum == mdfSetupTable.CustAccount;
                    mdfSetupTable.InventSiteId = custTable.InventSiteId;
                    mdfSetupTable.InventLocationId = custTable.InventLocation;
                    mdfSetupTable.ConsolidationMethodEDT = METConsolidationMethodEDT::Daily;
                }

            }

]]></Source>
