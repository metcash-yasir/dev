						<Methods>
							<Method>
								<Name>modified</Name>
								<Source><![CDATA[
            /// <summary>
            /// To update the ApplicationMethodEDT field based on the ConsolidationMethodEDT field value
            /// </summary>
            public void modified()
            {
                super();

                MetCustomerMdfTable mdfSetupTable = MetCustomerMdfTable_ds.cursor();

                // condition - adjust as needed
                if (mdfSetupTable.ConsolidationMethodEDT == METConsolidationMethodEDT::Daily) 
                {
                    mdfSetupTable.ApplicationMethodEDT = METApplicationMethodEDT::FreeTextInvoice;
                    MetCustomerMdfTable_ds.object(fieldNum(MetCustomerMdfTable, ApplicationMethodEDT)).allowEdit(false);
                }
                else
                {
                    MetCustomerMdfTable_ds.object(fieldNum(MetCustomerMdfTable, ApplicationMethodEDT)).allowEdit(true);
                }
                // Refrresh the datasource to reflect changes
                MetCustomerMdfTable_ds.refresh();
            }

]]></Source>
							</Method>
