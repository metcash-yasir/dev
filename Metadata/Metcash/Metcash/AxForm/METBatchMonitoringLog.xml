				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        void clicked()
        {
            Dialog      d = new Dialog("Clear log");
            DialogField df;
            ;
            df = d.addField(extendedTypeStr(Days), "Days to keep");
            df.value(30);
            if (d.run())
            {
                METBatchMonitoringLog::clearLog(df.value());
            }
            MonitoringLog_ds.research();
        }

]]></Source>
					</Method>
