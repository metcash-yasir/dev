			<Control>
				<Name>ViewBatchJob</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        void clicked()
        {
            BatchJob batchJobRec;
            Args     args;
            ;
            if (!MonitoringLog.BatchJobId)
            {
                warning("No batch job ID recorded for this log entry.");
                return;
            }

            select firstonly batchJobRec where batchJobRec.RecId == MonitoringLog.BatchJobId;
            if (!batchJobRec.RecId)
            {
                warning("Batch job record not found - it may have been cleaned up.");
                return;
            }

            args = new Args(formStr(BatchJobEnhanced));
            args.record(batchJobRec);
            new MenuFunction(menuItemDisplayStr(BatchJobEnhanced), MenuItemType::Display).run(args);
        }

]]></Source>
