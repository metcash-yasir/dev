			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        QueryBuildDataSource  qBDS;
        BatchJobHistory       callerBatchJobHistory;
        Common                callerRecord;
        ;
        super();

        if (!element.args() || !element.args().record())
        {
            METBatchMonitoringLogParameters::initParameters();
        }

        qBDS = MonitoringLog_ds.query().dataSourceName(MonitoringLog_ds.name());
        if (!qBDS)
        {
            return;
        }

        qBDS.addSortField(fieldnum(METBatchMonitoringLog, StartDateTime), SortOrder::Descending);
        qBDS.addSortField(fieldnum(METBatchMonitoringLog, RecId), SortOrder::Descending);

        if (element.args() && element.args().record())
        {
            callerRecord = element.args().record();
            switch (callerRecord.TableId)
            {
                case tableNum(BatchJob):
                    SysQuery::findOrCreateRange(qBDS, fieldNum(METBatchMonitoringLog, BatchJobId))
                        .value(queryValue(callerRecord.RecId));
                    break;

                case tableNum(BatchJobHistory):
                    callerBatchJobHistory = callerRecord;
                    SysQuery::findOrCreateRange(qBDS, fieldNum(METBatchMonitoringLog, BatchJobId))
                        .value(queryValue(callerBatchJobHistory.BatchJobId));
                    if (callerBatchJobHistory.StartDateTime)
                    {
                        SysQuery::findOrCreateRange(qBDS, fieldNum(METBatchMonitoringLog, StartDateTime))
                            .value(SysQuery::range(
                                callerBatchJobHistory.StartDateTime,
                                callerBatchJobHistory.EndDateTime ? callerBatchJobHistory.EndDateTime : DateTimeUtil::maxValue()));
                    }
                    break;
            }
        }
    }

]]></Source>
			</Method>
