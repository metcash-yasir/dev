    public void init()
    {
        FormStaticTextControl sitePolicyHelpText, rebateCompanyHelpText, rebateModuleHelpText, industryKeyHelpText, stateHelpText;

        super();

        // Set help text for TAM rebate company restriction policy
        rebateCompanyHelpText = this.design().controlName(formControlStr(METUserSecurityGroup, UserSecurityRebateCompanyListHelpText));
        rebateCompanyHelpText.text(METSecurityPolicyHelper::getTAMRebateCompanyRestrictionHelpText());

        // Set help text for TAM rebate module restriction policy
        rebateModuleHelpText = this.design().controlName(formControlStr(METUserSecurityGroup, UserSecurityRebateModuleListHelpText));
        rebateModuleHelpText.text(METSecurityPolicyHelper::getTAMRebateModuleRestrictionHelpText());

        // Set help text for site restriction policy
        sitePolicyHelpText = this.design().controlName(formControlStr(METUserSecurityGroup, UserSecurityWarehouseListHelpText));
        sitePolicyHelpText.text(METSecurityPolicyHelper::getWarehouseRestrictionHelpText());

        // Set help text for industry key restriction policy
        industryKeyHelpText = this.design().controlName(formControlStr(METUserSecurityGroup, METUserSecurityMETIndustryKeyTableListHelpText));
        industryKeyHelpText.text(METSecurityPolicyHelper::getMETIndustryKeyRestrictionHelpText());

        // Set help text for state restriction policy
        stateHelpText = this.design().controlName(formControlStr(METUserSecurityGroup, UserSecurityStateListHelpText));
        stateHelpText.text(METSecurityPolicyHelper::getStateRestrictionHelpText());
    }

]]></Source>
