		<DataControls xmlns="">
			<Control>
				<Name>DeleteButtonControl</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void clicked()
        {
            METUserSitesAssignment record;

            record = METUserSitesAssignment_ds.cursor();

            if (record.RecId)
            {
                if (Box::okCancel("Delete this site assignment?", DialogButton::Cancel) == DialogButton::Ok)
                {
                    ttsbegin;
                    record.delete();
                    ttscommit;

                    // Refresh the grid with custom query
                    METUserSitesAssignment_ds.executeQuery();
                }
            }
            else
            {
                warning("Select a record to delete.");
            }
        }

]]></Source>
					</Method>
