				<Methods>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            super();

            if (!METUserSitesAssignment_DS.cursor().RecId)
            {
                // Set default value for GroupId and UserId field
                UserGroupList userGroupListCur = UserGroupList_DS.cursor();
                METUserSitesAssignment userSiteAssignment = METUserSitesAssignment_DS.cursor();

                userSiteAssignment.UserGroupId = userGroupListCur.groupId;
                userSiteAssignment.UserId = userGroupListCur.userId;
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            QueryBuildDataSource qbds;
            QueryBuildRange qbrGroup, qbrUser;
            UserGroupList userGroupListCurrent;

            // Get METUserSitesAssignment query data source
            qbds = this.query().dataSourceTable(tableNum(METUserSitesAssignment));

            // Clear all ranges to start fresh
            qbds.clearRanges();

            // Get the currently active/selected user from UserGroupList grid
            userGroupListCurrent = UserGroupList_ds.cursor();

            if (userGroupListCurrent.RecId)
            {
                // Add range: UserGroupId = selected user's groupId
                qbrGroup = qbds.addRange(fieldNum(METUserSitesAssignment, UserGroupId));
                qbrGroup.value(queryValue(userGroupListCurrent.groupId));

                // Add range: UserId = selected user's userId
                qbrUser = qbds.addRange(fieldNum(METUserSitesAssignment, UserId));
                qbrUser.value(queryValue(userGroupListCurrent.userId));
            }
            else
            {
                // No user selected - return empty result
                qbrGroup = qbds.addRange(fieldNum(METUserSitesAssignment, UserGroupId));
                qbrGroup.value(SysQuery::valueEmptyString());
            }
            
            super();
        }

]]></Source>
					</Method>
					<Method>
						<Name>delete</Name>
						<Source><![CDATA[
        public void delete()
        {
            super();

            // Refresh with custom query logic
            this.executeQuery();
        }

]]></Source>
					</Method>
				</Methods>
