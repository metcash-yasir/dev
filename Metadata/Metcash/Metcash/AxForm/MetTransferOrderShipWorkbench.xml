    /// <summary>
    /// Populates the <c>METOrderExtractScreenTmp</c> table.
    /// </summary>
    public void populateOrders()
    {
        delete_from MetTransferOrderShipWorkbenchTmp;

        if (this.args().parmObject() == null)
        {
            MetTransferOrderShipWorkbenchExtractFilter = MetTransferOrderShipWorkbenchExtractFilter::construct();
        }
        else
        {
            MetTransferOrderShipWorkbenchExtractFilter = this.args().parmObject() as MetTransferOrderShipWorkbenchExtractFilter;
        }

        MetTransferOrderShipWorkbenchExtractFilter.loadLastValue(formStr(MetTransferOrderShipWorkbench));

        MetTransferOrderShipWorkbenchProcessor = MetTransferOrderShipWorkbenchProcessor::construct(MetTransferOrderShipWorkbenchTmp, MetTransferOrderShipWorkbenchExtractFilter);


        latestUpdateDate = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
        latestUpdateTime = DateTimeUtil::getTimeNow(DateTimeUtil::getUserPreferredTimeZone());
        fromWarehouse    = MetTransferOrderShipWorkbenchExtractFilter.parmFromWarehouse();
        fromShipDate     = MetTransferOrderShipWorkbenchExtractFilter.parmFromShipDate();
        toShipdate       = MetTransferOrderShipWorkbenchExtractFilter.parmToShipDate();
        MetTransferOrderShipWorkbenchTmp_ds.research();

    }

]]></Source>
