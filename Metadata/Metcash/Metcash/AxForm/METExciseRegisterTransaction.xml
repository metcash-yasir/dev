						<Source><![CDATA[
        /// <summary>
        /// Form initialize method
        /// </summary>
        public void init()
        {
            super();

            if (element.args().dataset() == tableNum(METExciseRegisterView))
            {
                metExciseRegisterView = element.args().record();

                ItemId.text(metExciseRegisterView.ItemId);
                Lodgement.text(metExciseRegisterView.Lodgement);
                SiteId.text(metExciseRegisterView.SiteId);

                SysQuery::findOrCreateRange(this.queryBuildDataSource(), fieldNum(METExciseRegisterTransaction, Lodgement)).value(SysQuery::valueLike(metExciseRegisterView.Lodgement));
                SysQuery::findOrCreateRange(this.queryBuildDataSource(), fieldNum(METExciseRegisterTransaction, OriginType)).value(SysQuery::valueNot(InventTransType::Purch));
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>displayLodgementQty</Name>
						<Source><![CDATA[
        /// <summary>
        /// Display method to fetch and show lodgement qty
        /// </summary>
        /// <param name = "_metExciseRegisterTransaction">METExciseTransaction view</param>
        /// <returns>Lodgement qty</returns>
        public display InventQty displayLodgementQty(METExciseRegisterTransaction   _metExciseRegisterTransaction)
        {
            METExciseRegisterTransaction_ds.observe();

            int i;

            InventQty       lodgementQty;
            container       con = _metExciseRegisterTransaction.LodgementAndQtyCon;

            i = conFind(con, metExciseRegisterView.Lodgement);

            lodgementQty = conPeek(con, i + 1);

            if (_metExciseRegisterTransaction.TransactionQty < 0)
            {
                if (lodgementQty > 0)
                {
                    return lodgementQty * -1;
                }
                else
                {
                    return lodgementQty;
                }
            }
            else
            {
                if (lodgementQty < 0 )
                {
                    return lodgementQty * -1;
                }
                else
                {
                    return lodgementQty;
                }
            }
                
        }

]]></Source>
