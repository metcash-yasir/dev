					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// init
        /// </summary>
        public void init()
        {
            super();

            boolean editable = true;

            if(element.args().parm() == METConstants::Inactive)
            {
                METSalesOrderGuideTable_ds.queryBuildDataSource().addRange(fieldNum(METSalesOrderGuideTable, Status)).value(queryValue(METSalesOrderGuideStatus::Inactive));
                editable = false;

                METSalesOrderGuideHistory.visible(false);
            }
            if(element.args().parm() == METConstants::History)
            {
                METSalesOrderGuideTable_ds.queryBuildDataSource().addRange(fieldNum(METSalesOrderGuideTable, Status)).value(queryValue(METSalesOrderGuideStatus::Inactive));

                METSalesOrderGuideTable callerGuide = element.args().record();
                if(!callerGuide)
                {
                    throw error(error::missingRecord(funcName()));
                }
                METSalesOrderGuideTable_ds.queryBuildDataSource().addRange(fieldNum(METSalesOrderGuideTable, SalesOrderGuideID)).value(callerGuide.baseGuideID() + '*');
                editable = false;

                METSalesOrderGuideHistory.visible(false);            
            }

            else
            {
                METSalesOrderGuideTable_ds.queryBuildDataSource().addRange(fieldNum(METSalesOrderGuideTable, Status)).value(
                    queryValue(METSalesOrderGuideStatus::New) + ',' + 
                    queryValue(METSalesOrderGuideStatus::Active));
            }

            METSalesOrderGuideTable_ds.allowEdit(editable);
            METSalesOrderGuideTable_ds.allowCreate(editable);
            METSalesOrderGuideTable_ds.allowDelete(editable);

            if(!editable)
            {
                ManageButtonGroup.visible(false);
                PublishButtonGroup.visible(false);                
            }
        }

]]></Source>
					</Method>
