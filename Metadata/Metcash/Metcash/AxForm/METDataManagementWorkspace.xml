					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// DMFDefinitionGroup datasource
        /// </summary>
        public void init()
        {
            QueryBuildDataSource qbds;
            super();

            dataProjectFilterRange = METDMFFormUtil::setDataProjectFilterRange(this.queryBuildDataSource());
            METDMFFormUtil::setDataSourceFilterByLegalEntity(this.query());

            //If data management form is opened from entity list page we need to filter data projects to show only related ones
            if (element.args().record().RecId != 0 && element.args().record().TableId == tableNum(DMFEntity))
            {
                DMFEntity dmfEntity = element.args().record();
                    
                qbds = this.queryBuildDataSource();
                qbds = qbds.addDataSource(tableNum(DMFDefinitionGroupEntity));
                qbds.relations(true);
                qbds.JoinMode(JoinMode::ExistsJoin);
            
                qbds.addRange(fieldNum(DMFDefinitionGroupEntity, Entity)).value(dmfEntity.EntityName);
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>operationTypeIcon</Name>
						<Source><![CDATA[
        public display container operationTypeIcon(DMFDefinitionGroup _dmfDefinitionGroup)
        {
            ImageReference  imageReference;
            container       imageContainer;

            switch (_dmfDefinitionGroup.OperationType)
            {
                case DMFOperationType::Import:
                    imageReference = ImageReference::constructForSymbol('Import');
                    break;
                case DMFOperationType::Export:
                    imageReference = ImageReference::constructForSymbol('Export');
                    break;
            }

            if (imageReference)
            {
                imageContainer = imageReference.pack();
            }

            return imageContainer;

        }

]]></Source>
