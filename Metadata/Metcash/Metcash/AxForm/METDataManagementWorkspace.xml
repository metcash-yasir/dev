        /// <summary>
        /// display method To showFieldAccessException the status of
        /// entity after file import and mapping are completed
        /// </summary>
        /// <param name = "_dmfExecution">dmfExecution buffer</param>
        /// <returns>Image container</returns>
        public display container executionTargetStatus(DMFExecution _dmfExecution)
        {
            DMFExecutionSummaryStatus summaryStatus = _dmfExecution.GetExecutionSummaryStatus();
            return DMFExecutionStatusHelper::GetExecutionSummaryStatusImageReference(summaryStatus);
        }

