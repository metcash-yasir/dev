    /// Check if ok or cancel is clicked to process further
    /// </summary>
    /// <returns>true or false</returns>
    public boolean closedOk()
    {
        boolean ret;
    
        ret = super();

        if (ret)
        {
            METKleberPredictiveSearchTmp kleberPredictiveSearchTmp = METKleberPredictiveSearchTmp_ds.cursor();

            element.setLogisticsPostalAddressValues(kleberPredictiveSearchTmp);
            
            ttsbegin;
            delete_from kleberPredictiveSearchTmp where kleberPredictiveSearchTmp.RequestId == requestId;
            ttscommit;

        }
    
        return ret;
    }

