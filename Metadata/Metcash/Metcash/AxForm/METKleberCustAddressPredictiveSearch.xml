    /// <summary>
    /// Set logisticsPostalAddress values from predictive search selection
    /// </summary>
    /// <param name = "_kleberPredictiveSearchTmp"></param>
    void setLogisticsPostalAddressValues(METKleberPredictiveSearchTmp _kleberPredictiveSearchTmp)
    {
        logsiticsPostalAddress.Street = _kleberPredictiveSearchTmp.AddressLine;
        logsiticsPostalAddress.City = _kleberPredictiveSearchTmp.Locality;
        logsiticsPostalAddress.State = _kleberPredictiveSearchTmp.State;
        logsiticsPostalAddress.ZipCode = _kleberPredictiveSearchTmp.Postcode;
        logsiticsPostalAddress.modifiedFieldZipCode();
        logsiticsPostalAddress.METVerified = NoYes::Yes;
    }

