			<Method>
				<Name>filterRecords</Name>
				<Source><![CDATA[
    /// <summary>
    /// filterRecords
    /// </summary>
    public void filterRecords()
    {
        if (element.validate())
        {
            InventLocationID inventLocationId = InventlocationIdFilter.valueStr();

            InventjournalTrans_ds.queryBuildDataSource().clearRanges();
            Query query = InventjournalTrans_ds.query();
            QueryBuildDataSource qbds = query.dataSourceTable(tableNum(InventjournalTrans));

            // Lock date range
            QueryBuildRange qbrDate = qbds.addRange(fieldNum(InventjournalTrans, TransDate));
            qbrDate.value(SysQuery::range(Fromdatefilter.dateValue(), ToDateFilter.dateValue()));
            qbrDate.status(RangeStatus::Locked); // Lock

            // Lock InventLocationId
            qbds = query.dataSourceTable(tableNum(InventDim));
            qbds.clearRange(fieldNum(InventDim, InventLocationId));
    
            if (inventLocationId)
            {
                QueryBuildRange qbrLocation = qbds.addRange(fieldNum(InventDim, InventLocationId));
                qbrLocation.value(queryValue(inventLocationId));
                qbrLocation.status(RangeStatus::Locked); // Lock
            }

            InventjournalTrans_ds.executeQuery();
            InventjournalTrans_ds.refresh();
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// init
    /// </summary>
    public void init()
    {
        super();

        QueryBuildRange qbrPosted, qbrJournalType;
        QueryBuildDataSource qbds = InventjournalTable_ds.query().dataSourceTable(tableNum(InventJournalTable));

        // ✅ Filter only posted records and lock it
        qbrPosted = qbds.addRange(fieldNum(InventJournalTable, Posted));
        qbrPosted.value(queryValue(NoYes::Yes));
        qbrPosted.status(RangeStatus::Locked); // Lock

        // ✅ Filter JournalType = Count and lock it
        qbrJournalType = qbds.addRange(fieldNum(InventJournalTable, JournalType));
        qbrJournalType.value(queryValue(InventJournalType::Count));
        qbrJournalType.status(RangeStatus::Locked); // Lock
    }

]]></Source>
			</Method>
			<Method>
				<Name>validate</Name>
				<Source><![CDATA[
    public boolean validate()
    {
        #define.MinAllowedDaysBack(365)
        boolean ret = true;
        date today = DateTimeUtil::getSystemDate(DateTimeUtil::getUserPreferredTimeZone());
        date minAllowedDate = today - #MinAllowedDaysBack;

        // Check if FromDateFilter is empty (mandatory check)
        if (!FromDateFilter.dateValue())
        {
            error("@MET:FromDateMandatory");
            ret = false;
        }
        // Check if From date is earlier than the minimum allowed date
        else if (FromDateFilter.dateValue() < minAllowedDate)
        {
            error(strFmt("@MET:FromDateEarlier", minAllowedDate));
            FromDateFilter.dateValue(minAllowedDate);
            ret = false;
        }

        // Check if ToDateFilter is empty (mandatory check)
        if (!ToDateFilter.dateValue())
        {
            error("@MET:ToDateMandatory");
            ret = false;
        }

        // Check if Warehouse is empty (mandatory check)
        if (!InventlocationIdFilter.valueStr() || !InventLocation::find(InventlocationIdFilter.valueStr()))
        {
            error("@MET:WarehouseMandatory");
            ret = false;
        }

        // Check if From date is greater than To date
        if (FromDateFilter.dateValue() && ToDateFilter.dateValue() &&
        FromDateFilter.dateValue() > ToDateFilter.dateValue())
        {
            error(strFmt("@MET:FromDateGreater",
                     FromDateFilter.dateValue(), ToDateFilter.dateValue()));
            ret = false;
        }

        return ret;
    }

]]></Source>
