					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Handles the click event of the OK button.
        /// </summary>
        public void clicked()
        {
            int     i;
            str     item            = ItemId.valueStr();
            int     numIter         = NumOfIteration.value();
            NoYes   updPurchPrice   = UpdatePurchPrice.value();
            NoYes   updSalesPrice   = UpdateSalesPrice.value();

            InventTable         inventTable;
            InventTableModule   inventTableModulePurch;
            InventTableModule   inventTableModuleSales;

            if (!item || numIter <= 0)
            {
                info("@MET:ValidItemAndIteration");
                return;
            }

            inventTable = InventTable::find(item);
            if (!inventTable)
            {
                info(strFmt("@MET:ItemIdNotFound", item));
                return;
            }

            inventTableModulePurch = InventTableModule::find(inventTable.ItemId, ModuleInventPurchSales::Purch, true);
            inventTableModuleSales = InventTableModule::find(inventTable.ItemId, ModuleInventPurchSales::Sales, true);

            ttsbegin;
            for (i = 1; i <= numIter; i++)
            {
                if (updPurchPrice == NoYes::Yes && inventTableModulePurch)
                {
                    inventTableModulePurch.Price += 1;
                    inventTableModulePurch.update();
                }

                if (updSalesPrice == NoYes::Yes && inventTableModuleSales)
                {
                    inventTableModuleSales.Price += 1;
                    inventTableModuleSales.update();
                }
            }
            ttscommit;

            super();
        }

]]></Source>
					</Method>
				</Methods>
