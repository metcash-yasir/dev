					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        /// active
        /// </summary>
        /// <returns>int</returns>
        public int active()
        {
            int ret;
        
            ret = super();

            if(MetTransferShipmentTable.ShipmentStatus == MetShipmentStatus::Open)
            {
                btnOutboundShipConfirm.enabled(true);
            }
            else
            {
                btnOutboundShipConfirm.enabled(false);
            }

            btnOutboundShipConfirm.enabled(MetTransferShipmentTable.ShipmentStatus == MetShipmentStatus::Open|| MetTransferShipmentTable.ShipmentStatus != MetShipmentStatus::Loaded ||
                                                      MetTransferShipmentTable.LoadId == metLoadId);
           
            
            metLoadId = MetTransferShipmentTable.LoadId;
        
            return ret;
        }

]]></Source>
					</Method>
