					<Method>
						<Name>markChanged</Name>
						<Source><![CDATA[
        /// <summary>
        /// Confirm shipment button needs to remain active if the shipments in a single load are selected for confirmation. This is to allow confirmation of all shipments in a load at once.
        /// The same logic to prevent shipment confirmation across loads (the button is to deactivate if shipments across loads are selected for confirmation).
        /// </summary>
        public void markChanged()
        {
            MetTransferShipmentTable       metTransferTableMarked;
            METLoadId               loadId;
            boolean                 sameLoadId = true;
            boolean                 openStatus = true, loadedStatus = true;
            MultiSelectionHelper    multiSelectionHelper =  MultiSelectionHelper::construct();
            multiSelectionHelper.parmDatasource(MetTransferShipmentTable_ds);
            metTransferTableMarked = multiSelectionHelper.getFirst();
            
            loadId = metTransferTableMarked.LoadId;
            openStatus = metTransferTableMarked.ShipmentStatus == MetShipmentStatus::Open;
            loadedStatus = metTransferTableMarked.ShipmentStatus == MetShipmentStatus::Loaded;
            
            while (metTransferTableMarked)
            {
                metTransferTableMarked = multiSelectionHelper.getNext();

                if (metTransferTableMarked && loadId != metTransferTableMarked.LoadId)
                {
                    sameLoadId = false;
                    break;
                }

                if (metTransferTableMarked && metTransferTableMarked.ShipmentStatus != MetShipmentStatus::Open)
                {
                    openStatus = false;
                }

                if (metTransferTableMarked && metTransferTableMarked.ShipmentStatus != MetShipmentStatus::Loaded)
                {
                    loadedStatus = false;
                }
            }
            
            btnOutboundShipConfirm.enabled(sameLoadId && openStatus);
            
            super();
        }

]]></Source>
					</Method>
