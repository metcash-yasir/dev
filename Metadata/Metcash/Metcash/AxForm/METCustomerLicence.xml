					<Method>
						<Name>write</Name>
						<Source><![CDATA[
        /// <summary>
        /// write METCustomerLicence
        /// </summary>
        public void write()
        {
            super();  

            // Research to force CustAccountName view to select and show the customer name
            element.args().lookupRecord(METCustomerLicence);
            // Issue with research adding a sort by recId by default MS ticket #2312060030006177
            METCustomerLicence_ds.research(false);
        }

]]></Source>
					</Method>
					<Method>
						<Name>validateWrite</Name>
						<Source><![CDATA[
        /// <summary>
        /// validate write used to set LicenceExpiryDate if empty
        /// </summary>
        /// <returns>true if validation successful; otherwise, false</returns>
        public boolean validateWrite()
        {
            boolean ret;
        
            // If no date entered by user, set to 31/12/2154 (Max Date).
            if (!METCustomerLicence.LicenceExpiryDate)
            {
                METCustomerLicence.LicenceExpiryDate = dateMax();
            }

            ret = super();
        
            return ret;
        }

]]></Source>
