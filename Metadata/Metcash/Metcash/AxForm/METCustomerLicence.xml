			<Method>
				<Name>updateControls</Name>
				<Source><![CDATA[
    public void updateControls()
    {
        boolean isLiquorLicence = !METCustomerLicence.isTobaccoLicence();

        METCustomerLicence_ds.object(fieldNum(METCustomerLicence, StateId)).mandatory(isLiquorLicence);
        METCustomerLicence_ds.object(fieldNum(METCustomerLicence, StateId)).allowEdit(isLiquorLicence);
        METCustomerLicence_ds.object(fieldNum(METCustomerLicence, LicenceCategory)).allowEdit(isLiquorLicence);
        METCustomerLicence_ds.object(fieldNum(METCustomerLicence, IndustryIdentifier)).allowEdit(isLiquorLicence);

        METCustomerLicence_ds.object(fieldNum(METCustomerLicence, LicenceExpiryDate)).allowEdit(METCustomerLicence.LicenceCategory != METLicenceCategory::Unlicenced);
    }

]]></Source>
