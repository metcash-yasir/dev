			<Method>
				<Name>disableOrderGuide</Name>
				<Source><![CDATA[
    /// <summary>
    /// change Status to Disable
    /// </summary>
    private void disableOrderGuide()
    {
        METSalesOrderGuideItem  salesOrderGuideItem = METSalesOrderGuideItem_ds.getFirst(true);

        while(salesOrderGuideItem)
        {
            if (salesOrderGuideItem.Status == MetEnabledDisabled::Enable)
            {
                salesOrderGuideItem.Status = MetEnabledDisabled::Disable;
                salesOrderGuideItem.update();
            }
            salesOrderGuideItem = METSalesOrderGuideItem_ds.getNext();
        }

        METSalesOrderGuideItem_ds.executeQuery();
    }

]]></Source>
