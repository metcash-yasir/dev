						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Triggers on this button click.
        /// </summary>
        public void clicked()
        {
            SysQueryRun queryRun;

            if (metFulfilmentProfile.RecId)
            {
                queryRun = new SysQueryRun(new Query(metFulfilmentProfile.ConditionQueryPacked));

                //queryRun.args().caller(element);
                queryRun.title("@SYS90545");
                queryRun.promptShowSorting(false);
                queryRun.promptShowReset(false);
                queryRun.promptLoadLastUsedQuery(false);

                if (queryRun.prompt())
                {
                    metFulfilmentProfile.ConditionQueryPacked = queryRun.query().pack();
                    metFulfilmentProfile_ds.write();
                }

                element.refreshCondtions();
            }
        }

]]></Source>
