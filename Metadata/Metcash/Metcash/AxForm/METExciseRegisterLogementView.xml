			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Form initialize method
    /// </summary>
    public void init()
    {
        super();

        if (element.args().dataset() == tableNum(InventTable))
        {
            inventTable = element.args().record();
        }
        else
        {
            throw error("@SYS104799");
        }
        SysQuery::findOrCreateRange(METExciseRegisterView_ds.queryBuildDataSource(), fieldNum(METExciseRegisterView, OriginType)).value(queryValue(InventTransType::Purch));
        LodgementStatus.selection(enum2int(METCloseOpenAll::Open));
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>METExciseRegisterView</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Database execute query method
        /// </summary>
        public void executeQuery()
        {
            METExciseRegisterView_ds.queryBuildDataSource().clearRange(fieldNum(METExciseRegisterView, LodgementClosed));
            METExciseRegisterView_ds.queryBuildDataSource().clearRange(fieldNum(METExciseRegisterView, SiteId));

            if (LodgementStatus.selection() == enum2int(METCloseOpenAll::Open))
            {
                SysQuery::findOrCreateRange(METExciseRegisterView_ds.queryBuildDataSource(), fieldNum(METExciseRegisterView, LodgementClosed)).value(queryValue(NoYes::No));
            }
            else if (LodgementStatus.selection() == enum2int(METCloseOpenAll::Closed))
            {
                SysQuery::findOrCreateRange(METExciseRegisterView_ds.queryBuildDataSource(), fieldNum(METExciseRegisterView, LodgementClosed)).value(queryValue(NoYes::Yes));
            }

            if (SiteId.valueStr() != '')
            {
                SysQuery::findOrCreateRange(METExciseRegisterView_ds.queryBuildDataSource(), fieldNum(METExciseRegisterView, SiteId)).value(queryValue(SiteId.valueStr()));
            }
            super();
        }

]]></Source>
					</Method>
