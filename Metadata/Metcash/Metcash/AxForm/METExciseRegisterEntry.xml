				<Source><![CDATA[
    /// <summary>
    /// Updates the design of the form based on the active tab.
    /// </summary>
    private void updateDesign()
    {
        str queryRangeStr = '';

        QueryBuildRange qbrValidFrom, qbrValidTo;

       
        if (HistoryTabPage.isActivePage())
        {
            METExciseRegisterEntry metExciseRegisterEntryActive = METExciseRegisterEntry_ds.cursor();

            qbrValidFrom = SysQuery::findOrCreateRange(METExciseRegisterEntryHistory_ds.queryBuildDataSource(), fieldNum(METExciseRegisterEntry,ValidFrom));
            qbrValidTo   = SysQuery::findOrCreateRange(METExciseRegisterEntryHistory_ds.queryBuildDataSource(), fieldNum(METExciseRegisterEntry,ValidTo));

            queryRangeStr = DateEffectivenessCheck::queryRange(false, true, false);
            METExciseRegisterEntryHistory_ds.query().validTimeStateDateTimeRange(DateTimeUtil::minValue(), DateTimeUtil::utcNow());
            METExciseRegisterEntryHistory_ds.validTimeStateUpdate(ValidTimeStateUpdate::Correction);

            SysQuery::findOrCreateRange(METExciseRegisterEntryHistory_ds.queryBuildDataSource(), fieldNum(METExciseRegisterEntry, ReferenceId)).value(queryValue(metExciseRegisterEntryActive.ReferenceId));

            if (queryRangeStr)
            {
                qbrValidFrom.value(
                            strFmt(queryRangeStr,
                                METExciseRegisterEntryHistory_ds.name(),
                                fieldStr(METExciseRegisterEntry,ValidFrom),
                                fieldStr(METExciseRegisterEntry,ValidTo),
                                DateTimeUtil::toStr(DateTimeUtil::utcNow())));
            }
            METExciseRegisterEntryHistory_ds.executeQuery();
        }
    }

]]></Source>
