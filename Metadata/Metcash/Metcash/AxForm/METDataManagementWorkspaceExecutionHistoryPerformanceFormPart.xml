						<Source><![CDATA[
        public void clicked()
        {
            super();

            DMFDefinitionGroupExecution dmfDefinitionGroupExecution;

            select firstonly dmfDefinitionGroupExecution
                where dmfDefinitionGroupExecution.ExecutionId == DMFExecution.ExecutionId;

            Args args = new Args();
            args.caller(this);
            args.record(dmfDefinitionGroupExecution);

            new MenuFunction(MenuItemActionStr(DMFDownloadDataPackage), MenuItemType::Action).run(args);
        }

