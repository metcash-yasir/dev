			<Method>
				<Name>setDownloadPackageControl</Name>
				<Source><![CDATA[
    /// <summary>
    /// Hide the download package when the operation type is import or when the data source is EntityDB.
    /// </summary>
    private void setDownloadPackageControl()
    {
        DMFDefinitionGroupExecution groupExecution;
        DMFDataSource dmfdatasource;

        if(DMFUtil::getOperationTypeForExecution(DMFExecution.ExecutionId) == DMFOperationType::Export)
        {
            select firstonly type from dmfdatasource
                exists join groupExecution
                    where groupExecution.Source == dmfdatasource.SourceName
                        && groupExecution.ExecutionId == DMFExecution.ExecutionId;

            if (dmfdatasource.Type == DMFSourceType::EntityDB)
            {
                DownloadPackage.enabled(false);
            }
            else
            {
                DownloadPackage.enabled(true);
            }
        }
        else
        {
            DownloadPackage.enabled(false);
        }
    }

]]></Source>
