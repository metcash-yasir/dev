					<Method>
						<Name>selectionChanged</Name>
						<Source><![CDATA[
        public void selectionChanged()
        {
            super();

            Array array = DMFExecution_ds.recordsMarked();
            if (Array.lastIndex() <= 1)
            {
                element.setDownloadPackageControl();
            }
        }

]]></Source>
