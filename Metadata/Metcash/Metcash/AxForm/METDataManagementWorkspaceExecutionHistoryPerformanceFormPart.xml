[Form]
public class METDataManagementWorkspaceExecutionHistoryPerformanceFormPart extends FormRun
{
    private QueryBuildRange executionDateFilterRange;
    private DMFExecutionHistoryDateFilterOptions historyDateFilter;
    private MenuItemName callingMenuItemName;
    private utcdatetime executionSummaryStatusFilterDateTime;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        switch (this.args().parmEnumType())
        {
            case enumNum(DMFExecutionHistoryDateFilterOptions):
                historyDateFilter = this.args().parmEnum();
                break;

            default:
                historyDateFilter = DMFExecutionHistoryDateFilterOptions::All;
                break;
        }

        callingMenuItemName = this.args().menuItemName();

        super();

        this.setViewExecutionControl();
    }

]]></Source>
			</Method>
			<Method>
				<Name>setViewExecutionControl</Name>
				<Source><![CDATA[
    private void setViewExecutionControl()
    {
        DMFFormView formView = element.getFormView();
        boolean isEnhancedView = (formView != DMFFormView::StandardView);

        ViewExecution.visible(!isEnhancedView);
        ViewExecutionEnhanced.visible(isEnhancedView);
    }

]]></Source>
			</Method>
			<Method>
				<Name>getFormView</Name>
				<Source><![CDATA[
    private DMFFormView getFormView()
    {
        DMFFormView formView;

        if (DMFFormViewUserParameters::isGlobalOverrideActive())
        {
            formView = DMFParameters::find().DefaultFormView;
        }
        else
        {
            DMFFormViewUserParameters userFormParameters = DMFFormViewUserParameters::findByUserId(curUserId());

            if (userFormParameters)
            {
                formView = userFormParameters.ViewExecutionViewMode;
            }
        }

        return formView;
    }

]]></Source>
			</Method>
