								<Source><![CDATA[
            /// <summary>
            /// Clear the field name if table name is changed
            /// </summary>
            public void modified()
            {   
                METTableFieldNames tableName    = METTableFieldNames_ds.cursor();

                super();

                // If table Name is changed than blank the record else ignore it
                if (tableName.orig().CustTableName != METTableFieldNames.CustTableName)
                {
                    METTableFieldNames.TableFieldName = '';
                    METMandatorySetups_ds.research();
                }
                

            }

]]></Source>
