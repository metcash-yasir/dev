							<Method>
								<Name>lookupTableName</Name>
								<Source><![CDATA[
            public void lookupTableName(TableName _tableName, FormControl _formControl)
            {
                Query query = new Query();
                QueryBuildDataSource queryBuildDataSource = query.addDataSource(tableNum(SysTableFieldIdView));
                QueryBuildRange queryBuildRange;
                SysTableLookup sysTableLookup =  SysTableLookup::newParameters(tableNum(SysTableFieldIdView), _formControl);
                sysTableLookup.addLookupField(fieldNum(SysTableFieldIdView, Name));
                queryBuildRange = queryBuildDataSource.addRange(fieldNum(SysTableFieldIdView, Id));
                queryBuildRange.value(SysQuery::value(tableName2Id(_tableName)));
                sysTableLookup.parmQuery(query);
                sysTableLookup.performFormLookup();
            }

]]></Source>
