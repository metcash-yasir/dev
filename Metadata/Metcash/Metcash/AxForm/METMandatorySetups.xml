			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initializes the temp table data to load with specific table fields from <c>METCustTableNames</c> base enum.
    /// </summary>
    public void init()
    {
        super();

        SysDictEnum SysDictEnum = new SysDictEnum(enumNum(METCustTableNames));

        for (int i = 0; i < SysDictEnum.values(); i++)
        {
            this.fillTempTableData(SysDictEnum.index2Label(i));
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>fillTempTableData</Name>
				<Source><![CDATA[
    /// <summary>
    /// Inserts the temp table data based on enum values.
    /// </summary>
    /// <param name = "_tableName">_tableName</param>
    void fillTempTableData(TableName _tableName)
    {
        RecordInsertList insertList = new RecordInsertList(tableNum(METTableFieldNamesTmp));
        SysDictTable dictTable = new SysDictTable(tableName2Id(_tableName));
        SysDictField dictField;
        FieldId fieldId = dictTable.fieldNext(0);

        while (fieldId)
        {
            dictField = dictTable.fieldObject(fieldId);

            if (dictField.isSql() && !dictField.isSystem())
            {
                fieldsTmp.Label = dictField.label();
                fieldsTmp.FieldName = dictField.name();
                fieldsTmp.TableName = _tableName;
                fieldsTmp.insert();
            }

            fieldId = dictTable.fieldNext(fieldId);
        }
    }

]]></Source>
			</Method>
