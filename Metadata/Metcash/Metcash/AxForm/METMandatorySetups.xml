						<Methods>
							<Method>
								<Name>lookup</Name>
								<Source><![CDATA[
            /// <summary>
            /// Gives the lookup for the field names.
            /// </summary>
            /// <param name = "_formControl">_formControl</param>
            /// <param name = "_filterStr">_filterStr</param>
            public void lookup(FormControl _formControl, str _filterStr)
            {
                this.lookupTableName(enum2Str(METTableFieldNames.CustTableName), _formControl);
            }

]]></Source>
							</Method>
							<Method>
								<Name>lookupTableName</Name>
								<Source><![CDATA[
            /// <summary>
            /// Prepares the lookup query.
            /// </summary>
            /// <param name = "_tableName">_tableName</param>
            /// <param name = "_formControl">_formControl</param>
            public void lookupTableName(TableName _tableName, FormControl _formControl)
            {
                Query query = new Query();
                QueryBuildDataSource queryBuildDataSource = query.addDataSource(tableNum(METTableFieldNamesTmp));
                QueryBuildRange queryBuildRange;
                SysTableLookup sysTableLookup =  SysTableLookup::newParameters(tableNum(METTableFieldNamesTmp), _formControl);
                sysTableLookup.addLookupField(fieldNum(METTableFieldNamesTmp, Label));
                sysTableLookup.addLookupField(fieldNum(METTableFieldNamesTmp, FieldName));
                queryBuildRange = queryBuildDataSource.addRange(fieldNum(METTableFieldNamesTmp, TableName));
                queryBuildRange.value(_tableName);
                sysTableLookup.parmQuery(query);
                sysTableLookup.parmTmpBuffer(fieldsTmp);
                sysTableLookup.performFormLookup();
            }

]]></Source>
							</Method>
							<Method>
								<Name>modified</Name>
								<Source><![CDATA[
            /// <summary>
            /// This method updates the respective fields when updated the field name
            /// </summary>
            public void modified()
            {
                super();

                select firstonly FieldName from fieldsTmp
                    where fieldsTmp.Label == METTableFieldNames.TableFieldName
                    && fieldsTmp.TableName == enum2Str(METTableFieldNames.CustTableName);

                if (fieldsTmp.FieldName)
                {
                    METTableFieldNames.FieldName = fieldsTmp.FieldName;
                }
            }

]]></Source>
