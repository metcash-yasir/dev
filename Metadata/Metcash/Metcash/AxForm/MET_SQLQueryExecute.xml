			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        super();

        ttsbegin;

        MET_SQLExecuteParm  executeParmLocal = MET_SQLExecuteParm::find(curUserId(), true);

        executeParmLocal.SQLText = 'select * from SalesTable';
        executeParmLocal.MaxRows = 100;
        executeParmLocal.Filename = 'SQL_Outcomes.html';
        executeParmLocal.UserId = curUserId();
        executeParmLocal.write();

        ttscommit;

        QueryBuildRange   qbr = ExecuteParm_ds.queryBuildDataSource().addRange(fieldNum(MET_SQLExecuteParm, UserId));
        qbr.status(RangeStatus::Locked);
        qbr.value(SysQuery::value(curUserId()));

    }

]]></Source>
			</Method>
			<Method>
				<Name>DEVisUserInRole</Name>
				<Source><![CDATA[
    public boolean DEVisUserInRole(Description  _roleName)
    {
        boolean                 res;
        SecurityUserRole        securityUserRole;
        SecurityRole            securityRole;
        ;
        select firstonly RecId from securityUserRole
            where  securityUserRole.User    == curUserId()
            join RecId from securityRole
                where  securityRole.RecId == securityUserRole.SecurityRole
                    && (   securityRole.AotName == _roleName
                    )    ;
        if (securityUserRole.RecId)
        {
            res = true;
        }
    
        return res;
    }

]]></Source>
			</Method>
