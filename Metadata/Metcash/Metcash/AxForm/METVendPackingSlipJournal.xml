                inventLocationIdFilter = caller1.parminventoryLocationIdFilter();
                curDateTime = DateTimeUtil::utcNow();
                past7DateTime = DateTimeUtil::addDays(curDateTime, -7);
                if (inventLocationIdFilter)
                {   
                    this.query().dataSourceTable(tableNum(VendPackingSlipJour)).clearRanges();
                    QueryBuildDataSource  qbds = this.queryBuildDataSource();
                    QueryBuildDataSource    qbds1 = qbds.addDataSource(tableNum(VendPackingSlipTrans));
                    qbds1.joinMode(JoinMode::InnerJoin);
                    qbds1.addLink(fieldNum(VendPackingSlipJour, RecId), fieldNum(VendPackingSlipTrans, VendPackingSlipJour));
                    qbds1.addRange(fieldNum(VendPackingSlipTrans, ItemId)).value(queryValue(itemIdFilter));

                    QueryBuildDataSource    qbds2 = qbds.addDataSource(tableNum(PurchTable));
                    qbds2.joinMode(JoinMode::InnerJoin);
                    qbds2.addLink(fieldNum(VendPackingSlipJour, PurchId ), fieldNum(PurchTable, PurchId));
                    qbds2.addRange(fieldNum(PurchTable, InventLocationId)).value(queryValue(inventLocationIdFilter));
                    qbds2.addRange(fieldNum(PurchTable, CreatedDateTime)).value(strFmt("%1..%2", past7DateTime, curDateTime));

                }
                else
                {
                    this.query().dataSourceTable(tableNum(VendPackingSlipJour)).clearRanges();
                    QueryBuildDataSource  qbds = this.queryBuildDataSource();
                    QueryBuildDataSource    qbds1 = qbds.addDataSource(tableNum(VendPackingSlipTrans));
                    qbds1.joinMode(JoinMode::InnerJoin);
                    qbds1.addLink(fieldNum(VendPackingSlipJour, RecId), fieldNum(VendPackingSlipTrans, VendPackingSlipJour));
                    qbds1.addRange(fieldNum(VendPackingSlipTrans, ItemId)).value(queryValue(itemIdFilter));

                    QueryBuildDataSource    qbds2 = qbds.addDataSource(tableNum(PurchTable));
                    qbds2.joinMode(JoinMode::InnerJoin);
                    qbds2.addLink(fieldNum(VendPackingSlipJour, PurchId ), fieldNum(PurchTable, PurchId));
                    qbds2.addRange(fieldNum(PurchTable, CreatedDateTime)).value(strFmt("%1..%2", past7DateTime, curDateTime));
                }
            }        
        
            super();        
        }

