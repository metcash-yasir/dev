				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Execute query
        /// </summary>
        public void executeQuery()
        {
            ItemId                  itemIdFilter;
            InventLocationId        inventLocationIdFilter;
            utcdatetime             curDateTime, past7DateTime;
            QueryBuildDataSource    qbdsRecentlyReceivedPOView;
            
            if (formRun)
            {
                itemIdFilter            = formRun.parmItemId();
                inventLocationIdFilter  = formRun.parminventoryLocationId();
                
                curDateTime     = DateTimeUtil::utcNow();
                past7DateTime   = DateTimeUtil::addDays(curDateTime, -7);

                qbdsRecentlyReceivedPOView = this.queryBuildDataSource();
                qbdsRecentlyReceivedPOView.clearRanges();

                QueryBuildDataSource qbdsTrans = VendPackingSlipTrans_ds.queryBuildDataSource();
                qbdsTrans.clearRanges();

                QueryBuildDataSource purchTableds = PurchTable_ds.queryBuildDataSource();
                purchTableds.clearRanges();

                qbdsRecentlyReceivedPOView.addRange(fieldNum(VendPackingSlipJour, DeliveryDate)).value(strFmt("%1..%2", past7DateTime, curDateTime));


                if (itemIdFilter)
                {
                    qbdsTrans.addRange(fieldNum(VendPackingSlipTrans, ItemId)).value(itemIdFilter);
                    qbdsTrans.addRange(fieldNum(VendPackingSlipTrans, ItemId)).status(RangeStatus::Locked);
                }


                if (inventLocationIdFilter)
                {
                    purchTableds.addRange(fieldNum(PurchTable, InventLocationId)).value(inventLocationIdFilter);
                    purchTableds.addRange(fieldNum(PurchTable, InventLocationId)).status(RangeStatus::Locked);
                }
            }

            super();
        }

]]></Source>
