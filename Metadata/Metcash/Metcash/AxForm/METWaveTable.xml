        public void selectionChanged()
        {
            #SysSystemDefinedButtons

            super();

            FormControl SystemDefinedDeleteButton = element.design().controlName(#SystemDefinedDeleteButton);
            METWaveTable_ds.allowDelete(METWaveTable.WaveStatus == METCSDWaveStatus::Open ? true : false);
            SystemDefinedDeleteButton.enabled(METWaveTable.WaveStatus == METCSDWaveStatus::Open ? true : false);

