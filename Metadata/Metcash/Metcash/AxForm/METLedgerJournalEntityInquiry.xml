						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void executeQuery()
        {
            //this.query().clearQueryFilters();

            METLedgerJournalEntityInquiryView ledger;

            select count(RecId) from ledger
            where ledger.TransferStatus == DMFTransferStatus::Error &&
                  ledger.StartDateTime >= dateFrom.dateTimeValue() &&
                  ledger.StartDateTime <= dateTo.dateTimeValue ();
          
            totalErrors = ledger.RecId;

            select count(RecId) from ledger
                where ledger.TransferStatus == DMFTransferStatus::Duplicate &&
                  ledger.StartDateTime >= dateFrom.dateTimeValue() &&
                  ledger.StartDateTime <= dateTo.dateTimeValue ();

            totalDuplicates = ledger.RecId;

            select count(RecId) from ledger
                where ledger.TransferStatus == DMFTransferStatus::Validated &&
                  ledger.StartDateTime >= dateFrom.dateTimeValue() &&
                  ledger.StartDateTime <= dateTo.dateTimeValue ();


            totalValidated = ledger.RecId;

      
            // METLedgerJournalEntityInquiryView_ds.query().dataSourceTable(tableNum(METLedgerJournalEntityInquiryView)).addRange(fieldNum(METLedgerJournalEntityInquiryView, TransferStatus)).value(SysQuery::valueNot(DMFTransferStatus::Completed));
            //METLedgerJournalEntityInquiryView_ds.query().dataSourceTable(tableNum(METLedgerJournalEntityInquiryView)).addRange(fieldNum(METLedgerJournalEntityInquiryView, StartDateTime)).value(SysQueryRangeUtil::dateRange(start, start+1));
           
            rngStartDateTime.value(queryRange(datefrom.dateTimeValue(), dateTo.dateTimeValue()));

            super();
        }

]]></Source>
