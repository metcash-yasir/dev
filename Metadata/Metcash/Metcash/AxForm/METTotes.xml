					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// executeQuery method
        /// </summary>
        public void executeQuery()
        {
            if(element.args().dataset() == tableNum(METSalesOrderShipmentLoadLines))
            {
                METSalesOrderShipmentLoadLines      metSOShipmentLoadLines = element.args().record();
                
                QueryBuildRange     qr;
                SalesId             salesId = metSOShipmentLoadLines.OrderNum;

                qr = this.query().dataSourceTable(tableNum(METTotes)).addRange(fieldNum(METTotes, SalesId));
                qr.value(queryValue(salesId));
                qr.status(RangeStatus::Locked);//lock the querybuildrange object so user cannot filter the grid on other item id values
            }
            super();

        }

]]></Source>
