/// <summary>
/// MPJ_28155_SalesFinalisation 3.6.11 Sales finalisation workspace
/// Copied from CustomerCollectionManagerWorkspace
/// </summary>
[Form]
public class METSalesOrderFinalisationWorkspace extends FormRun implements SysIFilterProvider, METSalesOrdersISalesOrderFinalisationWorkspace
{
    SysFilterChangeEvent changeEvent;

}
]]></Source>
			</Method>
			<Method>
				<Name>parmInventLocationId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns and sets the warehouse that will be used to filter forms
    /// </summary>
    /// <param name = "_inventLocationId">The warehouse to use as a filter</param>
    /// <returns>The warehouse to use as a filter</returns>
    public InventLocationId parmInventLocationId(InventLocationId _inventLocationId = '')
    {
        return InventLocationIdFilter.valueStr();
    }

]]></Source>
			</Method>
			<Method>
				<Name>parmShippingDate</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns and sets the ship date that will be used to filter forms
    /// </summary>
    /// <param name = "_shipDate">The ship date to use as a filter</param>
    /// <returns>The ship date to use as a filter</returns>
    public SalesShippingDate parmShippingDate(SalesShippingDate _shippingDate = dateNull())
    {
        return ShippingDateFilter.dateValue();
    }

]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Init method to register the controls to filter the workspace tiles
    /// </summary>
    public void init()
    {
        super();

        changeEvent = SysFilterChangeEvent::newFromFormControl(InventLocationIdFilter);
        changeEvent.registerFormControl(ShippingDateFilter);
    }

]]></Source>
			</Method>
			<Method>
				<Name>parmFilter</Name>
				<Source><![CDATA[
    /// <summary>
    /// Required by <c>SysIFilterProvider</c>, initialize the <c>SysIFilter</c> class with filter values
    /// </summary>
    /// <returns>a <c>SysIFilter</c> class</returns>
    public SysIFilter parmFilter()
    {
        var filter = SysFilterFactory::createEmptyFilter();

        if (element.parmInventLocationId() != '')
        {
            SysIFilterValue warehouseFilter = SysFilterValueFactory::createFilterValueForString(element.parmInventLocationId(), extendedTypeNum(InventLocationId));
            filter.addItem(warehouseFilter, SysFilterOperator::Equal, SysFilterValueResolutionMethod::None);
        }

        if (element.parmShippingDate() != dateNull())
        {
            SysIFilterValue shipDateFilter = SysFilterValueFactory::createFilterValueForDate(element.parmShippingDate(), extendedTypeNum(SalesShippingDate));
            filter.addItem(shipDateFilter, SysFilterOperator::Equal, SysFilterValueResolutionMethod::None);
        }

        return filter;
    }

]]></Source>
			</Method>
			<Method>
				<Name>parmChangeEvent</Name>
				<Source><![CDATA[
    /// <summary>
    /// Required by <c>SysIFilterProvider</c>, to return the changeEvent object initialized from the filter controls
    /// </summary>
    /// <returns><c>SysFilterChangeEvent</c> class</returns>
    public SysFilterChangeEvent parmChangeEvent()
    {
        return changeEvent;
    }

]]></Source>
			</Method>
			<Method>
				<Name>task</Name>
				<Source><![CDATA[
    /// <summary>
    /// Task method
    /// </summary>
    /// <param name = "_taskId">Task Id</param>
    /// <returns>Integer</returns>
    public int task(int _taskId)
    {
        #task

        if (_taskId == #taskRefresh)
        {
            this.parmChangeEvent().raiseEvent();
        }

        return super(_taskId);
    }

]]></Source>
			</Method>
