				<Name>init</Name>
				<Source><![CDATA[
    /// <summary>
    /// Refresh the calling form's datasource
    /// </summary>
    /// <param name = "_append"></param>
    public void init()
    {
        MetCustomerMdfSetupTable  rec;
        Query                     q;
        QueryBuildDataSource      qbds;
        QueryBuildRange           qbr;

        super();

        rec = element.args().record();

        if (rec)
        { 
            q = MetCustomerMdfSetupTable_ds.query();
            qbds = q.dataSourceTable(tableNum(MetCustomerMdfSetupTable));
            qbr = qbds.findRange(fieldNum(MetCustomerMdfSetupTable, RecId));
            if (!qbr)
            {
                qbr = qbds.addRange(fieldNum(MetCustomerMdfSetupTable, RecId));
            }
            qbr.value(queryValue(rec.RecId));

            MetCustomerMdfSetupTable_ds.executeQuery(); // run the modified query
        }

        FormTabPageControl tabInclusion = element.design().controlName("CategoryCommodityCodeTabPage");
        FormTabPageControl tabExclusion = element.design().controlName("CategoryCommodityCodeTabPageExlusion");

        if (rec.ItemScope == METItemScope::ExplicitItemInclusion)
        {  
            tabExclusion.visible(false);
        }
        else if (rec.ItemScope == METItemScope::ItemsWithExclusions)
        {  
            tabInclusion.visible(false);
        }
        else
        {  
            tabInclusion.visible(true);
            tabExclusion.visible(true);
        }


    }

]]></Source>
