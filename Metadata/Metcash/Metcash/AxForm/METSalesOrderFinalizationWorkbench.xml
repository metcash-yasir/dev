			<Control>
				<Name>ReprintShipment</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Clicked method for Reprint
        /// </summary>
        public void clicked()
        {
            METSalesOrderShipmentLoadHeader     metSOShipmentLoadHeader;
            SalesPackingSlipJournalPrint        salesPackingSlipJournalPrint;
            SalesInvoiceJournalPrint            salesInvoiceJournalPrint;
            SRSPrintDestinationSettings         srsPrintDestinationSettings;
            boolean                             hasRecord = false;

            Set set = new Set(Types::Record);

            while select metSOShipmentLoadHeader
                where metSOShipmentLoadHeader.MarkSelection == NoYes::Yes
            {
                if(metSOShipmentLoadHeader.DocumentStatus == DocumentStatus::PackingSlip)
                {
                    CustPackingSlipJour     packingSlipJour;

                    while select packingSlipJour
                        where packingSlipJour.METShipmentId == metSOShipmentLoadHeader.ShipmentId
                    {
                        // Add record
                        set.add(packingSlipJour);
                        hasRecord = true;
                    }

                    if(hasRecord)
                    {
                        // Set printer settings
                        srsPrintDestinationSettings = new SRSPrintDestinationSettings();
                        //srsPrintDestinationSettings.fileFormat(SRSReportFileFormat::Screen);
                        // Initalize
                        salesPackingSlipJournalPrint = SalesPackingSlipJournalPrint::construct();
                        salesPackingSlipJournalPrint.parmPrintFormletter(NoYes::Yes);
                        salesPackingSlipJournalPrint.parmUsePrintManagement(NoYes::Yes);
                        salesPackingSlipJournalPrint.parmPrinterSettingsFormLetter(srsPrintDestinationSettings.pack());

                        // Print
                        salesPackingSlipJournalPrint.printJournal(set);
                    }
                }
                else if (metSOShipmentLoadHeader.DocumentStatus == DocumentStatus::Invoice)
                {
                    CustInvoiceJour     invoiceJour;

                    while select invoiceJour
                        where invoiceJour.METShipmentId == metSOShipmentLoadHeader.ShipmentId
                    {
                        // Add record
                        set.add(invoiceJour);
                        hasRecord = true;
                    }

                    if(hasRecord)
                    {
                        // Set printer settings
                        srsPrintDestinationSettings = new SRSPrintDestinationSettings();
                        //srsPrintDestinationSettings.fileFormat(SRSReportFileFormat::Screen);

                        // Initalize
                        salesInvoiceJournalPrint = SalesInvoiceJournalPrint::construct();
                        salesInvoiceJournalPrint.parmPrintFormletter(NoYes::Yes);
                        salesInvoiceJournalPrint.parmUsePrintManagement(NoYes::Yes);
                        salesInvoiceJournalPrint.parmPrinterSettingsFormLetter(srsPrintDestinationSettings.pack());

                        // Print
                        salesInvoiceJournalPrint.printJournal(set);
                    }
                }
            }
            super();
        }

]]></Source>
