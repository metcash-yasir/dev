    /// <summary>
    /// Init method
    /// </summary>
    public void init()
    {
        headerMap = new Map(Types::Int64, Types::String);
        lineMap = new Map(Types::String, Types::String);
        formInitialize = true;
        
        orderTransactionType = element.args().parmEnum();

        super();

        if (orderTransactionType ==METOrderTransactionType ::TransferOrder)
        {
            LineGrid_displaySalesStatus.visible(false);
            LineGrid_displayOrderExtractStatus.visible(false);
            ShipmentTabPage.visible(false);
            METSalesOrderShipmentLoadHeader_ds.object(fieldNum(METSalesOrderShipmentLoadHeader, PostMultiDocument)).visible(false);
        }
        else
        {
            LineGrid_displayTransferOrderExtractStatus.visible(false);
            LineGrid_displayTransferStatus.visible(false);
            ShipmentTabTransferOrder.visible(false);
        }
    }

]]></Source>
