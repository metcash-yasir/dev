					<Method>
						<Name>editMarkHeaderMap</Name>
						<Source><![CDATA[
        /// <summary>
        /// This is an edit method
        /// </summary>
        /// <param name = "_set">Set</param>
        /// <param name = "_metSalesOrderShipmentLoadHeader">METSalesOrderShipmentLoadHeader reference</param>
        /// <param name = "_mark">mark reference</param>
        /// <returns>EditValue</returns>
        [SysClientCacheDataMethodAttribute(true)]
        public edit NoYes editMarkHeaderMap(boolean _set, METSalesOrderShipmentLoadHeader _metSalesOrderShipmentLoadHeader, NoYes _mark)
        {
            if (_set)
            {
                if (!_mark)
                {
                    if (headerMap.exists(_metSalesOrderShipmentLoadHeader.RecId))
                    {
                        headerMap.remove(_metSalesOrderShipmentLoadHeader.RecId);
                    }
                }
                else
                {
                    headerMap.insert(_metSalesOrderShipmentLoadHeader.RecId, _metSalesOrderShipmentLoadHeader.ShipmentId);
                }
            }
            return headerMap.exists(_metSalesOrderShipmentLoadHeader.RecId);
        }

]]></Source>
