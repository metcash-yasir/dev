					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Clicked method for confirm shipment
        /// </summary>
        public void clicked()
        {
            //Validations for shipment
            METShipmentPackingSlipCreate::shipmentValidations();
            //Post a packing slip
            METShipmentPackingSlipCreate::createPackingSlip();

            METSalesOrderShipmentLoadHeader_ds.reread();
            METSalesOrderShipmentLoadHeader_ds.refresh();

            super();
        }

]]></Source>
