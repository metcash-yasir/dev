						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Data source init method
        /// </summary>
        public void init()
        {
            super();

            METSalesOrderShipmentLoadLines_ds.queryBuildDataSource().addGroupByField(fieldNum(METSalesOrderShipmentLoadLines, OrderNum));
            
            if (orderTransactionType == METOrderTransactionType::SalesOrder)
            {
                QueryBuildDataSource        qbdsSalesLine = METSalesOrderShipmentLoadLines_ds.queryBuildDataSource().addDataSource(tableNum(SalesLine));

                qbdsSalesLine.relations(false);
                qbdsSalesLine.addLink(fieldNum(METSalesOrderShipmentLoadLines, OrderNum), fieldNum(SalesLine, SalesId));
                qbdsSalesLine.addLink(fieldNum(METSalesOrderShipmentLoadLines, LineNum), fieldNum(SalesLine, LineNum));

                qbdsSalesLine.joinMode(JoinMode::ExistsJoin);

                QueryBuildDataSource        qbdsWmsOrderTrans = qbdsSalesLine.addDataSource(tableNum(WMSOrderTrans));

                qbdsWmsOrderTrans.relations(false);
                qbdsWmsOrderTrans.addLink(fieldNum(SalesLine, InventTransId), fieldNum(WMSOrderTrans, inventTransId));
                qbdsWmsOrderTrans.joinMode(JoinMode::ExistsJoin);
            }
        }

]]></Source>
