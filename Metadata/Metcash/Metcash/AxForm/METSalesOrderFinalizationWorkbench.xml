				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Clicked method for Reprint
        /// </summary>
        public void clicked()
        {
            METSalesOrderShipmentLoadHeader     metSOShipmentLoadHeader;
            MapIterator                         mapIterator = new MapIterator(headerMap);
            container                           conRecordId;
            MenuFunction                        menuFunction;

            while (mapIterator.more())
            {
                metSOShipmentLoadHeader = METSalesOrderShipmentLoadHeader::findByRecId(mapIterator.key());
                if(metSOShipmentLoadHeader)
                {
                    conRecordId += metSOShipmentLoadHeader.RecId;
                }
                mapIterator.next();
            }

            Args    args = new Args();
            args.parm(con2Str(conRecordId));

            menuFunction = new MenuFunction(menuitemActionStr(METSOShipment), MenuItemType::Action);
            menuFunction.run(args);

            super();
        }

]]></Source>
