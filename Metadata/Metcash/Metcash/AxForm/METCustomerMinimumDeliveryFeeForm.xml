				<Fields>
					<Field>
						<DataField>DeliveryChargeType</DataField>
						<Methods>
							<Method>
								<Name>modified</Name>
								<Source><![CDATA[
            /// <summary>
            /// To update the delivery fees based on the selection
            /// </summary>
            public void modified()
            {
                super();

                MetCustomerMdfSetupTable mdfSetupTable = MetCustomerMdfSetupTable_ds.cursor();

                boolean isThresholdEditable = mdfSetupTable.DeliveryChargeType != METDeliveryChargeType::TotalDeliveryFees;

                if (!isThresholdEditable)
                {
                    mdfSetupTable.ThresholdValue = 0.00;
                }

                MetCustomerMdfSetupTable_ds.object(fieldNum(MetCustomerMdfSetupTable, ThresholdValue)).allowEdit(isThresholdEditable);

                boolean isTaxEditable = (mdfSetupTable.DeliveryChargeType == METDeliveryChargeType::TotalInvoiceAmount);

                if (!isTaxEditable)
                {
                    mdfSetupTable.IncludeTaxesInThreshold = NoYes::No;
                }

                MetCustomerMdfSetupTable_ds.object(fieldNum(MetCustomerMdfSetupTable, IncludeTaxesInThreshold)).allowEdit(isTaxEditable);



                // Refrresh the datasource to reflect changes
                MetCustomerMdfSetupTable_ds.refresh();

            }

]]></Source>
