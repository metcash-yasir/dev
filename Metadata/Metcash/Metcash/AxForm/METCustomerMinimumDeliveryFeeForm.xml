						<Name>create</Name>
						<Source><![CDATA[
        /// <summary>
        /// Call the dialog form to create or edit a record in the MetCustomerMdfTable table.
        /// </summary>
        /// <param name = "_append"></param>
        public void create(boolean _append = false)
        {
            MetCustomerMdfTable  mdfCustomerTable;
            boolean ret = mdfCustomerForm.createForm();

            if (ret)
            {
                mdfCustomerTable = mdfCustomerForm.parmMDFTable();
                super(_append);
                mdfCustomerTable.data(mdfCustomerTable);
                RecId currentRecId = mdfCustomerTable.RecId;
                MetCustomerMdfTable_ds.research(true);

                if (currentRecId)
                {
                    MetCustomerMdfTable_ds.findRecord(MetCustomerMdfTable::findRecId(currentRecId));
                    MetCustomerMdfTable_ds.refresh();
                }
                
            }
        }

]]></Source>
