			<Method>
				<Name>canClose</Name>
				<Source><![CDATA[
    /// <summary>
    /// The canCose method of the form.
    /// </summary>
    /// <returns>True or false</returns>
    public boolean canClose()
    {
        boolean canClose = super();

        if (element.closedOk() && canClose)
        {   
            METItemPackChangeHelper metItemPackChangeHelper = new METItemPackChangeHelper();

            metItemPackChangeHelper.parmMetItemSiteSettingsSetupOriginal(metItemSiteSettingsSetup);
            metItemPackChangeHelper.parmMetItemSiteSettingsSetupTemp(metItemSiteSettingsSetupTemp);
            metItemPackChangeHelper.parmInventItemBarcodeOrigItem(inventItemBarcodeOrig);
            metItemPackChangeHelper.parmInventItemBarcodeTempItem(inventItemBarcodeTemp);
            metItemPackChangeHelper.parmInventItemPurchSetupOrigItem(inventItemPurchSetupOrigItem);
            metItemPackChangeHelper.parmInventItemPurchSetupTempItem(inventItemPurchSetupTempItem);
            metItemPackChangeHelper.parmInventItemSalesSetupOrigItem(inventItemSalesSetupOrigItem);
            metItemPackChangeHelper.parmInventItemSalesSetupTempItem(inventItemSalesSetupTempItem);
            metItemPackChangeHelper.parmWHSPhysDimUOMOrigItem(whsPhysDimUOMOrig);
            metItemPackChangeHelper.parmWHSPhysDimUOMTempItem(whsPhysDimUOMTemp);

            metItemPackChangeHelper.startOperation();
        }

        return canClose;
    }

]]></Source>
