    /// <summary>
    /// The init method of the form
    /// </summary>
    public void init()
    {
        super();

        if (element.args().caller() && element.args().record() && element.args().record() is MetItemSiteSettingsSetup)
        {
            metItemSiteSettingsSetup = element.args().record();

            ItemId.text(metItemSiteSettingsSetup.ItemId);
            SiteId.text(metItemSiteSettingsSetup.InventSiteId);

            this.initControls();            
        }
    }

