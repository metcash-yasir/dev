[Form]
public class METProcessPackChange extends FormRun
{
    MetItemSiteSettingsSetup metItemSiteSettingsSetup;
    metItemSiteSettingsSetup metItemSiteSettingsSetupTemp;            
    InventItemPurchSetup inventItemPurchSetupTempItem;
    InventItemPurchSetup inventItemPurchSetupOrigItem;
    InventItemSalesSetup inventItemSalesSetupTempItem;
    InventItemSalesSetup inventItemSalesSetupOrigItem;
    InventTable inventTable;
    METInventTable metInventTable;
    InventItemBarcode inventItemBarcodeOrig;
    InventItemBarcode inventItemBarcodeTemp;    
    WHSPhysDimUOM whsPhysDimUOMOrig;
    WHSPhysDimUOM whsPhysDimUOMTemp;
    
    InventDim inventDim;

}
]]></Source>
			</Method>
			<Method>
				<Name>initControls</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise form control values
    /// </summary>
    private void initControls()
    {
        ItemId tempItemId;

        tempItemId = metItemSiteSettingsSetup.TempItemPackChg;
            
        inventDim.clear();
        inventDim.InventSiteId = metItemSiteSettingsSetup.InventSiteId;
        inventDim = InventDim::findOrCreate(inventDim);

        inventTable = InventTable::find(metItemSiteSettingsSetup.ItemId);
        metInventTable = METInventTable::find(metItemSiteSettingsSetup.ItemId);
        inventItemPurchSetupOrigItem = InventItemPurchSetup::find(metItemSiteSettingsSetup.ItemId, inventDim.inventDimId);
        inventItemPurchSetupTempItem = InventItemPurchSetup::find(tempItemId, inventDim.inventDimId);
        inventItemSalesSetupOrigItem = InventItemSalesSetup::find(metItemSiteSettingsSetup.ItemId, inventDim.inventDimId);
        inventItemSalesSetupTempItem = InventItemSalesSetup::find(tempItemId, inventDim.inventDimId);
            
        whsPhysDimUOMOrig = METItemPackChangeHelper::getWhsPhysDimOUM(inventTable.ItemId);
        inventItemBarCodeOrig = METItemPackChangeHelper::getInventItembarcode(inventTable.ItemId);
        whsPhysDimUOMTemp = METItemPackChangeHelper::getWhsPhysDimOUM(tempItemId);
        inventItemBarCodeTemp = METItemPackChangeHelper::getInventItembarcode(tempItemId);
        metItemSiteSettingsSetupTemp = METItemPackChangeHelper::getItemSiteSettingsSetup(tempItemId, metItemSiteSettingsSetup.InventSiteId);

        //Display original item data
        PurchOrderUnit.text(inventItemPurchSetupOrigItem.METPurchUnit);
        SalesOrderUnit.text(inventItemSalesSetupOrigItem.METSalesUnit);
        PackSize.text(metInventTable.ItemSize);
        CartonPerLayer.realValue(metItemSiteSettingsSetup.CartonPerLayer);
        Layers.realValue(metItemSiteSettingsSetup.Layers);
        PalletLayerQty.realValue(metItemSiteSettingsSetup.PalletLayerQty);
        PalletQty.realValue(metItemSiteSettingsSetup.PalletQty);
        whsPhysDimUOM_UOM.text(whsPhysDimUOMOrig.UOM);
        WHSPhysDimUOM_Weight.realValue(whsPhysDimUOMOrig.Weight);
        WHSPhysDimUOM_NetWeight.realValue(whsPhysDimUOMOrig.METNetWeight);
        whsPhysDimUOM_Width.realValue(whsPhysDimUOMOrig.Width);
        whsPhysDimUOM_Depth.realValue(whsPhysDimUOMOrig.Depth);
        whsPhysDimUOM_Height.realValue(whsPhysDimUOMOrig.Height);
        ItemBarcode.text(inventItemBarcodeOrig.itemBarCode);

        //Display temp item data
        PurchOrderUnitTemp.text(inventItemPurchSetupTempItem.METPurchUnit);
        SalesOrderUnitTemp.text(inventItemSalesSetupTempItem.METSalesUnit);
        PackSizeTemp.text(metInventTable::find(metItemSiteSettingsSetup.TempItemPackChg).ItemSize);
        CartonPerLayerTemp.realValue(metItemSiteSettingsSetupTemp.CartonPerLayer);
        LayersTemp.realValue(metItemSiteSettingsSetupTemp.Layers);
        PalletLayerQtyTemp.realValue(metItemSiteSettingsSetupTemp.PalletLayerQty);
        PalletQtyTemp.realValue(metItemSiteSettingsSetupTemp.PalletQty);
        whsPhysDimUOM_UOMTemp.text(whsPhysDimUOMTemp.UOM);
        WHSPhysDimUOM_WeightTemp.realValue(whsPhysDimUOMTemp.Weight);
        WHSPhysDimUOM_NetWeightTemp.realValue(whsPhysDimUOMTemp.METNetWeight);
        whsPhysDimUOM_WidthTemp.realValue(whsPhysDimUOMTemp.Width);
        whsPhysDimUOM_DepthTemp.realValue(whsPhysDimUOMTemp.Depth);
        whsPhysDimUOM_HeightTemp.realValue(whsPhysDimUOMTemp.Height);
        ItemBarcodeTemp.text(inventItemBarcodeTemp.itemBarCode);

    }

]]></Source>
