        /// <summary>
        /// MPJ_26255_MissingCustomDeviationFieldsFromDMEnvCustomersAndVendors 10062022
        /// </summary>
        private void enableDisableLiquorLicenceExpiryDate()
        {
            if(METCustLiquorLicenseTable.LiquorLicenceType == METLiquorLicenceType::U )
            {
                METCustLiquorLicenseTable_ds.object(fieldNum(METCustLiquorLicenseTable,LiquorLicenceExpiryDate)).enabled(false);
