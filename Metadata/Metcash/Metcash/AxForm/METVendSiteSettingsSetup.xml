                    && METVendSiteSettingsSetup.VendSiteSetupDefaultPlannedOrderType == METVendSiteSetupDefaultPlannedOrderType::Transfer)
                {
                    throw error("@MET:METDefaulMainWHError");
                }
            }
        
            return ret;
        }

