						<Name>updateLookupControlValue</Name>
						<Source><![CDATA[
        /// <summary>
        /// Marks the values seleted on multi select lookup.
        /// </summary>
        /// <param name = "_formStringControl">The form string control</param>
        /// <param name = "_multiSelectLookup">The multi select lookup object</param>
        /// <param name = "_value">The value from the form datasource</param>
        private void updateLookupControlValue(FormStringControl _formStringControl, SysLookupMultiSelectCtrl _multiSelectLookup, str _value)
        {
            #define.semiColon(';');
            _formStringControl.text(_value);
            container recIds, names;
            RecId recId;
            List list = new List(Types::String);
            ListIterator iterator;
            SysDictEnum sysDictEnum = new SysDictEnum(enumNum(METVendSitePOSetup));

            list = Global::strSplit(_value, #semiColon);
            iterator = new ListIterator(list);

            while(iterator.more())
            {
                recId = METMultiSelectBaseEnumTable::findByEnumValue(sysDictEnum.name(), iterator.value()).RecId;
                recIds += recId;
                names += iterator.value();
                iterator.next();
            }

            _multiSelectLookup.set([recIds, names]);
        }

]]></Source>
