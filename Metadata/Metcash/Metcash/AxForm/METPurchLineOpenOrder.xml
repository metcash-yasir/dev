					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void executeQuery()
        {
            ItemId                  itemId              = formRun.parmItemId();
            InventLocationId        inventLocationId    = formRun.parminventoryLocationId();
            QueryBuildDataSource    qbdsPurchOpenLines;

            if (formRun)
            {
                qbdsPurchOpenLines = this.queryBuildDataSource();

                qbdsPurchOpenLines.clearRanges();
                
                if (itemId)
                {
                    qbdsPurchOpenLines.addRange(fieldNum(METPurchOpenLinesView, ItemId)).value(itemId);
                    qbdsPurchOpenLines.addRange(fieldNum(METPurchOpenLinesView, ItemId)).status(RangeStatus::Locked);
                }
                if (inventLocationId)
                {
                    qbdsPurchOpenLines.addRange(fieldNum(METPurchOpenLinesView, InventLocationId)).value(inventLocationId);
                    qbdsPurchOpenLines.addRange(fieldNum(METPurchOpenLinesView, InventLocationId)).status(RangeStatus::Locked);
                }
            }
            super();
        }

]]></Source>
