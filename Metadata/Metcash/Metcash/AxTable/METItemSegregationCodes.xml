				<Name>validateDelete</Name>
				<Source><![CDATA[
    /// <summary>
    /// Validate while delete
    /// </summary>
    /// <returns>Yes or No</returns>
    public boolean validateDelete()
    {
        boolean ret;
    
        ret = super();

        METInventItemOrderSetup metInventItemOrderSetup;

        select firstonly RecId, ItemId, SiteId from metInventItemOrderSetup
            where metInventItemOrderSetup.SegregationCode == this.SegregationCode;
        if(metInventItemOrderSetup)
        {
            ret = checkFailed(strFmt("@MET:SegregationCodeDelete",this.SegregationCode,metInventItemOrderSetup.ItemId, metInventItemOrderSetup.SiteId));
        }
    
        return ret;
    }

]]></Source>
