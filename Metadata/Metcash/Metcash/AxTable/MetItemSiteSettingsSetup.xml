			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    ///Values upon modifying fields
    /// </summary>
    /// <param name = "_fieldId"></param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(MetItemSiteSettingsSetup, DistributionMethod) :
                this.DistributionMethodDesc = MetItemDistributionMethod::find(this.DistributionMethod).Description;;
                break;
            case fieldNum(MetItemSiteSettingsSetup, CartonPerLayer) :
                this.CartonPerPallet = this.CartonPerLayer*this.Layers;
                break;
            case fieldNum(MetItemSiteSettingsSetup, Layers) :
                this.CartonPerPallet = this.CartonPerLayer*this.Layers;
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find method to select <c>MetItemSiteSettingsSetup</c> record
    /// </summary>
    /// <param name = "_itemId">Item Id</param>
    /// <param name = "_siteId">Site Id</param>
    /// <param name = "_forUpdate">select for updating, boolean true or false</param>
    /// <returns>record of type <c>MetItemSiteSettingsSetup</c> if found</returns>
    static MetItemSiteSettingsSetup find(
        ItemId              _itemId,
        InventSiteId        _siteId,
        boolean             _forUpdate = false)

    {
        MetItemSiteSettingsSetup metItemSiteSettingsSetup;

        if (_itemId && _siteId)
        {
            if (_forUpdate)
            {
                metItemSiteSettingsSetup.selectForUpdate(_forUpdate);
            }

            select firstonly metItemSiteSettingsSetup
                where metItemSiteSettingsSetup.ItemId       == _itemId    &&
                      metItemSiteSettingsSetup.InventSiteId == _siteId;
        }

        return metItemSiteSettingsSetup;
    }

]]></Source>
			</Method>
