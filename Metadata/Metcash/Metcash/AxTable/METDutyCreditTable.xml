		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find the record based on the provided parameters
    /// </summary>
    /// <param name = "_returnItemNum">ReturnItem</param>
    /// <param name = "_itemId">Item Id</param>
    /// <param name = "_siteId">Site Id</param>
    /// <param name = "_forUpdate">Boolean value (default: false)</param>
    /// <param name = "_concurrencyModel">Concurrency model (default: Auto)</param>
    /// <returns>Table record</returns>
    static METDutyCreditTable find(
        ReturnItemNum _returnItemNum,
        ItemId _itemId,
        InventSiteId _siteId,
        boolean _forUpdate = false,
        ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        METDutyCreditTable metDutyCreditTable;

        // Avoid unnecessary checks, as the select query will return null if no records are found.
        select firstonly metDutyCreditTable
            where metDutyCreditTable.RMANumber == _returnItemNum
            && metDutyCreditTable.ItemId == _itemId
            && metDutyCreditTable.SiteId == _siteId;

        // Proceed with update locking if needed
        if (metDutyCreditTable)
        {
            if (_forUpdate)
            {
                metDutyCreditTable.selectForUpdate(_forUpdate);

                if (_concurrencyModel != ConcurrencyModel::Auto)
                {
                    metDutyCreditTable.concurrencyModel(_concurrencyModel);
                }
            }
        }

        return metDutyCreditTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exists</Name>
				<Source><![CDATA[
    /// <summary>
    /// Check if the record exists
    /// </summary>
    /// <param name = "_returnItemNum">ReturnItem</param>
    /// <param name = "_itemId">Item Id</param>
    /// <param name = "_siteId">Site Id</param>
    /// <returns>Boolean indicating if record exists</returns>
    static boolean exists(
        ReturnItemNum _returnItemNum,
        ItemId _itemId,
        InventSiteId _siteId)
    {
        // Validate input parameters
        if (!_returnItemNum || !_itemId || !_siteId)
        {
            return false;
        }

        // Check if record exists
        return (select firstonly RecId
                from metDutyCreditTable
                where metDutyCreditTable.RMANumber == _returnItemNum
                  && metDutyCreditTable.ItemId == _itemId
                  && metDutyCreditTable.SiteId == _siteId).RecId != 0;
    }

]]></Source>
			</Method>
