		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find the record
    /// </summary>
    /// <param name = "_returnItemNum">ReturnItem</param>
    /// <param name = "_forUpdate">Boolean value</param>
    /// <param name = "_concurrencyModel">concurrencyModel</param>
    /// <returns>Table record</returns>
    static METDutyCreditTable find(ReturnItemNum          _returnItemNum,
                           boolean          _forUpdate = false,
                           ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        METDutyCreditTable  metDutyCreditTable;

        if (metDutyCreditTable)
        {
            if (_forUpdate)
            {
                metDutyCreditTable.selectForUpdate (_forUpdate);
                if (_concurrencyModel != ConcurrencyModel::Auto)
                {
                    metDutyCreditTable.concurrencyModel(_concurrencyModel);
                }
            }
            metDutyCreditTable.selectLocked (_forUpdate);

            select firstonly metDutyCreditTable
                where metDutyCreditTable.RMANumber == _returnItemNum;
        }

        return metDutyCreditTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Exists the record
    /// </summary>
    /// <param name = "_returnItemNum">ReturnItem</param>
    /// <returns>Exists the record</returns>
    static boolean exist(ReturnItemNum          _returnItemNum)
    {
        if (!_returnItemNum)
        {
            return false;
        }

        return (select firstonly RecId from metDutyCreditTable
                    where metDutyCreditTable.RMANumber == _returnItemNum).RecId != 0;
    }

]]></Source>
			</Method>
