			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_8105 - kscerri - 02-07-2021
    /// </summary>
    /// <param name = "_fieldIdToCheck">Field id</param>
    /// <returns>if validation was successful</returns>
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
    
        ret = super(_fieldIdToCheck);
        
        if (ret)
        {
            switch (_fieldIdToCheck)
            {
                case fieldNum(METCustTable, CSAccountNum) :
                    if(this.CSLegalEntity)
                    {
                        if (!this.findCustByLE(this.CSLegalEntity, this.CSAccountNum))
                        {
                            ret = checkFailed(strFmt("@MET:CustAccNumValidation", this.CSAccountNum, this.CSLegalEntity));
                        }
                    }

                case fieldNum(METCustTable, LinkedCustAccountNum) :
                    if(this.LinkedLegalEntity)
                    {
                        if (!this.findCustByLE(this.LinkedLegalEntity, this.LinkedCustAccountNum))
                        {
                            ret = checkFailed(strFmt("@MET:CustAccNumValidation", 
                                                     this.LinkedCustAccountNum, 
                                                     this.LinkedLegalEntity));
                        }
                    }
            }

        }


        return ret;
    }

]]></Source>
