				<Name>findByCompany</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_3338_AMEXCustomerPaymentProcessing - vpotula
    /// Finds the specified record in the <c>METCustTable</c> table.
    /// </summary>
    /// <param name="_company">
    ///    The company for the customer record.
    /// </param>
    /// <param name="_custAccount">
    ///    The account number for the customer record.
    /// </param>
    /// <param name="_forUpdate">
    ///    A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    A record in the <c>METCustTable</c> table; otherwise, an empty record.
    /// </returns>
    public static METCustTable findByCompany(
        DataAreaId _company,
        CustAccount _custAccount,
        boolean _forUpdate = false)
    {
        METCustTable cust;

        if (_company)
        {
            changecompany(_company)
            {
                cust = METCustTable::find(_custAccount, _forUpdate);
            }
        }

        return cust;
    }

]]></Source>
