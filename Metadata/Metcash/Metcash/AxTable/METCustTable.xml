			<Method>
				<Name>findCustByLE</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_8105 - kscerri - 02-07-2021
    /// Finds cross company customer account
    /// </summary>
    /// <param name = "_dataArea">data area id</param>
    /// <param name = "_custAccount">customer account</param>
    /// <returns>account num found</returns>
    public AccountNum findCustByLE(SelectableDataArea _dataArea, CustAccount _custAccount)
    {
        CustTable custTable;

        select firstonly crosscompany AccountNum from custTable
            where custTable.DataAreaId == _dataArea && custTable.AccountNum == _custAccount;

        return custTable.AccountNum;
    }

]]></Source>
