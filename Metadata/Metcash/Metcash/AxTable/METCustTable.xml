		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_2864_CreditLimitBalance 03/11/2021
    /// find method finds record in METCustTable
    /// </summary>
    /// <param name = "_custAccount">CustomerAccount</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns METCustTable</returns>
    static METCustTable find(CustAccount _custAccount, boolean _forUpdate = false)
    {
        METCustTable metCustTable;

        if (_custAccount)
        {
            metCustTable.selectForUpdate(_forUpdate);
          
            select firstonly metCustTable
              where metCustTable.AccountNum == _custAccount;
        }

        return metCustTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_2864_CreditLimitBalance 03/11/2021
    /// This method is used to check if a record that fulfils the specified key actually exists.
    /// exist method
    /// </summary>
    /// <param name = "_custAccount">CustomerAccount</param>
    /// <returns>returns true or false depedning if records exists</returns>
    static boolean exist(CustAccount _custAccount)
    {
        return _custAccount  &&
              (select firstonly RecId from METCustTable
                   where METCustTable.AccountNum == _custAccount).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayMETIndustryChannel</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method to get Industry channel
    /// </summary>
    /// <returns>Type METIndustryChannel</returns>
    [SysClientCacheDataMethodAttribute(true)]
    public display METIndustryChannel displayMETIndustryChannel ()

    {

        METIndustryKeyTable metIndustryKeyTable;

        select firstonly1 IndustryChannel 
            from metIndustryKeyTable
            where metIndustryKeyTable.IndustryKey == this.IndustryKey;

        return metIndustryKeyTable.IndustryChannel;

    }

]]></Source>
			</Method>
