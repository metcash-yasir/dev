		<Methods>
			<Method>
				<Name>purchLine</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find related PurchLine
    /// </summary>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>PurchLine</returns>
    public PurchLine purchLine(boolean _forUpdate = false)
    {
        if(this.PurchLine)
        {
            return PurchLine::findRecId(this.PurchLine, _forUpdate);
        }
        return null;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by reference
    /// </summary>
    /// <param name = "_purchLineRecID">_salesLineRecID</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>SalesLine</returns>
    static public METPurchLine find(RefRecId _purchLineRecID, boolean _forUpdate = false)
    {
        METPurchLine metPurchLine;
        if(_purchLineRecID)
        {
            metPurchLine.selectForUpdate(_forUpdate);
            select firstonly metPurchLine
               where   metPurchLine.purchLine  == _purchLineRecID;
        }
        return metPurchLine;
    }

]]></Source>
			</Method>
