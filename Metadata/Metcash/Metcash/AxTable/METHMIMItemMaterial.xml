		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by reference
    /// </summary>
    /// <param name = "_hmimItemMaterialRecID">_hmimItemMaterialRecID</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>HMIMItemMaterial</returns>
    static public METHMIMItemMaterial find(RefRecId _hmimItemMaterialRecID, boolean _forUpdate = false)
    {
        METHMIMItemMaterial metHMIMItemMaterial;
        if(_hmimItemMaterialRecID)
        {
            metHMIMItemMaterial.selectForUpdate(_forUpdate);
            select firstonly metHMIMItemMaterial
               where   metHMIMItemMaterial.RefRecId == _hmimItemMaterialRecID;
        }
        return metHMIMItemMaterial;
    }

]]></Source>
