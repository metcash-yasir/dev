				<Name>cleanUpReserveEventOrdersQueue</Name>
				<Source><![CDATA[
    /// <summary>
    /// clean up table for anything older than 14 days
    /// </summary>
    static void cleanUpReserveEventOrdersQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METReserveEventOrdersQueue reserveEventOrdersQueue;
        METReserveEventOrdersQueue::skip(reserveEventOrdersQueue);

        ttsbegin;
        delete_from reserveEventOrdersQueue
        where reserveEventOrdersQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>skip</Name>
				<Source><![CDATA[
    /// <summary>
    /// skip method for performance purpose
    /// </summary>
    /// <param name = "_reserverEventOrdersQueue"><c>METReserveEventOrdersQueue</c> record</param>
    public static void skip(METReserveEventOrdersQueue _reserverEventOrdersQueue)
    {
        _reserverEventOrdersQueue.skipDatabaseLog(true);
        _reserverEventOrdersQueue.skipDataMethods(true);
        _reserverEventOrdersQueue.skipDeleteActions(true);
        _reserverEventOrdersQueue.skipEvents(true);
        _reserverEventOrdersQueue.skipBusinessEvents(true);
    }

]]></Source>
