		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find method
    /// </summary>
    /// <param name = "_vendRebateTypeId">Vendor rebate type</param>
    /// <param name = "_forUpdate">Select for update</param>
    /// <returns><c>METVendorRebateType</c> record</returns>
    static METVendorRebateType find(METVendorRebateTypeId _vendRebateTypeId,
                                                  boolean _forUpdate = false)
    {
        METVendorRebateType vendorRebateType;

        if (_vendRebateTypeId)
        {
            if (_forUpdate)
            {
                vendorRebateType.selectForUpdate(_forUpdate);
            }

            select firstonly vendorRebateType
                where vendorRebateType.TypeId == _vendRebateTypeId;
        }

        return vendorRebateType;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Exist method
    /// </summary>
    /// <param name = "_vendRebateTypeId">Vendor rebate type</param>
    /// <returns>True if vendor rebate type exists; otherwise, false.</returns>
    static boolean exist(METVendorRebateTypeId _vendRebateTypeId)
    {
        return (select firstonly RecId from METVendorRebateType
                    where METVendorRebateType.TypeId == _vendRebateTypeId).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateNumberSequenceId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Update numbersequence Id
    /// </summary>
    private void updateNumberSequenceId()
    {
        NumberSequenceTable numberSequenceTable;

        // Only populate if NumberSequence exists and Id is missing
        if (this.NumberSequence)
        {
            select firstonly RecId
            from numberSequenceTable
            where numberSequenceTable.NumberSequence == this.NumberSequence;

            if (numberSequenceTable.RecId)
            {
                this.NumberSequenceId = numberSequenceTable.RecId;
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    /// Inser numbersequence Id
    /// </summary>
    public void insert()
    {
        this.updateNumberSequenceId();
        super();
    }

]]></Source>
