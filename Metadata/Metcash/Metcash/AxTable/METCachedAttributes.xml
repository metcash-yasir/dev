			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///    Finds the single instance of the <c>EcoResProductParameters</c> record if it exists; otherwise,
    ///    creates and returns a new record.
    /// </summary>
    /// <param name="_forupdate">
    ///    A Boolean value that determines whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    The single instance of the record.
    /// </returns>
    static METCachedAttributes find(boolean _forupdate = false)
    {
        METCachedAttributes cachedAttributes;

        if (_forupdate)
        {
            cachedAttributes.selectForUpdate(_forupdate);
        }

        select firstonly * from cachedAttributes;

        return cachedAttributes;
    }

]]></Source>
