				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>METDistributionMethod</c> with given parameters.
    /// </summary>
    /// <param name="_recId">
    /// Id of the record.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static MetItemDistributionMethod find(METDistributionMethod _distributionMethod, boolean _forupdate = false)
    {
        MetItemDistributionMethod   itemDistributionMethod;

        if (_distributionMethod)
        {
            itemDistributionMethod.selectForUpdate(_forupdate);

            select firstonly itemDistributionMethod
                where itemDistributionMethod.DistributionMethod == _distributionMethod;
        }

        return itemDistributionMethod;
    }

]]></Source>
