		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static METVillageName find(
        METVillageId _VillageId ,
        boolean _forupdate = false,
        ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        METVillageName villageName;

        villageName.selectForUpdate(_forupdate);
        if (_forupdate && _concurrencyModel != ConcurrencyModel::Auto)
        {
            villageName.concurrencyModel(_concurrencyModel);
        }

        select firstonly villageName where villageName.villageId == _VillageId;

        return villageName;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    public static boolean exist(METVillageId _VillageId )
    {
        boolean found;

        found = (select firstonly
                     RecId
                from
                     METVillageName
                 where
                     METVillageName.villageId == _VillageId).RecId != 0;

        return found;
    }

]]></Source>
			</Method>
