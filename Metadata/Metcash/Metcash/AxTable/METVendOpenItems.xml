		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_5046_MetpayInterfaces 05/05/2021
    /// This method finds a specific row and returns it
    /// </summary>
    /// <param name = "_refRecId">RecId Identifier</param>
    /// <param name = "_accountNum">Account number</param>
    /// <param name = "_invoice">Invoice Number</param>
    /// <returns>returns vendOpenItems table</returns>
    public METVendOpenItems find(RefRecId _refRecId, AccountNum _accountNum, VendInvoiceId _invoice)
    {
        METVendOpenItems vendOpenItems;

        select vendOpenItems
            where vendOpenItems.VendTransOpenRecId == _refRecId
            && vendOpenItems.AccountNum == _accountNum
            && vendOpenItems.Invoice == _invoice;

        return vendOpenItems;
    }

]]></Source>
