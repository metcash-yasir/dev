		<Methods>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// modifiedField
    /// </summary>
    /// <param name = "_fieldId">_fieldId</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch(_fieldId)
        {
            case fieldNum(METSalesOrderGuideLine, LineType):
                this.ItemId         = '';
                this.AttributeName  = '';
                this.AttributeValue = '';
                break;
            case fieldNum(METSalesOrderGuideLine, AttributeName):
                this.AttributeValue = '';
                this.ItemId         = '';
                if(this.AttributeName)
                {
                    this.LineType       = METSalesOrderGuideLineType::Attribute;
                }
                else
                {
                    this.LineType       = METSalesOrderGuideLineType::NotSelected;
                }
                break;
            case fieldNum(METSalesOrderGuideLine, ItemId):
                this.AttributeName  = '';
                this.AttributeValue = '';
                if(this.ItemId)
                {
                    this.LineType       = METSalesOrderGuideLineType::Item;
                }
                else
                {
                    this.LineType       = METSalesOrderGuideLineType::NotSelected;
                }
                break;
        }   
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    /// <summary>
    /// initValue
    /// </summary>
    public void initValue()
    {
        super();
        this.LineType = METSalesOrderGuideLineType::NotSelected;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// validateWrite
    /// </summary>
    /// <returns>Result</returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();
    
        switch(this.LineType)
        {
            case METSalesOrderGuideLineType::NotSelected:
                ret = checkFailed("@MET:SalesOrderGuideLineTypeError");
                break;
            case METSalesOrderGuideLineType::Item:
                if(!this.ItemId || this.AttributeName || this.AttributeValue)
                {
                    ret = checkFailed("@MET:SalesOrderGuideLineTypeError");
                }                
                break;
            case METSalesOrderGuideLineType::Attribute:
                if(this.ItemId || !this.AttributeName)
                {
                    ret = checkFailed("@MET:SalesOrderGuideLineTypeError");
                }        
                else
                {
                    if(!this.AttributeValue)
                    {
                        ret = checkFailed("@MET:SalesOrderGuideAttributeNotSpecified");
                    }
                }
                break;
        }

        return ret;
    }

]]></Source>
			</Method>
