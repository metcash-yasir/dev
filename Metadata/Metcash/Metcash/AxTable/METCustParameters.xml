]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// Customer Tobacco validations on modified fields
    /// </summary>
    /// <param name = "_fieldId">Field number of the modified column</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);
        switch(_fieldId)
        {
            case fieldnum(METCustParameters, ValidateTobaccoLicence):
                str strTitle = "@MET:METUpdateConfirmation";
                if(this.ValidateTobaccoLicence == NoYes::Yes)
                {
                    str strMessage = "@MET:METTobaccoLicEnableMsg";
                    DialogButton dlgBtn = Box::yesNo(strMessage, DialogButton::Yes, strTitle); 
                    this.ValidateTobaccoLicence = (dlgBtn == DialogButton::Yes) ? NoYes::Yes : NoYes::No;
                }
                else
                {
                    str strMessage = "@MET:METTobaccoLicDisableMsg";
                    DialogButton dlgBtn = Box::yesNo(strMessage, DialogButton::Yes, strTitle);
                    this.ValidateTobaccoLicence = (dlgBtn == DialogButton::Yes) ? NoYes::No : NoYes::Yes;
                }
                break;
        }
    }

]]></Source>
			</Method>
		</Methods>
