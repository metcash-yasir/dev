    /// <returns>Order guide ID</returns>
    static METSalesOrderGuideID nextOrderGuideID()
    {
        return NumberSeq::newGetNum(NumberSeqReference::findReference(extendedTypeNum(METSalesOrderGuideID))).num();
    }

]]></Source>
