				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find record
    /// </summary>
    /// <param name = "_guideID">_guideID</param>
    /// <returns>METSalesOrderGuideTable</returns>
    static METSalesOrderGuideTable find(METSalesOrderGuideID _guideID, boolean _forUpdate = false)
    {
        METSalesOrderGuideTable guide;
        guide.selectForUpdate(_forUpdate);
        select firstonly guide
            where   guide.SalesOrderGuideID == _guideID;
        return guide;
    }

]]></Source>
