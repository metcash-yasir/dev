    /// <summary>
    /// MPJ_22974_BMSProductMDRItemStatusAndPackChange by chaminda on 27 Apr 2022
    /// Finds the specified record in the <c>METItemStockStatusTable</c> table.
    /// </summary>
    /// <param name="_metItemStockStatus">
    /// The ItemStatus of the <c>METItemStockStatusTable</c> record to find.
    /// </param>
    /// <param name="_update">
    /// A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    /// A record in the <c>METItemStockStatusTable</c> table; otherwise, an empty record.
    /// </returns>
    public static METItemStockStatusTable find(
        METItemStockStatus      _metItemStockStatus,
        boolean     _update = false)
    {
        METItemStockStatusTable  metItemStockStatusTable;

        metItemStockStatusTable.selectForUpdate(_update);

        if (_metItemStockStatus)
        {
            select firstonly metItemStockStatusTable
                where metItemStockStatusTable.ItemStockStatus == _metItemStockStatus;
        }

        return metItemStockStatusTable;
    }

