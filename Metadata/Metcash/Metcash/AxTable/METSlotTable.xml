		<Methods>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Exist method
    /// </summary>
    /// <param name = "_inventLocation">InventLocationId</param>
    /// <returns>boolean</returns>
    public static boolean exist(InventLocationId _inventLocation)
    {
        METSlotTable metSlotTable;

        return _inventLocation && (select firstonly metSlotTable
                    where metSlotTable.InventLocationId == _inventLocation
               ).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find method
    /// </summary>
    /// <param name = "_inventLocation">InventLocationId</param>
    /// <param name = "_update">boolean</param>
    /// <returns>METSlotTable</returns>
    public static METSlotTable find(InventLocationId _inventLocation, boolean _update = false)
    {
        METSlotTable metSlotTable;

        metSlotTable.selectForUpdate(_update);

        if (_inventLocation)
        {
            select firstonly metSlotTable
                where metSlotTable.InventLocationId == _inventLocation;
        }

        return metSlotTable;
    }

]]></Source>
			</Method>
		</Methods>
