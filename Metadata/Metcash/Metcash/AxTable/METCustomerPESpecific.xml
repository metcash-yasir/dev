				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find the record
    /// </summary>
    /// <param name = "_reportId">ReportId</param>
    /// <param name = "_forUpdate">forUpdate</param>
    /// <returns>record</returns>
    public static METPriceChangeInquiry find(GUPPriceReportReportId _reportId, boolean _forUpdate = false)
    {
        METPriceChangeInquiry inquiry;
        
        if (_reportId)
        {
            inquiry.selectForUpdate(_forUpdate);

            select firstonly inquiry
                where inquiry.ReportId == _reportId;
        }

        return inquiry;
    }

]]></Source>
