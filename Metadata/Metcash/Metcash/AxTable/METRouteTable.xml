		<Methods>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method checks for existance of a specific record
    /// </summary>
    /// <param name = "_routeIdentifier">
    /// RouteIdentifier
    /// </param>
    /// <returns>
    /// True if exists, else false.
    /// </returns>
    public static boolean exist(METRouteIdentifier _routeIdentifier)
    {
        boolean         found;        

        found = (select firstonly
                     RecId
                from
                     METRouteTable
                 where
                     METRouteTable.RouteIdentifier == _routeIdentifier).RecId != 0;

        return found;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByRouteIdentifier</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method finds a specific record based on route identifier
    /// </summary>
    /// <param name = "_routeIdentifier">
    /// RouteIdentifier
    /// </param>
    /// <param name = "_forupdate">
    /// Parameter to update the record
    /// </param>
    /// <returns>
    /// METRouteTable buffer
    /// </returns>
    public static METRouteTable findByRouteIdentifier(METRouteIdentifier _routeIdentifier ,
        boolean _forupdate = false)
        
    {
        METRouteTable routeTable;

        routeTable.selectForUpdate(_forupdate);        

        select firstonly routeTable
            where routeTable.RouteIdentifier == _routeIdentifier;

        return routeTable;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
