			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the METSplitGroupTable record by InventLocationId, shipmentUOM.
    /// </summary>
    /// <param name = "_splitGroup">SplitGroup</param>
    /// <returns>METSplitGroupTable buffer</returns>
    public static METSplitGroupTable find(METOrderSplitGroup _splitGroup, boolean _forUpdate = false)
    {
        METSplitGroupTable metSplitGroupTable;

        if (_forUpdate)
        {
            metSplitGroupTable.selectForUpdate(true);
        }

        if (_splitGroup)
        {
            select firstonly metSplitGroupTable
               where metSplitGroupTable.SplitGroup == _splitGroup;
        }

        return metSplitGroupTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns a boolean value, Yes if record found otherwise No.
    /// </summary>
    /// <param name = "_splitGroup">Split group.</param>
    /// <returns>A boolean value, Yes if record found otherwise No.</returns>
    public static boolean exist(METOrderSplitGroup _splitGroup)
    {
        return (_splitGroup) && (select firstonly RecId from metSplitGroupTable
                                                        index hint SplitGroupIDX
                                                            where metSplitGroupTable.SplitGroup == _splitGroup).RecId != 0;
    }

]]></Source>
