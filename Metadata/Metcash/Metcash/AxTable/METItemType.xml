				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>METItemType</c> with given parameters.
    /// </summary>
    /// <param name="_itemTypes">
    /// Item type.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static METItemType find(METItemTypes _itemTypes, boolean _forupdate = false)
    {
        METItemType  itemType;

        if (_itemTypes)
        {
            itemType.selectForUpdate(_forupdate);

            select firstonly itemType
                where itemType.ItemType == _itemTypes;
        }

        return itemType;
    }

]]></Source>
