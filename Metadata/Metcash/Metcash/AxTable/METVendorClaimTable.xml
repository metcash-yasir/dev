		<Methods>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// update related fields on field modified
    /// </summary>
    /// <param name = "_fieldId">modified field</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(METVendorClaimTable, Qty):
            case fieldNum(METVendorClaimTable, UnitClaimAmount):
                this.setClaimAmount();
                break;

            case fieldNum(METVendorClaimTable, ItemId):
                
                this.initFromItem();
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>setClaimAmount</Name>
				<Source><![CDATA[
    /// <summary>
    /// Set claim amount based on Qty and Unit claim price
    /// </summary>
    public void setClaimAmount()
    {
        if(this.ClaimType == MetVendClaimType::StandardCost)
        {
            this.ClaimAmount = this.Qty * this.UnitClaimAmount;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find the record matching with criteria and return
    /// </summary>
    /// <param name = "_claimRecId">Claim RecId</param>
    /// <param name = "_forUpdate">Indicates whether record to be selected for update</param>
    /// <returns><c>METVendorClaimTable</c> record buffer</returns>
    public static METVendorClaimTable find(RefRecId _claimRecId, boolean _forUpdate = false)
    {
        METVendorClaimTable vendorClaimTable;

        if(_claimRecId)
        {
            vendorClaimTable.selectForUpdate(_forUpdate);

            select firstonly vendorClaimTable
                where vendorClaimTable.RecId == _claimRecId;
        }

        return vendorClaimTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateClaimStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// update the claim status for selected record buffer
    /// </summary>
    /// <param name = "_status">Clami status</param>
    public void updateClaimStatus(METVendorClaimStatus _status)
    {
        ttsbegin;

        this.ClaimStatus = _status;
        this.update();

        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>existClaimLinesToProcess</Name>
				<Source><![CDATA[
    /// <summary>
    /// Check whether unprocessed claim lines exist for processing for specific claim type and site
    /// </summary>
    /// <param name = "_claimType">Claim type</param>
    /// <param name = "_siteId">Site id</param>
    /// <returns>true if lines exists.</returns>
    public static boolean existClaimLinesToProcess(MetVendClaimType _claimType, InventSiteId _siteId)
    {
        METVendorClaimTable vendorClaimTable;

        select firstonly RecId 
            from vendorClaimTable
            where vendorClaimTable.ClaimType == _claimType
            &&  vendorClaimTable.ClaimStatus == METVendorClaimStatus::Approved
            &&  vendorClaimTable.Claimed == NoYes::No
            &&  vendorClaimTable.SiteId == _siteId;

        return (vendorClaimTable.RecId != 0);
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromItem</Name>
				<Source><![CDATA[
    /// <summary>
    /// init fields from Item Id
    /// </summary>
    public void initFromItem()
    {
        METInventTable          metInventTable = METInventTable::find(this.ItemId);
        InventTable             inventTable = InventTable::find(this.ItemId);
        METTariffItemCodeBase   tariffItemCodeBase = METTariffItemCodeBase::findRecId(metInventTable.METTariffItemCodeBaseRecid);

        this.ItemDescription = inventTable.itemName();
        this.TariffItem = tariffItemCodeBase.TariffItem;
        this.StatCode   = tariffItemCodeBase.StatCode;
        this.CountryCode = metInventTable.CountryCode;
    }

]]></Source>
			</Method>
