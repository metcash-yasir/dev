		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>METPickDirectorData</c> record with given parameters.
    /// </summary>
    /// <param name = "_salesId">Sales order.</param>
    /// <param name = "_lineNum">Line number.</param>
    /// <param name = "_forUpdate">Determines whether the record is selected for update.</param>
    /// <param name = "_concurrencyModel">Determines the concurreny model when selecting <c>METPickDirectorData</c> record.</param>
    /// <returns>The record that is searched for METPickDirectorData if found.</returns>
    static METPickDirectorData find(SalesId                 _salesId,
                                 LineNum                    _lineNum,
                                 boolean                    _forUpdate = false,
                                 ConcurrencyModel           _concurrencyModel = ConcurrencyModel::Auto)
    {
        METPickDirectorData  pickDirectorData;

        if (_salesId)
        {
            if (_forUpdate)
            {
                pickDirectorData.selectForUpdate (_forUpdate);

                if (_concurrencyModel != ConcurrencyModel::Auto)
                {
                    pickDirectorData.concurrencyModel(_concurrencyModel);
                }
            }

            select firstonly pickDirectorData
                where pickDirectorData.SalesId == _salesId
                    && pickDirectorData.LineNum == _lineNum;
        }

        return pickDirectorData;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks if a specific <c>METPickDirectorData</c> record exists.
    /// </summary>
    /// <param name = "_salesId">Sales order.</param>
    /// <param name = "_lineNum">Line number.</param>
    /// <returns>True if the record exists; otherwise, false</returns>
    static boolean exist(SalesId                 _salesId,
                         LineNum                 _lineNum)
    {
        if (!_salesId)
        {
            return false;
        }

        return (select firstonly RecId from METPickDirectorData
                    where METPickDirectorData.SalesId == _salesId
                        && METPickDirectorData.LineNum == _lineNum).RecId != 0;
    }

]]></Source>
			</Method>
