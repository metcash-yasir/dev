		<Methods>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves the RecId for a given Itemcode.
    /// </summary>
    /// <param name = "_recId">
    ///  The RecId of the recod
    ///  </param>
    /// <param name = "_forUpdate">
    /// A Boolean value that determines whether the RecId of orign should be selected for update; optional.
    /// </param>
    /// <returns>
    /// The <c>METTariffItemCodeBase</c>table.
    /// </returns>
    static METTariffItemCodeBase findRecId(RecId    _recId,
                                      boolean  _forUpdate  = false)
    {
        METTariffItemCodeBase metTariffItemCodeBase;

        if (_recId)
        {
            select firstonly metTariffItemCodeBase
                where metTariffItemCodeBase.RecId == _recId;

            metTariffItemCodeBase.selectForUpdate(_forUpdate);
        }
        return metTariffItemCodeBase;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findbyTariffStatCode</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find Tariff Item code Base using Tariff Item and Stat Code
    /// </summary>
    /// <param name = "_tariffItem">Tariff Item name</param>
    /// <param name = "_statCode">Stat Code name</param>
    /// <param name = "_forUpdate">true, if selected for update</param>
    /// <returns><c>METTariffItemCodeBase</c> record if found</returns>
    static METTariffItemCodeBase findbyTariffStatCode(METTariffItem    _tariffItem,
                                                      METStatCode      _statCode,
                                                      boolean  _forUpdate  = false)
    {
        METTariffItemCodeBase metTariffItemCodeBase;

        if (_tariffItem && _statCode)
        {
            select firstonly metTariffItemCodeBase
                where metTariffItemCodeBase.TariffItem == _tariffItem
                && metTariffItemCodeBase.StatCode   == _statCode;

            metTariffItemCodeBase.selectForUpdate(_forUpdate);
        }
        return metTariffItemCodeBase;
    }

]]></Source>
			</Method>
		</Methods>
