				<Name>wmsOrderTrans</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find related WMSOrderTrans record
    /// </summary>
    /// <returns>WMSOrderTrans buffer</returns>
    public WMSOrderTrans wmsOrderTrans()
    {
        WMSOrderTrans  wmsOrderTrans;

        select firstonly  wmsOrderTrans where wmsOrderTrans.RecId == this.WMSOrderTrans;

        return wmsOrderTrans;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by WMSOrderTrans reference
    /// </summary>
    /// <param name = "_wmsOrderTrans">WMSOrderTrans recid</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>METWMSOrderTrans record</returns>
    static public METWMSOrderTrans find(RefRecId _wmsOrderTrans, boolean _forUpdate = false)
    {
        METWMSOrderTrans metWMSOrderTrans;
        if(_wmsOrderTrans)
        {
            metWMSOrderTrans.selectForUpdate(_forUpdate);
            select firstonly metWMSOrderTrans
               where   metWMSOrderTrans.WMSOrderTrans  == _wmsOrderTrans;
        }
        return metWMSOrderTrans;
    }

]]></Source>
