		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds Pick List record using Pick list number
    /// </summary>
    /// <param name = "_pickListNumber">Pick list number</param>
    /// <param name = "_forUpdate">Select for update</param>
    /// <param name = "_concurrencyModel">The concurrency model</param>
    /// <returns>A MetPickList record</returns>
    public static METPickList find(
        METPickListNumber   _pickListNumber,
        boolean             _forUpdate = false,
        ConcurrencyModel    _concurrencyModel = ConcurrencyModel::Auto)
    {
        METPickList metPickList;

        metPickList.selectForUpdate(_forUpdate);
        if (_forUpdate && _concurrencyModel != ConcurrencyModel::Auto)
        {
            metPickList.concurrencyModel(_concurrencyModel);
        }

        select firstonly metPickList
            where metPickList.PickListNumber == _pickListNumber;

        return metPickList;
    }

]]></Source>
			</Method>
