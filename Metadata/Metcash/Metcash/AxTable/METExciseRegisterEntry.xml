			<Method>
				<Name>metUpdateRefFields</Name>
				<Source><![CDATA[
    public void metUpdateRefFields()
    {
        InventTable         inventTable;
        METInventTable      metInventTable;
        METTariffItemCode   metTariffItemCode;
        InventSite          inventSite;

        //Fetch Inventory unit
        select firstonly ItemId,Product,RecId
            from inventTable
                where inventTable.ItemId == this.ItemNo;
        this.InventoryUnitOfMeasure = inventtable.InventUnitId();

        //Duty of Country Code
        select firstonly InventTableRefRecid,CountryCode,AlcoholContent,BottleSize
            from metInventTable
                where metInventTable.InventTableRefRecid == inventTable.RecId;
        this.DutyOriginCountryCode = metInventTable.CountryCode;

        METDutyCountryOfOrigin METDutyCountryOfOrigin= METDutyCountryOfOrigin::find(this.DutyOriginCountryCode);
        this.PreferenceRule   = METDutyCountryOfOrigin.PreferenceRule;
        this.PreferenceScheme = METDutyCountryOfOrigin.PreferenceScheme;
        this.Advalorem        = METDutyCountryOfOrigin.AdValorem;
  
        //Fetch Tariff Item Code
        select firstonly TariffItem,StatCode,CustomsExcise,RecId
            from metTariffItemCode
                where metTariffItemCode.RecId == metInventTable.METTariffItemCodeRecid;

        this.TariffItemCode         = metTariffItemCode.TariffItem;
        this.StatCode               = metTariffItemCode.StatCode;
        this.CustomsExcise          = metTariffItemCode.CustomsExcise;
        this.DutyRate               = metTariffItemCode.DutyLAL;
       
        //Fetch Site Bond Number
        select firstonly MetBondNumber
            from inventSite
                where inventSite.SiteId == this.Site;
        this.SiteBondNumber         = inventSite.METBondNumber;
        //Calculation for Liters of Alcohol (calculated) as per below:

        this.LitresOfAlcoholCalculated = ((metInventTable.AlcoholContent /100) * metInventTable.BottleSize * this.Quantity);
        //Fetch Origin details
        if(this.OriginType == METOriginType::PurchaseOrder)
        {
            PurchTable purchTable;
            select firstonly OrderAccount from purchTable
                    where purchTable.PurchId        == this.OriginNumber;

            this.OriginParty = purchTable.OrderAccount;

            PurchLine purchLine;
            select firstonly PurchUnit from purchLine
                where purchLine.PurchId == this.OriginNumber
                  &&  purchLine.ItemId  == this.ItemNo;
            if(!purchLine.RecId)
            {
                throw error(strFmt('Purchase line not found with ItemId - %1 in purchase order - %2', this.ItemNo, this.OriginNumber));
            }
            this.ReceiptUnitOfMeasure = purchLine.PurchUnit;

            //Do Unit Conversion & get the quantity filled in Inventory Unit

            this.Quantity = UnitOfMeasureConverter::convert(this.ReceiptQuantity, ///qty to be converted
                                                        UnitOfMeasure::findBySymbol(this.ReceiptUnitOfMeasure).RecId, //from Unit Id
                                                        UnitOfMeasure::findBySymbol(this.InventoryUnitOfMeasure).RecId, // TO Unit Id
                                                        NoYes::No, //roundAbsoluteValue
                                                        inventTable.Product, //Item Detail
                                                        NoYes::No); //Apply rounding

            this.AvailableQuantity = this.Quantity;
           

            
        }
        else if (this.OriginType == METOriginType::SalesOrder)
        {
            this.AvailableQuantity    = 0;
            this.Closed = NoYes::Yes;

            SalesTable salesTable;
            select firstonly CustAccount from salesTable
                where salesTable.SalesId == this.OriginNumber;
            this.OriginParty = salesTable.CustAccount;
            this.LitresOfAlcoholCalculated = - this.LitresOfAlcoholCalculated;

        }

       
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    ///  MET_5013_ExciseRegisterEntry check whether seleted item id has a tariff item code
    /// </summary>
    /// <returns>
    /// true if tariff item code exists; otherwise, false.
    /// </returns>
    public boolean validateWrite()
    {
        boolean ret;
        
        ret = super();

        //If Site is bonded site or not
        InventSite inventSite;
        select firstonly METBondedWarehouse from inventSite where InventSite.SiteId == this.Site;
        if(!inventSite.METBondedWarehouse)
        {
            ret = checkFailed(strFmt("Site %1 is not a bonded site",this.Site));
        }

        return ret;
    }

]]></Source>
