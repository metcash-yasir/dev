		<Methods>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    /// MET_5013_ExciseRegisterEntry based on item id seleted insert value in required fields 
    /// </summary>
    public void insert()
    {
        this.metUpdateRefFields();
        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>metUpdateRefFields</Name>
				<Source><![CDATA[
    /// <summary>
    /// defaults some of the fields based on the inputs
    /// </summary>
    public void metUpdateRefFields()
    {
        METInventTable      metInventTable;
        
        //default values from Met InventTable
        select firstonly CountryCode,AlcoholContent,BottleSize,METTariffItemCodeRecid,ValueForDuty
            from metInventTable
                where metInventTable.ItemId == this.ItemId;
        this.DutyOriginCountryCode  = metInventTable.CountryCode;
        this.PreferenceRule         = metInventTable.PreferenceRule;
        this.PreferenceScheme       = metInventTable.PreferenceScheme;
        this.ValueForDuty           = metInventTable.ValueForDuty;

        //default fields values from TariffItemCode
        METTariffItemCode metTariffItemCode = METTariffItemCode::findRecId(metInventTable.METTariffItemCodeRecid);
        this.initFromTariffItemCode(metTariffItemCode);

        //default fields from Duty Country Code
        METDutyCountryOfOrigin METDutyCountryOfOrigin= METDutyCountryOfOrigin::find(this.DutyOriginCountryCode);
        this.isAdvalorem        = METDutyCountryOfOrigin.AdValorem;
       
        //default fields from Site
        this.initFromInventSite();
       
        //Fetch Origin details
        if(this.OriginType == METOriginType::PurchaseOrder)
        {
            this.initFromPurchOrder();

            this.setAvailableQty();    //calculate the quantity

            if(this.Quantity != 0)
            {
                //calculate duty rate received per unit in inventory unit (to be used by other type of entries)
                this.DutyRateReceivedInventUnit = this.DutyRateReceived * this.ReceiptQuantity / this.Quantity;
            }
            this.CustomValue    = this.DutyRateReceived * this.ReceiptQuantity;
            this.CustomerExempt = NoYes::Yes;
        }
        else if (this.OriginType == METOriginType::SalesOrder)
        {
            this.initFromSalesOrder();

            this.ReceiptQuantity            = 0;
            this.ReceiptUnitOfMeasure       = '';
            this.AvailableQuantity          = 0;
            this.Closed                     = NoYes::Yes;
        }
        else if (this.OriginType == METOriginType::SalesOrderReturn)
        {
            this.initFromSalesOrder();
            this.CustomerExempt = NoYes::Yes;
        }
       
        //check if beer allowance is there
        if(metTariffItemCode.BeerAllowance)
        {
            //if yes, we need to reduce alcohol content for LAL calulation 
            metInventTable.AlcoholContent = metInventTable.AlcoholContent - metTariffItemCode.AdValoremOrBeerSubsidyRate;
        }
            
        //Calculation for Liters of Alcohol (calculated) as per below:
        this.LitresOfAlcoholCalculated = (metInventTable.AlcoholContent /100) * metInventTable.BottleSize * abs(this.Quantity);

        //get Custom Duty (LAL *DutyLAL) , to be used by NAT30/40 reports
        this.CustomDuty = this.LitresOfAlcoholCalculated * this.DutyRate;

        
        if(metTariffItemCode.BeerAllowance)
        {
            this.TotalDuty = this.CustomDuty;
        }
        else
        {
            //LAL*DutyLAL + TotalVFD*Advalorem rate%
            METDutyRate advaloremRate;

            //if not beer allowance, check for advalorem
            if(METDutyCountryOfOrigin.AdValorem)
            {
                advaloremRate = metTariffItemCode.AdValoremOrBeerSubsidyRate;
            }
            else
            {
                advaloremRate = METDutyCountryOfOrigin.DevelopingRate;
            }

            this.TotalDuty = this.CustomDuty + this.DutyRateReceivedInventUnit * abs(this.Quantity) * advaloremRate / 100 ;
        }
       
        if( (this.OriginType == METOriginType::SalesOrderReturn || this.OriginType == METOriginType::TransferOrder || this.OriginType == METOriginType::ItemAdjustment)  && this.ReceiptQuantity > 0)
        {
            this.LitresOfAlcoholCalculated  = - this.LitresOfAlcoholCalculated;
            this.CustomDuty                 = - this.CustomDuty;
            this.TotalDuty                  = - this.TotalDuty;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>setAvailableQty</Name>
				<Source><![CDATA[
    /// <summary>
    /// convert and set the Inventory unit and quantity , and then sets the available qty
    /// </summary>
    public void setAvailableQty()
    {
        this.setInventUnitQty();

        this.AvailableQuantity = this.Quantity;

    }

]]></Source>
			</Method>
			<Method>
				<Name>setInventUnitQty</Name>
				<Source><![CDATA[
    /// <summary>
    /// convert and set the Inventory unit and quantity only
    /// </summary>
    public void setInventUnitQty()
    {
        this.InventoryUnitOfMeasure = InventTableModule::find(this.ItemId, ModuleInventPurchSales::Invent).UnitId;

        InventDim inventDim;
        inventDim.InventSiteId = this.Site;

        this.Quantity =  EcoResProductUnitConverter::convertGivenUnitSymbolsForReleasedProduct(
                            this.ItemId,
                            InventDim::findDim(inventDim).inventDimId,
                            this.ReceiptQuantity,
                            this.ReceiptUnitOfMeasure,//from unit
                            this.InventoryUnitOfMeasure,//to unit
                            NoYes::No,//roundAbsoulte value
                            NoYes::No);//apply rounding
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromTariffItemCode</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise default values from Tariff Item code
    /// </summary>
    /// <param name = "metTariffItemCode">Tariff Item Code table record</param>
    public void initFromTariffItemCode(METTariffItemCode metTariffItemCode)
    {
        this.TariffItemCode = metTariffItemCode.TariffItem;
        this.StatCode       = metTariffItemCode.StatCode;
        this.CustomsExcise  = metTariffItemCode.CustomsExcise;
        this.DutyRate       = metTariffItemCode.DutyLAL;
        this.NAT3040        = metTariffItemCode.NAT3040;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromPurchOrder</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise default values from Purchase Order
    /// </summary>
    public void initFromPurchOrder()
    {
        PurchTable purchTable;
        select firstonly OrderAccount from purchTable
                    where purchTable.PurchId        == this.OriginNumber;

        this.OriginParty = purchTable.OrderAccount;

        PurchLine purchLine;
        select firstonly PurchUnit from purchLine
                where purchLine.PurchId == this.OriginNumber
                  &&  purchLine.ItemId  == this.ItemId;
        
        this.ReceiptUnitOfMeasure = purchLine.PurchUnit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromSalesOrder</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise default values from Sales Order
    /// </summary>
    public void initFromSalesOrder()
    {
        SalesTable  salesTable;
        CustTable   custTable;

        select firstonly CustAccount from salesTable
                where salesTable.SalesId == this.OriginNumber
            join VATNum from custTable
                where custTable.Accountnum == salesTable.CustAccount;

        this.OriginParty = salesTable.CustAccount;

        //if customer has Tax exempt number, mark the transaction exempt from Duty
        //this logic to determine duty exempt can change in future release
        if(custTable.VATNum)
        {
            this.CustomerExempt = NoYes::Yes;
        }
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromInventSite</Name>
				<Source><![CDATA[
    /// <summary>
    /// initialise from Site
    /// </summary>
    public void initFromInventSite()
    {
        InventSite inventSite;
        //Fetch Site Bond Number
        select firstonly MetBondNumber
            from inventSite
                where inventSite.SiteId == this.Site;
        this.SiteBondNumber         = inventSite.METBondNumber;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    ///  MET_5013_ExciseRegisterEntry check whether seleted item id has a tariff item code
    /// </summary>
    /// <returns>
    /// true if tariff item code exists; otherwise, false.
    /// </returns>
    public boolean validateWrite()
    {
        boolean ret;
        
        ret = super();

        //If Site is bonded site or not
        InventSite inventSite;
        select firstonly METBondedWarehouse from inventSite where InventSite.SiteId == this.Site;
        if(!inventSite.METBondedWarehouse)
        {
            ret = checkFailed(strFmt("@MET:SiteIsNotABondedSite",this.Site));
        }

        if(this.OriginType == METOriginType::PurchaseOrder)
        {
            PurchLine purchLine;
            select firstonly PurchUnit from purchLine
                where purchLine.PurchId == this.OriginNumber
                  &&  purchLine.ItemId  == this.ItemId;
            if(!purchLine.RecId)
            {
                ret = checkFailed(strFmt("@MET:PurchaseLineNotFound", this.ItemId, this.OriginNumber));
            }
        }

        return ret;
    }

]]></Source>
			</Method>
