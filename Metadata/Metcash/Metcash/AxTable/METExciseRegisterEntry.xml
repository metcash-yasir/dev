				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    /// MET_5013_ExciseRegisterEntry based on item id seleted insert value in required fields 
    /// </summary>
    public void insert()
    {
        this.metUpdateRefFields();
        super();
    }

]]></Source>
