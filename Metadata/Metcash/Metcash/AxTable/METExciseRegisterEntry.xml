		<Methods>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    /// MET_5013_ExciseRegisterEntry based on item id seleted insert value in required fields 
    /// </summary>
    public void insert()
    {
        this.metUpdateRefFields();
        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>metUpdateRefFields</Name>
				<Source><![CDATA[
    public void metUpdateRefFields()
    {
        METInventTable      metInventTable;
        
        //Duty of Country Code
        select firstonly CountryCode,AlcoholContent,BottleSize
            from metInventTable
                where metInventTable.ItemId == this.ItemId;
        this.DutyOriginCountryCode = metInventTable.CountryCode;

        //default fields values from TariffItemCode
        this.initFromTariffItemCode(metInventTable.METTariffItemCodeRecid);

        //default fields from Duty Country Code
        this.initFromDutyCountryOfOrigin(this.DutyOriginCountryCode);
       
        //default fields from Site
        this.initFromInventSite();
       
        //Fetch Origin details
        if(this.OriginType == METOriginType::PurchaseOrder)
        {
            this.initFromPurchOrder();

            this.calculateQty();    //calculate the quantity
            this.LitresOfAlcoholCalculated = 1; //designate the sign (- or +) for field
        }
        else if (this.OriginType == METOriginType::SalesOrder)
        {
            this.initFromSalesOrder();

            this.ReceiptQuantity            = 0;
            this.ReceiptUnitOfMeasure       = '';
            this.AvailableQuantity          = 0;
            this.Closed                     = NoYes::Yes;
            this.LitresOfAlcoholCalculated  = -1; //designate the sign (- or +) for field

        }
        else if (this.OriginType == METOriginType::SalesOrderReturn)
        {
            this.initFromSalesOrder();

            this.calculateQty();    //calculate the quantity
            this.LitresOfAlcoholCalculated = 1;//designate the sign (- or +) for field
        }

        //Calculation for Liters of Alcohol (calculated) as per below:
        this.LitresOfAlcoholCalculated = this.LitresOfAlcoholCalculated * ((metInventTable.AlcoholContent /100) * metInventTable.BottleSize * this.Quantity);
       
    }

]]></Source>
			</Method>
			<Method>
				<Name>calculateQty</Name>
				<Source><![CDATA[
    private void calculateQty()
    {
        InventTable         inventTable;

        //Fetch Inventory unit
        select firstonly ItemId,Product,RecId
            from inventTable
                where inventTable.ItemId == this.ItemId;
        this.InventoryUnitOfMeasure = inventtable.InventUnitId();

        //Do Unit Conversion & get the quantity filled in Inventory Unit
        this.Quantity = UnitOfMeasureConverter::convert(this.ReceiptQuantity, ///qty to be converted
                                                        UnitOfMeasure::findBySymbol(this.ReceiptUnitOfMeasure).RecId, //from Unit Id
                                                        UnitOfMeasure::findBySymbol(this.InventoryUnitOfMeasure).RecId, // TO Unit Id
                                                        NoYes::No, //roundAbsoluteValue
                                                        inventTable.Product, //Item Detail
                                                        NoYes::No); //Apply rounding

        this.AvailableQuantity = this.Quantity;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromTariffItemCode</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise default values from Tariff Item code
    /// </summary>
    /// <param name = "_metTariffItemCodeRecId">Tariff Item Code table record Id</param>
    public void initFromTariffItemCode(RefRecId _metTariffItemCodeRecId)
    {
        METTariffItemCode metTariffItemCode = METTariffItemCode::findRecId(_metTariffItemCodeRecId);

        this.TariffItemCode         = metTariffItemCode.TariffItem;
        this.StatCode               = metTariffItemCode.StatCode;
        this.CustomsExcise          = metTariffItemCode.CustomsExcise;
        this.DutyRate               = metTariffItemCode.DutyLAL;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromDutyCountryOfOrigin</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise default values from Duty country of Origin
    /// </summary>
    /// <param name = "_countryCode">Country Code</param>
    public void initFromDutyCountryOfOrigin(METCountryCode _countryCode)
    {
        METDutyCountryOfOrigin METDutyCountryOfOrigin= METDutyCountryOfOrigin::find(_countryCode);
        this.PreferenceRule   = METDutyCountryOfOrigin.PreferenceRule;
        this.PreferenceScheme = METDutyCountryOfOrigin.PreferenceScheme;
        this.Advalorem        = METDutyCountryOfOrigin.AdValorem;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromPurchOrder</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise default values from Purchase Order
    /// </summary>
    public void initFromPurchOrder()
    {
        PurchTable purchTable;
        select firstonly OrderAccount from purchTable
                    where purchTable.PurchId        == this.OriginNumber;

        this.OriginParty = purchTable.OrderAccount;

        PurchLine purchLine;
        select firstonly PurchUnit from purchLine
                where purchLine.PurchId == this.OriginNumber
                  &&  purchLine.ItemId  == this.ItemId;
        
        this.ReceiptUnitOfMeasure = purchLine.PurchUnit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromSalesOrder</Name>
				<Source><![CDATA[
    /// <summary>
    /// Initialise default values from Sales Order
    /// </summary>
    public void initFromSalesOrder()
    {
        SalesTable salesTable;
        select firstonly CustAccount from salesTable
                where salesTable.SalesId == this.OriginNumber;

        this.OriginParty = salesTable.CustAccount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initFromInventSite</Name>
				<Source><![CDATA[
    /// <summary>
    /// initialise from Site
    /// </summary>
    public void initFromInventSite()
    {
        InventSite inventSite;
        //Fetch Site Bond Number
        select firstonly MetBondNumber
            from inventSite
                where inventSite.SiteId == this.Site;
        this.SiteBondNumber         = inventSite.METBondNumber;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    ///  MET_5013_ExciseRegisterEntry check whether seleted item id has a tariff item code
    /// </summary>
    /// <returns>
    /// true if tariff item code exists; otherwise, false.
    /// </returns>
    public boolean validateWrite()
    {
        boolean ret;
        
        ret = super();

        //If Site is bonded site or not
        InventSite inventSite;
        select firstonly METBondedWarehouse from inventSite where InventSite.SiteId == this.Site;
        if(!inventSite.METBondedWarehouse)
        {
            ret = checkFailed(strFmt("@MET:SiteIsNotABondedSite",this.Site));
        }

        if(this.OriginType == METOriginType::PurchaseOrder)
        {
            PurchLine purchLine;
            select firstonly PurchUnit from purchLine
                where purchLine.PurchId == this.OriginNumber
                  &&  purchLine.ItemId  == this.ItemId;
            if(!purchLine.RecId)
            {
                ret = checkFailed(strFmt("@MET:PurchaseLineNotFound", this.ItemId, this.OriginNumber));
            }
        }

        return ret;
    }

]]></Source>
			</Method>
