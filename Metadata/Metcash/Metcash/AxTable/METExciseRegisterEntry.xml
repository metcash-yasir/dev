			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    /// 
    /// </summary>
    public void insert()
    {
        InventTable         inventTable;
        METInventTable      metInventTable;
        METTariffItemCode   metTariffItemCode;
        InventSite          inventSite;

        inventtable   = Inventtable::find(this.ItemNo);
        select metInventTable where metInventTable.InventTableRefRecid == inventTable.RecId;
        metTariffItemCode = METTariffItemCode::findRecId(metInventTable.METTariffItemCodeRecid);
        inventSite = InventSite::find(this.Site);

        this.InventoryUnitOfMeasure = inventtable.InventUnitId();
        this.ReceiptUnitOfMeasure   = inventTable.inventTableModulePurch().UnitId;
        this.TariffItemCode         = metTariffItemCode.TariffItem;
        this.StatCode               = metTariffItemCode.StatCode;
        this.CustomsExcise          = metTariffItemCode.CustomsExcise;
        this.SiteBondNumber         = inventSite.METBondNumber;

        super();
    }

]]></Source>
			</Method>
