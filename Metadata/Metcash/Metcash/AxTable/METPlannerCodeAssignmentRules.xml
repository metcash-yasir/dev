    /// <param name = "_fieldId"> field id</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch(_fieldId)
        {
            case fieldnum(METPlannerCodeAssignmentRules, RuleEnabled):
                this.RuleEnabledStatusLastModified = DateTimeUtil::applyTimeZoneOffset(DateTimeUtil::getSystemDateTime(), DateTimeUtil::getUserPreferredTimeZone());
                break;                
        }
    }

]]></Source>
