		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_19364_PlannerCode
    /// </summary>
    /// <returns> boolean value </returns>
    public boolean validateWrite()
    {
        boolean ret;

        ret = super();

        if (ret && (this.RuleProductCategory && this.RuleProductCategoryHierarchy))
        {
            EcoResCategory ecoResCategory;
            select firstonly RecId from ecoResCategory
                where ecoResCategory.CategoryHierarchy == this.RuleProductCategoryHierarchy &&
                ecoResCategory.RecId == this.RuleProductCategory;

            if(!ecoResCategory.RecId)
            {
                ret = checkFailed("@MET:InvalidCategoryHierarchyAndCategoryCombination");
            }
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_19364_PlannerCode
