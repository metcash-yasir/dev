				<Source><![CDATA[
    /// <summary>
    /// Checks if on-hold status exist in the table.
    /// </summary>
    /// <param name = "_onHoldStatus">On-hold status.</param>
    /// <returns>True, if exists; otherwise, false.</returns>
    public static boolean exists(METCustOnHoldStatus _onHoldStatus)
    {
        return (select RecId from METCustOnHoldStatusParameters
            where METCustOnHoldStatusParameters.OnHoldStatus == _onHoldStatus).RecId != 0;
    }

]]></Source>
