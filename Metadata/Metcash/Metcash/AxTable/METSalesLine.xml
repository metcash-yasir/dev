			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by reference
    /// </summary>
    /// <param name = "_salesLineRecID">_salesLineRecID</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>SalesLine</returns>
    static public METSalesLine find(RefRecId _salesLineRecID, boolean _forUpdate = false)
    {
        METSalesLine metSalesLine;            
        if(_salesLineRecID)
        {
            metSalesLine.selectForUpdate(_forUpdate);
            select firstonly metSalesLine
               where   metSalesLine.SalesLine  == _salesLineRecID;
        }
        return metSalesLine;
    }

]]></Source>
