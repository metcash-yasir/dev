				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// Handles logic when a field value is modified. If the modified field is DelayPricing,
    /// updates the related METSalesTable record's DelayPricing field accordingly.
    /// </summary>
    /// <param name="_fieldId">The ID of the field that was modified.</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        if (_fieldId == fieldNum(METSalesLine, DelayPricing))
        {
            this.updateMetSalesTableDelayPricing();
        }
    }

]]></Source>
