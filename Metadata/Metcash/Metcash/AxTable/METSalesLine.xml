				<Name>updateIntegrationStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// Update Integration status
    /// </summary>
    /// <param name = "_integrationStatus">Integration Status</param>
    public void updateIntegrationStatus(METIntegrationStatus _integrationStatus)
    {
        
        ttsbegin;

        this.selectForUpdate(true);
        this.IntegrationStatus = _integrationStatus;
        this.update();

        ttscommit;
    }

]]></Source>
