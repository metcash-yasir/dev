			<Method>
				<Name>update</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates a table buffer into the database.
    /// </summary>
    public void update()
    {
        METInvoicePostingContext    invoicePostingContext = METInvoicePostingContext::current();

        if (invoicePostingContext 
                && invoicePostingContext.parmSkipBusinessEvents())
        {
            this.skipBusinessEvents(true);
        }
        else
        {
            // Skip business events processing for this update operation
            METCheckSkipBusinessEventsHelper::shouldSkipBusinessEvents(this);
        }

        METSalesLine metSalesLineOrig = this.orig();

        METSalesLineContext salesLineContext = METSalesLineContext::current();

        if (salesLineContext && salesLineContext.skipMETSalesLineBusinessEvents == true)
        {
            this.skipBusinessEvents(true);
        }

        super();

        //Bug354734
        if (this.InvoiceNumber
            && (this.InvoiceNumber != metSalesLineOrig.InvoiceNumber || this.InvoiceLineNumber != metSalesLineOrig.InvoiceLineNumber || this.CWReturnWeight != metSalesLineOrig.CWReturnWeight))
        {
            SalesLine salesLine = this.salesLine();
            if (salesLine.SalesType == SalesType::ReturnItem)
            {
                SalesId originalSalesId;
                originalSalesId = METReturnOrderCopyChargesHelper::syncSalesHeaderInvoice(this, salesLine);
                
                METReturnOrderCopyChargesHelper::copySOLineCharges(this, originalSalesId, salesLine, true);
                METReturnOrderCopyChargesHelper::createPriceComponentsByLine(this, originalSalesId, salesLine);
                // update the line to recalculate the line amount
                salesLine.reread();
                salesLine.selectForUpdate(true);
                salesLine.update();
                this.refreshSalesLineDataSource();
            }
        }
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    /// Inserts a new record into the database.
    /// </summary>
    public void insert()
    {
        METSalesTable metSalesTable;
        SalesLine salesLine = this.salesLine();

        if (!this.InvoiceNumber)
        {
            metSalesTable = salesLine.salesTable().metSalesTable();
            this.InvoiceNumber = metSalesTable.OriginalInvoice;
        }

        super();
        
        SalesId originalSalesId;

        //Bug354734
        if (salesLine.SalesType == SalesType::ReturnItem && this.InvoiceNumber)
        {
            originalSalesId = METReturnOrderCopyChargesHelper::syncSalesHeaderInvoice(this, salesLine);
            
            METReturnOrderCopyChargesHelper::copySOLineCharges(this, originalSalesId, salesLine);
            METReturnOrderCopyChargesHelper::createPriceComponentsByLine(this, originalSalesId, salesLine);
            // update the line to recalculate the line amount
            salesLine.reread();
            salesLine.selectForUpdate(true);
            salesLine.update();

            this.refreshSalesLineDataSource();
        }
        else if (salesLine.SalesQty < 0 && metSalesTable.OriginalSalesId)
        {
            salesLine.reread();
            salesLine.selectForUpdate(true);
            salesLine.update();
            
            this.refreshSalesLineDataSource();
        }
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>refreshSalesLineDataSource</Name>
				<Source><![CDATA[
    private void refreshSalesLineDataSource()
    {
        if (FormDataUtil::isFormDataSource(this))
        {
            FormDataSource salesLine_ds;
            FormRun formRun = FormDataUtil::getFormDataSource(this).formRun();
            salesLine_ds = formRun.dataSource(formDataSourceStr(SalesTable, SalesLine));
            if (salesLine_ds)
            {
                salesLine_ds.research(true);
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (ret && this.InvoiceNumber)
        {
            SalesLine salesLine = this.salesLine();

            if (salesLine && salesLine.SalesType == SalesType::ReturnItem)
            {
                METSalesTable   metSalesTable;

                select firstonly OriginalInvoice from metSalesTable
                    where metSalesTable.SalesId == salesLine.SalesId;

                if (metSalesTable.OriginalInvoice
                    && metSalesTable.OriginalInvoice != this.InvoiceNumber)
                {
                    ret = checkFailed(strFmt("@MET:DuplicateOrigInvoice",
                            metSalesTable.OriginalInvoice,
                            this.InvoiceNumber));
                }
            }
        }

        return ret;
    }

]]></Source>
