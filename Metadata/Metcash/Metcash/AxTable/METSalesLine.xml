		<Methods>
			<Method>
				<Name>salesLine</Name>
				<Source><![CDATA[
    public SalesLine salesLine(boolean _forUpdate = false)
    {
        if(this.SalesLine)
        {
            return SalesLine::findRecId(this.SalesLine, _forUpdate);
        }
        return null;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static public METSalesLine find(RefRecId _salesLineRecID, boolean _forUpdate = false)
    {
        if(!_salesLineRecID)
            return null;
        METSalesLine metSalesLine;
        metSalesLine.selectForUpdate(_forUpdate);
        select firstonly metSalesLine
            where   metSalesLine.SalesLine  == _salesLineRecID;
        return metSalesLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findOrCreate</Name>
				<Source><![CDATA[
    static public METSalesLine findOrCreate(RefRecId _salesLineRecID, boolean _forUpdate = false)
    {
        if(!_salesLineRecID)
            return null;
        METSalesLine metSalesLine = METSalesLine::find(_salesLineRecID, _forUpdate);        
        if(!metSalesLine)
        {
            metSalesLine.initValue();
            metSalesLine.SalesLine = _salesLineRecID;
            metSalesLine.insert();
        }
        return metSalesLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();
        this.SubstitutionCode   = METSalesItemSubstitutionCode::None;
        this.SubstitutionType   = METSalesItemSubstitutionType::None;
    }

]]></Source>
