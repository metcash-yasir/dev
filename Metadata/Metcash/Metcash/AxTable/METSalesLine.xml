			<Method>
				<Name>islineExtracted</Name>
				<Source><![CDATA[
    /// <summary>
    ///  /// MPJ_24819_SOParametersAndCancelLinePickList
    /// </summary>
    /// <param name = "_salesLine">salesLine</param>
    /// <returns>boolean</returns>
    static public boolean islineExtracted(SalesLine _salesLine)
    {
        METSalesLine    metSalesLine;
        boolean         metLineExtracted;

        select firstonly OrderExtractStatus from metSalesLine
                where metSalesLine.SalesLine            == _salesLine.RecId &&
                      metSalesLine.OrderExtractStatus   == METOrderExtractStatus::Extracted;
        if(metSalesLine.OrderExtractStatus)
        {
            metLineExtracted = true;
        }
        return metLineExtracted;
    }

]]></Source>
