			<Method>
				<Name>removeIndicator</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB166_SalesOrderSubstitutes
    /// </summary>
    /// <param name = "_indicator">indicator to remove</param>
    public void removeIndicator(str _indicator)
    {
        if (strScan(this.Indicators, _indicator, 1, strLen(this.Indicators)))
        {
            List list = strSplit(this.Indicators, METConstants::Comma);
            Container con;
            ListEnumerator le = list.getEnumerator();

            while (le.moveNext())
            {
                if (le.current() != _indicator)
                {
                    con += le.current();
                }
            }            

            this.Indicators = con2Str(con, METConstants::Comma);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>addIndicator</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB166_SalesOrderSubstitutes
    /// </summary>
    /// <param name = "_indicator">Indicator to add</param>
    public void addIndicator(str _indicator)
    {
        // If S is not in the indicators field add it
        if (!strScan(this.Indicators, _indicator, 1, strLen(this.Indicators)))
        {            
            // if indicators already has a value in it, add ,S
            if (this.Indicators)
            {
                this.Indicators += METConstants::Comma + _indicator;
            }
            else
            {
                // else set the field to S
                this.Indicators = _indicator;
            }
        }
    }

]]></Source>
