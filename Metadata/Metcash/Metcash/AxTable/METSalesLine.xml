			<Method>
				<Name>updateMetSalesTableDelayPricing</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates the DelayPricing field in the related METSalesTable record based on the value of DelayPricing in the current and other METSalesLine records.
    /// </summary>
    public void updateMetSalesTableDelayPricing()
    {
        SalesTable      salesTable;
        SalesLine       salesLine;
        METSalesLine    metSalesLineLocal;
        METSalesTable   metSalesTable = METSalesTable::findBySalesId(this.salesLine().SalesId);
      
        if (this.DelayPricing == METDelayPricing::PackChange
                && metSalesTable.DelayPricing != METDelayPricing::PackChange)
        {          
            ttsbegin;
            metSalesTable.selectForUpdate(true);
            metSalesTable.DelayPricing = this.DelayPricing;
            metSalesTable.update();
            ttscommit;          
        }
        else
            if (this.DelayPricing == METDelayPricing::None
                && metSalesTable.DelayPricing != METDelayPricing::None)
        {
            select firstonly RecId from metSalesLineLocal
                where metSalesLineLocal.DelayPricing == METDelayPricing::PackChange
                    && metSalesLineLocal.RecId != this.RecId
                join salesLine                    
                    where salesLine.RecId == metSalesLineLocal.SalesLine
                    && salesLine.SalesId == this.salesLine().SalesId;
               
            if (!metSalesLineLocal.RecId)
            {      
                ttsbegin;
                metSalesTable.selectForUpdate(true);
                metSalesTable.DelayPricing = METDelayPricing::None;
                metSalesTable.update();
                ttscommit;        
            }                  
        }                               
    }

]]></Source>
			</Method>
			<Method>
				<Name>isPickingAllowed</Name>
				<Source><![CDATA[
    public static boolean isPickingAllowed(
    RefRecId _salesLineRecId)
    {
        METSalesLine metSalesLine;

        select firstOnly RecId, LineCancellationRequired
        from metSalesLine
        where metSalesLine.SalesLine == _salesLineRecId;

        // Exclude only when LineCancellationRequired is explicitly Yes.
        return !metSalesLine.RecId
        || metSalesLine.LineCancellationRequired == NoYes::No;
    }

]]></Source>
