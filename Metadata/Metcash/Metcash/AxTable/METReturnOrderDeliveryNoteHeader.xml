		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find Return order delivery note header based on RMA number
    /// </summary>
    /// <param name = "returnordernum">Return order number</param>
    /// <param name = "_forUpdate">Update identifier</param>
    /// <returns>Return METReturnOrderDeliveryNoteHeader</returns>
    static METReturnOrderDeliveryNoteHeader find(SalesReturnItemNum _returnordernum, boolean _forUpdate = false)
    {
        METReturnOrderDeliveryNoteHeader metReturnOrderHeader;

        metReturnOrderHeader.selectForUpdate(_forUpdate);

        if (_returnordernum)
        {
            select firstonly metReturnOrderHeader
                where metReturnOrderHeader.ReturnOrderNum == _returnordernum
                && metReturnOrderHeader.IntegrationStatus == METIntegrationStatus::None;
        }

        return metReturnOrderHeader;
    }

]]></Source>
			</Method>
		</Methods>
