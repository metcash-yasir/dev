			<Method>
				<Name>displayTotalTimeWithoutDualWrite</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    display real displayTotalTimeWithoutDualWrite()
    {
        real totalTime = this.Duration;

        if (!totalTime)
        {
            return 0;
        }

        if (this.DualWriteTimeInSec)
        {
            totalTime = totalTime - this.DualWriteTimeInSec;
        }

        return round(totalTime, 0.01);
    }

]]></Source>
			</Method>
			<Method>
				<Name>displaySpeed</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    display real displaySpeed()
    {
        if (!this.Duration || !this.LineCount)
        {
            return 0;
        }

        real durationInMinutes = this.Duration / 60;

        if (!durationInMinutes)
        {
            return 0;
        }

        real speed = this.LineCount / durationInMinutes;

        return round(speed, 0.01);
    }

]]></Source>
			</Method>
