		<Declaration><![CDATA[
public class METBatchMonitoringLog extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>durationDisp</Name>
				<Source><![CDATA[
    display Integer durationDisp()
    {
        Integer res;
        ;
        if (this.EndDateTime && this.StartDateTime)
        {
            res = any2int(DateTimeUtil::getDifference(this.LastUpdatedDateTime, this.StartDateTime));
        }
        return res;
    }

]]></Source>
			</Method>
			<Method>
				<Name>remainingDisp</Name>
				<Source><![CDATA[
    display Integer remainingDisp()
    {
        ;
        return max(0, this.LinesToProcess - this.DocumentCount);
    }

]]></Source>
			</Method>
			<Method>
				<Name>percentCompleteDisp</Name>
				<Source><![CDATA[
    display Integer percentCompleteDisp()
    {
        ;
        return this.LinesToProcess > 0 ? (this.DocumentCount * 100 / this.LinesToProcess) : 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>elapsedDisp</Name>
				<Source><![CDATA[
    display Integer elapsedDisp()
    {
        UtcDateTime endDt;
        ;
        if (!this.StartDateTime)
        {
            return 0;
        }
        endDt = this.EndDateTime ? this.EndDateTime : DateTimeUtil::getSystemDateTime();
        return any2int(DateTimeUtil::getDifference(endDt, this.StartDateTime));
    }

]]></Source>
			</Method>
			<Method>
				<Name>estimatedRemainingDisp</Name>
				<Source><![CDATA[
    display Integer estimatedRemainingDisp()
    {
        Integer elapsedSec, remaining;
        ;
        if (!this.StartDateTime || this.DocumentCount <= 0 || this.LinesToProcess <= 0 || this.Status == METBatchMonitoringStatus::Completed)
        {
            return 0;
        }
        elapsedSec = any2int(DateTimeUtil::getDifference(
            this.EndDateTime ? this.EndDateTime : DateTimeUtil::getSystemDateTime(),
            this.StartDateTime));
        remaining  = max(0, this.LinesToProcess - this.DocumentCount);
        return (remaining * elapsedSec) / this.DocumentCount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>clearLog</Name>
				<Source><![CDATA[
    static void clearLog(int _daysToKeep = 0)
    {
        METBatchMonitoringLog  batchMonitoringLog;
        TransDateTime          delDate = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -1 * _daysToKeep);
        ;
        if (! _daysToKeep)
        {
            delete_from batchMonitoringLog;
        }
        else
        {
            delete_from batchMonitoringLog
                where batchMonitoringLog.createdDateTime < delDate;
        }
    }

]]></Source>
			</Method>
		</Methods>
