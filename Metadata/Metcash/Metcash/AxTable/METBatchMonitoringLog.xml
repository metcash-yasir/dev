		<Methods>
			<Method>
				<Name>durationDisp</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    display Integer durationDisp()
    {
        Integer res;

        utcdatetime endDateTime = this.EndDateTime ? this.EndDateTime : this.LastUpdatedDateTime;
        
        if (endDateTime && this.StartDateTime)
        {
            res = any2int(DateTimeUtil::getDifference(endDateTime, this.StartDateTime));
        }

        return res;
    }

]]></Source>
			</Method>
			<Method>
				<Name>hasChildren</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    private boolean hasChildren()
    {
        METBatchMonitoringLog child;
        ;

        if (!this.BatchJobId || !this.IsHeader)
        {
            return false;
        }

        select firstonly RecId from child
            where child.BatchJobId  == this.BatchJobId
                && child.Operation  == this.Operation
                && child.IsHeader   == NoYes::No
                && this.IsHeader    == NoYes::Yes;

        return child.RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>hasRunningChildren</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns true if at least one child task log is still in Running status.
    /// Used by display methods to short-circuit once all children have finished.
    /// </summary>
    [SysClientCacheDataMethod(true)]
    boolean hasRunningChildren()
    {
        METBatchMonitoringLog child;
        ;

        if (!this.BatchJobId || !this.IsHeader)
        {
            return false;
        }

        select firstonly RecId from child
            where child.BatchJobId     == this.BatchJobId
               && child.Operation      == this.Operation
               && child.IsHeader       == NoYes::No
               && child.Status         == METBatchMonitoringStatus::Running
               && this.IsHeader        == NoYes::Yes;

        return child.RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>childDocumentCount</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    private int childDocumentCount()
    {
        METBatchMonitoringLog child;
        ;

        select sum(DocumentCount) from child
            where child.BatchJobId     == this.BatchJobId
               && child.Operation      == this.Operation
               && child.IsHeader       == NoYes::No
               && this.IsHeader        == NoYes::Yes;

        return child.DocumentCount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>effectiveLinesToProcess</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    private int effectiveLinesToProcess()
    {
        METBatchMonitoringLog parent, sibling;
        ;

        if (this.LinesToProcess > 0 || !this.BatchJobId)
        {
            return this.LinesToProcess;
        }

        select firstonly LinesToProcess from parent
            where parent.BatchJobId     == this.BatchJobId
               && parent.Operation      == this.Operation
               && parent.IsHeader       == NoYes::Yes;

        if (!parent.LinesToProcess)
        {
            return 0;
        }

        select sum(DocumentCount) from sibling
            where sibling.BatchJobId     == this.BatchJobId
               && sibling.Operation      == this.Operation
               && sibling.IsHeader       == NoYes::No
               && sibling.RecId          != this.RecId;

        return max(this.DocumentCount, parent.LinesToProcess - any2int(sibling.DocumentCount));
    }

]]></Source>
			</Method>
			<Method>
				<Name>remainingDisp</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    display Integer remainingDisp()
    {
        if (!this.IsHeader)
        {
            return 0;
        }

        if (this.hasChildren())
        {
            if (!this.hasRunningChildren())
            {
                return 0;
            }
            return max(0, this.LinesToProcess - this.childDocumentCount());
        }

        if (this.Status == METBatchMonitoringStatus::Completed)
        {
            return 0;
        }

        return max(0, this.effectiveLinesToProcess() - this.DocumentCount);
    }

]]></Source>
			</Method>
			<Method>
				<Name>percentCompleteDisp</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    display Integer percentCompleteDisp()
    {
        int linesToProcess;
        int docCount;

        if (this.hasChildren())
        {
            if (!this.hasRunningChildren())
            {
                return 100;
            }
            linesToProcess = this.LinesToProcess;
            docCount       = this.childDocumentCount();
            return linesToProcess > 0 ? (docCount * 100 / linesToProcess) : 0;
        }

        if (this.Status == METBatchMonitoringStatus::Completed)
        {
            return 100;
        }

        linesToProcess = this.effectiveLinesToProcess();
        docCount       = this.DocumentCount;
        return linesToProcess > 0 ? (docCount * 100 / linesToProcess) : 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>elapsedDisp</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    display Integer elapsedDisp()
    {
        METBatchMonitoringLog   child;
        UtcDateTime             endDt;
        ;
        if (!this.StartDateTime)
        {
            return 0;
        }
        if (this.hasChildren())
        {
            select firstonly RecId from child
                where child.BatchJobId     == this.BatchJobId
                   && child.Operation      == this.Operation
                   && child.IsHeader       == NoYes::No
                   && child.Status         == METBatchMonitoringStatus::Running;
            if (child.RecId)
            {
                endDt = DateTimeUtil::getSystemDateTime();
            }
            else
            {
                select maxof(EndDateTime) from child
                    where child.BatchJobId     == this.BatchJobId
                       && child.Operation      == this.Operation
                       && child.IsHeader       == NoYes::No;
                endDt = child.EndDateTime ? child.EndDateTime : DateTimeUtil::getSystemDateTime();
            }
        }
        else
        {
            endDt = this.EndDateTime ? this.EndDateTime : DateTimeUtil::getSystemDateTime();
        }
        return any2int(DateTimeUtil::getDifference(endDt, this.StartDateTime));
    }

]]></Source>
			</Method>
			<Method>
				<Name>estimatedRemainingDisp</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    display Integer estimatedRemainingDisp()
    {
        Integer             elapsedSec, remaining, linesToProcess, docCount;
        UtcDateTime         endDt;

        if (this.hasChildren())
        {
            if (!this.hasRunningChildren())
            {
                return 0;
            }
            linesToProcess = this.LinesToProcess;
            docCount       = this.childDocumentCount();
            if (linesToProcess <= 0 || docCount <= 0)
            {
                return 0;
            }
            elapsedSec = any2int(DateTimeUtil::getDifference(DateTimeUtil::getSystemDateTime(), this.StartDateTime));
            remaining  = max(0, linesToProcess - docCount);
            return remaining == 0 ? 0 : (remaining * elapsedSec) / docCount;
        }

        if (!this.StartDateTime || this.Status == METBatchMonitoringStatus::Completed)
        {
            return 0;
        }

        // Child or standalone
        linesToProcess = this.effectiveLinesToProcess();
        if (linesToProcess <= 0 || this.DocumentCount <= 0)
        {
            return 0;
        }
        endDt      = this.EndDateTime ? this.EndDateTime : DateTimeUtil::getSystemDateTime();
        elapsedSec = any2int(DateTimeUtil::getDifference(endDt, this.StartDateTime));
        remaining  = max(0, linesToProcess - this.DocumentCount);
        return (remaining * elapsedSec) / this.DocumentCount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>setSession</Name>
				<Source><![CDATA[
    /// <summary>
    /// Populates SessionId and SessionLoginDateTime from the current session.
    /// Follows the master session when running inside a child session.
    /// </summary>
    public void setSession()
    {
        xSession xSession = new xSession(sessionid());
        
        this.SessionId            = xSession.sessionId();
        this.SessionLoginDateTime = xSession.loginDateTime();
    }

]]></Source>
