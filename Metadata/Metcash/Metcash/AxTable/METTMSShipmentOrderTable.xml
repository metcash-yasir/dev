				<Name>initValue</Name>
				<Source><![CDATA[
    /// <summary>
    /// It initialisesthe number sequence.
    /// </summary>
    public void initValue()
    {
        NumberSequenceReference numberSequenceReference;

        super();

        numberSequenceReference = NumberSeqReference::findReference(extendedTypeNum(METTMSShipmentOrderIdentifier));
        if (numberSequenceReference)
        {
            this.TMSShipmentOrderIdentifier = NumberSeq::newGetNum(numberSequenceReference).num();
        }
  
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find method finds record in METTMSShipmentOrderIdentifier
    /// </summary>
    /// <param name = "_metTMSShipmentOrderIdentifier">METTMSShipmentOrderIdentifier</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns METTMSShipmentOrderIdentifier</returns>
    static METTMSShipmentOrderTable find(METTMSShipmentOrderIdentifier _metTMSShipmentOrderIdentifier, boolean _forUpdate = false)
    {
        METTMSShipmentOrderTable metTMSShipmentOrderTable;

        if (_metTMSShipmentOrderIdentifier)
        {
            metTMSShipmentOrderTable.selectForUpdate(_forUpdate);
          
            select firstonly metTMSShipmentOrderTable
              where metTMSShipmentOrderTable.TMSShipmentOrderIdentifier == _metTMSShipmentOrderIdentifier;
        }

        return metTMSShipmentOrderTable;
    }

]]></Source>
