			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method is used to check if a record that fulfils the specified key actually exists.
    /// exist method
    /// </summary>
    /// <param name = "_metTMSShipmentOrderIdentifier">METTMSShipmentOrderIdentifier</param>
    /// <returns>returns true or false depedning if records exists</returns>
    static boolean exist(METTMSShipmentOrderIdentifier _metTMSShipmentOrderIdentifier)
    {
        return _metTMSShipmentOrderIdentifier  &&
              (select firstonly RecId from METTMSShipmentOrderTable
                   where METTMSShipmentOrderTable.TMSShipmentOrderIdentifier == _metTMSShipmentOrderIdentifier).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>orderExist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method is used to check if a record for Sales order exists.
    /// orderExist method
    /// </summary>
    /// <param name = "_orderNumber">METOrderNumber</param>
    /// <returns>returns true or false depedning if records exists</returns>
    static boolean orderExist(METOrderNumber    _orderNumber)
    {
        return _orderNumber  &&
              (select firstonly RecId from METTMSShipmentOrderTable
                   where METTMSShipmentOrderTable.OrderNumber == _orderNumber).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByOrder</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method is used to find the record for Sales order - picking list number.
    /// </summary>
    /// <param name = "_orderNumber">METOrderNumber</param>
    /// <param name = "_pickingRouteId">Picking list number</param>
    /// <param name = "_forUpdate">Select record for update</param>
    /// <returns>returns METTMSShipmentOrderTable records</returns>
    static METTMSShipmentOrderTable findByOrder(METOrderNumber      _orderNumber,
                                                WMSPickingRouteID   _pickingRouteId = '',
                                                boolean             _forUpdate = false)
    {
        METTMSShipmentOrderTable    tmsShipmentOrderTable;

        if (_orderNumber)
        {
            if (_forUpdate)
            {
                tmsShipmentOrderTable.selectForUpdate(_forUpdate);
            }
            
            select firstonly tmsShipmentOrderTable
                       where tmsShipmentOrderTable.OrderNumber == _orderNumber
                          && tmsShipmentOrderTable.PickListId == _pickingRouteId;
        }
        return tmsShipmentOrderTable;
    }

]]></Source>
