		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find method finds record in METCBCTCustomerProfitCentreLink
    /// </summary>
    /// <param name = "_custClassificationId">METCBCTClassificationID</param>
    /// <param name = "_vendClassificationId">METCBCTClassificationID</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns METCBCTCustomerProfitCentreLink</returns>
    static METCBCTCustomerProfitCentreLink find(METCBCTClassificationID _custClassificationId, 
                                                METCBCTClassificationID _vendClassificationId, 
                                                boolean _forUpdate = false)
    {
        METCBCTCustomerProfitCentreLink customerProfitCentreLink;

        if (_custClassificationId && _vendClassificationId)
        {
            customerProfitCentreLink.selectForUpdate(_forUpdate);
          
            select firstonly customerProfitCentreLink
              where customerProfitCentreLink.CustClassificationID == _custClassificationId
                && customerProfitCentreLink.VendClassificationID == _vendClassificationId;
        }

        return customerProfitCentreLink;
    }

]]></Source>
			</Method>
		</Methods>
