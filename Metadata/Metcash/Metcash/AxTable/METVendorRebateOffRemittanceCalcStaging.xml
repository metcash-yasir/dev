        METVendorRebateOffRemittanceCalcStaging::skip(reserveEventOrdersQueue);

        ttsbegin;
        delete_from reserveEventOrdersQueue
        where reserveEventOrdersQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
