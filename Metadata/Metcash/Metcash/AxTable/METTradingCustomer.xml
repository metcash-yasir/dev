		<Methods>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Exist method
    /// </summary>
    /// <param name = "_custGroupId">Customer group id</param>
    /// <returns>True if customer group id exists; otherwise, false</returns>
    static boolean exist(CustGroupId _custGroupId)
    {
        return _custGroupId && (select firstonly RecId from METTradingCustomer
                                                      where METTradingCustomer.CustGroup == _custGroupId).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find method
    /// </summary>
    /// <param name = "_custGroupId">Customer group id</param>
    /// <param name = "_forUpdate">Select record for update</param>
    /// <returns><c>METTradingCustomer</c> record if found; otherwise, null</returns>
    static METTradingCustomer find(CustGroupId _custGroupId, boolean _forUpdate = false)
    {
        METTradingCustomer tradingCustomer;

        if (_custGroupId)
        {
            if (_forUpdate)
            {
                tradingCustomer.selectForUpdate(_forUpdate);
            }

            select firstonly tradingCustomer
                       where tradingCustomer.CustGroup == _custGroupId;
        }

        return tradingCustomer;
    }

]]></Source>
			</Method>
		</Methods>
