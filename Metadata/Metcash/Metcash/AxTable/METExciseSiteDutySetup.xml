		<Methods>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// on modifying item id and value for duty case
    /// </summary>
    /// <param name = "_fieldId">fieldName</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(METExciseSiteDutySetup, ItemId) :
                this.DutyPerCase = METExciseSiteDutySetup::getDutyPerCaseAmt(this.ItemId, this.ValueForDuty);
                break;

            case fieldNum(METExciseSiteDutySetup, ValueForDuty) :
                this.DutyPerCase = METExciseSiteDutySetup::getDutyPerCaseAmt(this.ItemId, this.ValueForDuty);
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>getDutyPerCaseAmt</Name>
				<Source><![CDATA[
    /// <summary>
    /// Get duty per case field calucation
    /// <param name = "_itemId">ItemID</param>
    /// <param name = "_valueForDuty">ValueForDuty</param>
    /// <returns>Duty per case amount</returns>
    /// </summary>
    
    public static Amount getDutyPerCaseAmt(ItemId   _itemId, METValueForDuty    _valueForDuty)
    {
        Amount                  dutyAmount;
        METTariffItemCode       mETTariffItemCode;
        METInventTable          metInventTable = METInventTable::find(_itemId);

        select firstonly DutyLAL,AdValoremOrBeerSubsidyRate from mETTariffItemCode
            where mETTariffItemCode.METTariffItemCodeBase == metInventTable.METTariffItemCodeBaseRecid
            && mETTariffItemCode.ValidTo >= DateTimeUtil::date(DateTimeUtil::utcNow());

        dutyAmount = (metInventTable.ItemPack * metInventTable.BottleSize * (metInventTable.AlcoholContent/100) * mETTariffItemCode.DutyLAL) +
                        (_valueForDuty * (mETTariffItemCode.AdValoremOrBeerSubsidyRate/100));

        return dutyAmount;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
