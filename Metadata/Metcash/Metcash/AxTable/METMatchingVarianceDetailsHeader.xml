		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a record in the <c>METMatchingVarianceDetailsHeader</c> table.
    /// </summary>
    /// <param name = "_purchId">_purchId</param>
    /// <param name = "_forupdate">_forupdate</param>
    /// <returns>true if the record must be selected for update; otherwise, false.</returns>
    public static METMatchingVarianceDetailsHeader find(METPONumber _purchId, boolean _forupdate = false)
    {
        METMatchingVarianceDetailsHeader header;

        header.selectForUpdate(_forUpdate);

        select firstonly header
            index hint PurchIdX
            where header.PONumber == _purchId;

        return header;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Send true when record exists, otherwise false.
    /// </summary>
    /// <param name = "_purchId">_purchId</param>
    /// <returns>boolean</returns>
    static boolean exist(METPONumber _purchId)
    {
        return (select RecId from METMatchingVarianceDetailsHeader
            index hint PurchIdX
            where METMatchingVarianceDetailsHeader.PoNumber == _purchId).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>metVarianceToBeClaimed</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for the sum of variance amount for all lines.
    /// </summary>
    /// <returns>MetVarianceToBeClaimed</returns>
    public display MetVarianceToBeClaimed metVarianceToBeClaimed()
    {
        METMatchingVarianceDetailLines metMatchingVarianceDetailLines;

        select sum (VarianceAmount) from metMatchingVarianceDetailLines
            where metMatchingVarianceDetailLines.VendAccountNumber == this.VendAccountNumber
            && metMatchingVarianceDetailLines.InvoiceNumber == this.InvoiceNumber
            && metMatchingVarianceDetailLines.Claim == NoYes::Yes;

        return metMatchingVarianceDetailLines.VarianceAmount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>metVarianceAccepted</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for the sum of variance amount for all lines.
    /// </summary>
    /// <returns>MetVarianceAcceptedByMetcash</returns>
    public display MetVarianceAcceptedByMetcash metVarianceAccepted()
    {
        METMatchingVarianceDetailLines metMatchingVarianceDetailLines;

        select sum (VarianceAmount) from metMatchingVarianceDetailLines
            where metMatchingVarianceDetailLines.VendAccountNumber == this.VendAccountNumber
            && metMatchingVarianceDetailLines.InvoiceNumber == this.InvoiceNumber
            && metMatchingVarianceDetailLines.Claim == NoYes::No;

        return metMatchingVarianceDetailLines.VarianceAmount;
    }

]]></Source>
			</Method>
