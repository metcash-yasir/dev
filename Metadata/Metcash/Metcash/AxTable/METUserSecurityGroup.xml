    public static METUserSecurityGroup find(METUserSecurityGroupId  _userSecurityGroupId,
                                            boolean                 _forUpdate = false)
    {
        METUserSecurityGroup userSecurityGroup;
        ;
        if (_userSecurityGroupId)
        {
            userSecurityGroup.selectForUpdate(_forUpdate);
            
            select firstonly userSecurityGroup
                where userSecurityGroup.UserSecurityGroupId  == _userSecurityGroupId;
        }
        
        return userSecurityGroup;
    }

]]></Source>
