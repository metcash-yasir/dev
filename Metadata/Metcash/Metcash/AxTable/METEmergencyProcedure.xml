				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>METEmergencyProcedure</c> with given parameters.
    /// </summary>
    /// <param name="_emergencyProcedureGroup">
    /// Emergency procedure group.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static METEmergencyProcedure find(METEmergencyProcedureGroup _emergencyProcedureGroup, boolean _forupdate = false)
    {
        METEmergencyProcedure  emergencyProcedure;

        if (_emergencyProcedureGroup)
        {
            emergencyProcedure.selectForUpdate(_forupdate);

            select firstonly emergencyProcedure
                where emergencyProcedure.EmergencyProcedureGroup == _emergencyProcedureGroup;
        }

        return emergencyProcedure;
    }

]]></Source>
