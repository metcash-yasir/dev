			<Method>
				<Name>findSingleRebateCompanyByUser</Name>
				<Source><![CDATA[
    public static SelectableDataArea findSingleRebateCompanyByUser(UserId _userId = curUserId())
    {
        METUserSecurityRebateCompanyList  metUserSecurityRebateCompanyList;                                                   
        METUserSecurityGroupList          metUserSecurityGroupList;
        SelectableDataArea                singleCompany;  
        boolean                           hasMoreThanOneRecord;

        while select RebateCompanyId from metUserSecurityRebateCompanyList
          group by RebateCompanyId
          exists join metUserSecurityGroupList
              where metUserSecurityGroupList.UserSecurityGroupId == metUserSecurityRebateCompanyList.UserSecurityGroupId
                 && metUserSecurityGroupList.UserId == _userId
        {
            if (hasMoreThanOneRecord)
            {
                singleCompany = '';
                break;
            }

            singleCompany = metUserSecurityRebateCompanyList.RebateCompanyId;
            hasMoreThanOneRecord = true;
        }

        return singleCompany;
    }

]]></Source>
