		<Methods>
			<Method>
				<Name>findbyRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>WHSPhysDimUOM</c> with given parameters.
    /// </summary>
    /// <param name="_recId">
    /// Id of the record.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static METWHSPhysDimUOMSite findbyRecId(RefRecId _recId, boolean _forupdate = false)
    {
        METWHSPhysDimUOMSite whsPhysDimUOM;

        if (_recId)
        {
            whsPhysDimUOM.selectForUpdate(_forupdate);

            select firstonly whsPhysDimUOM
                where whsPhysDimUOM.RecId == _recId;
        }

        return whsPhysDimUOM;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks whether a specific <c>whsPhysDimUOM</c> record exists.
    /// </summary>
    /// <param name="_recId">
    /// The parameter of type <c>RecId</c>.
    /// </param>
    /// <returns>
    /// True if the record exists.
    /// </returns>
    public static boolean exist(RecId _recId)
    {
        return (_recId) &&
               (select firstonly METWHSPhysDimUOMSite
                where METWHSPhysDimUOMSite.RecId == _recId).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>updateItemUOM</Name>
				<Source><![CDATA[
    /// <summary>
    ///     Updates the itemId and UOM on the table.
    /// </summary>
    /// <param name="_itemId">
    ///     The item ID.
    /// </param>
    public static void updateItemUOM(ItemId _itemId)
    {
        WHSUOMSeqGroupLine          uomSeqGroupLine;
        WHSUOMSeqGroupId            seqGroupId;
        InventTable                 inventTable;
        Weight                      grossWeight;

        seqGroupId  = WHSInventTable::find(_itemId).uomSeqGroupId;
        inventTable = InventTable::find(_itemId);
        grossWeight = inventTable.grossWeight();

        while select UnitId from uomSeqGroupLine
            where uomSeqGroupLine.uomSeqGroupId == seqGroupId
        {
            METWHSPhysDimUOMSite        physDimUOMUpdate;

            select firstonly physDimUOMUpdate
                where physDimUOMUpdate.ItemId   == _itemId &&
                      physDimUOMUpdate.uom      == uomSeqGroupLine.UnitId;

            if (physDimUOMUpdate.RecId == 0)
            {
                ttsbegin;

                physDimUOMUpdate.ItemId = _itemId;
                physDimUOMUpdate.uom    = uomSeqGroupLine.UnitId;
                physDimUOMUpdate.Weight = grossWeight;
                physDimUOMUpdate.Depth  = inventTable.grossDepth;
                physDimUOMUpdate.Height = inventTable.grossHeight;
                physDimUOMUpdate.Width  = inventTable.grossWidth;
                physDimUOMUpdate.insert();
                ttscommit;
            }
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayVolume</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for the volume from the physical dimensions.
    /// </summary>
    /// <returns>
    /// The volume calculated from physical dimensions.
    /// </returns>
    public display Volume displayVolume()
    {
        return this.Depth * this.Height * this.Width;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displaySurfaceAreaM2</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for the Surface Area M2 from the physical dimensions.
    /// </summary>
    /// <returns>
    /// The Surface Area M2 calculated from physical dimensions.
    /// </returns>
    public display METSurfaceAreaM2 displaySurfaceAreaM2()
    {
        #define.Million(1000000)
                return (this.Depth * this.Width)/#Million;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayCaseVolumeCM</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for the Case volume CM from the physical dimensions.
    /// </summary>
    /// <returns>
    /// The Case volume CM calculated from physical dimensions.
    /// </returns>
    public display METCaseVolM2 displayCaseVolumeCM()
    {
        #define.Thousand(1000)
        return (this.Depth / #Thousand) * (this.Height / #Thousand) * (this.Width / #Thousand);
    }

]]></Source>
			</Method>
