        Query query = new Query();
        query.allowCrossCompany(true);
        query.addCompanyRange(_company);

        QueryBuildDataSource qbds = query.addDataSource(tableNum(LogisticsAddressState));

        SysTableLookup lookup = SysTableLookup::newParameters(tableNum(LogisticsAddressState), _formControl);
        lookup.addLookupField(fieldNum(LogisticsAddressState, StateId));
        lookup.addLookupField(fieldNum(LogisticsAddressState, Name));
        lookup.parmQuery(query);
        lookup.performFormLookup();
    }

