			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///    Finds a record in the <c>SystemParameters</c> table.
    /// </summary>
    /// <param name="_forUpdate">
    ///    A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    ///    A record in the <c>SystemParameters</c> table.
    /// </returns>
    /// <remarks>
    ///    This method inserts a new record into the <c>SystemParameters</c> table if one does not exist.
    /// </remarks>
    public client server static METIntegrationParameters find(boolean _forUpdate = false)
    {
        METIntegrationParameters metIntegrationParameters;

        metIntegrationParameters.selectForUpdate(_forUpdate);

        select firstonly metIntegrationParameters
            where metIntegrationParameters.Key == 0;

        if (metIntegrationParameters.RecId == 0 && !metIntegrationParameters.isTmp())
        {
            metIntegrationParameters.insert();
        }

        return metIntegrationParameters;
    }

]]></Source>
