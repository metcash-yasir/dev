		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// find the record
    /// </summary>
    /// <param name = "_transRecid">transRecid</param>
    /// <param name = "_forupdate">forupdate</param>
    /// <returns>record</returns>
    public static METRetroDiscountSalesInvoiceTransaction find(RecId _transRecid, boolean _forupdate = false)
    {
        METRetroDiscountSalesInvoiceTransaction trans;
        
        trans.selectForUpdate(_forUpdate);

        if (_transRecid)
        {
            select firstonly trans
                where trans.RecId == _transRecid;
        }
    
        return trans;
    }

]]></Source>
