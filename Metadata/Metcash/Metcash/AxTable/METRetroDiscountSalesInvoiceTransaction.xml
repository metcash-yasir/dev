    /// <returns>boolean value</returns>
    public boolean validateDelete()
    {
        boolean ret = super();
    
        if (ret && this.Posted)
        {
            ret = checkFailed('Cannot delete posted transactions.');
        }

        return ret;
    }

]]></Source>
