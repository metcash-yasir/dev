		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// The validateWrite method of the table.
    /// </summary>
    /// <returns>True or false</returns>
    public boolean validateWrite()
    {
        boolean ret;
        
        ret = super();

        if (this.PlannerCodePersonnelNumber && HcmWorker::workerStatusServer(this.PlannerCodePersonnelNumber) == HcmWorkerStatus::Terminated)
        {
            ret = checkFailed(strFmt("@MET:METPlannerCodeTerminated", HcmWorker::find(this.PlannerCodePersonnelNumber).PersonnelNumber));
        }

        if (this.PlannerManagerPersonnelNumber && HcmWorker::workerStatusServer(this.PlannerManagerPersonnelNumber) == HcmWorkerStatus::Terminated)
        {
            ret = checkFailed(strFmt("@MET:METManagerPlannerCodeTerminated", HcmWorker::find(this.PlannerManagerPersonnelNumber).PersonnelNumber));
        }

        if (this.PlannerCodePersonnelNumber && this.PlannerCodePersonnelNumber == this.PlannerManagerPersonnelNumber)
        {
            ret = checkFailed("@MET:METPlannerManagerError");
        }
    
        return ret;
    }

]]></Source>
			</Method>
