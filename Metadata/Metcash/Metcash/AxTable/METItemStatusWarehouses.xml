		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static METItemStatusWarehouses find(InventLocationId _inventLocation, boolean _update = false)
    {
        METItemStatusWarehouses metItemStatusWarehouses;

        metItemStatusWarehouses.selectForUpdate(_update);

        if (_inventLocation)
        {
            select firstonly metItemStatusWarehouses
                where metItemStatusWarehouses.InventLocationId == _inventLocation;
        }

        return metItemStatusWarehouses;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    public static boolean exist(InventLocationId _inventLocation)
    {
        return _inventLocation && (select firstonly metItemStatusWarehouses
                    where metItemStatusWarehouses.InventLocationId == _inventLocation
               ).RecId != 0;
    }

]]></Source>
