				<Source><![CDATA[
    /// <summary>
    /// Modified field
    /// </summary>
    /// <param name = "_fieldId">fieldId</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(METPalletRoundingPolicyLine, ItemCode):
                this.ItemRelation = '';
                break;

            case fieldNum(METPalletRoundingPolicyLine, AccountCode):
                this.AccountRelation = '';
                break;

            case fieldNum(METPalletRoundingPolicyLine, RuleType):
                if (this.RuleType == METPalletRoundingPolicyRuleType::Exclude &&
                    this.ItemCode != TableGroupAll::Table)
                {
                    this.ItemCode       = TableGroupAll::Table;
                    this.ItemRelation   = '';                                      
                }
                break;
        }
    }

]]></Source>
