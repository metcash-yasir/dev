			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the specified record in the <c>METPalletRoundingPolicyLine</c> table.
    /// </summary>
    /// <param name="_recId">
    /// Record Id.
    /// </param>
    /// <param name="_forUpdate">
    /// A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    /// A <c>METPalletRoundingPolicyLine</c> record if found; otherwise, an empty record.
    /// </returns>
    static  METPalletRoundingPolicyLine findRecId(RecId      _recId,
                                                  boolean    _forUpdate = false)
    {
        METPalletRoundingPolicyLine policyLine;

        policyLine.selectForUpdate(_forUpdate);

        select firstonly policyLine
            where policyLine.RecId == _recId;

        return policyLine;
    }

