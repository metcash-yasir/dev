			<Method>
				<Name>updateChildItemSiteStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates the child item's status
    /// </summary>
    /// <param name = "_parentItemId">The Parent Item Id</param>
    /// <param name = "_inventSiteId">The site Id to be updated</param>
    public static void updateChildItemSiteStatus(ItemId _parentItemId, InventSiteId _inventSiteId)
    {
        #OCCRetryCount
        METSalesItemSubstitutionParentChild metSalesItemSubstitutionParentChild;
        METInventItemOrderSetup metInventItemOrderSetup;
        InventDim inventDim;

        try
        {
            ttsbegin;
        
            update_recordset metInventItemOrderSetup
            setting ItemStatus = METConstants::Active,
                PublishPriceBook = NoYes::Yes,
                PublishPortal = NoYes::Yes,
                PublishHost = NoYes::Yes
                where metInventItemOrderSetup.ItemStatus == MetConstants::NewStr
        exists join inventDim
            where inventDim.inventDimId == metInventItemOrderSetup.InventDimId
            && inventDim.InventSiteId == _inventSiteId
        exists join metSalesItemSubstitutionParentChild
            where metSalesItemSubstitutionParentChild.ParentItemId == _parentItemId
            && metInventItemOrderSetup.ItemId == metSalesItemSubstitutionParentChild.ChildItemId
            && metSalesItemSubstitutionParentChild.InventSiteId == _inventSiteId;
        
            ttscommit;
        }
        catch (Exception::Deadlock)
        {
            if (xSession::currentRetryCount() >= #RetryNum)
            {
                throw Exception::Deadlock;
            }
            else
            {
                retry;
            }
        }
        catch (Exception::UpdateConflict)
        {
            if (appl.ttsLevel() == 0)
            {
                if (xSession::currentRetryCount() >= #RetryNum)
                {
                    throw Exception::UpdateConflictNotRecovered;
                }
                else
                {
                    retry;
                }
            }
            else
            {
                throw Exception::UpdateConflict;
            }
        }
    }

]]></Source>
