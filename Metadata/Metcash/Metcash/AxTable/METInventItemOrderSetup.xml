			<Method>
				<Name>isItemStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB166_SalesOrderSubstitutes
    /// </summary>
    /// <param name = "_itemId">Item id</param>
    /// <param name = "_siteId">Invent site id</param>
    /// <param name = "_itemStatus">Item status</param>
    /// <returns>True False</returns>
    static boolean isItemStatus(ItemId _itemId, InventSiteId _siteId, METItemStatus _itemStatus)
    {
        METInventItemOrderSetup metInventItemOrderSetup;
        return _itemId && _siteId
        && (select firstOnly RecId
            from metInventItemOrderSetup
            where   metInventItemOrderSetup.ItemId         == _itemId
            &&      metInventItemOrderSetup.SiteId   == _siteId
            &&      metInventItemOrderSetup.ItemStatus     == _itemStatus).RecId != 0;
    }

]]></Source>
