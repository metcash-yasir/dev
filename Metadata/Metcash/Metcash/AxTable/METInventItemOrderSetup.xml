				<Name>ecoResProductLifecycleState</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB232_AutoSettingItemStockStatus.
    /// Gets related <c>EcoResProductLifecycleState</c> record.
    /// </summary>
    /// <param name = "_forUpdate">forUpdate.</param>
    /// <returns> <c>EcoResProductLifecycleState</c> record. </returns>
    public EcoResProductLifecycleState ecoResProductLifecycleState(boolean _forUpdate = false)
    {
        return EcoResProductLifecycleState::find(this.ProductLifecycleStateId, _forUpdate);
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByItemAndSite</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB232_AutoSettingItemStockStatus.
    /// Gets <c>METInventItemOrderSetup</c> record by item and site Ids.
    /// </summary>
    /// <param name = "_itemId">Item Id.</param>
    /// <param name = "_siteId">Site id.</param>
    /// <param name = "_forUpdate">forUpdate.</param>
    /// <returns> <c>METInventItemOrderSetup</c> record. </returns>
    public static METInventItemOrderSetup findByItemAndSite(ItemId _itemId, InventSiteId _siteId, boolean _forUpdate = false)
    {
        METInventItemOrderSetup itemOrderSetup;
        
        itemOrderSetup.selectForUpdate(_forUpdate);

        select firstonly itemOrderSetup
            where itemOrderSetup.ItemId == _itemId
            &&    itemOrderSetup.SiteId == _siteId;
            
        return itemOrderSetup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>resetItemStockLTNAStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB232_AutoSettingItemStockStatus.
    /// Resets item stock status from LTNA to blank.
    /// </summary>
    /// <param name = "_itemId">Item Id.</param>
    /// <param name = "_siteId">Site Id.</param>
    public static void resetItemStockLTNAStatus(ItemId _itemId, InventSiteId _siteId)
    {
        #OCCRetryCount
        EcoResProductLifecycleState productLifecycleState;
        METInventItemOrderSetup     itemOrderSetup;
        
        select firstonly itemOrderSetup
            where itemOrderSetup.ItemId == _itemId
            &&    itemOrderSetup.SiteId == _siteId
            exists join productLifecycleState
                where productLifecycleState.StateId   == itemOrderSetup.ProductLifecycleStateId
                &&    productLifecycleState.METStatus == METEcoResProductLifecycleStateStatus::LTNA;

        if (!itemOrderSetup)
        {
            return;
        }

        try
        {
            ttsbegin;

            itemOrderSetup.selectForUpdate(true);
        
            //Empties the field.
            itemOrderSetup.ProductLifecycleStateId = '';
            itemOrderSetup.update();

            ttscommit;
        }
        catch (Exception::Deadlock)
        {
            if (xSession::currentRetryCount() >= #RetryNum)
            {
                throw Exception::Deadlock;
            }
            else
            {
                retry;
            }
        }
        catch (Exception::UpdateConflict)
        {
            if (appl.ttsLevel() == 0)
            {
                if (xSession::currentRetryCount() >= #RetryNum)
                {
                    throw Exception::UpdateConflictNotRecovered;
                }
                else
                {
                    retry;
                }
            }
            else
            {
                throw Exception::UpdateConflict;
            }
        }
    }

]]></Source>
			</Method>
		</Methods>
