		<Methods>
			<Method>
				<Name>existShipmentId</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_28155_SalesFinalisation 3.6.7 Confirm shipments
    /// Determines whether a record in the <c>MetCarrierSealTable</c> table exists for a specified custom shipment Id.
    /// </summary>
    /// <param name="_shipmentId">
    ///  The custom shipment Id of the <c>MetCarrierSealTable</c> to find.
    /// </param>
    /// <returns>
    /// true if the specified record exists; otherwise, false.
    /// </returns>
    public static boolean existShipmentId(METShipmentId _shipmentId)
    {
        return _shipmentId && (select firstonly RecId from MetCarrierSealTable
                                                     where MetCarrierSealTable.ShipmentId == _shipmentId).RecId != 0;
    }

]]></Source>
