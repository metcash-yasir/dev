				<Source><![CDATA[
    /// <summary>
    /// MPJ_21178_VendorGlobal by chaminda on 16 Mar 2022
    /// Finds a record in the <c>METVendParameters</c> table.
    /// </summary>
    /// <param name="_forupdate">
    /// true if the record must be selected for update; otherwise, false.
    /// </param>
    /// <returns>
    /// A <c>METVendParameters</c> record.
    /// </returns>
    public static METVendParameters find(boolean _forupdate = false)
    {
        METVendParameters parm;
        parm.selectForUpdate(_forUpdate);
        select firstonly parm where parm.Key == 0;
        if (!parm && !parm.istmp())
        {
            Company::createParameter(parm);
        }
        return parm;
    }

