			<Method>
				<Name>allowISPCreatePO</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB501_ISP_Security
    /// Centralized method to indicate if ISP users can create PO based on AllowISPCreatePO parameter and security role METISPXDS assigned to user
    /// </summary>
    /// <returns>True if the ISP user can create PO; otherwise, false.</returns>
    boolean allowISPCreatePO()
    {
        boolean     ret = true;

        if (METisISPUser() && !this.AllowISPCreatePO)
        {
            ret = false;
        }

        return ret;
    }

