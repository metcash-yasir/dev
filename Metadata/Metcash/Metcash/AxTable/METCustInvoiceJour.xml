    /// <summary>
    /// Find by reference
    /// </summary>
    /// <param name = "_custInvoiceJourRecID">CustInvoiceJourRecID</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>METCustInvoiceJour</returns>
    static public METCustInvoiceJour find(RefRecId _custInvoiceJourRecID, boolean _forUpdate = false)
    {
        METCustInvoiceJour metCustInvoiceJour;
        if(_custInvoiceJourRecID)
        {
            metCustInvoiceJour.selectForUpdate(_forUpdate);
            select firstonly metCustInvoiceJour
               where   metCustInvoiceJour.CustInvoiceJour  == _custInvoiceJourRecID;
        }
        return metCustInvoiceJour;
    }

]]></Source>
