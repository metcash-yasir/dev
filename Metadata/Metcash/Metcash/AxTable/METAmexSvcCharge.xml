		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_3338_AMEXCustomerPaymentProcessing
    /// standard find method
    /// </summary>
    /// <param name = "_charge">METAMEXCharge</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns <c>METAmexSvcCharge</c></returns>
    static METAmexSvcCharge find(METAmexCharge _charge, boolean _forUpdate = false)
    {
        METAmexSvcCharge metAmexSvcCharge;

        if (_charge)
        {
            metAmexSvcCharge.selectForUpdate(_forUpdate);
          
            select firstonly metAmexSvcCharge
              where metAmexSvcCharge.AmexCharge == _charge;
        }

        return metAmexSvcCharge;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_3338_AMEXCustomerPaymentProcessing
    /// standard exist method
    /// </summary>
    /// <param name = "_charge">METAMEXCharge</param>
    /// <returns>Returns true/false</returns>
    static boolean exist(METAmexCharge _charge)
    {
        return _charge  &&
              (select firstonly RecId from METAmexSvcCharge
                   where METAmexSvcCharge.AmexCharge == _charge).RecId != 0;
    }

]]></Source>
