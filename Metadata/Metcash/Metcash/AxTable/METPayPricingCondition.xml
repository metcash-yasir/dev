				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_3171_AP_PricingConditions - KScerri - 26/03/2021
    /// Find method to find record from table METPayPricingCondition
    /// </summary>
    /// <param name = "_vendAccount">VendAccount</param>
    /// <param name = "_forUpdate">FroUpdate</param>
    /// <returns>Table record</returns>
    static METPayPricingCondition find(METVendAccount _vendAccount, boolean _forUpdate = false)
    {
        METPayPricingCondition    payPricingCondition;
        
        if (_vendAccount)
        {
            payPricingCondition.selectForUpdate(_forUpdate);
          
            select firstonly payPricingCondition
                     where payPricingCondition.AccountNum == _vendAccount;
        }
        
        return payPricingCondition;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_3171_AP_PricingConditions - KScerri - 26/03/2021
    /// Exists method for table METPayPricingCondition.
    /// </summary>
    /// <param name = "_vendAccount">VendAccount</param>
    /// <returns>Exits or not</returns>
    static boolean exist(METVendAccount _vendAccount)
    {
        return _vendAccount  &&
               (select firstonly RecId from METPayPricingCondition
                     where METPayPricingCondition.AccountNum == _vendAccount).RecId != 0;
    }

]]></Source>
