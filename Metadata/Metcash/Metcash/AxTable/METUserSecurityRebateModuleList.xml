			<Method>
				<Name>findRebateModuleByUser</Name>
				<Source><![CDATA[
    public static METModuleCustVend findRebateModuleByUser(UserId _userId = curUserId())
    {
        METUserSecurityRebateModuleList  metUserSecurityRebateModuleList;
        METUserSecurityGroupList         metUserSecurityGroupList;
        
        select firstonly ModuleCustVend from metUserSecurityRebateModuleList
              exists join metUserSecurityGroupList
                  where metUserSecurityGroupList.UserSecurityGroupId == metUserSecurityRebateModuleList.UserSecurityGroupId
                     && metUserSecurityGroupList.UserId == curUserId();

        return metUserSecurityRebateModuleList.ModuleCustVend;
    }

]]></Source>
