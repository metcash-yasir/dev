			<Method>
				<Name>findSingleRebateModuleByUser</Name>
				<Source><![CDATA[
    public static METModuleCustVend findSingleRebateModuleByUser(UserId _userId = curUserId())
    {
        METUserSecurityRebateModuleList  metUserSecurityRebateModuleList;                                                       
        METUserSecurityGroupList         metUserSecurityGroupList;
        boolean                          hasCust;
        boolean                          hasVend;

        while select ModuleCustVend from metUserSecurityRebateModuleList
          group by ModuleCustVend
          exists join metUserSecurityGroupList
              where metUserSecurityGroupList.UserSecurityGroupId == metUserSecurityRebateModuleList.UserSecurityGroupId
                 && metUserSecurityGroupList.UserId == _userId
        {
            switch (metUserSecurityRebateModuleList.ModuleCustVend)
            {
                case METModuleCustVend::Cust:
                    hasCust = true;
                    break;
                case METModuleCustVend::Vend:
                    hasVend = true;
                    break;
            }
        }

        if (hasCust && hasVend)
        {
            return METModuleCustVend::NotApplicable;
        }
        else if (hasCust)
        {
            return METModuleCustVend::Cust;
        }
        else if (hasVend)
        {
            return METModuleCustVend::Vend;
        }

        return METModuleCustVend::NotApplicable;
    }

]]></Source>
