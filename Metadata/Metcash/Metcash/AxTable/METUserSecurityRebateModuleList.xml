			<Method>
				<Name>countRebateModulesByUser</Name>
				<Source><![CDATA[
    public static int countRebateModulesByUser(UserId _userId = curUserId())
    {
        METUserSecurityRebateModuleList  metUserSecurityRebateModuleList;
        METUserSecurityGroupList         metUserSecurityGroupList;

        select count(RecId) from metUserSecurityRebateModuleList
          exists join metUserSecurityGroupList
              where metUserSecurityGroupList.UserSecurityGroupId == metUserSecurityRebateModuleList.UserSecurityGroupId
                 && metUserSecurityGroupList.UserId == _userId;

        return int642Int(metUserSecurityRebateModuleList.RecId);
    }

