    /// <summary>
    /// Update the Name field with the customer name when a customer account is selected.
    /// </summary>
    public void insert()
    {
        
        if (this.CustAccount)
        {
            this.Name = CustTable::find(this.CustAccount).Name();
        }

        super(); 
    }

