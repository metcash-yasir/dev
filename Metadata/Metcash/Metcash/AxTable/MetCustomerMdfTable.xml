			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///  find method for the MetCustomerMDFTable table.
    /// </summary>
    /// <param name = "custAccount">The customer account to search for.</param>
    /// <param name = "_forUpdate">Indicates whether to lock the record for update.</param>
    /// <returns> CustMDFTable record if found; otherwise, null.</returns>
    static MetCustomerMDFTable find(CustAccount    custAccount,
                           boolean          _forUpdate = false)
    {
        MetCustomerMDFTable customerMDFTable;

        if (custAccount)
        {
            if (_forUpdate)
            {
                customerMDFTable.selectForUpdate  (_forUpdate);
            }
           
            select firstonly customerMDFTable
                where customerMDFTable.custAccount == custAccount;
        }

        return customerMDFTable;
    }

]]></Source>
