		<Methods>
			<Method>
				<Name>ValidateWrite</Name>
				<Source><![CDATA[
    /// <Summary>
    ///This method is used to make field Destination Customer mandatory if Destination type is Customer.and Destination Warehouse madatory if Destination type is Warehouse.
    /// </summary>
    /// <returns>Boolean value</returns>
    public boolean ValidateWrite()
    {
        int  ret;

        ret = super();

        if (this.DestinationType == METDestinationType::Customer && this.DestinationCustomer == "")
        {
            ret = checkFailed("@MET:DestinationCustomerMandatoryWarning");
        }
        else if (this.DestinationType == METDestinationType::Warehouse && this.DestinationWarehouse == "")
        {
            ret = checkFailed("@MET:DestinationWarehouseWarning");
        }
               
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Standard find and exist method where added to the new table
    /// </summary>
    
    
    /// <summary>
    /// find method finds record in METTMSShipmentTable
    /// </summary>
    /// <param name = "_metTMSShipmentID">TMSShipmentID</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns METTMSShipmentTable</returns>
    static METTMSShipmentTable find(METTMSShipmentID _metTMSShipmentID, boolean _forUpdate = false)
    {
        METTMSShipmentTable metTMSShipmentTable;

        if (_metTMSShipmentID)
        {
            metTMSShipmentTable.selectForUpdate(_forUpdate);
          
            select firstonly metTMSShipmentTable
              where metTMSShipmentTable.ShipmentID == _metTMSShipmentID;
        }

        return metTMSShipmentTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method is used to check if a record that fulfils the specified key actually exists.
    /// exist method
    /// </summary>
    /// <param name = "_metTMSShipmentID">TMSShipmentID</param>
    /// <returns>returns true or false depedning if records exists</returns>
    static boolean exist(METTMSShipmentID _metTMSShipmentID)
    {
        return _metTMSShipmentID  &&
              (select firstonly RecId from METTMSShipmentTable
                   where METTMSShipmentTable.ShipmentID == _metTMSShipmentID).RecId != 0;
    }

]]></Source>
			</Method>
