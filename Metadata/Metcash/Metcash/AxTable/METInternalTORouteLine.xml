		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds METInternalTORouteLine record.
    /// </summary>
    /// <param name = "_custAccount">Customer.</param>
    /// <param name = "_inventLocation">Warehouse.</param>
    /// <param name = "_weekDays">Day of week.</param>
    /// <param name = "_forUpdate">For update.</param>
    /// <returns>METInternalTORouteLine record.</returns>
    public static METInternalTORouteLine find(CustAccount _custAccount,
                                              InventLocationId _inventLocation,
                                              METInternalTORouteWeekDays _weekDays,
                                              boolean _forUpdate = false)
    {
        METInternalTORouteLine toRouteLine;
        METInternalTORouteTable toRouteTable;

        toRouteLine.selectForUpdate(_forUpdate);

        select firstonly toRouteLine
            where toRouteLine.WeekDays == _weekDays
                exists join toRouteTable
                    where toRouteTable.RecId == toRouteLine.InternalTORouteTableRecId
                    &&    toRouteTable.CustAccount == _custAccount
                    &&    toRouteTable.InventLocationId == _inventLocation;

        return toRouteLine;
    }

]]></Source>
			</Method>
