				<Source><![CDATA[
    public static METSalesItemSubstituteTestOnHand find(
        InventSiteId    _siteID,
        ItemId          _itemID)
    {
        METSalesItemSubstituteTestOnHand onHand;
        select firstonly onHand
            where   onHand.InventSiteId == _siteID
            &&      onHand.ItemId       == _itemID;
        return onHand;
    }

]]></Source>
