				<Name>cleanUpPostInventJournalCreationProcessingQueue</Name>
				<Source><![CDATA[
    /// <summary>
    /// clean up table for anything older than 14 days
    /// </summary>
    static void cleanUpPostInventJournalCreationProcessingQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METInventJournalPostingQueue postInventJournalQueue;
        METInventJournalPostingQueue::skip(postInventJournalQueue);

        ttsbegin;
        delete_from postInventJournalQueue
        where postInventJournalQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>skip</Name>
				<Source><![CDATA[
    /// <summary>
    /// skip method for performance purpose
    /// </summary>
    /// <param name = "_postInventJournalQueue"><c>METInventJournalPostingQueue</c> record</param>
    private static void skip(METInventJournalPostingQueue _postInventJournalQueue)
    {
        _postInventJournalQueue.skipDatabaseLog(true);
        _postInventJournalQueue.skipDataMethods(true);
        _postInventJournalQueue.skipDeleteActions(true);
        _postInventJournalQueue.skipEvents(true);
        _postInventJournalQueue.skipBusinessEvents(true);
    }

]]></Source>
