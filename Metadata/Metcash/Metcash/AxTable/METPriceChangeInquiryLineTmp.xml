				<Name>hashKey</Name>
				<Source><![CDATA[
    public str hashKey()
    {
        str hashKey = this.ItemId + '~'
                    + this.InventSiteId + '~'
                    + num2Str(this.PreviousPrice, 1, 2, 1, 0) + '~'
                    + date2Str(this.ToDate, 321, 2, 3, 2, 3, 4) + '~'
                    + num2Str(this.CurrentPrice, 1, 2, 1, 0) + '~'
                    + date2Str(this.FromDate, 321, 2, 3, 2, 3, 4) + '~'
                    + this.Currency + '~'
                    + this.OfferId  + '~'
                    + this.AccountRelation + '~';

        return hashKey;
    }

]]></Source>
			</Method>
			<Method>
				<Name>hashValue</Name>
				<Source><![CDATA[
    public METPriceChangeInquiryLineSHA1HashHex hashValue()
    {
        str hashKey = strLwr(this.hashKey());
        METPriceChangeInquiryLineSHA1HashHex hexString;

        using (var hashStream = Microsoft.Dynamics.AX.Data.Helper.HashKeyHelper::ComputeSHA1HashFromCaller(hashKey, tableStr(METPriceChangeInquiryLineTmp)))
        {
            hexString = StrRem(System.BitConverter::ToString(hashStream.ToArray()), '-');
        }

        return hexString;
    }

]]></Source>
