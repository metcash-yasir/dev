		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// It is used to find out the zone based on the recid
    /// </summary>
    /// <param name = "_recId"> RecId </param>
    /// <param name = "_update"> boolean </param>
    /// <returns> CB538_ZoneGroupTable </returns>
    public static CB538_ZoneGroupTable find(RecId _recId, boolean _update = false)
    {
        CB538_ZoneGroupTable zoneGroupTable;

        select firstonly zoneGroupTable
            where zoneGroupTable.RecId == _recId;

        if(_update)
        {
            zoneGroupTable.selectForUpdate(true);
        }

        return zoneGroupTable;
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// It is used to check whether records is exist in the table
    /// </summary>
    /// <param name = "_recId"> RecId </param>
    /// <returns> boolean </returns>
    public static boolean exist(RecId _recId)
    {
        return (select firstonly CB538_ZoneGroupTable
            where CB538_ZoneGroupTable.RecId == _recid).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByCustWHSC</Name>
				<Source><![CDATA[
    /// <summary>
    /// It is used to find out the records based on the combination customer, warehouse and shipping carrier
    /// </summary>
    /// <param name = "_custAccount"> CustAccount </param>
    /// <param name = "_warehouse"> InventLocationId </param>
    /// <param name = "_carrier"> TMSCarrierCode </param>
    /// <param name = "_recId"> RecId </param>
    /// <returns> CB538_ZoneGroupTable </returns>
    public static CB538_ZoneGroupTable findByCustWHSC(CustAccount _custAccount, InventLocationId _warehouse, TMSCarrierCode _carrier, RecId _recId)
    {
        CB538_ZoneGroupTable zoneGroupTable;

        select firstonly RecId from zoneGroupTable
            where zoneGroupTable.Customer       == _custAccount
            && zoneGroupTable.Warehouse         == _warehouse
            && zoneGroupTable.ShippingCarrier   == _carrier
            && zoneGroupTable.RecId             != _recId;

        return zoneGroupTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// It is used to validate the table fields
    /// </summary>
    /// <returns> boolean </returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();
        
        CB538_ZoneGroupTable zoneGroupTable = CB538_ZoneGroupTable::findByCustWHSC(this.Customer, this.Warehouse, this.ShippingCarrier, this.RecId);

        if(zoneGroupTable.RecId != 0)
        {
            ret = checkFailed("@MET:CustWareHouseCarrierValidation");
        }
        
        return ret;
    }

]]></Source>
			</Method>
