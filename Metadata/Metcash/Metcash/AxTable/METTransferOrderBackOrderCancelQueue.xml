				<Source><![CDATA[
    /// <summary>
    /// clean up table for anything older than 14 days
    /// </summary>
    static void cleanUpQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METTransferOrderBackOrderCancelQueue queue;
        METTransferOrderBackOrderCancelQueue::skip(queue);

        ttsbegin;
        delete_from queue
            where queue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
