    {
        _salesOrderGuideCheckQueue.skipDatabaseLog(true);
        _salesOrderGuideCheckQueue.skipDataMethods(true);
        _salesOrderGuideCheckQueue.skipDeleteActions(true);
        _salesOrderGuideCheckQueue.skipEvents(true);
        _salesOrderGuideCheckQueue.skipBusinessEvents(true);
    }

]]></Source>
