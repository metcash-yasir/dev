				<Source><![CDATA[
    /// <summary>
    /// clean up table for anything older than 14 days
    /// </summary>
    static void cleanUpSalesOrderGuideCheckQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METSalesOrderGuideCheckQueue salesOrderGuideCheckQueue;
        METSalesOrderGuideCheckQueue::skip(salesOrderGuideCheckQueue);

        ttsbegin;
        delete_from salesOrderGuideCheckQueue
        where salesOrderGuideCheckQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
