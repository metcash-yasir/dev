    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METDutyRollMonthlyQueue dutyRollMonthlyQueue;
        METDutyRollMonthlyQueue::skip(dutyRollMonthlyQueue);

        ttsbegin;
        delete_from dutyRollMonthlyQueue;
        //where dutyRollMonthlyQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
