		<Methods>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Determines whether the specified policy name is located in the <c>METPalletRoundingPolicyName</c> table.
    /// </summary>
    /// <param name="_policyName">
    /// Pallet rounding policy name.
    /// </param>
    /// <returns>
    /// true if the specified record exists; otherwise, false.
    /// </returns>
    public static boolean exist(METPalletRoundingPolicyName _policyName)
    {
        boolean found;

        found = _policyName && 
                (select firstonly RecId from METPalletRoundingPolicyHeader
                    where METPalletRoundingPolicyHeader.PolicyName == _policyName).RecId != 0;

        return found;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the specified record in the <c>METPalletRoundingPolicyHeader</c> table.
    /// </summary>
    /// <param name="_policyName">
    /// Pallet rounding policy name.
    /// </param>
    /// <param name="_forUpdate">
    /// A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    /// A <c>METPalletRoundingPolicyHeader</c> record if found; otherwise, an empty record.
    /// </returns>
    public static METPalletRoundingPolicyHeader find(
        METPalletRoundingPolicyName _policyName,
        boolean _forUpdate = false)
    {
        METPalletRoundingPolicyHeader policyHeader;

        policyHeader.selectForUpdate(_forUpdate);

        select firstonly policyHeader
            where policyHeader.PolicyName == _policyName;

        return policyHeader;
    }

]]></Source>
			</Method>
