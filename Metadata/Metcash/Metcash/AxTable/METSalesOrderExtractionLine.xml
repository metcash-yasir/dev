			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    static boolean exist(METSalesOrderExtractionId _extractionId, SalesId _salesId)
    {
        METSalesOrderExtractionLine salesOrderExtractionLine;

        if (_extractionId && _salesId)
        {
            select firstonly RecId
                from salesOrderExtractionLine
                where salesOrderExtractionLine.ExtractionId == _extractionId
                   && salesOrderExtractionLine.SalesId == _salesId;
        }

        return salesOrderExtractionLine.RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static METSalesOrderExtractionLine find(
        METSalesOrderExtractionId   _extractionId,
        SalesId       _salesId,
        boolean       _forUpdate = false)
    {
        METSalesOrderExtractionLine salesOrderExtractionLine;

        if (_extractionId && _salesId)
        {
            if (_forUpdate)
            {
                salesOrderExtractionLine.selectForUpdate(_forUpdate);
            }

            select firstonly salesOrderExtractionLine
                where salesOrderExtractionLine.ExtractionId == _extractionId
                   && salesOrderExtractionLine.SalesId == _salesId; 
        }

        return salesOrderExtractionLine;
    }

]]></Source>
