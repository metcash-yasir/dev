    /// <summary>
    /// MPJ_22974_BMSProductMDRItemStatusAndPackChange by chaminda on 27 Apr 2022
    /// Finds the specified record in the <c>METItemStatusTable</c> table.
    /// </summary>
    /// <param name="_metItemStatus">
    /// The ItemStatus of the <c>METItemStatusTable</c> record to find.
    /// </param>
    /// <param name="_update">
    /// A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    /// A record in the <c>METItemStatusTable</c> table; otherwise, an empty record.
    /// </returns>
    public static METItemStatusTable find(
        METItemStatus      _metItemStatus,
        boolean     _update = false)
    {
        METItemStatusTable  metItemStatusTable;

        metItemStatusTable.selectForUpdate(_update);

        if (_metItemStatus)
        {
            select firstonly metItemStatusTable
                where metItemStatusTable.ItemStatus == _metItemStatus;
        }

        return metItemStatusTable;
    }

