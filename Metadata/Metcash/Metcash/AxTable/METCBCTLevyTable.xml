				<Source><![CDATA[
    /// <summary>
    /// MPJ_37288_ChargebackChargethrough_extension functionalities(MPJ_3587)
    /// find method to select <c>METCBCTLevyTable</c> record
    /// </summary>
    /// <param name = "_levyCode">levy code</param>    
    /// <param name = "_forUpdate">select for updating, boolean true or false</param>
    /// <returns>record of type <c>METCBCTLevyTable</c> if found</returns>
    static METCBCTLevyTable find(
        METCBCTLevyCode     _levyCode,        
        boolean             _forUpdate = false)
    {
        METCBCTLevyTable metCBCTLevyTable;

        if (_levyCode)
        {
            metCBCTLevyTable.selectForUpdate(_forUpdate);
            
            select firstonly metCBCTLevyTable
                where metCBCTLevyTable.LevyCode       == _levyCode;    
        }

        return metCBCTLevyTable;
    }

]]></Source>
