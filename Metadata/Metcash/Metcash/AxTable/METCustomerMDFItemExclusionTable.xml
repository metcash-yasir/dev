    /// <param name = "_category">EcoResCategoryId</param>
    /// <param name = "_forUpdate">boolean</param>
    /// <returns>METCustomerMDFItemExclusionTable</returns>
    static METCustomerMDFItemExclusionTable find(RefRecId _refRecId,
                                                 METItemTypes _itemTypes,
                                                 EcoResCategoryId _category,
                                                 boolean _forUpdate = false)
    {
        METCustomerMDFItemExclusionTable customerMDFItemExclusionTable;

        if (_forUpdate)
        {
            customerMDFItemExclusionTable.selectForUpdate(_forUpdate);
        }
           
        select firstonly customerMDFItemExclusionTable
                where customerMDFItemExclusionTable.RefRecId == _refRecId
                   && customerMDFItemExclusionTable.METItemTypes == _itemTypes
                   && customerMDFItemExclusionTable.Category == _category;

        return customerMDFItemExclusionTable;
    }

