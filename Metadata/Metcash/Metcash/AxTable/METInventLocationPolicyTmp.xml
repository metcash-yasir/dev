				<Source><![CDATA[
    public RefreshFrequency xds()
    {
        METInventLocationPolicyTmp     metInventLocationPolicyTmp;
        METUserSecurityGroupList       metUserSecurityGroupList;
        METUserSecurityWarehouseList   metUserSecurityWarehouseList;

        Unchecked(Uncheck::XDS)
        {
            insert_recordset metInventLocationPolicyTmp(InventLocationId, Company)
                select InventLocationId, Company from metUserSecurityWarehouseList
                  group by InventLocationId, Company
                    join metUserSecurityGroupList
                where metUserSecurityGroupList.UserSecurityGroupId == metUserSecurityWarehouseList.UserSecurityGroupId
                && metUserSecurityGroupList.UserId == curUserId();
        }

        return RefreshFrequency::PerSession;
    }

]]></Source>
