		<Methods>
			<Method>
				<Name>Find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves the first record of the table based on condition. If Record does not exists then New Parameter record is created.
    /// </summary>
    /// <param name = "_forUpdate"> A Boolean value that determines whether the RecId of orign should be selected for update; optional.</param>
    /// <returns> The table record </returns>
    public static METCBCTParameters Find(boolean _forUpdate = false)
    {
        METCBCTParameters parm;
        parm.selectForUpdate(_forUpdate);
        select firstonly parm where parm.Key == 0;
        if (!parm && !parm.istmp())
        {
            Company::createParameter(parm);
        }
        return parm;
    }

]]></Source>
			</Method>
			<Method>
				<Name>Exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Searches for the first record of the table based on condition
    /// </summary>
    /// <returns> A Boolean value "Yes" if record exists, else "No" </returns>
    public static boolean Exist()
    {
        return (select firstonly RecId from METCBCTParameters).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>update</Name>
				<Source><![CDATA[
    /// <summary>
    /// Whenever this table is updated, we will need to flush the cache so that the system uses the updated values.
    /// </summary>
    public void update()
    {
        super();
        flush METCBCTParameters;
    }

]]></Source>
