			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the specified record in the <c>METInventTable</c> table.
    /// </summary>
    /// <param name="_itemId">
    /// The ItemID of the <c>InventTable</c> record to find.
    /// </param>
    /// <param name="_update">
    /// A Boolean value that indicates whether to read the record for update; optional.
    /// </param>
    /// <returns>
    /// A record in the <c>METInventTable</c> table; otherwise, an empty record.
    /// </returns>
    public static METInventTable find(
        ItemId      _itemId,
        boolean     _update = false)
    {
        METInventTable  metInventTable;

        metInventTable.selectForUpdate(_update);

        if (_itemId)
        {
            select firstonly metInventTable
                where metInventTable.ItemId == _itemId;
        }

        return metInventTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getLitersPerPricingUnit</Name>
				<Source><![CDATA[
    /// <summary>
    /// Calculates the liters per pricing unit 
    /// </summary>
    /// <returns>Liters per pricing unit</returns>
    [SysClientCacheDataMethod(true)]
    public display METLitersPerPricingUnit getLitersPerPricingUnit()
    {
        return this.ItemPack * this.BottleSize;
    }

]]></Source>
