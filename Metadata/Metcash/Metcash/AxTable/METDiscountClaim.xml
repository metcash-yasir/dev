}
]]></Declaration>
		<Methods>
			<Method>
				<Name>displayTotalClaimAmount</Name>
				<Source><![CDATA[
    display real displayTotalClaimAmount()
    {
        return this.totalClaimAmount();
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayTotalClaimAmountWithFee</Name>
				<Source><![CDATA[
    display real displayTotalClaimAmountWithFee()
    {
        return this.totalClaimAmount() + this.feeAmount();
    }

]]></Source>
			</Method>
			<Method>
				<Name>totalClaimAmount</Name>
				<Source><![CDATA[
    public AmountCur totalClaimAmount()
    {
        // POC TODO replace GUPDiscountClaimTransaction by custom table
        GUPDiscountClaimTransaction discountClaimTransaction;
        select sum(Amount) from discountClaimTransaction
            where discountClaimTransaction.DiscountClaimId == this.DiscountClaimId;
        return discountClaimTransaction.Amount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>feeAmount</Name>
				<Source><![CDATA[
    public AmountCur feeAmount()
    {
        // POC TODO replace GUPDiscountVendorClaimFeeCalculation by custom table
        GUPDiscountVendorClaimFeeCalculation feeCalc;
        select sum(Amount) from feeCalc
            where feeCalc.DiscountClaimId == this.DiscountClaimId;
        return feeCalc.Amount;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();
        this.Status = GUPDiscountClaimStatus::Calculated;
    }

]]></Source>
			</Method>
		</Methods>
