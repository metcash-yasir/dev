				<Name>cleanUpCPIRepricingQueue</Name>
				<Source><![CDATA[
    /// <summary>
    /// clean up table for anything older than 14 days
    /// </summary>
    static void cleanUpCPIRepricingQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METCPIRepricingQueue metCPIRepricingQueue;
        METCPIRepricingQueue::skip(metCPIRepricingQueue);

        ttsbegin;
        delete_from metCPIRepricingQueue
        where metCPIRepricingQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>skip</Name>
				<Source><![CDATA[
    /// <summary>
    /// skip method for performance purpose
    /// </summary>
    /// <param name = "_metCPIRepricingQueue"><c>METReserveEventOrdersQueue</c> record</param>
    public static void skip(metCPIRepricingQueue _metCPIRepricingQueue)
    {
        _metCPIRepricingQueue.skipDatabaseLog(true);
        _metCPIRepricingQueue.skipDataMethods(true);
        _metCPIRepricingQueue.skipDeleteActions(true);
        _metCPIRepricingQueue.skipEvents(true);
        _metCPIRepricingQueue.skipBusinessEvents(true);
    }

]]></Source>
