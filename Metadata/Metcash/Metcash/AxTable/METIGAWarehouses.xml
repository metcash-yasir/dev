				<Source><![CDATA[
    public static METIGAWarehouses find(InventLocationId _inventLocation, boolean _update = false)
    {
        METIGAWarehouses metIGAWarehouses;

        metIGAWarehouses.selectForUpdate(_update);

        if (_inventLocation)
        {
            select firstonly metIGAWarehouses
                where metIGAWarehouses.InventLocationId == _inventLocation;
        }

        return metIGAWarehouses;
    }

]]></Source>
