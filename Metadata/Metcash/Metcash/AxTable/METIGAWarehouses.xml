				<Source><![CDATA[
    public static boolean exist(InventLocationId _inventLocation)
    {
        METIGAWarehouses metIGAWarehouses;

        return _inventLocation && (select firstonly metIGAWarehouses
                    where metIGAWarehouses.InventLocationId == _inventLocation
               ).RecId != 0;
    }

]]></Source>
