		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///     Finds the specified record in the <c>METDutyRollValuesLine</c> table.
    /// </summary>
    /// <param name = "_site">InventSiteId</param>
    /// <param name = "_itemId">ItemId</param>
    /// <param name = "_forupdate">true/false</param>
    /// <returns>
    ///     A record in the <c>METDutyRollValuesLine</c> table.
    /// </returns>
    static METDutyRollValuesLine find(InventSiteId  _site,
                                    ItemId          _itemId,
                                    boolean         _forupdate = false)
    {
        METDutyRollValuesLine dutyRollValuesLine;

        dutyRollValuesLine.selectForUpdate(_forupdate);
        select firstonly dutyRollValuesLine
            index MainIdx
            where dutyRollValuesLine.Site == _site
                && dutyRollValuesLine.ItemId == _itemId;

        return dutyRollValuesLine;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks if a <c>METDutyRollValuesLine</c> record exists;
    /// </summary>
    /// <param name = "_site">InventSiteId</param>
    /// <param name = "_itemId">ItemId</param>
    /// <returns>
    /// true if a <c>METDutyRollValuesLine</c> record exists; otherwise, false.
    /// </returns>
    public static boolean exist(InventSiteId _site, ItemId  _itemId)
    {
        return (select firstonly RecId from METDutyRollValuesLine
            where METDutyRollValuesLine.Site == _site && METDutyRollValuesLine.ItemId == _itemId).RecId != 0;
    }

]]></Source>
			</Method>
