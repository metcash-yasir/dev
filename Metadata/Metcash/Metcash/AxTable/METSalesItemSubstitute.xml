				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// validateWrite
    /// </summary>
    /// <returns>Result</returns>
    public boolean validateWrite()
    {
        boolean ret = super();
        
        if(ret)
        {
            if(this.RecId)
            {
                // Updating existing  
                METSalesItemSubstitutionLog subLog;
                select firstonly subLog
                    where   subLog.SalesItemSubstitute == this.RecId;
                if(subLog)
                {
                    ret = checkFailed("Cannot modify this record as it has been referenced on sales order %1",
                       subLog.SalesID);    // ** add line # / item / lot ID / etc.
                }
            }
            else
            {                
            }
        }

        return ret;
    }

]]></Source>
