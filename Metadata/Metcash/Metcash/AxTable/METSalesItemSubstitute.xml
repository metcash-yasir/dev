			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super(); 
       
        this.SubstitutionCode = METSalesItemSubstitutionCode::Always;
        this.modifiedField(fieldNum(METSalesItemSubstitute, SubstitutionCode));
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// modifiedField
    /// </summary>
    /// <param name = "_fieldId">_fieldId</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);
        switch(_fieldId)
        {
            case fieldNum(METSalesItemSubstitute, SubstitutionCode):
                if(this.SubstitutionCode == METSalesItemSubstitutionCode::Always)
                {
                    this.DateEffectivityCategory = 0;                     
                }
                else
                {
                    this.DateEffectivityCategory = 1;
                }
                break;
        }
    }

]]></Source>
