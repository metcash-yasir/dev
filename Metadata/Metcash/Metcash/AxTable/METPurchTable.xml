			<Method>
				<Name>initFromVendSiteSettingsSetup</Name>
				<Source><![CDATA[
    /// <summary>
    /// To initialize table buffer
    /// </summary>
    /// </param>
    /// <param name="METVendSiteSettingsSetup">
    /// A <C>METVendSiteSettingsSetup</C> record
    /// </param>
    Public void initFromVendSiteSettingsSetup()
    {
        PurchTable purchTable = purchTable::findRecId(this.PurchTable);

        this.POBackOrderSetting                    = purchtable.getVendSiteSettingsSetupFieldValues(fieldNum(METVendSiteSettingsSetup,DefaultBackOrderSetting));
        this.POExpressReceiptSetting               = purchtable.getVendSiteSettingsSetupFieldValues(fieldNum(METVendSiteSettingsSetup,ExpressReceiptSetting));
        this.POASNSetting                          = purchtable.getVendSiteSettingsSetupFieldValues(fieldNum(METVendSiteSettingsSetup,ASNSetting));
        this.POMinOrderValue                       = purchtable.getVendSiteSettingsSetupFieldValues(fieldNum(METVendSiteSettingsSetup,MinOrderValue));
        this.POSubMode                             = purchtable.getVendSiteSettingsSetupFieldValues(fieldNum(METVendSiteSettingsSetup,POSubMode));
        this.POIHGEmailEDIAddress                  = purchtable.getVendSiteSettingsSetupEmailEDI();
    }

]]></Source>
