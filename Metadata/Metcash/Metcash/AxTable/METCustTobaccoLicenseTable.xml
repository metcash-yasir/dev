		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves the first record of the table based on condition
    /// </summary>
    /// <param name = "_custAccount"> Customer account number</param>
    /// <param name = "_forUpdate"> A Boolean value that determines whether the RecId of orign should be selected for update; optional.</param>
    /// <returns> The table record </returns>
    static METCustTobaccoLicenseTable find(CustAccount   _custAccount, boolean  _forUpdate = false)
    {
        METCustTobaccoLicenseTable custTobaccoLicenseTable;

        if (_custAccount)
        {
            if (_forUpdate)
            {
                custTobaccoLicenseTable.selectForUpdate(_forUpdate);
            }

            select firstonly custTobaccoLicenseTable
                index hint CustLicenceIdx
                where custTobaccoLicenseTable.CustomerNumber == _custAccount;
        }

        return custTobaccoLicenseTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Searches for the first record of the table based on condition
    /// </summary>
    /// <param name = "_custAccount"> Customer account number</param>
    /// <returns> A Boolean value "Yes" if record exists, else "No" </returns>
    static boolean exist(CustAccount _custAccount)
    {
        return _custAccount && (select firstonly RecId from METCustTobaccoLicenseTable
                                    index hint CustLicenceIdx
                                    where METCustTobaccoLicenseTable.CustomerNumber == _custAccount).RecId != 0;
    }

]]></Source>
			</Method>
