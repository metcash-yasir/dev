    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Mandatory values are validated
    /// </summary>
    /// <returns>True, if all the validations are cleared, else False.</returns>
    public boolean validateWrite()
    {
        boolean ret;
        CustTable   custTable;
    
        ret = super();

        select firstonly PartyCountry, PartyState from custTable index hint AccountIdx where custTable.AccountNum == this.CustomerNumber;
        if(LogisticsAddressState::find(custTable.PartyCountry, custTable.PartyState).METTobaccoLicenceExpiryDateRequired 
            && this.TobaccoLicenceExpiry == dateNull())
        {
            ret = ret && checkFailed("@MET:METTobaccoLicExpiryError");
        }
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    /// <summary>
    ///  insert method overriden to assign values before Record is inserted to the table
    /// </summary>
    public void insert()
    {
        CustTable custTable;
        select firstonly AccountNum, Party from custTable index hint AccountIdx where custTable.AccountNum == this.CustomerNumber;
        if(custTable.AccountNum)
        {
            this.CustomerName = custTable.name();
        }
        super();
    }

]]></Source>
