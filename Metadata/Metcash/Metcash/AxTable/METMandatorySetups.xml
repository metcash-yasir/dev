				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves the METMandatorySetups record based on the provided RecId.
    /// Optionally locks the record for update.
    /// </summary>
    /// <param name="_recId">The unique identifier (RecId) of the METMandatorySetups record to find.</param>
    /// <param name="_forUpdate">Specifies whether the record should be locked for update (default is false).</param>
    /// <returns>Returns the METMandatorySetups record if found, otherwise returns null.</returns>
    static METMandatorySetups find(RefRecId _recId, boolean _forUpdate = false)
    {
        METMandatorySetups metMandatorySetups;

        if (_recId)
        {
            metMandatorySetups.selectForUpdate(_forUpdate);

            select firstonly metMandatorySetups
                where metMandatorySetups.RecId == _recId;
        }

        return metMandatorySetups;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks whether a METMandatorySetups record exists based on the provided RecId.
    /// </summary>
    /// <param name="_recId">The unique identifier (RecId) of the METMandatorySetups record to check.</param>
    /// <returns>Returns true if the record exists, otherwise returns false.</returns>
    static boolean exist(RefRecId _recId)
    {
        return _recId  &&
           (select firstonly RecId from METMandatorySetups
                where METMandatorySetups.RecId == _recId).RecId != 0;
    }

]]></Source>
