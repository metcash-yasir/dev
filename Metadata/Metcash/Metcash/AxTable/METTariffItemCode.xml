		<Methods>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves the RecId for a given Itemcode.
    /// </summary>
    /// <param name = "_recId">
    ///  The RecId of the transaction
    ///  </param>
    /// <param name = "_transDate">
    /// Date for which we need to find the record
    /// </param>
    /// <param name = "_forUpdate">
    /// A Boolean value that determines whether the RecId of orign should be selected for update; optional.
    /// </param>
    /// <returns>
    /// The RecId.
    /// </returns>
    static METTariffItemCode findRecId(RecId    _recId,
                                TransDate _transDate = DateTimeUtil::getToday(DateTimeUtil::getUserPreferredTimeZone()),
                                boolean  _forUpdate  = false)
    {
        METTariffItemCode metTariffItemCode, metTariffItemCodeSelect;

        if (_recId)
        {
            metTariffItemCode.selectForUpdate(_forUpdate);
            
            select firstonly validtimestate(_transDate) metTariffItemCode
                join metTariffItemCodeSelect
                where metTariffItemCodeSelect.RecId == _recId
                   && metTariffItemCodeSelect.TariffItem == metTariffItemCode.TariffItem
                   && metTariffItemCodeSelect.StatCode   == metTariffItemCode.StatCode;
        }

        return metTariffItemCode;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
