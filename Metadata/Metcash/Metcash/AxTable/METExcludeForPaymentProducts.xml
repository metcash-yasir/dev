		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static METExcludeForPaymentProducts find(GUPRefRecId _ruleId, ItemId _itemId, boolean _update = false)
    {
        METExcludeForPaymentProducts excludeForPaymentProducts;

        if (_ruleId && _itemId)
        {
            if (_update)
            {
                excludeForPaymentProducts.selectForUpdate(_update);
            }
            
            select firstonly excludeForPaymentProducts index hint ExclusionIdx
                    where excludeForPaymentProducts.RuleId == _ruleId 
                       && excludeForPaymentProducts.ItemId == _itemId;
            
        }

        return excludeForPaymentProducts;
    }

]]></Source>
			</Method>
			<Method>
				<Name>addToExcludeForPayment</Name>
				<Source><![CDATA[
    public void addToExcludeForPayment(GUPRefRecId _ruleId, ItemId _itemId)
    {
        this.RuleId = _ruleId;
        this.ItemId = _itemId;
        if(this.validateWrite())
        {
            this.insert();
        }

    }

]]></Source>
