		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find METSalesTable by SalesTable.RecId
    /// </summary>
    /// <param name = "_refRecId">SalesTable.RecId</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>SalesLine</returns>
    static public METSalesTable find(SalesTableRefRecId _refRecId, boolean _forUpdate = false)
    {
        METSalesTable METSalesTable;

        if(_refRecId)
        {
            METSalesTable.selectForUpdate(_forUpdate);
            select firstonly METSalesTable
               where   METSalesTable.SalesTable  == _refRecId;
        }

        return METSalesTable;
    }

]]></Source>
