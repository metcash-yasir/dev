			<Method>
				<Name>runCustomCreditCheckForSalesOrder</Name>
				<Source><![CDATA[
    /// <summary>
    /// Execute the trigger for custom credit check for sales order
    /// </summary>
    /// <param name = "_salesTable">Sales table reference</param>
    /// <param name = "_cutInfoLog">Cut infolog</param>
    public static void runCustomCreditCheckForSalesOrder(SalesTable  _salesTable, boolean _cutInfoLog = true)
    {
        boolean credManStatusCheckSetupProf;
        boolean credManStatusCheckSetupPost;
        try
        {
            if (!_salesTable.CredManInCreditControl)
            {
                credManStatusCheckSetupProf = CredManStatusCheckSetup::exist(CredManHoldType::Credit, CredManDocumentStatusCheck::METCreditCheck, true);
                credManStatusCheckSetupPost = CredManStatusCheckSetup::exist(CredManHoldType::Credit, CredManDocumentStatusCheck::METCreditCheck, false);

                if (credManStatusCheckSetupPost || credManStatusCheckSetupProf)
                {
                    ttsbegin;
                    FormletterJournalCreate::METDeletePreviousCreditHoldList(_salesTable);
                    FormletterJournalCreate::METSOProformaPosting(_salesTable, _cutInfoLog);
                    ttscommit;

                    //CBNF019_Observability
                    METTelemetrySOCreditCheckInfoEvent::runTelemetryEvent(_salesTable.SalesId);
                    //CBNF019_Observability

                }
            }
        }
        catch
        {
            error(strFmt("@MET:CreditCheckFail", _salesTable.SalesId));

            //CBNF019_Observability
            METTelemetrySOCreditCheckErrorEvent::runTelemetryEvent(_salesTable.SalesId, strFmt("@MET:CreditCheckFail", _salesTable.SalesId));
            //CBNF019_Observability
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>findBySalesId</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB395_CSDFulfilementInterBranchTransfer.
    /// Finds and return <c>METSalesTable</c> record.
    /// </summary>
    /// <param name = "_salesId">SalesId.</param>
    /// <param name = "_forUpdate">ForUpdate.</param>
    /// <returns><c>METSalesTable</c> record.</returns>
    public static METSalesTable findBySalesId(SalesId _salesId, boolean _forUpdate = false)
    {
        METSalesTable metSalesTable;
        SalesTable    salesTable;

        metSalesTable.selectForUpdate(_forUpdate);

        select firstonly metSalesTable
            exists join salesTable
                where salesTable.RecId == metSalesTable.SalesTable
            &&    salesTable.SalesId == _salesId;

        return metSalesTable;
    }

]]></Source>
