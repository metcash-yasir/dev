    /// <returns>SalesLine</returns>
    static public METSalesTable findByRefRecId(SalesTableRefRecId _refRecId, boolean _forUpdate = false)
    {
        METSalesTable METSalesTable;

        if(_refRecId)
        {
            METSalesTable.selectForUpdate(_forUpdate);
