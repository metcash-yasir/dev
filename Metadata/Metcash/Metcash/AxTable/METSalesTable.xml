			<Method>
				<Name>originalSalesId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the original SalesId for this return order by looking up the CustInvoiceJour
    /// </summary>
    /// <param name = "_invoiceAccount">Optional invoice account to use for the lookup. If not provided, the invoice account from the sales table will be used.</param>
    /// <returns>The original SalesId if found; otherwise, an empty SalesId.</returns>
    public SalesId originalSalesId(CustInvoiceAccount _invoiceAccount = '')
    {
        SalesId         origSalesId;
        SalesTable      salesTable;
        CustInvoiceJour custInvoiceJour;
        CustInvoiceAccount invoiceAccount = _invoiceAccount;

        if (this.OriginalInvoice)
        {
            if (!invoiceAccount)
            {
                salesTable = SalesTable::findRecId(this.SalesTable);
                invoiceAccount = salesTable.InvoiceAccount;
            }

            select firstOnly SalesId from custInvoiceJour
                order by InvoiceDate desc
                where custInvoiceJour.InvoiceId      == this.OriginalInvoice
                   && custInvoiceJour.InvoiceAccount == invoiceAccount;

            origSalesId = custInvoiceJour.SalesId;
        }

        return origSalesId;
    }

]]></Source>
