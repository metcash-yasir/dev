		<Methods>
			<Method>
				<Name>findByRefRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find METSalesTable by SalesTable.RecId
    /// </summary>
    /// <param name = "_refRecId">SalesTable.RecId</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>SalesLine</returns>
    static public METSalesTable findByRefRecId(SalesTableRefRecId _refRecId, boolean _forUpdate = false)
    {
        METSalesTable METSalesTable;

        if(_refRecId)
        {
            METSalesTable.selectForUpdate(_forUpdate);
            select firstonly METSalesTable
               where   METSalesTable.SalesTable  == _refRecId;
        }

        return METSalesTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_28155_SalesFinalisation
    /// Standard validation secondary warehouse is connected to secondary site
    /// </summary>
    /// <param name = "_fieldIdToCheck">Field id to check</param>
    /// <returns>True if field is valudated; otherwise, false</returns>
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
    
        ret = super(_fieldIdToCheck);
    
        switch (_fieldIdToCheck)
        {
            // Validate fied for secondary warehouse
            case fieldNum(METSalesTable, SecondaryInventLocationId):
                ret = this.InventStorageDimMap::validateField(fieldNum(InventStorageDimMap, InventLocationId));
                break;
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_28155_SalesFinalisation
    /// </summary>
    /// <param name = "_fieldId">Field id modified</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(METSalesTable, SecondaryInventSiteId):
                this.InventStorageDimMap::modifiedField(fieldNum(InventStorageDimMap, InventSiteId));
                break;

            case fieldNum(METSalesTable, SecondaryInventLocationId):
                this.InventStorageDimMap::modifiedField(fieldNum(InventStorageDimMap, InventLocationId));
                break;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>update</Name>
				<Source><![CDATA[
    /// <summary>
    /// Update method
    /// </summary>
    public void update()
    {
        boolean orderProcessingStatusUpdated;

        METSalesTable   metSalesTableOrig = this.orig();

        if (this.OrderProcessingStatus != metSalesTableOrig.OrderProcessingStatus && this.OrderProcessingStatus == METSalesOrderProcessingStatus::ReadyForPricing)
        {
            orderProcessingStatusUpdated = true;
        }
        super();

        if(orderProcessingStatusUpdated)
        {
            //trigger TMS Engine
            METSOReadyForPricingBusinessEvent::newFromSalesTable(SalesTable::findRecId(this.SalesTable)).send();
        }
    }

]]></Source>
			</Method>
