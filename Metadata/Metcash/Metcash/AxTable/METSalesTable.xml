    /// <summary>
    /// To cretate new <c>METSalesTable</c> record.
    /// </summary>
    public void insert()
    {
        if (this.SalesTable)
        {
            SalesTable  salesTable = SalesTable::findRecId(this.SalesTable);
            this.SalesId = salesTable.SalesId;

            super();

            //Bug354734 
            if (this.OriginalInvoice)
            {
                if (salesTable.SalesType == SalesType::ReturnItem)
                {
                    METReturnOrderCopyChargesHelper::copySOHeaderCharges(this, salesTable);
                }
            }
        }
    }

]]></Source>
