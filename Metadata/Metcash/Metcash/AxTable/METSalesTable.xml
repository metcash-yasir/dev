				<Source><![CDATA[
    /// <summary>
    /// MPJ_28155_SalesFinalisation
    /// Standard validation secondary warehouse is connected to secondary site
    /// </summary>
    /// <param name = "_fieldIdToCheck">Field id to check</param>
    /// <returns>True if field is valudated; otherwise, false</returns>
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
    
        ret = super(_fieldIdToCheck);
    
        switch (_fieldIdToCheck)
        {
            // Validate fied for secondary warehouse
            case fieldNum(METSalesTable, SupplyingWarehouse):
