				<Name>modifiedField</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_28155_SalesFinalisation
    /// </summary>
    /// <param name = "_fieldId">Field id modified</param>
    public void modifiedField(FieldId _fieldId)
    {
        super(_fieldId);

        switch (_fieldId)
        {
            case fieldNum(METSalesTable, SupplyingSiteId):
                this.InventStorageDimMap::modifiedField(fieldNum(InventStorageDimMap, InventSiteId));
