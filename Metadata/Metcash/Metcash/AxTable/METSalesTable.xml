    public boolean validateWrite()
    {
        boolean ret = super();

        if (ret && this.OriginalInvoice && !this.ClaimSalesId)
        {
            ret = checkFailed(strFmt("@MET:OrigInvoiceNotFound", this.OriginalInvoice));
        }

        return ret;
    }

]]></Source>
