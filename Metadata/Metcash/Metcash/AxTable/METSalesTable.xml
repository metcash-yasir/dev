			<Method>
				<Name>update</Name>
				<Source><![CDATA[
    /// <summary>
    /// Update method
    /// </summary>
    public void update()
    {
        boolean orderProcessingStatusUpdated;
        boolean orderprocessingStatusProcessEvent;

        METSalesTable   metSalesTableOrig = this.orig();

        if (this.OrderProcessingStatus != metSalesTableOrig.OrderProcessingStatus && 
            (this.OrderProcessingStatus == METSalesOrderProcessingStatus::ReadyForPricing || 
            (this.OrderProcessingStatus == METSalesOrderProcessingStatus::RepriceRequired &&
             this.DelayPricing != METDelayPricing::PackChange)))
        {
            orderProcessingStatusUpdated = true;
        }
        //CBNF019_Observability_PostSalesOrderCreation

        SalesTable  salesTable = SalesTable::findRecId(this.SalesTable);

        if (this.OrderProcessingStatus != metSalesTableOrig.OrderProcessingStatus 
            && (this.OrderProcessingStatus == METSalesOrderProcessingStatus::ReadyForPricing 
            || this.OrderProcessingStatus == METSalesOrderProcessingStatus::PricingCompleted
            || this.OrderProcessingStatus == METSalesOrderProcessingStatus::PendingProcessing
            || this.OrderProcessingStatus == METSalesOrderProcessingStatus::ReadyForInvoicing
            || this.OrderProcessingStatus == METSalesOrderProcessingStatus::OptimisationCompleted
            || this.OrderProcessingStatus == METSalesOrderProcessingStatus::IOMSyncCompleted))
        {
            MetTelemetryOrderProcessingStatusEvent::triggerOrderProcessingEvent(salesTable, this);
        }

        //CBNF019_Observability_PostSalesOrderCreation

        super();

        if(orderProcessingStatusUpdated)
        {
            //trigger PE Pricing business event
            METSOReadyForPricingBusinessEvent::newFromSalesTable(salesTable).send();
        }

        //Bug354734
        if (salesTable.SalesType == SalesType::ReturnItem && this.OriginalInvoice && this.OriginalInvoice != metSalesTableOrig.OriginalInvoice)
        {
            Markup::delete(salesTable);
            METReturnOrderCopyChargesHelper::copySOHeaderCharges(this, salesTable);
            METReturnOrderCopyChargesHelper::syncSalesLines(this);
        }

        // Task192490_CB888_SalesOrderHeaderCharges
        METSalesOrderProcessingStatus salesOrderProcessingStatusPricing = SalesParameters::find().METSalesOrderProcessingStatus;
        
        if (salesTable.SalesType != SalesType::ReturnItem && metSalesTableOrig.OrderProcessingStatus != salesOrderProcessingStatusPricing && this.OrderProcessingStatus == salesOrderProcessingStatusPricing)
        {
            salesTable.createMarkupTrans(true, false); // Research auto charges.
            salesTable.createMarkupTrans(false, true); // Calculate tiered charges. Tiered charges are determined upon order basis in summary update scenario.
        }

    }

]]></Source>
