		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by reference
    /// </summary>
    /// <param name = "_salesId">_salesId</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>SalesLine</returns>
    static public METSalesTable find(SalesId _salesId, boolean _forUpdate = false)
    {
        METSalesTable METSalesTable;
        if(_salesId)
        {
            METSalesTable.selectForUpdate(_forUpdate);
            select firstonly METSalesTable
               where   METSalesTable.SalesId  == _salesId;
        }
        return METSalesTable;
    }

]]></Source>
