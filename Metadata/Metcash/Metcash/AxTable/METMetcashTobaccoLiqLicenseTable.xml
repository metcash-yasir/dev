		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Retrieves the first record of the table based on condition
    /// </summary>
    /// <param name = "_stateId"> Customer's state Id</param>
    /// <param name = "_forUpdate"> A Boolean value that determines whether the RecId of orign should be selected for update; optional.</param>
    /// <returns> The table record </returns>
    static METMetcashTobaccoLiqLicenseTable find(LogisticsAddressStateId   _stateId, boolean  _forUpdate = false)
    {
        METMetcashTobaccoLiqLicenseTable metcashTobaccoLiqLicenseTable;

        if (_stateId)
        {
            if (_forUpdate)
            {
                metcashTobaccoLiqLicenseTable.selectForUpdate(_forUpdate);
            }

            select firstonly metcashTobaccoLiqLicenseTable
                index hint StateLicenceIdx
                where metcashTobaccoLiqLicenseTable.StateId == _stateId;
        }

        return metcashTobaccoLiqLicenseTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Searches for the first record of the table based on condition
    /// </summary>
    /// <param name = "_stateId"> Customer's state Id</param>
    /// <returns> A Boolean value "Yes" if record exists, else "No" </returns>
    static boolean exist(LogisticsAddressStateId   _stateId)
    {
        return _stateId && (select firstonly RecId from METMetcashTobaccoLiqLicenseTable
                                    index hint StateLicenceIdx
                                    where METMetcashTobaccoLiqLicenseTable.StateId == _stateId).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
