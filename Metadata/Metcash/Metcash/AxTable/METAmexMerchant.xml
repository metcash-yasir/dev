				<Source><![CDATA[
    /// <summary>
    /// MPJ_3338_AMEXCustomerPaymentProcessing
    /// standard find method
    /// </summary>
    /// <param name = "_merchantid">METAMEXMerchantId</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns <c>METAmexSvcCharge</c></returns>
    static METAmexMerchant find(METAmexMerchantId _merchantid, boolean _forUpdate = false)
    {
        METAmexMerchant metAmexMerchant;

        if (_merchantid)
        {
            METAmexMerchant.selectForUpdate(_forUpdate);
          
            select firstonly METAmexMerchant
              where METAmexMerchant.MerchantId == _merchantid;
        }

        return METAmexMerchant;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_3338_AMEXCustomerPaymentProcessing
    /// standard exist method
    /// </summary>
    /// <param name = "_merchantid">METAmexMerchantId</param>
    /// <returns>Returns true/false</returns>
    static boolean exist(METAmexMerchantId _merchantid)
    {
        return _merchantid  &&
              (select firstonly RecId from METAmexMerchant
                   where METAmexMerchant.MerchantId == _merchantid).RecId != 0;
    }

]]></Source>
