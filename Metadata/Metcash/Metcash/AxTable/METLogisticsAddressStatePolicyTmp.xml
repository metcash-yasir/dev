    public RefreshFrequency xds()
    {
        METLogisticsAddressStatePolicyTmp  metStatePolicyTmp;
        METUserSecurityGroupList           metUserSecurityGroupList;
        METUserSecurityStateList           metUserSecurityStateList;

        Unchecked(Uncheck::XDS)
        {
            insert_recordset metStatePolicyTmp(METLogisticsAddressStateId, Company)
                select METLogisticsAddressStateId, Company from metUserSecurityStateList
                  group by METLogisticsAddressStateId, Company
                    join metUserSecurityGroupList
                where metUserSecurityGroupList.UserSecurityGroupId == metUserSecurityStateList.UserSecurityGroupId
                   && metUserSecurityGroupList.UserId == curUserId();
        }

        return RefreshFrequency::PerSession;
    }

]]></Source>
