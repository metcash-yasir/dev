		<Methods>
			<Method>
				<Name>countLines</Name>
				<Source><![CDATA[
    /// <summary>
    /// Count number of lines for specified order guide.
    /// </summary>
    /// <param name = "_guideID">_guideID</param>
    /// <returns>Number of lines</returns>
    static public int countLines(METSalesOrderGuideID _guideID)
    {
        METSalesOrderGuideExpanded expanded;
        select count(RecId) from expanded
            where   expanded.SalesOrderGuideID == _guideID;
        return int642int(expanded.RecId);
    }

]]></Source>
			</Method>
			<Method>
				<Name>deleteLines</Name>
				<Source><![CDATA[
    /// <summary>
    /// Delete all entries for specified order guide.
    /// </summary>
    /// <param name = "_guideID">_guideID</param>
    static public void deleteLines(METSalesOrderGuideID _guideID)
    {
        METSalesOrderGuideExpanded expanded;
        delete_from expanded
            where   expanded.SalesOrderGuideID == _guideID;
    }

]]></Source>
			</Method>
