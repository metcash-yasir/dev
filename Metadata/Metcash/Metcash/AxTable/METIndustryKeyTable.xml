		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by industry key ID.
    /// </summary>
    /// <param name = "_industryKey">Industry key</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>METIndustryKeyTable</returns>
    static public METIndustryKeyTable find(METIndustryKey _industryKey, boolean _forUpdate = false)
    {
        METIndustryKeyTable industryKey;
        industryKey.selectForUpdate(_forUpdate);
        select firstonly industryKey
            where   industryKey.IndustryKey == _industryKey;
        return industryKey;
    }

]]></Source>
