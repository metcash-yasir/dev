		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by industry key ID.
    /// </summary>
    /// <param name = "_industryKey">Industry key</param>
    /// <param name = "_forUpdate">false or true</param>
    /// <returns>METIndustryKeyTable</returns>
    static public METIndustryKeyTable find(METIndustryKey _industryKey, boolean _forUpdate = false)
    {
        METIndustryKeyTable industryKey;

        industryKey.selectForUpdate(_forUpdate);

        select firstonly industryKey
            where   industryKey.IndustryKey == _industryKey;

        return industryKey;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findInLegalEntity</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by industry key ID and dataareaId.
    /// </summary>
    /// <param name = "_industryKey">Industry key</param>
    /// <param name = "_dataAreaId">DataAreaId</param>
    /// <returns>METIndustryKeyTable</returns>
    public static METIndustryKeyTable findInLegalEntity(METIndustryKey _industryKey,DataAreaId _dataAreaId)
    {
        METIndustryKeyTable industryKey;

        if (_industryKey &&
            _dataAreaId)
        {
            select firstonly crosscompany industryKey
                where industryKey.IndustryKey == _industryKey
                   && industryKey.DataAreaId == _dataAreaId;
        }

        return industryKey;
    }

]]></Source>
			</Method>
		</Methods>
