		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find method
    /// </summary>
    /// <param name = "_wmsPickingRouteID">FO picking list number</param>
    /// <param name = "_forUpdate">Select record for update</param>
    /// <returns><c>METPicklistReference</c> record if found; otherwise, null.</returns>
    static METPicklistReference find(WMSPickingRouteID _wmsPickingRouteID,
                                     boolean           _forUpdate = false)
    {
        METPicklistReference pickListReference;

        if (_wmsPickingRouteID)
        {
            if (_forUpdate)
            {
                pickListReference.selectForUpdate(_forUpdate);
            }
            
            select firstonly pickListReference
                       where pickListReference.D365FOPicklistNumber == _wmsPickingRouteID;

        }

        return pickListReference;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Exist method
    /// </summary>
    /// <param name = "_wmsPickingRouteID">FO picking list number</param>
    /// <returns>True if record exists; otherwise, null.</returns>
    static boolean exist(WMSPickingRouteID _wmsPickingRouteID)
    {
        return (select firstonly RecId from METPicklistReference
                                      where METPicklistReference.D365FOPicklistNumber  == _wmsPickingRouteID).RecId != 0;
    }

]]></Source>
			</Method>
