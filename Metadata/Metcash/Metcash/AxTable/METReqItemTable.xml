    /// Find by reference
    /// </summary>
    /// <param name = "_reqItemTableRecID">_reqItemTableRecID</param>
    /// <param name = "_forUpdate">_forUpdate</param>
    /// <returns>ReqItemTable</returns>
    static public METReqItemTable find(RefRecId _reqItemTableRecID, boolean _forUpdate = false)
    {
        METReqItemTable metReqItemTable;
        if(_reqItemTableRecID)
        {
            metReqItemTable.selectForUpdate(_forUpdate);
            select firstonly metReqItemTable
               where   metReqItemTable.ItemId == _reqItemTableRecID;
        }
        return metReqItemTable;
    }

