		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Bug 281410: CB201- For Volumetric rebate Calculate tier rate rebate is not working properly if we click on Process provision without doing the Calculate tier rate rebate
    /// </summary>
    /// <param name = "_rebateId">Rebate management number</param>
    /// <param name = "_rebateRefDate">Rebate transaction date</param>
    /// <param name = "_rebateTransactionType">RebateTransaction type</param>
    /// <param name = "_forUpdate">Select for update</param>
    /// <returns><c>METTierRateTrans</c></returns>
    public static METTierRateTrans find(TAMRebateDealId _rebateDealId,
        TAMRebateRefDate _rebateRefDate,
        TAMRebateTransactionType _rebateTransactionType,
                                            boolean _forUpdate = false)
    {
        METTierRateTrans tierRateTrans;
        
        tierRateTrans.selectForUpdate(_forUpdate);

        if (_rebateDealId && _rebateRefDate)
        {
            select firstonly tierRateTrans
                       where tierRateTrans.TAMRebateDealId == _rebateDealId
                          && tierRateTrans.FromDate <= _rebateRefDate
                          && tierRateTrans.ToDate >= _rebateRefDate
                          && tierRateTrans.RebateTransactionType == _rebateTransactionType;
        }
    
        return tierRateTrans;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
