		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find method to fetch the table reference based on input parameter
    /// </summary>
    /// <param name = "_warehouseCarrierId">Warehouse carrier Id reference</param>
    /// <param name = "_forUpdate">Boolean value to update table</param>
    /// <returns>METWarehouseCarrier reference</returns>
    public static METWarehouseCarrier find(METWarehouseCarierId     _warehouseCarrierId,
                                           boolean                  _forUpdate = false)
    {
        METWarehouseCarrier metWarehouseCarrier;

        if (_forUpdate)
        {
            metWarehouseCarrier.selectForUpdate(_forUpdate);
        }

        select firstonly metWarehouseCarrier
            where metWarehouseCarrier.WarehouseCarierId == _warehouseCarrierId;

        return metWarehouseCarrier;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Method to check existance of record in table
    /// </summary>
    /// <param name = "_warehouseCarrierId">Warehouse carrier Id reference</param>
    /// <returns>Boolean value</returns>
    public static boolean exist(METWarehouseCarierId   _warehouseCarrierId)
    {
        return _warehouseCarrierId && (select firstonly RecId from metWarehouseCarrier
                        where metWarehouseCarrier.WarehouseCarierId == _warehouseCarrierId).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
