    public RefreshFrequency xds()
    {
        METIndustryKeyTablePolicyTmp             metIndustryKeyTablePolicyTmp;
        METUserSecurityGroupList                 metUserSecurityGroupList;
        METUserSecurityMETIndustryKeyTableList   metUserSecurityMETIndustryKeyTableList;

        Unchecked(Uncheck::XDS)
        {
            insert_recordset metIndustryKeyTablePolicyTmp(IndustryKey, Company)
                select IndustryKey, Company from metUserSecurityMETIndustryKeyTableList
                  group by IndustryKey, Company
                    join metUserSecurityGroupList
                where metUserSecurityGroupList.UserSecurityGroupId == metUserSecurityMETIndustryKeyTableList.UserSecurityGroupId
                && metUserSecurityGroupList.UserId == curUserId();
        }

        return RefreshFrequency::PerSession;
    }

]]></Source>
