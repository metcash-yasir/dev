		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns METTableFieldNames record when found.
    /// </summary>
    /// <param name = "_metTableFieldName">Record id</param>
    /// <param name = "_forUpdate">The forupdate buffer to pass</param>
    /// <returns>METTableFieldNames record</returns>
    static METTableFieldNames find(RefRecId _recId, boolean _forUpdate = false)
    {
        METTableFieldNames metTableFieldNames;

        if (_recId)
        {
            metTableFieldNames.selectForUpdate(_forUpdate);
      
            select firstonly metTableFieldNames
            where metTableFieldNames.RecId == _recId;
        }

        return metTableFieldNames;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns boolean value if record exists true otherwise false.
    /// </summary>
    /// <param name = "_metTableFieldName">Record id</param>
    /// <returns>Returns boolean value if record exists true otherwise false</returns>
    static boolean exist(RefRecId _recId)
    {
        return _recId  &&
           (select firstonly RecId from METTableFieldNames
                where METTableFieldNames.RecId == _recId).RecId != 0;
    }

]]></Source>
			</Method>
