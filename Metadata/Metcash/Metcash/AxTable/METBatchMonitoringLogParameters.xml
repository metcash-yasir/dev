			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static METBatchMonitoringLogParameters find(METBatchLogOperation  _logOperation, boolean _forUpdate = false)
    {
        METBatchMonitoringLogParameters batchMonitoringLogParameters;
        ;
        if (_forUpdate)
        {
            batchMonitoringLogParameters.selectForUpdate(_forUpdate);
        }
    
        select firstonly batchMonitoringLogParameters
            where batchMonitoringLogParameters.LogOperation == _logOperation;
    
        return batchMonitoringLogParameters;
    }

]]></Source>
			</Method>
			<Method>
				<Name>initParameters</Name>
				<Source><![CDATA[
    public static void initParameters()
    {
        DictEnum de = new DictEnum(enumNum(METBatchLogOperation));
        int      i;
        METBatchLogOperation               logOperation;
        METBatchMonitoringLogParameters    logParameters;
        ;

        ttsbegin;

        for (i = 1; i <= de.values(); i++)
        {
            logOperation = de.index2Value(i - 1);
            logParameters = null;
            select firstonly logParameters
                where logParameters.LogOperation == logOperation;
            if (! logParameters.RecId)
            {
                logParameters.initValue();
                logParameters.LogOperation = logOperation;
                logParameters.insert();
            }
        }

        ttscommit;
    }

]]></Source>
			</Method>
