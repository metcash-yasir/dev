				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns METWholesaleCustomerClassifications record when found.
    /// </summary>
    /// <param name = "_metWCC">METWholesaleCustomerClassification buffer</param>
    /// <param name = "_forUpdate">The forupdate buffer to pass</param>
    /// <returns>METWholesaleCustomerClassifications record</returns>
    static METWholesaleCustomerClassifications find(METWholesaleCustomerClassification _metWCC, boolean _forUpdate = false)
    {
        METWholesaleCustomerClassifications metWholesaleCustomerClassifications;

        if (_metWCC)
        {
            metWholesaleCustomerClassifications.selectForUpdate(_forUpdate);
          
            select firstonly metWholesaleCustomerClassifications
              where metWholesaleCustomerClassifications.WholesaleCustomerClassification == _metWCC;
        }

        return metWholesaleCustomerClassifications;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns boolean value if record exists true otherwise false.
    /// </summary>
    /// <param name = "_metWCC">METWholesaleCustomerClassification buffer</param>
    /// <returns>Returns boolean value if record exists true otherwise false</returns>
    static boolean exist(METWholesaleCustomerClassification _metWCC)
    {
        return _metWCC  &&
              (select firstonly RecId from metWholesaleCustomerClassifications
                   where metWholesaleCustomerClassifications.WholesaleCustomerClassification == _metWCC).RecId != 0;
    }

]]></Source>
