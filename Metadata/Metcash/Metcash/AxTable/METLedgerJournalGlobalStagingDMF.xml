		<Methods>
			<Method>
				<Name>updateLineNumbers</Name>
				<Source><![CDATA[
    /// <summary>
    /// Updates staging records line number
    /// </summary>
    /// <param name = "_dmfDefinitionGroupExecution">The definition group for which the line numbers should be updated.</param>
    public static void updateLineNumbers(DMFDefinitionGroupExecution _dmfDefinitionGroupExecution)
    {
        METLedgerJournalGlobalStagingDMF    globalStagingDMF,globalStagingDMFBuff;
        DataAreaId                          previousCompany = '';
        LedgerJournalId                     previousJournal = '';
        LineNum                             lineNum = 0,journalLastNum = 0,stagingLastNum = 0;

        while select forupdate globalStagingDMF
            order by JournalBatchNumber,Company
                where globalStagingDMF.DefinitionGroup == _dmfDefinitionGroupExecution.DefinitionGroup
                    && globalStagingDMF.ExecutionId    == _dmfDefinitionGroupExecution.ExecutionId
                    && globalStagingDMF.JournalBatchNumber != ''
                    && globalStagingDMF.Voucher == ''
        {
            try
            {
                ttsbegin;
                if ((previousCompany != globalStagingDMF.Company) ||
                    (previousJournal != globalStagingDMF.JournalBatchNumber))
                {
                    select firstonly globalStagingDMFBuff order by LineNumber desc
                        where globalStagingDMFBuff.DefinitionGroup == _dmfDefinitionGroupExecution.DefinitionGroup
                            && globalStagingDMFBuff.ExecutionId    == _dmfDefinitionGroupExecution.ExecutionId
                            && globalStagingDMFBuff.JournalBatchNumber == globalStagingDMF.JournalBatchNumber;

                    stagingLastNum = globalStagingDMFBuff.LineNumber;

                    changecompany(globalStagingDMF.Company)
                    {
                        journalLastNum = LedgerJournalTrans::lastLineNum(globalStagingDMF.JournalBatchNumber) + 1;
                    }

                    if (stagingLastNum > journalLastNum)
                    {
                        lineNum = stagingLastNum + 1;
                    }
                    else
                    {
                        lineNum = journalLastNum;
                    }
                }
                globalStagingDMF.LineNumber = lineNum;
                globalStagingDMF.doupdate();
                lineNum++;

                previousCompany = globalStagingDMF.Company;
                previousJournal = globalStagingDMF.JournalBatchNumber;
                ttscommit;
            }
            catch
            {
                error("@MET:LineNumberStagingError");
            }
        }
    }

]]></Source>
			</Method>
