		<Methods>
			<Method>
				<Name>cleanUpQueue</Name>
				<Source><![CDATA[
    /// <summary>
    /// Cleans up queue.
    /// </summary>
    static void cleanUpQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METTMSEngineProcessingQueue queue;
        METTMSEngineProcessingQueue::skip(queue);

        ttsbegin;
        delete_from queue
            where queue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>skip</Name>
				<Source><![CDATA[
    /// <summary>
    /// skip method for performance purpose
    /// </summary>
    /// <param name = "_queue"><c>Queue.</param>
    public static void skip(METTMSEngineProcessingQueue _queue)
    {
        _queue.skipDatabaseLog(true);
        _queue.skipDataMethods(true);
        _queue.skipDeleteActions(true);
        _queue.skipEvents(true);
        _queue.skipBusinessEvents(true);
    }

]]></Source>
			</Method>
