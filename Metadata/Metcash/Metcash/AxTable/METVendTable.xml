		<Methods>
			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_3535 - NCiantar - 29/04/2021
    /// Field validation for % not to exceed 100
    /// </summary>
    /// <param name = "_fieldIdToCheck">Field ID</param>
    /// <returns>boolean value</returns>
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
    
        ret = super(_fieldIdToCheck);

        if (ret)
        {
            switch (_fieldIdToCheck)
            {
                case fieldNum(METVendTable, MetpayFinanceAllowableDiscPercent):
                    if (this.MetpayFinanceAllowableDiscPercent > 100)
                    {
                        ret = false;
                    }
                    else
                    {
                        ret = true;
                    }
                    break;
            }
        }
           

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getCreditPaymId</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_5046_MetpayInterfaces 05/05/2021
    /// Method to find a row of data by account number
    /// </summary>
    /// <param name = "_vendAccount">VendAccount</param>
    /// <returns>returns the field CreditPaymTermId</returns>
    public static METCreditPaymTermId getCreditPaymId(VendAccount _vendAccount)
    {
        METVendTable metvendTable;
 
        select firstonly CreditPaymTermId
            from metvendTable
            where metvendTable.AccountNum == _vendAccount;

        return metvendTable.CreditPaymTermId;
    }

]]></Source>
			</Method>
