				<Source><![CDATA[
    static METBYODComp find(TableName   _tableName,
                        boolean       _forUpdate = false)
    {
        METBYODComp metBYODComp;

        if (_tableName)
        {
            metBYODComp.selectForUpdate(_forUpdate);
          
            select firstonly metBYODComp
              where metBYODComp.tableName == _tableName;
        }

        return metBYODComp;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    static boolean exist(TableName   _tableName)
    {
        return _tableName  &&
              (select firstonly tableName from METBYODComp
                   where METBYODComp.tableName == _tableName).RecId != 0;
    }

]]></Source>
