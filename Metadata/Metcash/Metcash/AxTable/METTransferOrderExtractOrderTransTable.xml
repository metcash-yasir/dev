				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds the record based on the parameters passed
    /// </summary>
    /// <param name = "_pickingRouteId">
    /// Picking route ID
    /// </param>
    /// <param name = "_itemId">
    /// Item number
    /// </param>
    /// <param name = "_lineNum">
    /// Line number
    /// </param>
    /// <param name = "_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The actual record
    /// </returns>
    public static METTransferOrderExtractOrderTransTable find(WMSPickingRouteID _pickingRouteId, ItemId _itemId,LineNum _lineNum,boolean _forupdate = false)
    {
        METTransferOrderExtractOrderTransTable transTable;

        if (_pickingRouteId && _itemId && _lineNum)
        {
            transTable.selectForUpdate(_forupdate);

            select firstonly transTable
                where transTable.SalesOrderNumber == _pickingRouteId
                && transTable.ItemNumber == _itemId
                && transTable.LineNum == _lineNum;
        }

        return transTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks whether a specific <c>METTransferOrderExtractOrderTransTable</c> record exists.
    /// </summary>
    /// <param name = "_pickingRouteId">
    /// Picking route ID
    /// </param>
    /// <param name = "_itemId">
    /// Item number
    /// </param>
    /// <param name = "_lineNum">
    /// Line number
    /// </param>
    /// <returns>
    /// True if found, else false
    /// </returns>
    public static boolean exist(WMSPickingRouteID _pickingRouteId,ItemId _itemId,LineNum _lineNum)
    {
        return (_pickingRouteId && _itemId && _lineNum) &&
               (select firstonly METTransferOrderExtractOrderTransTable
                    where METTransferOrderExtractOrderTransTable.SalesOrderNumber == _pickingRouteId
                    && METTransferOrderExtractOrderTransTable.ItemNumber == _itemId
                    && METTransferOrderExtractOrderTransTable.LineNum == _lineNum).RecId != 0;
    }

