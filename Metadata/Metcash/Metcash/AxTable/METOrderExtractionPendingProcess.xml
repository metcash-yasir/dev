			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static METOrderExtractionPendingProcess find(SalesId _salesId, boolean _forUpdate = false)
    {
        METOrderExtractionPendingProcess result;

        if (!_salesId)
        {
            return result;
        }

        result.selectForUpdate(_forUpdate);

        select firstonly result
            order by result.RecId desc
            where result.SalesId == _salesId;

        return result;
    }

]]></Source>
