	<Name>METExciseRegisterEntryAIS</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// AIS table to hold the excise register entry data for processing before moving to the actual register entry table. This is required as the data coming from AIS will be in a different format and needs to be transformed before it can be inserted into the register entry table.
/// </summary>
public class METExciseRegisterEntryAIS extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>moveEntriesToRegisterEntry</Name>
				<Source><![CDATA[
    /// <summary>
    /// Moves the data from the AIS table to the actual register entry table after transformation.
    /// </summary>
    public static void moveEntriesToRegisterEntry(ParmId        _aisIntegrationId)
    {
        METExciseRegisterEntry registerEntry;

        METExciseRegisterEntryAIS registerEntryAIS;

        while select registerEntryAIS
            where registerEntryAIS.AISIntegrationId == _aisIntegrationId
        {
            registerEntry.clear();
            registerEntry.DutyRateReceived = registerEntryAIS.DutyRateReceived;
            registerEntry.EditReasonCode = registerEntryAIS.EditReasonCode;
            registerEntry.ItemId = registerEntryAIS.ItemId;
            registerEntry.Lodgement = registerEntryAIS.Lodgement;
            registerEntry.OrderNumber = registerEntryAIS.OrderNumber;
            registerEntry.OriginDocumentNumber = registerEntryAIS.OriginDocumentNumber;
            registerEntry.OriginType = registerEntryAIS.OriginType;
            registerEntry.PermissionNumber = registerEntryAIS.PermissionNumber;
            registerEntry.ReceiptQuantity = registerEntryAIS.ReceiptQuantity;
            registerEntry.SiteId = registerEntryAIS.SiteId;
            registerEntry.TIUV = registerEntryAIS.TIUV;
            registerEntry.ReferenceId = guid2Str(newGuid());
            registerEntry.VersionNumberRegister = 1;
            registerEntry.ValidFrom = DateTimeUtil::utcNow();
            registerEntry.ValidTo = DateTimeUtil::maxValue();
            registerEntry.insert();
        }

        delete_from registerEntryAIS
            where registerEntryAIS.AISIntegrationId == _aisIntegrationId;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
