    /// <summary>
    /// Finds a specific <c>METTallyGroup</c> with given parameters.
    /// </summary>
    /// <param name="_tallyGroupId">
    /// Tally Group Id.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static METTallyGroup find(METTallyGroupId _tallyGroupId, boolean _forupdate = false)
    {
        METTallyGroup  tallyGroup;

        if (_tallyGroupId)
        {
            tallyGroup.selectForUpdate(_forupdate);

            select firstonly tallyGroup
                where tallyGroup.TallyGroup == _tallyGroupId;
        }

        return tallyGroup;
    }

