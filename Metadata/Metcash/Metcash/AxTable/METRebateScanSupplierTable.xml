		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    /// Blank record must not be inserted into the table
    /// </summary>
    /// <returns>True, if validations are clear, else False</returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        if(!(this.CustAccount || this.VendAccount))
        {
            ret = false;
        }
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    static METRebateScanSupplierTable find(METRebateTransId _rebateTransId, boolean _forUpdate = false)
    {
        METRebateScanSupplierTable externalSellData;

        if (_rebateTransId)
        {
            if (_forUpdate)
            {
                externalSellData.selectForUpdate(_forUpdate);
            }

            select firstonly externalSellData
                where externalSellData.TransactionNumber == _rebateTransId;
        }

        return externalSellData;
    }

]]></Source>
			</Method>
		</Methods>
