		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_2864_CreditLimitBalance 03/11/2021
    /// find method finds record in METCustCreditLimit
    /// </summary>
    /// <param name = "_custAccount">CustomerAccount</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns METCustCreditLimit table</returns>
    static METCustCreditLimit find(CustAccount _custAccount, boolean _forUpdate = false)
    {
        METCustCreditLimit metCustCreditLimit;

        if (_custAccount)
        {
            metCustCreditLimit.selectForUpdate(_forUpdate);
          
            select firstonly metCustCreditLimit
              where metCustCreditLimit.AccountNum == _custAccount;
        }

        return metCustCreditLimit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method is used to check if a record that fulfils the specified key actually exists
    /// </summary>
    /// <param name = "_custAccount">CustomerAccount</param>
    /// <returns>returns true or false depedning if records exists</returns>
    static boolean exist(CustAccount _custAccount)
    {
        return _custAccount  &&
              (select firstonly RecId from METCustCreditLimit
                   where METCustCreditLimit.AccountNum == _custAccount).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
