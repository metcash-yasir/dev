				<Name>lookupIndustryKeyByCompany</Name>
				<Source><![CDATA[
    public static void lookupIndustryKeyByCompany(FormStringControl _formControl, DataAreaId _company)
    {
        if (!_company)
        {
            return;
        }

        Query query = new Query();
        query.allowCrossCompany(true);
        query.addCompanyRange(_company);

        QueryBuildDataSource qbds = query.addDataSource(tableNum(METIndustryKeyTable));

        SysTableLookup lookup = SysTableLookup::newParameters(tableNum(METIndustryKeyTable), _formControl);
        lookup.addLookupField(fieldNum(METIndustryKeyTable, IndustryKey));
        lookup.addLookupField(fieldNum(METIndustryKeyTable, IndustryChannel));
        lookup.parmQuery(query);
        lookup.performFormLookup();
    }

]]></Source>
