    /// <summary>
    /// Set unit weight, unit volume, unit case 
    /// </summary>
    public void setUnitFields()
    {
        InventTransferLine      inventTransferLine = this.InventTransferLine();

        if (inventTransferLine.itemId && inventTransferLine.UnitId && inventTransferLine.InventDimId)
        {
            this.WarehouseUnitId = METInventLocation::getWarehouseUnit(inventTransferLine.itemId, inventTransferLine.inventDim());

            this.TOUnitWeight = METWHSPhysDimUOMSite::convertWeight(
                                inventTransferLine.itemId, 1, inventTransferLine.UnitId, inventTransferLine.inventDim());
            this.TOUnitVolume = METWHSPhysDimUOMSite::convertVolume(
                                inventTransferLine.itemId, 1,  inventTransferLine.UnitId, inventTransferLine.inventDim());
        }
    }

]]></Source>
