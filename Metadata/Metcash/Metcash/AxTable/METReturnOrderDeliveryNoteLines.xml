]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static METReturnOrderDeliveryNoteLines find(SalesReturnItemNum _returnOrderNumber, TradeLineNumber   _lineNumber,
                          boolean       _forUpdate = false)
    {
        METReturnOrderDeliveryNoteLines returnOrderDeliveryNoteLines;

        if (_returnOrderNumber && _lineNumber)
        {
            if (_forUpdate)
            {
                returnOrderDeliveryNoteLines.selectForUpdate(_forUpdate);
            }

            select firstonly returnOrderDeliveryNoteLines
                where returnOrderDeliveryNoteLines.ReturnOrderNum == _returnOrderNumber
                && returnOrderDeliveryNoteLines.LineNumber == _lineNumber;
        }

        return returnOrderDeliveryNoteLines;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    static boolean exist(SalesReturnItemNum _returnOrderNumber, TradeLineNumber   _lineNumber)
    {
        return _returnOrderNumber && _lineNumber && (select firstonly RecId from METReturnOrderDeliveryNoteLines
                                    where METReturnOrderDeliveryNoteLines.ReturnOrderNum == _returnOrderNumber && METReturnOrderDeliveryNoteLines.LineNumber == _lineNumber).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
