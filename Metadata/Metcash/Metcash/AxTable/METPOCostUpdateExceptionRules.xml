            where metPOCostUpdateExceptionRules.CategoryHierarchy   == _ecoResCategoryHierarchyId &&
                  metPOCostUpdateExceptionRules.Category     == _ecoResCategoryId;
         
        return metPOCostUpdateExceptionRules;
    }

