    static METPOCostUpdateExceptionRules find(EcoResCategoryId _ecoResCategoryId, EcoResCategoryHierarchyId _ecoResCategoryHierarchyId, boolean _forupdate = false, ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        METPOCostUpdateExceptionRules metPOCostUpdateExceptionRules;

        metPOCostUpdateExceptionRules.selectForUpdate(_forupdate);
        metPOCostUpdateExceptionRules.concurrencyModel(_concurrencyModel);

