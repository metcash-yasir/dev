		<Methods>
			<Method>
				<Name>findByRecId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find by recId
    /// </summary>
    /// <param name = "_recId">RecId reference</param>
    /// <param name = "_forUpdate">For update boolean</param>
    /// <returns>METExciseInformationTable</returns>
    static METExciseInformationTable findByRecId(RefRecId   _recId,
                                                boolean     _forUpdate = false)
    {
        METExciseInformationTable metExciseInformationTable;

        if (_forUpdate)
        {
            metExciseInformationTable.selectForUpdate(_forUpdate);
        }

        select firstonly metExciseInformationTable
            where metExciseInformationTable.RecId == _recId;

        return metExciseInformationTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>existByInventTrans</Name>
				<Source><![CDATA[
    /// <summary>
    /// Check invent trans record
    /// </summary>
    /// <param name = "_InventTransRecId">Invent trans rec Id reference</param>
    /// <returns>Boolean</returns>
    static boolean existByInventTrans(RefRecId _InventTransRecId)
    {
        return _InventTransRecId && (select firstonly RecId from metExciseInformationTable
                                        where metExciseInformationTable.InventTransRefRecId == _InventTransRecId).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
