		<Methods>
			<Method>
				<Name>lastLineNum</Name>
				<Source><![CDATA[
    /// <summary>
    /// Method to return the latest line number from shipment lines for a specific shipment id
    /// </summary>
    /// <param name = "_shipmentId">Shipment Id</param>
    /// <returns>latest line number from shipment lines for a specific shipment id</returns>
    static LineNum lastLineNum(METShipmentId _shipmentId)
    {
        return (select maxof(LineNum) from METShipmentLine
                    where METShipmentLine.shipmentId == _shipmentId).LineNum;
    }

]]></Source>
