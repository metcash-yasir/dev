		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static METCustOperGroup find(
        METCustOperGroupId _custGroupId ,
        boolean _forupdate = false,
        ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        METCustOperGroup custGroup;

        custGroup.selectForUpdate(_forupdate);
        if (_forupdate && _concurrencyModel != ConcurrencyModel::Auto)
        {
            custGroup.concurrencyModel(_concurrencyModel);
        }

        select firstonly custGroup where custGroup.CustOperGroupId == _custGroupId;

        return custGroup;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    public static boolean exist(METCustOperGroupId custGroupId )
    {
        boolean found;

        found = (select firstonly
                     RecId
                from
                     METCustOperGroup
                 where
                     METCustOperGroup.CustOperGroupId == custGroupId).RecId != 0;

        return found;
    }

]]></Source>
			</Method>
