			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB231_ContainerContentReport 06/12/2024
    /// find method finds record in METTotes
    /// </summary>
    /// <param name = "_salesId">SalesId</param>
    /// <param name = "_totes">_totes</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns METCCRTable table</returns>
    static METTotes find(SalesId _salesId,str60 _totes, boolean _forUpdate = false)
    {
        METTotes metTotes;

        if (_salesId && _totes)
        {
            metTotes.selectForUpdate(_forUpdate);
          
            select firstonly metTotes
              where metTotes.SalesId == _salesId
                && metTotes.Tote == _totes;
        }

        return metTotes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method is used to check if a record that fulfils the specified key actually exists
    /// </summary>
    /// <param name = "_salesId">SalesId</param>
    /// <param name = "_totes">_totes</param>
    /// <returns>returns true or false depedning if records exists</returns>
    static boolean exist(SalesId _salesId,str60 _totes)
    {
        return _salesId && _totes &&
              (select firstonly RecId from metTotes
                where metTotes.SalesId == _salesId
                && metTotes.Tote == _totes).RecId != 0;
    }

]]></Source>
			</Method>
