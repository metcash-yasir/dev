				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>METSubRiskClass</c> with given parameters.
    /// </summary>
    /// <param name="_subRiskClassId">
    /// Subrisk class Id.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static METSubRiskClass find(METSubRiskClassId _subRiskClassId, boolean _forupdate = false)
    {
        METSubRiskClass  subRiskClass;

        if (_subRiskClassId)
        {
            subRiskClass.selectForUpdate(_forupdate);

            select firstonly subRiskClass
                where subRiskClass.SubRiskClass == _subRiskClassId;
        }

        return subRiskClass;
    }

]]></Source>
