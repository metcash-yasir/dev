				<Source><![CDATA[
    public RefreshFrequency xds()
    {
        METInventSiteSecurityPolicyTmp metInventSiteSecurityPolicyTmp;
        METUserSecurityGroupList       metUserSecurityGroupList;
        METUserSecuritySiteList        metUserSecuritySiteList;

        Unchecked(Uncheck::XDS)
        {
            insert_recordset metInventSiteSecurityPolicyTmp(InventSite)
                select SiteId from metUserSecuritySiteList
                    join metUserSecurityGroupList
                where metUserSecurityGroupList.UserSecurityGroupId == metUserSecuritySiteList.UserSecurityGroupId
                && metUserSecurityGroupList.UserId == curUserId();
        }

        return RefreshFrequency::PerSession;
    }

]]></Source>
