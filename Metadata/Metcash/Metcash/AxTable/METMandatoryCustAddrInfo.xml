    static METMandatoryCustAddrInfo find(RefRecId _recId, boolean _forUpdate = false)
    {
        METMandatoryCustAddrInfo metMandatoryCustAddrInfo;

        if (_recId)
        {
            metMandatoryCustAddrInfo.selectForUpdate(_forUpdate);

            select firstonly metMandatoryCustAddrInfo
                where metMandatoryCustAddrInfo.RecId == _recId;
