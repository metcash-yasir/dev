    /// <summary>
    /// clean up table for anything older than 14 days
    /// </summary>
    static void cleanUpOrderShipmentBundlingReportQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METOrderShipmentBundlingReportingJobQueue orderShipmentBundlingReportingJobQueue;
        METOrderShipmentBundlingReportingJobQueue::skip(orderShipmentBundlingReportingJobQueue);

        ttsbegin;
        delete_from orderShipmentBundlingReportingJobQueue
            where orderShipmentBundlingReportingJobQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
