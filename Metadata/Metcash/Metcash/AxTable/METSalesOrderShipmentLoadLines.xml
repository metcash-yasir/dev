		<Methods>
			<Method>
				<Name>displayDeliveryInstructions</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for delivery instructions
    /// </summary>
    /// <returns>METDeliveryInstructions</returns>
    public display METDeliveryInstructions displayDeliveryInstructions()
    {
        METSalesOrderShipmentLoadLines      loadLines;

        select firstonly DeliveryInstructions from loadLines
            where loadLines.OrderNum == this.OrderNum;

        return loadLines.DeliveryInstructions;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayIsHazardousMaterial</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for hazardous material
    /// </summary>
    /// <returns>Boolean value</returns>
    public display NoYesId displayIsHazardousMaterial()
    {
        METSalesOrderShipmentLoadLines           loadLines;
        HMIMItemMaterial    hmimItemMaterial;

        select firstonly RecId from hmimItemMaterial
            exists join loadLines
                where loadLines.ItemId  == hmimItemMaterial.ItemId     &&
                    loadLines.OrderNum == this.OrderNum;

        if (hmimItemMaterial.RecId != 0)
        {
            return NoYes::Yes;
        }
        else
        {
            return NoYes::No;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>displaySalesStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// Method used in sales finalization because of group by on order num
    /// </summary>
    /// <returns>SalesStatus</returns>
    public display SalesStatus displaySalesStatus()
    {
        return SalesLine::find(this.OrderNum, this.LineNum).SalesStatus;
    }

]]></Source>
