			<Method>
				<Name>displayCCRReceived</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for CCR Received
    /// </summary>
    /// <returns>boolean</returns>
    public display boolean displayCCRReceived()
    {
        METCCRTable     ccrTable;
        METTotes        totes;

        select firstonly ccrTable
            where ccrTable.SalesOrder == this.OrderNum;
        if(ccrTable)
        {
            return NoYes::Yes;
        }

        select firstonly totes
            where totes.SalesId == this.OrderNum;
        if(totes)
        {
            return NoYes::Yes;
        }
        return NoYes::No;
    }

]]></Source>
			</Method>
