				<Source><![CDATA[
    /// <summary>
    /// Checks if tax group exists.
    /// </summary>
    /// <param name = "_taxGroup">Tax group.</param>
    /// <returns>Return true if tax group exists; otherwise, false.</returns>
    public static boolean exist(TaxGroup _taxGroup)
    {
        return (select firstonly RecId from METWETTaxGroupParameters
            where METWETTaxGroupParameters.TaxGroup == _taxGroup).RecId != 0;
    }

