		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    ///    Retrieves the Duty country of orign  for a given Country code.
    /// </summary>
    /// <param name="_metCountryCode">
    ///    The country code of the transaction.
    /// </param>
    /// <param name="_forUpdate">
    ///    A Boolean value that determines whether the Duty country of orign should be selected for update; optional.
    /// </param>
    /// <returns>
    ///    The Duty country of orign.
    /// </returns>
    static METDutyCountryOfOrigin find(METCountryCode   _metCountryCode,
                          boolean       _forUpdate = false)
    {
        METDutyCountryOfOrigin metDutyCountryOfOrigin;

        if (_metCountryCode)
        {
            if (_forUpdate)
            {
                metDutyCountryOfOrigin.selectForUpdate(_forUpdate);
            }

            select firstonly metDutyCountryOfOrigin
                where metDutyCountryOfOrigin.CountryCode == _metCountryCode;
        }
        return metDutyCountryOfOrigin;
    }

]]></Source>
			</Method>
		</Methods>
