		<Methods>
			<Method>
				<Name>findComponent</Name>
				<Source><![CDATA[
    /// <summary>
    /// Find a component code record using component
    /// </summary>
    /// <param name = "_component">The <c>METComponent</c> value to retrieve the component code record.</param>
    /// <param name = "_forUpdate">Specifies if record is selected for update</param>
    /// <param name = "_concurrencyModel">Specifies concurrency model</param>
    /// <returns>Found component code record; otherwise, blank.</returns>
    static METComponentCode findComponent(METComponent         _component,
                                          boolean              _forUpdate = false,
                                          ConcurrencyModel     _concurrencyModel = ConcurrencyModel::Auto)
    {
        METComponentCode  componentCode;

        if (_component)
        {
            if (_forUpdate)
            {
                componentCode.selectForUpdate (_forUpdate);
                if (_concurrencyModel != ConcurrencyModel::Auto)
                {
                    componentCode.concurrencyModel(_concurrencyModel);
                }
            }
            componentCode.selectLocked(_forUpdate);

            select firstonly componentCode
                       where componentCode.Component == _component;
        }

        return componentCode;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
