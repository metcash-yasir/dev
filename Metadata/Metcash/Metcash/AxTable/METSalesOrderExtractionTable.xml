			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    static boolean exist(METSalesOrderExtractionId _extractionId)
    {
        METSalesOrderExtractionTable salesOrderExtractionTable;

        if (_extractionId)
        {
            select firstonly RecId 
                from salesOrderExtractionTable
                where salesOrderExtractionTable.ExtractionId == _extractionId;
        }

        return salesOrderExtractionTable.RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    static METSalesOrderExtractionTable find(METSalesOrderExtractionId   _extractionId,
                          boolean       _forUpdate = false)
    {
        METSalesOrderExtractionTable salesOrderExtractionTable;

        if (_extractionId)
        {
            if (_forUpdate)
            {
                salesOrderExtractionTable.selectForUpdate(_forUpdate);
            }

            select firstonly salesOrderExtractionTable
                where salesOrderExtractionTable.ExtractionId == _extractionId;
        }

        return salesOrderExtractionTable;
    }

]]></Source>
