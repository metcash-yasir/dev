			<Method>
				<Name>isAllowBackorderRouteId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Are backorders allowed on a Transfer order, find by route Id
    /// </summary>
    /// <param name = "_pickingRouteId">Route Id</param>
    /// <returns>True/false</returns>
    public static boolean isAllowBackorderRouteId(WMSPickingRouteID _pickingRouteId)
    {
        boolean allowed = false;
    
        WMSPickingRoute             pickingRoute;
        InventTransferTable         inventTransferTable;
        METInventTransferTableExt   inventTransferTableExt;

        while select firstonly pickingRouteID from pickingRoute
            where   pickingRoute.pickingRouteID == _pickingRouteId

            exists  join inventTransferTable
            where   inventTransferTable.TransferId == pickingRoute.transRefId

            exists  join inventTransferTableExt
            where   inventTransferTableExt.InventTransferTable   == inventTransferTable.RecId
            &&      inventTransferTableExt.AllowBackorder        == NoYes::Yes
        {
            allowed = true;
        }

        return allowed;
    }

]]></Source>
			</Method>
			<Method>
				<Name>metIsAutoExtract</Name>
				<Source><![CDATA[
    /// <summary>
    /// get auto extract value
    /// </summary>
    /// <param name = "_metInventLocationIdFrom">from warehouse</param>
    /// <param name = "_metInventLocationIdTo">to warehouse</param>
    /// <returns>True/false</returns>
    public static METAutoExtract metIsAutoExtract(InventLocationIdFrom _metInventLocationIdFrom, InventLocationIdTo _metInventLocationIdTo)
    {
        METAutoExtract metAutoExtract = NoYes::No;

        if(InventLocation::metGetAutoExtract(_metInventLocationIdFrom) && InventLocation::metGetAutoExtract(_metInventLocationIdTo))
        {
            metAutoExtract = NoYes::yes;
        }

        return metAutoExtract;
    }

]]></Source>
			</Method>
			<Method>
				<Name>setExtractionStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// Set Extraction status
    /// </summary>
     public void  setExtractionStatus()
    {
        this.OrderExtractStatus = this.AutoExtract == NoYes::Yes ? METOrderExtractStatus::ReadyForExtract : METOrderExtractStatus::Open;
    }

]]></Source>
			</Method>
			<Method>
				<Name>UpdateExtractionStatus</Name>
				<Source><![CDATA[
    /// <summary>
    /// Update Extract status
    /// </summary>
    /// <param name = "_transferId">Transfer order id</param>
    public static void UpdateExtractionStatus(InventTransferId  _transferId)
    {
        InventTransferTable         inventTransferTable;
        METInventTransferTableExt   inventTransferTableExt;
        InventTransferLine          inventTransferLine;
        METInventTransferLine       metInventTransferLine;

        select firstonly RecId from metInventTransferLine
            exists join inventTransferLine 
            where inventTransferLine.TransferId == _transferId
            && metInventTransferLine.InventTransferLine == inventTransferLine.RecId
            && metInventTransferLine.OrderExtractStatus == METOrderExtractStatus::Open;
      
        select firstonly forupdate inventTransferTableExt
            join RecId from inventTransferTable
            where inventTransferTable.RecId == inventTransferTableExt.InventTransferTable
            && inventTransferTable.TransferId == _transferId;

        if (inventTransferTableExt)
        {
            ttsbegin;
            inventTransferTableExt.OrderExtractStatus = metInventTransferLine.RecId ? METOrderExtractStatus::Open : METOrderExtractStatus::Extracted;
            inventTransferTableExt.update();
            ttscommit;
        }
  
    }

]]></Source>
			</Method>
