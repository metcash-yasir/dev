				<Name>cleanUpABNValidationJobQueue</Name>
				<Source><![CDATA[
    /// <summary>
    /// clean up table for anything older than 14 days
    /// </summary>
    static void cleanUpABNValidationJobQueue()
    {
        utcdatetime cutOffDateTime = DateTimeUtil::addDays(DateTimeUtil::utcNow(), -14);

        METABNValidationJobQueue abnValidationjobQueue;
        METABNValidationJobQueue::skip(abnValidationjobQueue);

        ttsbegin;
        delete_from abnValidationjobQueue
        where abnValidationjobQueue.CreatedDateTime <= cutOffDateTime;
        ttscommit;
    }

]]></Source>
			</Method>
			<Method>
				<Name>skip</Name>
				<Source><![CDATA[
    /// <summary>
    /// skip method for performance purpose
    /// </summary>
    /// <param name = "_abnValidationJobQueue"><c>METABNValidationJobQueue</c> record</param>
    public static void skip(METABNValidationJobQueue _abnValidationJobQueue)
    {
        _abnValidationJobQueue.skipDatabaseLog(true);
        _abnValidationJobQueue.skipDataMethods(true);
        _abnValidationJobQueue.skipDeleteActions(true);
        _abnValidationJobQueue.skipEvents(true);
        _abnValidationJobQueue.skipBusinessEvents(true);
    }

]]></Source>
			</Method>
		</Methods>
