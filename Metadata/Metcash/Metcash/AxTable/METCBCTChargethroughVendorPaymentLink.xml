				<Source><![CDATA[
    /// <summary>
    /// Finds the matching record from METCBCTChargethroughVendorPaymentLink table
    /// </summary>
    /// <param name="_vendAccount">
    /// The value of <c>VendAccount</c> which needs to be searched
    /// </param>
    /// <param name="_forupdate">
    /// The value of <c>boolean</c> if the record is selected for update
    /// </param>
    /// <returns>
    /// buffer of METCBCTChargethroughVendorPaymentLink table
    /// </returns>
    public static METCBCTChargethroughVendorPaymentLink find(VendAccount     _vendAccount, boolean _forupdate = false)
    {
        METCBCTChargethroughVendorPaymentLink chargethroughVendorPaymentLink;

        chargethroughVendorPaymentLink.selectForUpdate(_forupdate);
        select firstonly chargethroughVendorPaymentLink
            where chargethroughVendorPaymentLink.VendAccount == _vendAccount;
             
        return chargethroughVendorPaymentLink;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Check if the matching record from METCBCTChargethroughVendorPaymentLink table exists
    /// </summary>
    /// <param name="_vendAccount">
    /// The value of <c>VendAccount</c> which needs to be searched
    /// </param>
    /// <returns>
    /// True if the matching record is found
    /// </returns>
    public static boolean exist(VendAccount     _vendAccount)
    {
        return (select firstonly RecId from METCBCTChargethroughVendorPaymentLink
                    index hint VendAccountIdx
                    where METCBCTChargethroughVendorPaymentLink.VendAccount == _vendAccount
               ).RecId != 0;
    }

