		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>MetTransferShipmentTable</c> record with given parameters.
    /// </summary>
    /// <param name="_shipmentId">
    /// Id of the shipment.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <param name="_disableCache">
    /// Determines if the <c>MetTransferShipmentTable</c> record is allowed to be selected using cache or not.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static MetTransferShipmentTable find(WHSShipmentId _shipmentId,
                                        boolean       _forupdate = false,
                                        boolean       _disableCache = false)
    {
        MetTransferShipmentTable    shipmentTable;

        if (_shipmentId)
        {
            shipmentTable.selectForUpdate(_forupdate);
            shipmentTable.disableCache(_disableCache);

            select firstonly shipmentTable
                where shipmentTable.ShipmentId== _shipmentId;
        }

        return shipmentTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>transferLoad</Name>
				<Source><![CDATA[
    /// <summary>
    /// load tranfer from old to new
    /// </summary>
    /// <param name = "_oldLoadId">oldLoadId</param>
    /// <param name = "_newLoadId">newLoadId</param>
    protected void transferLoad(MetLoadId _oldLoadId, MetLoadId _newLoadId)
    {
        if (_oldLoadId == _newLoadId)
        {
            return;
        }
        MetTransferShipmentTable metTransferShipmentTable = MetTransferShipmentTable::findByLoadId(_oldLoadId, true);
        if (!metTransferShipmentTable)
        {
            throw error("@WAX5526");
        }
        else
        {
            metTransferShipmentTable.LoadId =_newLoadId;
            metTransferShipmentTable.update();

        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByLoadId</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a specific <c>MetTransferShipmentTable</c> record with given parameters.
    /// </summary>
    /// <param name="_loadId">
    /// Load id of the shipment.
    /// </param>
    /// <param name="_forupdate">
    /// Determines whether the record is selected for update.
    /// </param>
    /// <returns>
    /// The record that is searched for.
    /// </returns>
    public static MetTransferShipmentTable findByLoadId(MetLoadId   _loadId,
                                                boolean     _forupdate = false)
    {
        MetTransferShipmentTable    shipmentTable;

        if (_loadId)
        {
            shipmentTable.selectForUpdate(_forupdate);

            select firstonly shipmentTable
                where shipmentTable.LoadId == _loadId;
        }

        return shipmentTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>transferShipment</Name>
				<Source><![CDATA[
    /// <summary>
    /// transfer shipment to new load
    /// </summary>
    /// <param name = "_newLoadId">WhsLoadid</param>
    void transferShipment(WHSLoadId _newLoadId)
    {
        ttsbegin;
        this.transferLoad(this.LoadId, _newLoadId);
        ttscommit;
    }

]]></Source>
			</Method>
