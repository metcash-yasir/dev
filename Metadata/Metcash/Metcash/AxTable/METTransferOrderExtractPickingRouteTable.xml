				<Name>find</Name>
				<Source><![CDATA[
   /// <summary>
   /// Finds the record based on picking route ID
   /// </summary>
   /// <param name = "_pickingRouteId">
    /// Picking route ID
   /// </param>
   /// <param name = "_forupdate">
    /// Determines whether the record is selected for update.
   /// </param>
   /// <returns>
    /// The record that is searched for.
   /// </returns>
    public static METTransferOrderExtractPickingRouteTable find(WMSPickingRouteID _pickingRouteId, boolean _forupdate = false)
    {
        METTransferOrderExtractPickingRouteTable pickingRouteTable;

        if (_pickingRouteId)
        {
            pickingRouteTable.selectForUpdate(_forupdate);

            select firstonly pickingRouteTable
                where pickingRouteTable.PickingRouteID == _pickingRouteId;
        }

        return pickingRouteTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks whether a specific <c>METTransferOrderExtractPickingRouteTable</c> record exists.
    /// </summary>
    /// <param name="_pickingRouteId">
    /// The parameter of picking route ID
    /// </param>
    /// <returns>
    /// True if found, else false
    /// </returns>
    public static boolean exist(WMSPickingRouteID _pickingRouteId)
    {
        return (_pickingRouteId) &&
               (select firstonly METTransferOrderExtractPickingRouteTable
                    where METTransferOrderExtractPickingRouteTable.PickingRouteID == _pickingRouteId).RecId != 0;
    }

]]></Source>
