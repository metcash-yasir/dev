		<Methods>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method checks for existance of a specific record
    /// </summary>
    /// <param name = "_routeIdentifier">
    /// RouteIdentifier
    /// </param>
    /// <returns>
    /// True if exists, else false.
    /// </returns>
    public static boolean exist(METRouteStopIdentifier _routeStopIdentifier)
    {
        boolean         found;        

        found = (select firstonly
                     RecId
                from
                     METRouteStopTable
                 where
                     METRouteStopTable.RouteStopIdentifier == _routeStopIdentifier).RecId != 0;

        return found;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findByRouteIdentifier</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method finds a specific record based on route identifier
    /// </summary>
    /// <param name = "_routeIdentifier">
    /// RouteIdentifier
    /// </param>
    /// <param name = "_forupdate">
    /// Parameter to update the record
    /// </param>
    /// <returns>
    /// METRouteStopTable buffer
    /// </returns>
    public static METRouteStopTable findByRouteIdentifier(METRouteStopIdentifier _routeStopIdentifier ,
        boolean _forupdate = false)
        
    {
        METRouteStopTable routeStopTable;

        routeStopTable.selectForUpdate(_forupdate);

        select firstonly routeStopTable
            where routeStopTable.RouteStopIdentifier == _routeStopIdentifier;

        return routeStopTable;
    }

]]></Source>
			</Method>
		</Methods>
