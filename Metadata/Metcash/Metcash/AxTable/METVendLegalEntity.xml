				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// MPJ_21178_VendorGlobal By chaminda on 04 Mar 2022
    /// Find the record
    /// </summary>
    /// <param name="_metVendParentCompanyID"> Get vendor parent company id</param>
    /// <param name="_metVendLegalEntityID"> Get vendor legal entity id</param>
    /// <param name="_forupdate"> Get update parameter </param>
    /// <param name="_concurrencyModel"> Get concurrency model parameter </param>
    /// /// <returns>
    /// Return table record
    /// </returns>
    static METVendLegalEntity find(METVendParentCompanyID _metVendParentCompanyID, METVendLegalEntityID _metVendLegalEntityID, boolean _forupdate = false, ConcurrencyModel _concurrencyModel = ConcurrencyModel::Auto)
    {
        METVendLegalEntity metVendLegalEntity;

        metVendLegalEntity.selectForUpdate(_forupdate);
        metVendLegalEntity.concurrencyModel(_concurrencyModel);

        select firstonly metVendLegalEntity
            where metVendLegalEntity.VendParentCompanyID    == _metVendParentCompanyID &&
                  metVendLegalEntity.VendLegalEntityID      == _metVendLegalEntityID;
         
        return metVendLegalEntity;
    }

]]></Source>
