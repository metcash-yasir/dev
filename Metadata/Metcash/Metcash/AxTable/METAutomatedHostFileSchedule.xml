		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean                         ret;
        container                       containerStates;
        Counter                         statesCounter;
        METAutomatedHostFileSchedule    autoHostFileSchedule;
        String255                       existingStates;
    
        ret = super();

        containerStates = str2con(this.States, ';');
        for(statesCounter = 1; statesCounter <= conLen(containerStates); statesCounter++)
        {
            String10 statesSubString = '*' + conPeek(containerStates, statesCounter) + '*';
            select firstonly1 autoHostFileSchedule where autoHostFileSchedule.States like statesSubString;
            if(autoHostFileSchedule)
            {
                existingStates = existingStates + (existingStates ? ',' + conPeek(containerStates, statesCounter) : conPeek(containerStates, statesCounter));
            }
        }
        if(existingStates)
        {
            ret = ret && checkFailed(strFmt("@MET:METStateValidation", existingStates));
        }
    
        return ret;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
