				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// CB231_ContainerContentReport 06/12/2024
    /// find method finds record in METCCRTable
    /// </summary>
    /// <param name = "_warehouse">Warehouse</param>
    /// <param name = "_custAccount">CustomerAccount</param>
    /// <param name = "_orderNumber">OrderNumber</param>
    /// <param name = "_salesId">SalesId</param>
    /// <param name = "_itemId">ItemId</param>
    /// <param name = "_distributionCenter">DistributionCenter</param>
    /// <param name = "_assignment">Assignment</param>
    /// <param name = "_forUpdate">true/false</param>
    /// <returns>Returns METCCRTable table</returns>
    static METCCRTable find(InventLocationId _warehouse,CustAccount _custAccount,str60 _orderNumber,SalesId _salesId,ItemId _itemId,str60 _distributionCenter,Str60 _assignment, boolean _forUpdate = false)
    {
        METCCRTable metCCRTable;

        if (_warehouse && _custAccount  && _orderNumber && _salesId && _itemId && _distributionCenter && _assignment)
        {
            metCCRTable.selectForUpdate(_forUpdate);
          
            select firstonly metCCRTable
              where metCCRTable.Warehouse == _warehouse
                && metCCRTable.CustAccount == _custAccount
                && metCCRTable.SalesOrder == _salesId
                && metCCRTable.ItemNumber == _itemId
                && metCCRTable.DistributionCenter == _distributionCenter
                && metCCRTable.Assignment == _assignment;
        }

        return metCCRTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method is used to check if a record that fulfils the specified key actually exists
    /// </summary>
    /// <param name = "_warehouse">Warehouse</param>
    /// <param name = "_custAccount">CustomerAccount</param>
    /// <param name = "_orderNumber">OrderNumber</param>
    /// <param name = "_salesId">SalesId</param>
    /// <param name = "_itemId">ItemId</param>
    /// <param name = "_distributionCenter">DistributionCenter</param>
    /// <param name = "_assignment">Assignment</param>
    /// <returns>returns true or false depedning if records exists</returns>
    static boolean exist(InventLocationId _warehouse,CustAccount _custAccount,str60 _orderNumber,SalesId _salesId,ItemId _itemId,str60 _distributionCenter,Str60 _assignment)
    {
        return _warehouse && _custAccount  && _orderNumber && _salesId && _itemId && _distributionCenter && _assignment &&
              (select firstonly RecId from METCCRTable
                where METCCRTable.Warehouse == _warehouse
                && METCCRTable.CustAccount == _custAccount
                && METCCRTable.SalesOrder == _salesId
                && METCCRTable.ItemNumber == _itemId
                && METCCRTable.DistributionCenter == _distributionCenter
                && METCCRTable.Assignment == _assignment).RecId != 0;
    }

]]></Source>
