		<Methods>
			<Method>
				<Name>getPillarValue</Name>
				<Source><![CDATA[
    /// <summary>
    /// This method displays the Pillar dimension value
    /// </summary>
    /// <returns><c>str</c> the pillar dimension value for a particular dimension set.</returns>
    public static server str getPillarValue()
    {
        str defaultDimension;

        defaultDimension = sysComputedColumn::returnField(viewstr(METPillarDimensionValues),
                                   identifierStr(DimensionAttributeValueSet), fieldStr(DimensionAttributeValueSet, RecId));

        return strFmt(@'select PillarValue from DimensionAttributeValueSet as dimension
                            where dimension.RecId = %1', defaultDimension);
    }

]]></Source>
