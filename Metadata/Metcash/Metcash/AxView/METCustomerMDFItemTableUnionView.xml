				<Source><![CDATA[
    /// <summary>
    /// Find record in METCustomerMDFItemTableUnionView by RefRecId, ItemTypes and Category
    /// </summary>
    /// <param name = "_refRecId">RefRecId</param>
    /// <param name = "_itemTypes">METItemTypes</param>
    /// <param name = "_category">EcoResCategoryId</param>
    /// <returns>METCustomerMDFItemTableUnionView</returns>
    static METCustomerMDFItemTableUnionView find(RefRecId _refRecId,
                                                 METItemTypes _itemTypes,
                                                 EcoResCategoryId _category)
    {
        METCustomerMDFItemTableUnionView customerMDFItemTableUnionView;
   
        select firstonly customerMDFItemTableUnionView
                where customerMDFItemTableUnionView.RefRecId == _refRecId
                   && customerMDFItemTableUnionView.METItemTypes == _itemTypes
                   && customerMDFItemTableUnionView.Category == _category;

        return customerMDFItemTableUnionView;
    }

]]></Source>
