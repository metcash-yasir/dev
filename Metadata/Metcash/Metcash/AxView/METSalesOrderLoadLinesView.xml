		<Methods>
			<Method>
				<Name>displayCustName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display customer name
    /// </summary>
    /// <returns>Name</returns>
    public display CustName displayCustName()
    {
        return CustTable::find(this.CustAccount).name();
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayShippingCarrier</Name>
				<Source><![CDATA[
    public display TMSCarrierCode displayShippingCarrier()
    {
        METSalesOrderShipmentLoadLines      shipmentLoadLines;
        TMSSalesTable                       tmsSalesTable;

        select firstonly CarrierCode from tmsSalesTable
            exists join shipmentLoadLines
                order by OrderNum asc
                    where tmsSalesTable.SalesId == shipmentLoadLines.OrderNum   &&
                        shipmentLoadLines.ShipmentId == this.ShipmentId;

        return tmsSalesTable.CarrierCode;
    }

]]></Source>
			</Method>
