    /// <summary>
    ///
    /// </summary>
    public static str metCases()
    {
        /*this.SalesUnit == METConstants::unitEach ? 0 : this.SalesQty;*/

        return strFmt(
        @"CASE WHEN %1 = '%2' THEN 0 ELSE %3 END",
        SysComputedColumn::returnField(viewStr(METSalesOrderLoadPlanningAidView), tableStr(SalesLine), fieldStr(SalesLine, SalesUnit)),
        METConstants::unitEach,
        SysComputedColumn::returnField(viewStr(METSalesOrderLoadPlanningAidView), tableStr(SalesLine), fieldStr(SalesLine, SalesQty))
        );
    }

]]></Source>
