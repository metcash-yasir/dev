        SysComputedColumn::returnField(viewStr(METSalesOrderLoadPlanningAidView), tableStr(SalesLine), fieldStr(SalesLine, SalesUnit)), // Field for condition
        METConstants::unitEach, // Value to compare
        SysComputedColumn::returnField(viewStr(METSalesOrderLoadPlanningAidView), tableStr(SalesLine), fieldStr(SalesLine, SalesQty)) // Value if condition is true
        );
    }

