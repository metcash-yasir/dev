		<Methods>
			<Method>
				<Name>computeVolume</Name>
				<Source><![CDATA[
    /// <summary>
    /// Calculate volume
    /// </summary>
    /// <returns>returns volume</returns>
    public static server str computeVolume()
    {
        str uomView  = identifierstr(METTransferOrderExtractScreenUOMSiteView);
        str uomSite = identifierstr(METWHSPhysDimUOMSite);
        str transferLine = identifierstr(InventTransferLine);
        str Width = SysComputedColumn::sum(SysComputedColumn::returnField(uomView, uomSite, identifierstr(Width)));
        str Height = SysComputedColumn::sum(SysComputedColumn::returnField(uomView, uomSite, identifierstr(Height)));
        str Depth = SysComputedColumn::sum(SysComputedColumn::returnField(uomView, uomSite, identifierstr(Depth)));
        str Qty = SysComputedColumn::sum(SysComputedColumn::returnField(uomView, transferLine, identifierstr(QtyTransfer)));
        return SysComputedColumn::multiply(SysComputedColumn::multiply(SysComputedColumn::multiply(Width, Height), Depth),Qty);
    }

]]></Source>
			</Method>
			<Method>
				<Name>computeWeight</Name>
				<Source><![CDATA[
    /// <summary>
    /// Calculate weight
    /// </summary>
    /// <returns>returns volume</returns>
    public static server str computeWeight()
    {
        str uomView  = identifierstr(METTransferOrderExtractScreenUOMSiteView);
        str uomSite = identifierstr(METWHSPhysDimUOMSite);
        str transferLine = identifierstr(InventTransferLine);
        str weight = SysComputedColumn::sum(SysComputedColumn::returnField(uomView, uomSite, identifierstr(Weight)));
        str Qty = SysComputedColumn::sum(SysComputedColumn::returnField(uomView, transferLine, identifierstr(QtyTransfer)));
        return SysComputedColumn::multiply(weight,Qty);
    }

]]></Source>
			</Method>
		</Methods>
