    public display METDutyLAL displayDutyLAL()
    {
        return METTariffItemCode::findRecId(METInventTable::find(this.ItemId).METTariffItemCodeBaseRecid).DutyLAL;
    }

    /// <summary>
    /// Display method for duty
    /// </summary>
    /// <returns>ValueforDuty</returns>
