			<Method>
				<Name>displayOriginParty</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for origin party
    /// </summary>
    /// <returns>VendAccount</returns>
    public display VendAccount displayOriginParty()
    {
        if (this.OriginType == InventTransType::Purch)
        {
            return PurchTable::find(this.OriginNumber).OrderAccount;
        }
        else
        {
            return '';
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayCustomsExciseExempt</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method for custom excise exempt
    /// </summary>
    /// <returns>CustomsExciseExempt</returns>
    public display NoYes displayCustomsExciseExempt()
    {
        CustomerAttributeValueEntity    customerAttributeValueEntity;
        SalesTable                      salesTable;
        VendParameters                  vendParameters;

        if (this.OriginType == InventTransType::Sales)
        {
            vendParameters = VendParameters::find();
            salesTable  = SalesTable::find(this.OriginNumber);

            select firstonly BooleanValue from customerAttributeValueEntity
                where customerAttributeValueEntity.AccountNum == salesTable.CustAccount     &&
                    customerAttributeValueEntity.AttributeName == vendParameters.METExciseCustomerAttribute;

            return customerAttributeValueEntity.BooleanValue;

        }
        return false;
    }

]]></Source>
			</Method>
