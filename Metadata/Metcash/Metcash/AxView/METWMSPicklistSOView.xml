		<Methods>
			<Method>
				<Name>getCustomer</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns customer field query.
    /// </summary>
    /// <returns>Query for customer field.</returns>
    public static str getCustomer()
    {
        List     interCompanySOcondition;
        str      query; 
        
        interCompanySOcondition = new List(Types::String); 

        interCompanySOcondition.addEnd(SysComputedColumn::equalExpression(
                                            SysComputedColumn::comparisonField(tableStr(METWMSPicklistSOView), 
                                                                               identifierStr(SalesTable),
                                                                               fieldStr(SalesTable, InterCompanyOrder)),
                                                                               SysComputedColumn::comparisonLiteral(NoYes::Yes)));

        interCompanySOcondition.addEnd(SysComputedColumn::equalExpression(
                                            SysComputedColumn::comparisonField(tableStr(METWMSPicklistSOView),
                                                                               identifierStr(SalesTable),
                                                                               fieldStr(SalesTable, InterCompanyOrigin)),
                                                                               SysComputedColumn::comparisonLiteral(InterCompanyOrigin::Derived)));

        query = SysComputedColumn::if(
                    SysComputedColumn::and(interCompanySOcondition),
                    SysComputedColumn::returnField(tableStr(METWMSPicklistSOView), identifierStr(SalesTable), fieldStr(SalesTable, InterCompanyOriginalCustAccount)),
                    SysComputedColumn::returnField(tableStr(METWMSPicklistSOView), identifierStr(SalesTable), fieldStr(SalesTable, CustAccount)));

        return query;
    }

]]></Source>
