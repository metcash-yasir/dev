				<Name>contactPersonName</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method to show Contact Person Name
    /// </summary>
    /// <returns></returns>
    [SysClientCacheDataMethod(true)]
    display ContactPersonName contactPersonName()
    {
        SalesTable salesTable = SalesTable::find(this.SalesId);
        return ContactPerson::name(salesTable.ContactPersonId);
    }

]]></Source>
			</Method>
			<Method>
				<Name>qualityOrderStatusDisplay</Name>
				<Source><![CDATA[
    /// <summary>
    /// Display method to show Quality order status
    /// </summary>
    [SysClientCacheDataMethod(true)]
    display InventTestOrderStatusDisplay qualityOrderStatusDisplay()
    {
        SalesTable salesTable = SalesTable::find(this.SalesId);

        return salesTable.qualityOrderStatusDisplay();
    }

]]></Source>
