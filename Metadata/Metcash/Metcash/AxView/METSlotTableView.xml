		<Methods>
			<Method>
				<Name>getFromSlot</Name>
				<Source><![CDATA[
    /// <summary>
    /// Formula for FromSlot
    /// </summary>
    /// <returns>String</returns>
    public static server str getFromSlot()
    { 
        str tableName = tableStr(METSlotTableView);
        str dataSourceName = dataEntityDataSourceStr(METSlotTableView, METSlotTable);
        str fieldName = fieldStr(METSlotTable, FromSlot);
         
        str fromSlotField = SysComputedColumn::returnField(tableName, dataSourceName, fieldName);

        // Generates SQL: REPLACE(T1.FROMSLOT, '-', '')
        return strFmt("REPLACE(%1, '-', '')", fromSlotField);
    }

]]></Source>
			</Method>
			<Method>
				<Name>getToSlot</Name>
				<Source><![CDATA[
    /// <summary>
    /// Formula for ToSlot
    /// </summary>
    /// <returns>String</returns>
    public static server str getToSlot()
    { 
        str tableName = tableStr(METSlotTableView);
        str dataSourceName = dataEntityDataSourceStr(METSlotTableView, METSlotTable);
        str fieldName = fieldStr(METSlotTable, ToSlot); // Using ToSlot field

        str toSlotField = SysComputedColumn::returnField(tableName, dataSourceName, fieldName);

        // SQL: REPLACE(T1.TOSLOT, '-', '')
        return strFmt("REPLACE(%1, '-', '')", toSlotField);
    }

]]></Source>
			</Method>
