		<Methods>
			<Method>
				<Name>isValidRecord</Name>
				<Source><![CDATA[
    /// <summary>
    /// isValidRecord
    /// </summary>
    public static  str isValidRecord()
    {
        str reasonCode = SysComputedColumn::returnField(tableStr(METPurchaseOrderAdjustmentView), identifierStr(METPurchLine), fieldStr(METPurchLine, ChangeReasonCode));
        str vendReturn = SysComputedColumn::returnField(tableStr(METPurchaseOrderAdjustmentView), identifierStr(METPurchTable), fieldStr(METPurchTable, VendorReturn));

        return 'Case when (( ' + reasonCode  + ' = \'KN\'' + ' Or ' + reasonCode + ' = \'LR\'' + ') Or ' + vendReturn + ' = 1) then 1 else 0 END';
    }

]]></Source>
