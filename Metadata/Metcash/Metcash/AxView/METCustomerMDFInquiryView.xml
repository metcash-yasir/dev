	<SourceCode>
		<Declaration><![CDATA[
public class METCustomerMDFInquiryView extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>displayTotal</Name>
				<Source><![CDATA[
    /// <summary>
    /// Displays the total based on the delivery charge type.
    /// </summary>
    /// <returns>Total</returns>
    display Total displayTotal()
    {
        Total ret;

        switch (this.DeliveryChargeType)
        {
            case METDeliveryChargeType::CartonTotalCaseFee:
            case METDeliveryChargeType::CartonTotalFlatFee:
                ret = this.Qty;
                break;
            case METDeliveryChargeType::TotalDeliveryFees:
                ret = this.DeliveryFee;
                break;
            case METDeliveryChargeType::TotalInvoiceAmount:
                ret = this.Amount;
                break;
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayTotalPerOrder</Name>
				<Source><![CDATA[
    /// <summary>
    /// Displays the total per order based on the delivery charge type.
    /// </summary>
    /// <returns>Total</returns>
    display Total displayTotalPerOrder()
    {
        METCustomerMDFInquiryView viewSum;

        select firstonly DeliveryChargeType, sum(Qty), sum(DeliveryFee), sum(Amount) from viewSum
            group by DeliveryChargeType
            where viewSum.SalesId == this.SalesId;

        return viewSum.displayTotal();
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayTotalPerInvoice</Name>
				<Source><![CDATA[
    /// <summary>
    /// Displays the total per invoice based on the delivery charge type.
    /// </summary>
    /// <returns>Total</returns>
    display Total displayTotalPerInvoice()
    {
        METCustomerMDFInquiryView viewSum;

        select firstonly DeliveryChargeType, sum(Qty), sum(DeliveryFee), sum(Amount) from viewSum
            group by DeliveryChargeType
        where viewSum.InvoiceId == this.InvoiceId;

        return viewSum.displayTotal();
    }

]]></Source>
			</Method>
			<Method>
				<Name>displayTotalPerShipment</Name>
				<Source><![CDATA[
    /// <summary>
    /// Displays the total per shipment based on the delivery charge type.
    /// </summary>
    /// <returns>Total</returns>
    display Total displayTotalPerShipment()
    {
        METCustomerMDFInquiryView viewSum;

        select firstonly DeliveryChargeType, sum(Qty), sum(DeliveryFee), sum(Amount) from viewSum
            group by DeliveryChargeType
            where viewSum.ShipmentId == this.ShipmentId;

        return viewSum.displayTotal();
    }

]]></Source>
			</Method>
		</Methods>
