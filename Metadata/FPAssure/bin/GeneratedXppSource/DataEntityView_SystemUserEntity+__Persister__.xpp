    private UserInfo LookForUniqueKeyMatch_DS1(SystemUserEntity _systemUserEntity, UserInfo _userInfo)
    {
        UserInfo userInfo_ = null;
        
        select
            forUpdate
            firstOnly
                userInfo_
        where
            userInfo_.id == _userInfo.id
        ;
        
        if (userInfo_)
        {
            return userInfo_;
        }
        
        return userInfo_;
    }
