    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // deletes data sources that reference [DirPartyBaseEntity].
            {
                // deletes data sources that reference [CompanyInfo].
                {
                    // handle datasources which are part of extensions and need to be saved before [DataArea]
                    if(!this.preSaveDataSource(_entityCtx, 'DataArea'))
                    {
                        return false;
                    }
                    _dataSourceCtx = _entityCtx.getRuntimeContextByName('DataArea');
                    // skips delete operation against read-only data source.
                    // marks the read-only data source as 'saved' and skips actual delete operation.
                    _dataSourceCtx.setDataSaved(true);
                    _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                    // deletes data source [DataArea].
                    this.saveDataSource(_entityCtx, _dataSourceCtx);
                    this.postSaveDataSource();
                }
                // handle datasources which are part of extensions and need to be saved before [CompanyInfo]
                if(!this.preSaveDataSource(_entityCtx, 'CompanyInfo'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('CompanyInfo');
                // deletes data source [CompanyInfo].
                if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
                {
                    // returns from here if an inner joined data source fails to be saved.
                    return false;
                }
                this.postSaveDataSource();
            }
            {
                // handle datasources which are part of extensions and need to be saved before [LogisticsPostalAddressBaseEntity]
                if(!this.preSaveDataSource(_entityCtx, 'LogisticsPostalAddressBaseEntity'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('LogisticsPostalAddressBaseEntity');
                // deletes data source [LogisticsPostalAddressBaseEntity].
                this.saveDataSource(_entityCtx, _dataSourceCtx);
                this.postSaveDataSource();
            }
            // handle datasources which are part of extensions and need to be saved before [DirPartyBaseEntity]
            if(!this.preSaveDataSource(_entityCtx, 'DirPartyBaseEntity'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('DirPartyBaseEntity');
            // deletes data source [DirPartyBaseEntity].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
